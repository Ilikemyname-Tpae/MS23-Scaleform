         var loadoutIdx : int
         for loadoutIdx := 0 to shopShelf.items.Get().Count() - 1
            var loadoutId    : string = (string)shopShelf.items.Get().Get(loadoutIdx).value.Get()
            var shopComp     : GL_ComponentShop = (GL_ComponentShop)$UiGlobals.componentsShop.Get(loadoutId)
            if (shopComp.offers.Get().Count() > 0)
               var loadoutOffer : GL_ComponentShopOffer = (GL_ComponentShopOffer)shopComp.offers.Get().Get(0)
               ret.Push((string)loadoutOffer.GetGlCost())
            else
               ret.Push("n/a~")
            end
         end
      end
      while (ret.Count() < 5)
         ret.Push("n/a~")
      end
      return ret 
   end
   
   func GetOfferCostCr(loadoutIdx : int) : string
      var ret     : string
      var costVec : vector = crOfferCosts.Get()
      if (loadoutIdx >= 0 and loadoutIdx < costVec.Count())
         ret := costVec.Get(loadoutIdx)
      end
      return ret
   end
   
   func GetOfferCostGp(loadoutIdx : int) : string
      var ret     : string
      var costVec : vector = gpOfferCosts.Get()
      if (loadoutIdx >= 0 and loadoutIdx < costVec.Count())
         ret := costVec.Get(loadoutIdx)
      end
      return ret
   end
   
end

