   var can_customize_secondary   : ObservableProperty = null
   var can_customize_visor       : ObservableProperty = null
   var can_customize_lights      : ObservableProperty = null
   var can_customize_holo        : ObservableProperty = null

   var ui_stats_protection       : ObservableProperty = null
   var ui_stats_weapons          : ObservableProperty = null
   var ui_stats_tech             : ObservableProperty = null
   var ui_stats_mobility         : ObservableProperty = null
   var ui_stats_cqc              : ObservableProperty = null
   var ui_stats_radar            : ObservableProperty = null

   // ssl-only
   var suitId                    : ObservableProperty = $OM.Property("")
   
   func GetEquipState(_loadoutIdx : int = -1) : int
      var ret        : int    = $uiEnums.CHALLENGE_ITEM_STATE_NOT_EQUIPPED
      var suitIdVal  : string = (string)suitId.Get()      
      if (suitIdVal != "")
         var loadout : UD_ArmorLoadout = (UD_ArmorLoadout)$UserDataStorage.GetLocalUserData().armor_loadouts.spartan.loadouts.Get().Get(_loadoutIdx)
         if loadout.armor.Get() == suitId.Get()
            ret := $uiEnums.CHALLENGE_ITEM_STATE_EQUIPPED
         end
      end
      return ret
   end
   
   func GetShowroomEquipState(_loadoutIdx : int = -1) : int
      var ret        : int    = $uiEnums.CHALLENGE_ITEM_STATE_NOT_EQUIPPED
      var suitIdVal  : string = (string)suitId.Get()      
      if (suitIdVal != "")
         var loadout : UD_ArmorLoadout = $UserDataStorage.local_user.GetShowroomArmorLoadout($UserDataStorage.local_user.GetCurrentArmorLoadoutIdx())
         if loadout.armor.Get() == suitId.Get()
            ret := $uiEnums.CHALLENGE_ITEM_STATE_EQUIPPED
         end
      end
      return ret
   end
end

