__type = ui_gfx_frame
gfx_movie = boot_up_screen
loading_screen = true

ssl = <<<

var interpolateDuration: float := 5
var extrapolateDuration: float := 40
var extrapolateValue: float := 0.1

override OnInit
   Log("->LoadingScreen.OnInit()")

   asSetupProgress(interpolateDuration, extrapolateDuration, extrapolateValue)
   var p: params
   p.state := "preload"
   ASCall("asSetState", p)   
end

func asSetupProgress(interpolateDuration:float, extrapolateDuration:float, extrapolateValue:float)
   var p: params
   p.interpolateDuration := interpolateDuration
   p.extrapolateDuration := extrapolateDuration
   p.extrapolateValue := extrapolateValue
   ASCall("asSetupProgress", p)
end


override OnTerm
   Log("->LoadingScreen.OnTerm()")
   
   var pp : params
   pp.idx := 0
   Fire("ReleasePauseController", pp)
end


>>>
