class UiHf2pMainMenuDebugPanelVM : UiWidgetContainer
   var   debugTxt             : ObservableProperty = $OM.Calculated(this, "GetDebugTxt")
   var   debugStrings         : vector
   var   startTime            : int = -1
   var   isEnabled            : ObservableProperty = $OM.Property("false")

   //global event uiDbgKey4()
   //   isEnabled.Set(! (bool)isEnabled.Get())
   //end

   func GetIsVisible() : bool
      var isConsoleEnabled : bool = (bool)($sslOptionsSys.GetVariable("Debug.EnableConsole"))
      return isConsoleEnabled and (bool)isEnabled.Get()
   end
   
   func GetCurTime() : int
      if (startTime == -1)
         startTime := (int)$UiGlobals.timer.Get()
      end
      var curTimer : int = (int)$UiGlobals.timer.Get()
      return curTimer
   end
   
   func GetDebugTxt() : string
      var ret : string = ""
      if (GetIsVisible())
         var curTimer : int = GetCurTime()
         ret := ret + " Time = " + (string) curTimer + "\n"
         
         var i : int
         var startI : int = debugStrings.Count() - 45
         if (startI < 0)
            startI := 0
         end
         for i := startI to debugStrings.Count() - 1
            var p : params = debugStrings.Get(i)
            var mesTime : int = (int)p.mesTime
            //if (curTimer - mesTime < 15)
               ret := ret + " " + (string)(i+1) + ") " + p.mesTxt + "\n"
            //end
         end
      end
      return ret
   end
   
   func AddMesEvent(p : params) : bool
      AddMes(p.str)
      return false
   end
   
   func AddMes(_str : string)
      if (! GetIsVisible())
         return
      end
      var curTimer : int = GetCurTime()
      var p : params
      p.mesTime   := curTimer
      p.mesTxt    := _str
      debugStrings.Push(p)
      debugTxt.Invalidate()
   end
end


