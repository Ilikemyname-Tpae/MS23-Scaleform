   offersModuleRentNew   =   {
      sslClass   =   "UiOffersModuleRentNew"
      sslModule   =   "ui.libs.hf2p_WeaponConf_lib.hf2p_WeaponConf_lib"
      isNoTranslate   =   True
      isBlinkable   =   True
      handlers   =   {
         OnUpdateOfferContAfterBuy   =   {
            handlerName   =   "OnUpdateOfferContAfterBuy"
         }
      }
      elements   =   {
         gpBuyBtn   =   {
            aliasName   =   "OfferBuyGoldButton"
