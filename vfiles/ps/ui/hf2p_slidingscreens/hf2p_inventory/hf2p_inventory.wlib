   InventoryLir   =   {
      sslClass   =   "UiInventoryLir"
      sslModule   =   "ui.hf2p_SlidingScreens.hf2p_Inventory.hf2p_Inventory"
      isBlinkable   =   True
      events   =   {
         doubleClick   =   {
            eventRemap   =   "#InventoryLIRDoubleClick"
         }
      }
      elements   =   {
         greyOverInst   =   {
            bindings   =   {
               visible   =   {
                  binding   =   "{false}"
               }
            }
            __type   =   "ui_widget_container"
         }
         timerInventory   =   {
            isBlinkable   =   True
            propMapping   =   {
               textColor   =   {
                  mapping   =   "tf.textColor"
               }
            }
            bindings   =   {
               visible   =   {
                  binding   =   "{ShowTimer()}"
               }
               tf   =   {
                  binding   =   "{GetRentStatus()}"
               }
               textColor   =   {
                  binding   =   "{GetRentStatusColor()}"
               }
            }
            __type   =   "ui_inventory_lib_as3::timeContainer"
         }
         textFieldUp   =   {
            bindings   =   {
               textFieldUp   =   {
                  binding   =   "{GetInvItemLabel()}"
               }
            }
            __type   =   "ui_inventory_lib_as3::nameTextCont"
         }
         wpnIndicator   =   {
            bindings   =   {
               visible   =   {
                  binding   =   "{false}"
               }
            }
            __type   =   "ui_widget_container"
         }
         bgGrad   =   {
            bindings   =   {
               visible   =   {
                  binding   =   "{IsItemValid()}"
               }
               mouseEnabled   =   {
                  binding   =   "{false}"
               }
               mouseChildren   =   {
                  binding   =   "{false}"
               }
            }
            __type   =   "ui_inventory_lib_as3::gradBg"
         }
         itemQualityCont   =   {
            bindings   =   {
               anim   =   {
                  binding   =   "{GetItemQuality()}"
               }
            }
            __type   =   "ui_widget_container"
         }
         attachContainerIcon   =   {
            elements   =   {
               attachContainerInt   =   {
                  isBlinkable   =   True
                  bindings   =   {
                     pic   =   {
                        binding   =   "{GetInvItemIcon()}"
                     }
                  }
                  __type   =   "ui_inventory_lib_as3::attachContainer"
               }
            }
            __type   =   "ui_inventory_lib_as3::attachIconInventory"
         }
      }
      bindings   =   {
         mouseChildren   =   {
            binding   =   "{itemId != ''}"
         }
         mouseEnabled   =   {
            binding   =   "{itemId != ''}"
         }
         DC   =   {
            binding   =   "{new: 'ui.hf2p_SlidingScreens.hf2p_Inventory.hf2p_Inventory.InventoryLirVM', itemId = (:DC2).itemId}"
         }
      }
      contextMenu   =   {
         bindings   =   {
            Command0   =   {
               binding   =   "{new {label: 'carousel_ui_btn_assign', isEnabled: true, isVisible: !IsTacticalPackage(), eventName: '#AssignItem', eventParams: new {itemId: (:DC2).itemId}}}"
            }
            Command1   =   {
               binding   =   "{new {label: 'carousel_ui_assign_tp0', isEnabled: true, isVisible: IsTacticalPackage(), eventName: '#AssignTacticalPackageInSlot', eventParams: new {itemId: (:DC2).itemId, index: 0}}}"
            }
            Command2   =   {
               binding   =   "{new {label: 'carousel_ui_assign_tp1', isEnabled: true, isVisible: IsTacticalPackage(), eventName: '#AssignTacticalPackageInSlot', eventParams: new {itemId: (:DC2).itemId, index: 1}}}"
            }
            Command3   =   {
               binding   =   "{new {label: 'carousel_ui_assign_tp2', isEnabled: true, isVisible: IsTacticalPackage(), eventName: '#AssignTacticalPackageInSlot', eventParams: new {itemId: (:DC2).itemId, index: 2}}}"
            }
            Command4   =   {
               binding   =   "{new {label: 'carousel_ui_assign_tp3', isEnabled: true, isVisible: IsTacticalPackage(), eventName: '#AssignTacticalPackageInSlot', eventParams: new {itemId: (:DC2).itemId, index: 3}}}"
            }
            Command5   =   {
               binding   =   "{new {label: RenewByCrLabel(), isEnabled: true, isVisible: VisibleRenewContextCr(), eventName: '#RenewInventoryItemByCr', eventParams: new {itemId: (:DC2).itemId}}}"
            }
            Command6   =   {
               binding   =   "{new {label: RenewByGpLabel(), isEnabled: true, isVisible: VisibleRenewContextGp(), eventName: '#RenewInventoryItemByGp', eventParams: new {itemId: (:DC2).itemId}}}"
            }
            Command7   =   {
               binding   =   "{new {label: 'carousel_view_in_shop', isEnabled: true, isVisible: IsItemValid(), eventName: '#ViewItemInShop', eventParams: new {itemId: (:DC2).itemId}}}"
            }
            CanOpen   =   {
               binding   =   "{CanOpenContext()}"
            }
         }
         __type   =   "hf2p_Default_lib::def_ContextMenu"
      }
      __type   =   "ui_inventory_lib_as3::hf2p_InventoryListLIR_S"
   }
