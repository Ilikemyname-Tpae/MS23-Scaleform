handle OnEnterState("MainMenuInitial")
   //music
   EnableFakeBg()
   $hf2pEngine.SetUIMusicId(1)   
   isRematchScreens  := false
   EnablePanelsInput(true)
   if (autoLoginScreen != "")
      var autoScreen : string = autoLoginScreen
      autoLoginScreen := ""
      if (autoScreen == $uiEnums.SLIDING_PAGE_WEAPONS)
         OpenSlidingScreenByName($uiEnums.SLIDING_PAGE_WEAPONS)
      elif (autoScreen == "Playlist")
         GenerateEvent("onMatchmakeGame", null)
      end
   end
   if ($UiGlobals.notifications.session_reward_replayIdx != $uiEnums.NOTIFICATION_SESSION_REWARDS_UNDEFINED)
      $UiGlobals.notifications.session_reward_replayIdx := $uiEnums.NOTIFICATION_SESSION_REWARDS_UNDEFINED
      GenerateEvent("openRosterDockerOver")
   end
   if (! notifSubscribed)
      notifSubscribed := true
      $UiGlobals.notifications.notifications.Subscribe(this, "CheckAllNotif")
      //$UiGlobals.notifications.challenge_complete.Subscribe(this, "")
   end
   ShowSpotlightScreen()
end          

func CheckAllNotif()
   $root.CheckAllNotifications()
end

func ShowSpotlightScreen()
   var newsVec : vector = $UiGlobals.news.Get()
   if (newsVec.Count() > 0)
      var newsGl : GL_News = (GL_News)newsVec.Get(newsVec.Count() - 1)
      var isRead : bool = (bool)newsGl.is_read.Get() 
      if (!isRead)
         var p : params
         p.newsId := (string)newsGl.id.Get()
         openNewsScreen(p)
      end   
   end
end
