               }
            }
            bindings   =   {
               DC   =   {
                  binding   =   "{rentDrop}"
               }
            }
            __type   =   "hf2p_Inventory::InventoryFilter"
         }
         tfHeadInventory   =   {
            isBlinkable   =   True
            bindings   =   {
               tf   =   {
                  binding   =   "{'main_inventory'}"
               }
            }
            __type   =   "ui_widget_container"
         }
         inventoryList   =   {
            isBlinkable   =   True
            events   =   {
               itemClick   =   {
                  eventRemap   =   "#onInventoryListClick"
               }
               itemRollOver   =   {
                  eventRemap   =   "#onInventoryListOver"
               }
               itemRollOut   =   {
                  eventRemap   =   "#onInventoryListOut"
               }
               itemDoubleClick   =   {
                  eventRemap   =   "#onInventoryListDoubleClick"
               }
