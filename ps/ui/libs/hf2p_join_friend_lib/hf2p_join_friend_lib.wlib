classes   =   {
   friendLir   =   {
      sslClass   =   "UiFriendLir"
      sslModule   =   "ui.libs.hf2p_join_friend_lib.hf2p_join_friend_lib"
      fixed   =   False
      elements   =   {
         JoinOrAddButton   =   {
            sslClass   =   "UiJoinOrAddButton"
            sslModule   =   "ui.libs.hf2p_join_friend_lib.hf2p_join_friend_lib"
            fixed   =   False
            events   =   {
               buttonClick   =   {
                  eventRemap   =   "onJoinOrAddBtnClick"
               }
            }
            elements   =   {
               attachPoint   =   {
                  impl   =   {
                     __type   =   "ui_widget_impl_gfx_image"
                  }
                  __type   =   "ui_widget_image"
               }
            }
            impl   =   {
               __type   =   "ui_widget_impl_gfx"
            }
            scaleX   =   0.99
            scaleY   =   0.99
            visible   =   False
            __type   =   "ui_widget_container"
         }
      }
      impl   =   {
         propMapping   =   {
            btn1Txt   =   {
               mapping   =   "JoinOrAddButton.tfContainer.tf.text"
            }
            statusTxt   =   {
               mapping   =   "textStatusField.textField2.text"
            }
            text   =   {
               mapping   =   "textNameCont.textField1.text"
            }
         }
         __type   =   "ui_widget_impl_gfx_list_item"
      }
      visible   =   False
      customProps   =   [
         {
            propName   =   "text"
            propVal   =   {
               val   =   "text"
               __type   =   "ui_widget_desc_prop_string"
            }
         },
         {
            propName   =   "statusTxt"
            propVal   =   {
               val   =   "Online"
               __type   =   "ui_widget_desc_prop_string"
            }
         },
         {
            propName   =   "btn1Txt"
            propVal   =   {
               __type   =   "ui_widget_desc_prop_string"
            }
         }
      ]
      __type   =   "ui_activity_lib::hf2pRosterLir"
   }
   friendList   =   {
      events   =   {
         itemClick   =   {
            eventRemap   =   "onListItemSelected"
         }
         itemRollOut   =   {
            eventRemap   =   "onListItemOut"
         }
         itemRollOver   =   {
            eventRemap   =   "onListItemOver"
         }
      }
      layer   =   "Layer2"
      x   =    -135      y   =    -20      customProps   =   [
         {
            propName   =   "isFriendList"
            propVal   =   {
               val   =   True
               __type   =   "ui_widget_desc_prop_bool"
            }
         },
         {
            propName   =   "_width"
            propVal   =   {
               val   =   330
               __type   =   "ui_widget_desc_prop_int"
            }
         },
         {
            propName   =   "_height"
            propVal   =   {
               val   =   680
               __type   =   "ui_widget_desc_prop_int"
            }
         }
      ]
      lir   =   {
         __type   =   "hf2p_join_friend_lib::friendLir"
      }
      scrollbar   =   {
         __type   =   "hf2p_map_grid_list_lib::mapGridListScrollBar"
      }
      __type   =   "ui_activity_lib::hf2pRosterListInt"
   }
}
__type   =   "ui_widget_lib"
