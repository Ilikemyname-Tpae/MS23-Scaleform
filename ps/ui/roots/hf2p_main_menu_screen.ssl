func GotoLobby(_lobbyState : string, _startPage : string = "Lobby")   
   $hf2pEngine.SetUIMusicId(2)  
   $uiPartyMonitor.SetLobbyMode(_lobbyState)
   Widgets().timer.EnterLobby()
   OpenSlidingScreenByName(_startPage)
end

func EnterFormation(mmQueueType : int)
   $hq.MatchmakingSetQueue(mmQueueType)
   $uiPartyMonitor.CreateParty()
   GotoLobby($uiPartyMonitor.STATE_FORMATION)   
end

func OpenLobbyMatchmaking()
   GotoLobby($uiPartyMonitor.STATE_MATCHMAKING)
end          

func OpenLobbySelectPlaylist()
   EnterFormation($uiEnums.MM_QUEUE_TYPE_RANKED)
end

func TestReward()
   var p : params
   // itemUnlock // lvlUp
   p.rewardType     := "itemUnlock"
   GenerateEvent("RewardRequest", p)  
end

func SetFakeBackground(_isVisible: bool, _state: string) 
   isFakeBackVisible    := _isVisible
   currentFakeBack      := _state
   if (isFakeBackVisible)
      Widgets().fakeBackground.GotoAndStop(currentFakeBack)
      var tintColor : params
      tintColor.r  := 255 
      tintColor.g  := 0 
      tintColor.b  := 0 
      tintColor.a  := 180
      tintColor.v  := 255
      Widgets().fakeBackground.colorMult := tintColor
   end
   Widgets().fakeBackground.visible := isFakeBackVisible
   Widgets().fakeBackground.alpha := 50
end

func OnChangeFakeBackground(p: params) : bool
   if (! IsVoid(p.state))
      SetFakeBackground(isFakeBackVisible, p.state)
   end
   return false
end

func EnableFakeBg()
   var p: params
   p.state := "mainMenu"
   GenerateEvent("ChangeFakeBackground", p)
end

func UpdateBackendSessionState(p : params) : bool
   var sessionState  : int = (int)$UiGlobals.backend_session.state.Get()
   var errCode       : int = (int)$UiGlobals.backend_session.error_code.Get()
   if (sessionState == $uiEnums.BACKEND_SESSION_OFFLINE and errCode != 0)
      OnSessionDisconnect(0, (int)$UiGlobals.backend_session.error_code.Get(), (int)$UiGlobals.backend_session.error_code_l10n.Get())
   end
   return true
end

func GotoMainMenuInitial()
   if (GetStateName() !=  "MainMenuInitial")
      RollbackChildStates()
      SetStateName("MainMenuInitial")   
   end
end


func OnChangeLobbyState(p : params) : bool      
   var lobbyStateIdx : int = (int)$UiGlobals.lobby.state.Get()
   if (lobbyStateIdx == $uiEnums.LOBBY_STATE_GAME_START_COUNTDOWN)
      OpenSlidingScreenByName("Lobby")
   end
   return true
end

func OnUpdatePartyState(p : params = null) : bool
   $root.UiLog("UpdatePartyState: " + $UiGlobals.party.GetStateStr() + ", leader = " + (string)$UserDataStorage.local_user.IsPartyLeader())
   //if (! $UserDataStorage.local_user.IsPartyLeader()) 
      var partyState : int = (int)$UiGlobals.party.state.Get()
      if (partyState == $uiEnums.PARTY_STATE_NONE)
         OnLeaveLobby()
         GotoMainMenuInitial()
      else
         $uiPartyMonitor.UpdateLobbyMode(partyState)
         if (slidingScreens.GetStateName() != "Visible" or slidingScreens.GetCurrentScreenName() != "Lobby")
            GotoLobby($UiGlobals.party.GetMMEnumFromState())
         end
      end
   //end
   return false
end

func OnSessionDisconnect(disconnectReason: int, errorCode: int, errorCode_l10n: int)
   var curState: string = GetStateName()
   if (curState != "Welcome" and curState != "WelcomeLoggedIn" and curState != "WelcomeRelogin")
      DisconnectErrorMsgBox(disconnectReason, errorCode, errorCode_l10n)
   end
end

func DisconnectErrorMsgBox(_disconnectReason: int, _errorCode: int, _errorCode_l10n: int) 
   Log("ui~welcomeScreen", "LoginErrorMsgBox")

   if ($root.IsAcceptingErrors())
      bLog("UI/MMENU", "Main_Menu_OnClientSessionDisconnect: disconnectReason = [" + (string)_disconnectReason + "], errorCode = [" + (string)_errorCode + "]")
      $root.StopAcceptingErrors()
      OnSessionDisconnectMb(null)
   end
end

func OnSessionDisconnectMb(p: params): bool
   var curState: string = GetStateName()
   //SetStateName("WelcomeRelogin")
   //
   if (curState == "WelcomeInitial")
      //SetStateName("Welcome")
      SetStateName("WelcomeRelogin")
   else
      $root.SetMainStartState("WelcomeRelogin")
      SetStateName("WelcomeInitial")
   end
   //
   return false
end

func HaloDisposeFromOldMap(p :  params) :  bool
   if (isLoggedIn)
      $hq.ShowroomEnd()
      $hq.isInShowroom := false
   end
   return false
end

