classes = {
	attachPoint = {
		__type = "ui_widget_container"

		impl {
			__type  = ui_widget_impl_gfx
			symbol  = "attachPoint" 
			lib     = prematch_lib 
		}
	}

	hf2p_TeamBoard = {
		__type = "ui_widget_container"

		impl {
			__type  = ui_widget_impl_gfx
			symbol  = "hf2p_TeamBoard" 
			lib     = prematch_lib 
		}

		elements {
			container {
				__type = "ui_widget_container"

				impl {
					__type  = ui_widget_impl_gfx
					propMapping {
						textDesc = {
							mapping = "textDesc.text"
						}
						textHeader = {
							mapping = "textHeader.text"
						}
					}
				}
				x         = 0
				y         = 0

				elements {
					gameModeAttach {
						__type = "ui_prematch_lib::attachPoint"
						x         = 18
						y         = 44
					} 
				}
				animated  = true
			} 
		}
	}

	hf2p_TeamNotification = {
		__type = "ui_widget_container"

		impl {
			__type  = ui_widget_impl_gfx
			symbol  = "hf2p_TeamNotification" 
			lib     = prematch_lib 
		}

		elements {
			bckg {
				__type = "ui_widget_container"

				impl {
					__type  = ui_widget_impl_gfx
					propMapping {
						textField = {
							mapping = "textField.text"
						}
					}
				}
				x         = -2
				y         = 0

				elements {
					bg {
						__type = "ui_widget_container"

						impl {
							__type  = ui_widget_impl_gfx
						}
						x         = 13
						y         = 0
					} 
				}
			} 
		}
	}

	hf2p_Timer = {
		__type = "ui_widget_container"

		impl {
			__type  = ui_widget_impl_gfx
			symbol  = "hf2p_Timer" 
			lib     = prematch_lib 
		}

		elements {
			textContainer {
				__type = "ui_widget_container"

				impl {
					__type  = ui_widget_impl_gfx
					propMapping {
						textField = {
							mapping = "textField.text"
						}
					}
				}
				x         = 0
				y         = 0
			} 
		}
	}
}
__type = "ui_widget_lib"
