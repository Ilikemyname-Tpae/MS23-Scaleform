                        elements   =   {
                           elem_1   =   {
                              state   =   "sAnimIn"
                              __type   =   "ui_widget_action_state"
                           }
                           elem_2   =   {
                              state   =   "sCounting"
                              __type   =   "ui_widget_action_state"
                           }
                        }
                        __type   =   "ui_widget_action_sequence"
                     }
                  }
               }
            }
            sAnimIn   =   {
               transitionsIn   =   {
                  any   =   {
                     action   =   {
                        anim   =   "this.animIn"
