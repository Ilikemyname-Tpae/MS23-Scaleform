      for i := 0 to items.Get().Count() - 1
         var item       : GL_String          = (GL_String)items.Get().Get(i)
         var itemComp   : GL_ComponentShop   = (GL_ComponentShop)$UiGlobals.componentsShop.Get(item.value.Get())
