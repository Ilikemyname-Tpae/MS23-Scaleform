class UiLoadoutSelectSmallBtn : UiWidgetButton

var   itemId: string
var   idx   : int
var   lbl   : string
var   isArmor : bool

func Init(_idx: int, _itemId: string, _lbl: string, _isArmor : bool)
   itemId   := _itemId
   idx      := _idx
   lbl      := _lbl
   isArmor  := _isArmor
   Update()
end

func Update()
   Props.txt1.textField     := (string)idx
   Props.txt2.textField     := lbl
end
end

class UiLoadoutSlot : UiWidgetButton
var blinkDelay : float = 0.0

//func onSlotClicked(p:params): bool
   //Log("ui~loadoutSlot", "onSlotClicked " + (string)(p.widget.btnIdx))
   //return false
//end
func StartBlink(_delay : float)
   blinkDelay := _delay
   StartDefaultBlinking(_delay)
end

func BlinkOverride(_phase : int, _dt : float) : bool
   var ret :  bool = false
   if (_dt > 4)
      return true
   end
   
   var t0 :  float = 0.0
   var t1 :  float = blinkDelay
   if (_phase == 0)
      Widgets.ingameBg.StartDefaultBlinking(t1 + 0.9)
      Widgets.txtFld.StartDefaultBlinking(t1 + 0.2)
      Widgets.btnBox.btn1.StartDefaultBlinking(t1 + 0.3)
      Widgets.btnBox.btn2.StartDefaultBlinking(t1 + 0.4)
      Widgets.btnBox.btn3.StartDefaultBlinking(t1 + 0.5)
      Widgets.btnBox.btn4.StartDefaultBlinking(t1 + 0.6)
      Widgets.btnBox.btn5.StartDefaultBlinking(t1 + 0.6)
      Widgets.btnBox.btn6.StartDefaultBlinking(t1 + 0.7)
      Widgets.btnBox.btn7.StartDefaultBlinking(t1 + 0.7)
      Widgets.btnBox.btn8.StartDefaultBlinking(t1 + 0.8)
      Widgets.btnBox.btn8.StartDefaultBlinking(t1 + 0.8)
      SetTfAlpha(-1, 0)
      SetTfAlpha(0, 0)
      SetTfAlpha(1, 0)
      SetTfAlpha(2, 0)
      SetTfAlpha(3, 0)
      SetTfAlpha(4, 0)
   elif (_phase == 1)
      SetTfAlpha(-1, _dt - 0.1 - t0)
      SetTfAlpha(0, _dt - 0.2 - t0)
      SetTfAlpha(1, _dt - 0.3 - t0)
      SetTfAlpha(2, _dt - 0.4 - t0)
      SetTfAlpha(3, _dt - 0.5 - t0)
      SetTfAlpha(4, _dt - 0.6 - t0)
   elif (_phase == 2)
   end      
   return ret
end   

func SetTfAlpha(_tf : int, _dt : float)
   //Widgets.btnBox.unitCard.tftPrimary.SetTfAlpha(
   var targetAlpha : float = 0.0
   if (_dt < 0)
      targetAlpha := 0.0
   elif (_dt < 1.0/24.0)
      targetAlpha := 0.0
   elif (_dt < 2.0/24.0)
      targetAlpha := 65
   elif (_dt < 3.0/24.0)
      targetAlpha := 30
   else
      targetAlpha := 100
   end
   if (_tf == 0)
      Widgets.btnBox.unitCard.txtPrimaryAlpha          := targetAlpha
   elif (_tf == 1)
      Widgets.btnBox.unitCard.txtSecondaryAlpha        := targetAlpha
   elif (_tf == 2)
      Widgets.btnBox.unitCard.txtGrenadesAlpha         := targetAlpha
   elif (_tf == 3)
      Widgets.btnBox.unitCard.txtTacticalPackagesAlpha := targetAlpha
   elif (_tf == 4)
      Widgets.btnBox.unitCard.txtBoostersAlpha         := targetAlpha
   elif (_tf == -1)
      Props.alpha                                      := targetAlpha
   end
end

 func onPerksButtonClicked(p:params): bool
    Log("ui~loadoutSlot", "onPerksButtonClicked " + (string)(p.widget.GetParentWidget().GetParentWidget().Props.idx) + ", " + (string)(p.widget.btnIdx - 4))
    if ((p.widget.btnIdx >= 4) and (p.widget.btnIdx <= 7))
       GenerateEvent("onPerksSlotClicked", p)
    end
    return false
 end
 
 func onLoadoutElementButtonClicked(p:params): bool
    if ((p.widget.btnIdx >= 1) and (p.widget.btnIdx <= 3))
       GenerateEvent("onLoadoutElementClicked", p)
    end
    return false
 end
 
 func onBoosterButtonClicked(p:params): bool
    Log("ui~loadoutSlot", "onBoosterButtonClicked " + (string)(p.widget.btnIdx)) 
    if (p.widget.btnIdx == 8)
       GenerateEvent("onBoosterSlotClicked", p)            
    end
    return false
 end
 
