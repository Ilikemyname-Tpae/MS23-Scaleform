class UiWcItemsList2 : UiWidgetList
   func OnItemClick(p:params):bool
      if (! IsVoid(p.index))
         if (p.index >= 0)
            SelectByIdx(p.index, false)
         end
      end
      return false
   end

   func SelectByIdx(idx:int, isTemp:bool=false)
      if (idx >= 0)
         var pp:params
         pp.idx      := idx
         GenerateEvent("#OnItemSlotSelect", pp)
      end
   end
         
   func OnItemRollOver(p:params):bool
      if (! IsVoid(p.index))
         if (p.index >= 0)
            SelectByIdx(p.index, true)
         end
      end         
      return false
   end
         
   func OnItemRollOut(p:params):bool
      GenerateEvent("#OnItemSlotMouseOut")
      return false
   end
end

