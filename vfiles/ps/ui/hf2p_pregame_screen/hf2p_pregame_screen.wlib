                     }
                     Loadout1   =   {
                        bindings   =   {
                           selected   =   {
                              binding   =   "{$UiIngame.character_index_desired == (#self:idx)}"
                           }
                        }
                        __type   =   "hf2p_Loadout_lib::loadoutSlot"
                     }
                     Loadout2   =   {
                        bindings   =   {
