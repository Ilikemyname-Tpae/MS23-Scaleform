   goldSlot   =   {
      sslClass   =   "UiGoldSlot"
      sslModule   =   "ui.libs.hf2p_GoldScreen_lib.hf2p_GoldScreen_lib"
      events   =   {
         buttonClick   =   {
            eventRemap   =   "AddGoldPoint"
         }
      }
      elements   =   {
         tfSaleRightAnim   =   {
            visible   =   False
            __type   =   "ui_widget_container"
         }
         saleShapeRight   =   {
            visible   =   False
            __type   =   "ui_widget_container"
         }
         bgBoostIcon   =   {
            bindings   =   {
               pic   =   {
                  binding   =   "{GetGoldIcon()}"
               }
            }
            __type   =   "ui_menu_lib::attachPoint"
         }
         tfRealMoney   =   {
            bindings   =   {
               tf   =   {
                  binding   =   "{GetPriceStr()}"
               }
            }
            __type   =   "ui_widget_container"
         }
         tfOldPriceOld   =   {
            visible   =   False
            __type   =   "ui_widget_container"
         }
         tfNewPriceNew   =   {
            visible   =   False
            __type   =   "ui_widget_container"
         }
         tfGold   =   {
            bindings   =   {
               tfGp   =   {
                  binding   =   "{GetGoldStr()}"
               }
            }
            __type   =   "ui_widget_container"
         }
      }
      bindings   =   {
         DC   =   {
            binding   =   "{new: 'ui.libs.hf2p_GoldScreen_lib.hf2p_GoldScreen_lib.BuyGoldVM', slotIdx = (:slotIdx)}"
         }
      }
      __type   =   "ui_menu_lib::hf2pSlotContainer"
   }
