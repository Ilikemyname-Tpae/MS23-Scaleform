                        isNoTranslate   =   True
                     }
                  }
                  bindings   =   {
                     visible   =   {
                        binding   =   "{!!gpDiscount}"
                     }
                     tfSaleRight   =   {
                        binding   =   "{gpDiscount}"
                     }
                  }
                  __type   =   "ui_widget_container"
               }
