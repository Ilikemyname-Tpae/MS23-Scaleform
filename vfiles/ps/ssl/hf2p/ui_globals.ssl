/***************************************************************
* GL_News
*
***************************************************************/   
class GL_News : UiSslBindableBase
   var id                        : ObservableProperty = null

   var is_read                   : ObservableProperty = null

   var author                    : ObservableProperty = null
   var date                      : ObservableProperty = null
   var text                      : ObservableProperty = null
   
   // ssl-only
   var formattedText             : ObservableProperty = $OM.Calculated(this, "GetFormattedText", true)
   
   
   func GetFormattedLine(headingId : string, txt : string, doTranslate : bool) : wstring
      var ret     : wstring      
      var tilda   : string = "~"
      var p       : params
      
      p.heading   := $UiGlobals.TranslateText(headingId)
      p.heading   := $root.MakeSpanWText(p.heading, "news_heading")
      p.heading   := p.heading + $UiGlobals.String2WString(" ")
      
      if (doTranslate)
         p.txt    := $UiGlobals.TranslateText(txt)
      else
         p.txt    := $UiGlobals.String2WString(txt)
      end
      p.txt       := p.txt + $UiGlobals.String2WString("\n")
      p.txt       := $root.MakeSpanWText(p.txt, "news_text")
      
      p.ret       := p.heading
      p.ret       := p.ret + p.txt
      
      return p.ret
   end
   
   func GetFormattedText() : wstring
      var ret     : wstring
      var p       : params

      p.line1     := GetFormattedLine("main_news_author",   (string)author.Get(),   true)
      p.line2     := GetFormattedLine("main_news_date",     (string)date.Get(),     false)
      p.line3     := GetFormattedLine("main_news_message",  (string)text.Get(),     true)
      
      p.ret       := p.line1
      p.ret       := p.ret + p.line2
      p.ret       := p.ret + p.line3
      
      return p.ret
   end
end

