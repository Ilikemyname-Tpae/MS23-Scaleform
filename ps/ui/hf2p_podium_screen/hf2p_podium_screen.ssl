   end   
end

class UiPodiumPlaceScreen : UiWidgetContainer


var current_stage    : int    = -1
var podium_players   : params
var debug_on         : bool   = false
var isSubscribed     : bool   = false

func ShowPoints(_place : int)
   if (_place == 0)
      Widgets().points.SetStateName("Winner")
   else
      Widgets().points.SetStateName("Initial")
   end   
end

func ShowLoadout(_place : int)
   if (_place == 0)
      Widgets().loadout.SetStateName("Winner")
   else
      Widgets().loadout.SetStateName("Initial")
   end
end

func FillSkillAndWeaponStats(playerUID : *, placeIdx : int)

   var ud               : UserData              = (UserData)$UserDataStorage.users.Get(playerUID)
   var scoreboardPlayer : GL_ScoreboardPlayer   = $UiGlobals.gameplay.scoreboard.FindPlayer(playerUID)
   var playerScore      : string                = ""
   
   if (scoreboardPlayer != null)
      Widgets().points.killsContainer.tfNum.text      := (string)(scoreboardPlayer.kills.Get())
      Widgets().points.assistsContainer.tfNum.text    := (string)(scoreboardPlayer.assists.Get())
      Widgets().points.headshotsContainer.tfNum.text  := (string)(scoreboardPlayer.deaths.Get())
      Widgets().points.meleeContainer.tfNum.text      := (string)(scoreboardPlayer.wp.Get())
      
      playerScore := (string)(scoreboardPlayer.wp.Get())
   else
      Widgets().points.killsContainer.tfNum.text      := " ???"
      Widgets().points.assistsContainer.tfNum.text    := " ???"
      Widgets().points.headshotsContainer.tfNum.text  := " ???"
      Widgets().points.meleeContainer.tfNum.text      := " ???"
      
      playerScore := " ???"
   end
   ShowPoints(placeIdx) : 0.25
   
   /*
   if (stage == "Third")
      inner_p := podium_players.Name3rd
   else if (stage == "Second")
      inner_p := podium_players.Name2nd
   else if (stage == "First")
      inner_p := podium_players.Name1st
   end
   
   Widgets().points.killsContainer.tfNum.text     := (string)(inner_p.kills)
   Widgets().points.assistsContainer.tfNum.text   := (string)(inner_p.assists)
   Widgets().points.headshotsContainer.tfNum.text := (string)(inner_p.deaths)
   Widgets().points.meleeContainer.tfNum.text     := (string)(inner_p.melee)
   Widgets().loadout.topLeftPanel.tfNIckName.text := inner_p.name
   */
   
   //Widgets().loadout.topLeftPanel.tfNIckName.text := inner_p.name
      
   var playerName    : wstring = ud.base.full_nickname.Get()   
   if (placeIdx == 0)
      $root.playSound("podium_1st_highlight")
      Widgets().podium.firstPlaceAnimContainer.nicknameTfContainer.tf.text    := playerName
      Widgets().podium.firstPlaceAnimContainer.scoreContainer.tf.text         := playerScore
   elif (placeIdx == 1)
      $root.playSound("podium_2nd_highlight")
      Widgets().podium.secondPlaceAnimContainer.nicknameTfContainer.tf.text   := playerName
      Widgets().podium.secondPlaceAnimContainer.scoreContainer.tf.text        := playerScore
   elif (placeIdx == 2)
      $root.playSound("podium_3rd_highlight")
      Widgets().podium.thirdPlaceAnimContainer.nicknameTfContainer.tf.text    := playerName
      Widgets().podium.thirdPlaceAnimContainer.scoreContainer.tf.text         := playerScore
   end

   var p : params
   p.uid := playerUID
   GenerateEvent("#SetPodiumLoadoutUID", p)
   Widgets().loadout.topLeftPanel.nicknameTf.tfNIckName := playerName
   ShowLoadout(placeIdx) : 0.25
end

handle OnTerm
   if (isSubscribed)
      $UiGlobals.gameplay.podium.state.Unsubscribe(this, "PodiumUpdate")
      $UiGlobals.gameplay.podium.participants_version.Unsubscribe(this, "PodiumUpdate")            
      isSubscribed := false
   end
end

handle OnEnteringState("Initial")
   bLog("UI/PODIUM", "Initial")
   if (isSubscribed)
      $UiGlobals.gameplay.podium.state.Unsubscribe(this, "PodiumUpdate")
      $UiGlobals.gameplay.podium.participants_version.Unsubscribe(this, "PodiumUpdate")            
      isSubscribed := false
   end
end

handle OnEnterState("Initial")
   Props().visible := false
end

handle OnEnteringState("Visible")
   bLog("UI/PODIUM", "Visible")
   Widgets().points.visible   := false
   Widgets().loadout.visible  := false
   Props().visible := true
   if (! isSubscribed)
      isSubscribed := true         
      if ($UiGlobals.gameplay.podium.participants.Get().Count() > 0)
         PodiumUpdate(null)
      end
      $UiGlobals.gameplay.podium.state.Subscribe(this, "PodiumUpdate")
      $UiGlobals.gameplay.podium.participants_version.Subscribe(this, "PodiumUpdate")
   end
   SetFocus()
end

func StartPodiumAnim(_idx : int)
   if (_idx == 0)
      Widgets().podium.firstPlaceAnimContainer.SetStateName("Visible")
   elif (_idx == 1)
      Widgets().podium.secondPlaceAnimContainer.SetStateName("Visible")
   elif (_idx == 2)      
      Widgets().podium.thirdPlaceAnimContainer.SetStateName("Visible")
   end
end

func PodiumUpdate(_val : *)
   var podiumState : int = (int)$UiGlobals.gameplay.podium.state.Get()
   if (podiumState == $uiEnums.PODIUM_STATE_SHOW_OFF)
      var top3 : vector = $UiGlobals.gameplay.podium.participants.Get()
      var idx  : int    = top3.Count() - 1
      if (idx >= 0)
         var uid  : *   = top3.Get(idx).id.Get()
         var place: int = top3.Get(idx).place.Get()
         if (place >= 0 and place < 3)
            FillSkillAndWeaponStats(uid, place)
            StartPodiumAnim(place)            
         end
      end
   elif (podiumState == $uiEnums.PODIUM_STATE_SCOREBOARD)
      GenerateEvent("OnPodiumPlayEnded")
   end
end

