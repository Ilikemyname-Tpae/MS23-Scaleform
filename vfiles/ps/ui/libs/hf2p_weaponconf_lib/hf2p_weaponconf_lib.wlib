   tooltipWidget   =   {
      elements   =   {
         content   =   {
            elements   =   {
               iconAttach   =   {
                  elements   =   {
                     placeHolder   =   {
                        visible   =   False
                        __type   =   "ui_weaponConf_lib::placeHolderContent"
                     }
                  }
                  bindings   =   {
                     pic2   =   {
                        binding   =   "{$uiEconomy.GetItemType(itemId) == $uiEnums.ITEM_TYPE_ARMOR ? $UiGlobals.componentsUI[itemId].icon : ''}"
                     }
                     pic   =   {
                        binding   =   "{$UiGlobals.componentsUI[itemId].icon_med}"
                     }
                  }
                  isCentered   =   True
                  __type   =   "ui_weaponConf_lib::attachPoint"
               }
               weaponRenderAttach   =   {
                  elements   =   {
                     rtts_weapons   =   {
                        __type   =   "ui_rtts_container::rtts_weapons"
                     }
                  }
                  __type   =   "ui_widget_container"
               }
               perkRenderAttach   =   {
                  elements   =   {
                     ConsumableRenderContainer   =   {
                        elements   =   {
                           consumableRenderContent   =   {
                              elements   =   {
                                 rtts_consumable   =   {
                                    __type   =   "ui_rtts_container::rtts_consumable"
                                 }
                              }
                              __type   =   "ui_icon_lib_cons::ConsumableRendterTexture"
                           }
                        }
                        __type   =   "ui_icon_lib_cons::ConsumableRenderContainer"
                     }
                  }
                  __type   =   "ui_widget_container"
               }
               desc   =   {
                  bindings   =   {
                     textField   =   {
                        binding   =   "{$UiGlobals.componentsUI[itemId].desc}"
                     }
                  }
                  __type   =   "ui_widget_container"
               }
               header   =   {
                  bindings   =   {
                     textField   =   {
                        binding   =   "{$UiGlobals.componentsUI[itemId].name}"
                     }
                  }
                  __type   =   "ui_widget_container"
               }
            }
            bindings   =   {
               anim2   =   {
                  binding   =   "{$uiEconomy.GetItemType(itemId) == $uiEnums.ITEM_TYPE_ARMOR ? 'icon' : $uiEconomy.GetItemType(itemId) == $uiEnums.ITEM_TYPE_TACTICAL ? 'video' : 'render'}"
               }
               anim   =   {
                  binding   =   "{$UiGlobals.componentsUI[itemId].video != 'unknown' ? 'video' : $UiGlobals.componentsUI[itemId].icon_big ? 'icon' : 'render'}"
               }
            }
            __type   =   "ui_weaponConf_lib::bundleItemTooltipContent"
         }
      }
      bindings   =   {
         renderHelper   =   {
            binding   =   "{new: 'ui.hf2p_SlidingScreens.hf2p_Bundles.hf2p_Bundles.BundleItemRenderHelper', itemId = itemId}"
         }
      }
      __type   =   "ui_weaponConf_lib::bundleItemTooltip"
   }
