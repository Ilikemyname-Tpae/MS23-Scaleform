      bindings   =   {
         expiringState   =   {
            binding   =   "{if: $UiGlobals.componentsInventory[(#self:itemId)].ownership_type == $uiEnums.ITEM_OWN_TYPE_RENTED and $UiGlobals.componentsInventory[(#self:itemId)].ownership_time < $uiEnums.ITEM_RENT_ALERT_SECONDS + $UiGlobals.timer, then = 'expiring', else = 'normal'}"
         }
      }
      __type   =   "ui_weaponConf_lib::hf2pLoadoutBtnMed"
   }
   loadoutElementPerk   =   {
      elements   =   {
         attachCont   =   {
            elements   =   {
               imageAttach   =   {
                  bindings   =   {
                     pic   =   {
                        binding   =   "{$UiGlobals.componentsUI[(#self:itemId)].icon}"
                     }
                  }
                  isCentered   =   True
