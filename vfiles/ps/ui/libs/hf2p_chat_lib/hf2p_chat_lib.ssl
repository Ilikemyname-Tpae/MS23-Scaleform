   func GetMembers() : vector
      var ret  : vector      
      if (! isMembersUpdating)
         isMembersInvalidated   := false
         isMembersUpdating      := true
         
         if (IsMembersVisible())
            var stream : GL_ChatStream = GetChatStream()
            if stream == $UiGlobals.chat.ui_channel_private
               ret := $UiGlobals.chat.GetPrivateMembers()
            elif stream == $UiGlobals.chat.ui_channel_general
               ret := new vector
            elif stream == $UiGlobals.chat.ui_channel_party
               ret := $UiGlobals.party.members.Get()
            elif stream == $UiGlobals.chat.ui_channel_game_all
               var lobbyState : int = (int)$UiGlobals.lobby.state.Get()
               //if (lobbyState != $uiEnums.LOBBY_STATE_NONE and lobbyState != $uiEnums.LOBBY_STATE_JOINING_SESSION)
               //   ret := $UiGlobals.lobby.players.Get()
               //else
                  ret := $UiGlobals.matchmaking.group.Get()
               //end
            else
               if (stream != null)
                  ret := stream.GetMembers()
               end
            end
         end      
         
         isMembersUpdating := false
         if (isMembersInvalidated)
            membersObservable.Invalidate()
         end
      else
         isMembersInvalidated := true
      end
      return ret      
   end
   
   func GetMessages() : vector
      var ret  : vector
      if (IsMessagesVisible())
         var channelIdx : int = GetSelectedChannel()
         var isPinnedPrivateTab : bool = !$UserDataStorage.IsEqualUIDs(tabs.GetSelectedTabData().Get().privateUid, $UserDataStorage.GetInvalidUID())
         var members : vector = membersObservable.Get()
         var selectedMember : GL_UID = null
         var selectedMemberIdx : int = (int)this.selectedMemberIdx.Get()
         if selectedMemberIdx >= 0 and selectedMemberIdx < members.Count()
            selectedMember := members.Get(selectedMemberIdx)
         end
         if channelIdx == $uiEnums.CHAT_CHANNEL_PRIVATE and !isPinnedPrivateTab
            if (selectedMember != null)
               ret := $UiGlobals.GetChatMessages(channelIdx, selectedMember.value.Get())
            end
         else
            ret := $UiGlobals.GetChatMessages(channelIdx, tabs.GetSelectedTabData().Get().privateUid)
         end
      end
      return ret
   end
   
   func UpdateStreamTimestamp()
      var stream : GL_ChatStream = GetChatStream()
      if stream == $UiGlobals.chat.ui_channel_private
         if (int)selectedMemberIdx.Get() >= 0 and (int)selectedMemberIdx.Get() < $UiGlobals.chat.GetPrivateMembers().Count()
            stream := $UiGlobals.chat.GetPrivateChannel($UiGlobals.chat.GetPrivateMembers().Get((int)selectedMemberIdx.Get()).value.Get())
         end
      end
      if (stream != null)
         stream.UpdateLastViewTime()
      end
   end
   
   
