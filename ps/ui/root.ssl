      p.str := _str
      $sslWidgetMgr.GenerateEvent("AddDebugPanelString", p)
   end
end

func DefMessageBox(_mbType : string, _header : string, _message : string, _event : string = "", _callbackTarget : * = null)
   var pp : params
   pp.titleTxt          := _header
   pp.messageTxt        := _message
   if (_event != "")
      pp.callbackEvent  := _event
   end
   if (_callbackTarget != null)
      pp.callbacktarget := _callbackTarget
   end
   pp.mbType            := _mbType
   $sslWidgetMgr.GenerateEvent("MainMenuDialogRequest", pp)
end

func sqrt(_val : float) : float
   var ret : float = _val / 2
   if (ret != 0)
      ret := 0.5 * (_val / ret + ret)
   end
   if (ret != 0)
      ret := 0.5 * (_val / ret + ret)
   end
   if (ret != 0)
      ret := 0.5 * (_val / ret + ret)
   end
   if (ret != 0)
      ret := 0.5 * (_val / ret + ret)
   end
   return ret
end

func FormatFloat(val : float, decimals : int) : string
   var ret : string
   ret := (string)(int)val
   var dec : vector
   var i : int
   var x : float = val
   for i := 0 to decimals - 1
      x := x * 10
      dec.Push(((int)x) % 10)
   end
   var zero : int = 0
   for i := decimals - 1 downto 0
      if dec.Get(i) != 0
         break
      end
      zero := zero + 1
   end
   if zero != decimals
      ret := ret + "."
      for i := 0 to decimals - zero - 1
         ret := ret + (string)dec.Get(i)
      end
   end
   return ret
end

func FormatArmorModifTempHack(_modifId : string, _val : float) : wstring
   var ret  : wstring
   var sign : string = "+"
   var val  : float  = _val
   var modifComp = (GL_ComponentGameplayModifier)$UiGlobals.componentsGameplayModifier.Get(_modifId) 
   var unit : string =(string)modifComp.units_id.Get()
   //var modifUiComp = (GL_ComponentUI)$UiGlobals.componentsUI.Get(unit)
   if val < 0
      sign := "-"
      val := -val
   end
   if (unit == "mod_unit_percent") 
      ret := $UiGlobals.TranslateText(unit + "," + sign + (string)(int)(val * 100 + 0.01))
   elif (unit == "mod_unit_meters")
      ret := $UiGlobals.TranslateText(unit + "," + sign + FormatFloat(val + 0.001, 2))
   elif (unit == "mod_unit_bool")
      ret := $UiGlobals.TranslateText(unit + "," + " ")
   elif (unit == "mod_unit_seconds")
      ret := $UiGlobals.TranslateText(unit + "," + sign + FormatFloat(val + 0.001, 2))
   elif (unit == "mod_unit_abs")
      ret := $UiGlobals.TranslateText(unit + "," + sign + (string)(int)(val + 0.01))
   elif (unit == "mod_unit_chance")
      ret := $UiGlobals.TranslateText(unit + "," + sign + (string)(int)(val * 100 + 0.01))
   end
   return ret
end

func MakeStringUntranslatable(str : *) : *
   var p : params
   p.str    := str
   p.tilde  := $UiGlobals.String2WString("~")
   p.ret    := p.str
   p.ret    := p.ret + p.tilde
   return p.ret
end

