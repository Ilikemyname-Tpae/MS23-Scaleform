func acceptLoadout(p: params): bool
   Log("ui~loadoutSelect", "acceptLoadout")
   $user_service.SetCharacterActive(p.widget.idx)
   $UiBiLogger.LogWeaponLoadoutEvent("Select", p.widget.idx, "" , 0)
   if (GetStateName() == "SelectLoadoutPregame")    
      GenerateEvent("onPregameLoadoutAccepted")
      //SetStateName("Initial")  
   else 
      if (GetStateName() == "SelectLoadout")
         SetStateName("ChoiceLoadoutBtn")
      end
   end

   return false
end

func CloseLoadoutSelection()
   Log("ui~loadoutSelect", "onCloseLoadoutSelection - send")
