                  bindings   =   {
                     text   =   {
                        binding   =   "{$UiGlobals.componentsUI[map_id].name}"
                     }
                  }
                  layer   =   "upLayer"
                  customProps   =   [
                     {
                        propName   =   "text"
                        propVal   =   {
                           __type   =   "ui_widget_desc_prop_string"
                        }
                     }
                  ]
                  __type   =   "ui_widget_container"
               }
               votesLabelTxt   =   {
                  bindings   =   {
                     text   =   {
                        binding   =   "{votes_count_txt}"
                     }
                  }
                  layer   =   "upLayer"
                  __type   =   "ui_widget_container"
               }
               votesTxt   =   {
                  bindings   =   {
                     text   =   {
                        binding   =   "{''}"
                     }
                  }
                  layer   =   "upLayer"
                  customProps   =   [
                     {
                        propName   =   "text"
                        propVal   =   {
                           __type   =   "ui_widget_desc_prop_string"
                        }
                     }
                  ]
                  __type   =   "ui_widget_container"
               }
            }
            bindings   =   {
               modeNameTxt   =   {
                  binding   =   "{$UiGlobals.componentsUI[game_mode_id].name}"
               }
            }
            layers   =   {
               downLayer   =   {
                  offset   =   -1
               }
               upLayer   =   {
                  offset   =   1
               }
            }
            __type   =   "ui_widget_container"
         }
         textField   =   {
            isNoTranslate   =   True
            customProps   =   [
               {
                  propName   =   "text"
                  propVal   =   {
                     __type   =   "ui_widget_desc_prop_string"
                  }
               }
            ]
            __type   =   "ui_widget_container"
         }
      }
      bindings   =   {
         DC   =   {
            binding   =   "{$UiGlobals.lobby.vote_set_op[(#self:voteIdx2)]}"
         }
         visible   =   {
            binding   =   "{$UiGlobals.lobby.vote_set_length > (#self:voteIdx2)}"
         }
         selected   =   {
            binding   =   "{$UiGlobals.lobby.vote_selection_index == (#self:voteIdx)}"
         }
      }
      soundMap   =   {
         soundMaps   =   {
            this   =   {
               mapping   =   {
                  mouseOver   =   {
                     uiSoundEvent   =   "item_highlight"
                  }
                  CLIK_focusIn   =   {
                     uiSoundEvent   =   "item_highlight"
                  }
                  buttonClick   =   {
                     uiSoundEvent   =   "tab_select"
                  }
               }
            }
         }
      }
      __type   =   "ui_lobby_lib::lobby_mapBtn"
   }
