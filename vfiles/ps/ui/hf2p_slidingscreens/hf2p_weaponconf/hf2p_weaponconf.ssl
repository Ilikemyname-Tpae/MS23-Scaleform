class WpBg : UiWidgetContainer

override StartDrag   
   var pp: params
   pp.dragEvent   := "WeaponScreenDrag"
   pp.dragTarget  :=  this
   GenerateEvent("#StartWeaponUniversalDrag", pp)
   return null
end

func OnWeaponScreenDrag(p: params): bool
   if p.updateType == "start"
      $hf2pEngine.OnWeaponScreenDragStart($uiEnums.UI_RTTS_WEAPONS_SHOP)
   else if p.updateType == "update"
      $hf2pEngine.OnWeaponScreenDragUpdate($uiEnums.UI_RTTS_WEAPONS_SHOP, p.mouseOffset.x, p.mouseOffset.y)
   else if p.updateType == "end"
      $hf2pEngine.OnWeaponScreenDragUpdate($uiEnums.UI_RTTS_WEAPONS_SHOP, p.mouseOffset.x, p.mouseOffset.y)
      $hf2pEngine.OnWeaponScreenDragEnd($uiEnums.UI_RTTS_WEAPONS_SHOP)
   end
   return false
end

func OnMouseDown(p: params): bool
   StartDragManual()   
   return false
end

end
