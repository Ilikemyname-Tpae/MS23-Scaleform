classes   =   {
   IngameChat   =   {
      sslClass   =   "UiIngameChat"
      sslModule   =   "ui.libs.hf2p_Chat_lib.hf2p_IngameChat_lib"
      visible   =   False
      fixed   =   False
      elements   =   {
         ingameChatCont   =   {
            elements   =   {
               inputCont   =   {
                  elements   =   {
                     inputTf   =   {
                        sslClass   =   "UiIngameChatMessage"
                        sslModule   =   "ui.libs.hf2p_Chat_lib.hf2p_IngameChat_lib"
                        isNoTranslate   =   True
                        elements   =   {
                           raw_textField   =   {
                              sslClass   =   "UiIngameChatInputField"
                              sslModule   =   "ui.libs.hf2p_Chat_lib.hf2p_IngameChat_lib"
                              __type   =   "ui_widget_text"
                           }
                        }
                        bindings   =   {
                           editable   =   {
                              binding   =   "{true}"
                           }
                           defaultText   =   {
                              binding   =   "{GetInputDefaultText()}"
                           }
                           enabled   =   {
                              binding   =   "{true}"
                           }
                           focusable   =   {
                              binding   =   "{true}"
                           }
                           actAsButton   =   {
                              binding   =   "{true}"
                           }
                           maxChars   =   {
                              binding   =   "{250}"
                           }
                        }
                        __type   =   "ui_chat_lib::ChatTextInputSkinned"
                     }
                  }
                  bindings   =   {
                     visible   =   {
                        binding   =   "{isInteractive}"
                     }
                  }
                  __type   =   "ui_chat_lib::IngameChatInputCont"
               }
               tfTarget   =   {
                  elements   =   {
                     textField   =   {
                        bindings   =   {
                           styleSheet   =   {
                              binding   =   "{GetStyleSheet()}"
                           }
                           text   =   {
                              binding   =   "{GetChatTarget()}"
                           }
                        }
                        __type   =   "ui_widget_text"
                     }
                  }
                  bindings   =   {
                     visible   =   {
                        binding   =   "{isInteractive}"
                     }
                  }
                  __type   =   "ui_chat_lib::IngameChatTargetTf"
               }
            }
            bindings   =   {
               items   =   {
                  binding   =   "{messagesMapObservable}"
               }
            }
            defContainer   =   "messagesCont"
            defTemplate   =   "hf2p_IngameChat_lib::IngameChatMessageCont"
            __type   =   "ui_chat_lib::IngameChatCont"
         }
      }
      stateMap   =   {
         startState   =   "Hidden"
         states   =   {
            Hidden   =   {
            }
            Visible   =   {
            }
            Active   =   {
            }
         }
      }
      bindings   =   {
         DC   =   {
            binding   =   "{new: 'ui.libs.hf2p_Chat_lib.hf2p_IngameChat_lib.UiIngameChatVM'}"
         }
      }
      __type   =   "ui_chat_lib::IngameChatRotated"
   }
   IngameChatMessageCont   =   {
      sslClass   =   "UiIngameChatMessageCont"
      sslModule   =   "ui.libs.hf2p_Chat_lib.hf2p_IngameChat_lib"
      elements   =   {
         messageCont   =   {
            propMapping   =   {
               textFieldHeight   =   {
                  mapping   =   "textField.textHeightEx"
               }
               textFieldHtml   =   {
                  mapping   =   "textField.htmlText"
                  isNoTranslate   =   True
               }
            }
            elements   =   {
               textField   =   {
                  bindings   =   {
                     styleSheet   =   {
                        binding   =   "{GetStyleSheet()}"
                     }
                  }
                  __type   =   "ui_widget_text"
               }
            }
            bindings   =   {
               textFieldHtml   =   {
                  binding   =   "{mesObservable}"
               }
            }
            __type   =   "ui_chat_lib::IngameChatMessage"
         }
      }
      stateMap   =   {
         states   =   {
            Initial   =   {
            }
            Visible   =   {
            }
            Hidden   =   {
            }
            ForceVisible   =   {
            }
         }
      }
      __type   =   "ui_chat_lib::IngameChatMessageCont"
   }
}
__type   =   "ui_widget_lib"
