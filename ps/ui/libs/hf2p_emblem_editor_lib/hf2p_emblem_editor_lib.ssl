   var p1 : params
   var a : int = 255     

   if ((not IsVoid(p.r)) and (not IsVoid(p.g)) and (not IsVoid(p.b)))  
      p1.r := p.r
      p1.g := p.g
      p1.b := p.b
      p1.a := a
   end

   Props().paliteItem.colorPlate.color := p1
end
end

