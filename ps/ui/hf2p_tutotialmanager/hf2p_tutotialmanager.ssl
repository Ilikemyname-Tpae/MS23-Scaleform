func GetRootWidget(): *
   return rootWidget.Props()
end


func GenericMessageBoxYesNo(_title: string, _text:string, _okFunc:string = "", _cancelFunc: string = "")
   var pp                     :  params
   var callbackParams         :  params
   
   pp.callbackEvent           := "MessageBoxHandler"
   pp.callbackTarget          := Props()
   pp.mbType                  := $uiEnums.MB_TYPE_NO_YES
   pp.titleTxt                := "msg_ui_" + _title
   pp.messageTxt              := "msg_ui_" + _text

   callbackParams.mbType      := pp.mbType
   callbackParams.okFunc      := _okFunc
   callbackParams.cancelFunc  := _cancelFunc
   pp.callbackParams          := callbackParams
   
   GenerateEvent("MainMenuDialogRequest", pp)   
end

func GenericMessageBoxInfo(_title: string, _text:string, _endFunc:string = "")
   var pp                  :  params
   var callbackParams      :  params
   
   pp.callbackEvent        := "MessageBoxHandler"
   pp.callbackTarget       := Props()
   pp.mbType               := "Info"
   pp.titleTxt             := "msg_ui_" + _title
   pp.messageTxt           := "msg_ui_" + _text

   callbackParams.mbType   := pp.mbType
   callbackParams.endFunc  := _endFunc
   pp.callbackParams       := callbackParams
   
   GenerateEvent("MainMenuDialogRequest", pp)   
end


func MessageBoxHandler(p:params) : bool
   var callingParams : params = p.callbackParams
   var targetFunc    : string = ""
   
   
   if (callingParams.mbType == $uiEnums.MB_TYPE_NO_YES)
      var okFunc     : string = callingParams.okFunc
      var cancelFunc : string = callingParams.cancelFunc
      if (p.isOK)
         targetFunc  := okFunc
      else
         targetFunc  := cancelFunc
      end
   else if (callingParams.mbType == "Info")
      var endFunc    : string = callingParams.endFunc
      targetFunc     := endFunc
   end
   
   //GenericMessageBoxInfo("TUTUTUT", "Func = " + targetFunc, "")
   
   if (targetFunc != "")
      var pp:params
      GenerateEvent(targetFunc, pp)            
   end
   return false
end


func MessageBoxYesNo(_title: string, _text:string, _okFunc:string = "", _cancelFunc: string = "")
   var pp                     :  params
   var callbackParams         :  params
   
   pp.callbackEvent           := "MessageBoxHandler"
   pp.callbackTarget          := Props()
   pp.mbType                  := $uiEnums.MB_TYPE_NO_YES
   pp.titleTxt                := _title
   pp.messageTxt              := _text

   callbackParams.mbType      := pp.mbType
   callbackParams.okFunc      := _okFunc
   callbackParams.cancelFunc  := _cancelFunc
   pp.callbackParams          := callbackParams
   
   GenerateEvent("TutorialDialogRequest", pp)   
end

func MessageBoxInfo(_title: string, _text:string, _endFunc:string = "")
   var pp                  :  params
   var callbackParams      :  params
   
   pp.callbackEvent        := "MessageBoxHandler"
   pp.callbackTarget       := Props()
   pp.mbType               := "Info"
   pp.titleTxt             := _title
   pp.messageTxt           := _text

   callbackParams.mbType   := pp.mbType
   callbackParams.endFunc  := _endFunc
   pp.callbackParams       := callbackParams
   
   GenerateEvent("TutorialDialogRequest", pp)   
end


