   LoadoutSelectorButton   =   {
      isBlinkable   =   True
      propMapping   =   {
         textField   =   {
            mapping   =   "tfCont.textField.text"
            isNoTranslate   =   True
         }
      }
      events   =   {
         buttonClick   =   {
            eventRemap   =   "#LoadoutSelectButtonClicked"
         }
      }
      bindings   =   {
         textField   =   {
            binding   =   "{'' + ((#self:idx) + 1)}"
         }
         selected   =   {
            binding   =   "{$UserDataStorage.local_user.currentArmorLoadoutIdx == (#self:idx)}"
         }
         enabled   =   {
            binding   =   "{(:idx) < $UserDataStorage.local_user.weapon_loadouts_unlocked}"
         }
      }
      __type   =   "ui_weaponConf_lib_slide::pageNumberMark"
   }
