         assignBtn   =   {
            x   =   1170
            y   =   729
            isBlinkable   =   True
            events   =   {
               buttonClick   =   {
                  eventRemap   =   "#AssignInventoryItem"
               }
            }
            elements   =   {
               btnHighlight   =   {
                  bindings   =   {
                     frame   =   {
                        binding   =   "{'green'}"
                     }
                  }
                  __type   =   "ui_widget_container"
               }
               btnBg   =   {
                  bindings   =   {
                     frame   =   {
                        binding   =   "{'green'}"
                     }
                  }
                  __type   =   "ui_widget_container"
               }
            }
            bindings   =   {
               enabled   =   {
                  binding   =   "{EnableAssignBtn()}"
               }
               visible   =   {
                  binding   =   "{true}"
               }
               label   =   {
                  binding   =   "{'carousel_ui_btn_assign'}"
               }
            }
            soundMap   =   {
               soundMaps   =   {
                  this   =   {
                     mapping   =   {
                        buttonClick   =   {
                           uiSoundEvent   =   "item_confirm"
                        }
                     }
                  }
               }
            }
            label   =   "carousel_ui_btn_assign"
            __type   =   "hf2p_WeaponConf_lib::wc_RightBtn_s"
         }
      }
      stateMap   =   {
         startState   =   "Hidden"
         states   =   {
            Visible   =   {
            }
            Hidden   =   {
            }
         }
      }
      bindings   =   {
         DC   =   {
            binding   =   "{new: 'ui.hf2p_SlidingScreens.hf2p_Inventory.hf2p_Inventory.InventoryScreenVM'}"
         }
      }
