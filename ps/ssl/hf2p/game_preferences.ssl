   native func GetPostprocessQuality            () : int
   native func SetPostprocessQuality            (value : int)
   native func GetMotionBlur                    () : bool
   native func SetMotionBlur                    (on : bool)

   //video settings obsolete
   native func GetLightVolumes                  () : bool
   native func SetLightVolumes                  (on : bool)
	native func GetReflections                   () : bool
	native func SetReflections                   (on : bool)
	native func GetDecorator                     () : bool
	native func SetDecorator                     (on : bool)
	native func GetParticleDetail                () : int
	native func SetParticleDetail                (value : int)
	native func GetContrast                      () : int
	native func SetContrast                      (value : int)
	native func GetSSAO                          () : bool
	native func SetSSAO                          (on : bool)

	// audio settings
	native func GetMasterVolume () : int
	native func SetMasterVolume (value : int, save : bool)
	native func GetSFXVolume () : int
	native func SetSFXVolume (value : int, save : bool)
	native func GetMusicVolume () : int
	native func SetMusicVolume (value : int, save : bool)
	native func GetVoiceVolume () : int
	native func SetVoiceVolume (value : int, save : bool)
	native func GetVoiceChatControl () : int
	native func SetVoiceChatControl (value : int)
	native func GetVoiceChatVolume () : int
	native func SetVoiceChatVolume (value : int, save : bool)

	// controls settings
	native func GetControlsMethod () : int
	native func SetControlsMethod (value : int)
	native func GetMouseSensitivityVert () : int
	native func GetMouseSensitivityHor () : int
	native func SetMouseSensitivityVert (value : int)
	native func SetMouseSensitivityHor (value : int)
	native func GetMouseSensitivityVehicleVert () : int
	native func GetMouseSensitivityVehicleHor () : int
	native func SetMouseSensitivityVehicleVert (value : int)
	native func SetMouseSensitivityVehicleHor (value : int)
	native func GetMouseAcceleration () : int
	native func SetMouseAcceleration (value : int)
	native func GetMouseFilter () : bool
	native func SetMouseFilter (on : bool)
	native func GetInvertMouse () : bool
	native func SetInvertMouse (on : bool)

	// controller settings
	native func GetLookSensitivity () : int
	native func SetLookSensitivity (value : int)
	native func GetInvertLook () : bool
	native func SetInvertLook (on : bool)
	native func GetAutoCentering () : bool
	native func SetAutoCentering (on : bool)
	native func GetButtonLayout () : int
	native func SetButtonLayout (value : int)

	// rebind keys
	native func GetKeyLabels () : vector
	native func GetActionLabels (biped : bool) : vector
	native func GetDefaultKeyBinds (biped : bool) : vector
	native func GetKeyBinds (biped : bool) : vector
	native func SetKeyBinds (binds : vector, biped : bool)
   
   // ssl-only funcs      
   var savedVideo                         : params
   var userAdvancedVideoSettings          : params
   var settingsInitialized                : bool = false
   
   // error Codes
   var VIDEO_CHECK_ERROR_NONE             : int  = 0
   var VIDEO_CHECK_ERROR_UNSIFFICIENT_MEM : int  = 1
   
   func GetSavedAdvancedVideoParams() : params
      if (!settingsInitialized)
         savedVideo := GetCurrentVideoSettings()
      end
      return savedVideo
   end
   
   func GetCurrentVideoSettings() : params
      var ret : params
      
      ret.textureResolution         := $hf2pPreferences.GetTextureResolution()
      ret.textureFilteringQuality   := $hf2pPreferences.GetTextureFilteringQuality()
      ret.lightingQuality           := $hf2pPreferences.GetLightingQuality()
      ret.effectsQuality            := $hf2pPreferences.GetEffectsQuality()
      ret.shadowQuality             := $hf2pPreferences.GetShadowQuality()
      ret.detailsQuality            := $hf2pPreferences.GetDetailsQuality()
      ret.postprocessQuality        := $hf2pPreferences.GetPostprocessQuality()
      ret.motionBlur                := $hf2pPreferences.GetMotionBlur()
      
      return ret
   end
   
   func SetUserAdvancedVideoSettings(p : params)
      userAdvancedVideoSettings := p
   end   
   
   func GetUserAdvancedVideoSettings() : params
      return userAdvancedVideoSettings
   end   
   
   func SetUserQualityPreset(preset : int)
      userAdvancedVideoSettings := GetAdvancedVideoPresetParams(preset)
   end
      
   func GetUserQualityPreset() : int
      return GetQualityPreset(userAdvancedVideoSettings)
   end
   
   func ApplyAdvancedSettings(p : params)
      $hf2pPreferences.SetTextureResolution(p.textureResolution)
      $hf2pPreferences.SetTextureFilteringQuality(p.textureFilteringQuality)
      $hf2pPreferences.SetLightingQuality(p.lightingQuality)
      $hf2pPreferences.SetEffectsQuality(p.effectsQuality)
      $hf2pPreferences.SetShadowQuality(p.shadowQuality)
      $hf2pPreferences.SetDetailsQuality(p.detailsQuality)
      $hf2pPreferences.SetPostprocessQuality(p.postprocessQuality)
      $hf2pPreferences.SetMotionBlur(p.motionBlur) 
   end   
            
   func CheckApplyUserAdvancedVideoSettings(_checkOnly : bool = false) : int
      var checkResult : int = CheckVideoSettingsForApply(userAdvancedVideoSettings)
      if (checkResult == $hf2pPreferences.VIDEO_CHECK_ERROR_NONE and !_checkOnly)
         ApplyAdvancedSettings(userAdvancedVideoSettings)
         SaveAdvancedVideoParams()
      end
      return checkResult
   end
   
   func SaveAdvancedVideoParams()
      savedVideo := GetCurrentVideoSettings()
      userAdvancedVideoSettings := savedVideo
      settingsInitialized := true
   end


   func SaveInitialVideoSettings()
      savedVideo := GetCurrentVideoSettings()
   end
   
   func HasAdvancedVideoChanges() : bool
      var ret : bool = false
      ret := ret or userAdvancedVideoSettings.textureResolution         != savedVideo.textureResolution
      ret := ret or userAdvancedVideoSettings.textureFilteringQuality   != savedVideo.textureFilteringQuality
      ret := ret or userAdvancedVideoSettings.lightingQuality           != savedVideo.lightingQuality
      ret := ret or userAdvancedVideoSettings.effectsQuality            != savedVideo.effectsQuality
      ret := ret or userAdvancedVideoSettings.shadowQuality             != savedVideo.shadowQuality
      ret := ret or userAdvancedVideoSettings.detailsQuality            != savedVideo.detailsQuality
      ret := ret or userAdvancedVideoSettings.postprocessQuality        != savedVideo.postprocessQuality
      ret := ret or userAdvancedVideoSettings.motionBlur                != savedVideo.motionBlur
      return ret
   end
      
   func RestoreAdvancedVideoParams()
      ApplyAdvancedSettings(savedVideo)
   end   
end
var $hf2pPreferences : GAME_PREFERENCES_SSL
