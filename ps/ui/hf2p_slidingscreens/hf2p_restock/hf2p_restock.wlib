      }
      bindings   =   {
         expiringState   =   {
            binding   =   "{if: $UiGlobals.componentsInventory[(#self:itemId)].ownership_type == $uiEnums.ITEM_OWN_TYPE_RENTED and $UiGlobals.componentsInventory[(#self:itemId)].ownership_time < $uiEnums.ITEM_RENT_ALERT_SECONDS + $UiGlobals.timer, then = 'expiring', else = 'normal'}"
         }
      }
      __type   =   "ui_weaponConf_lib::hf2pLoadoutBtnSmall"
   }
   restockLoadoutItem   =   {
      isBlinkable   =   True
      elements   =   {
         rentTimer   =   {
            impl   =   {
               propMapping   =   {
                  tfColor   =   {
                     mapping   =   "tf.textColor"
                  }
               }
               __type   =   "ui_widget_impl_gfx"
            }
            bindings   =   {
               tf   =   {
                  binding   =   "{rentStatus}"
               }
               tfColor   =   {
                  binding   =   "{rentStatusColor}"
               }
            }
            __type   =   "ui_weaponConf_lib::wc_exiredTimeContainer"
         }
         offerName   =   {
            bindings   =   {
               tf   =   {
                  binding   =   "{$UiGlobals.componentsUI[itemId].name}"
               }
            }
            __type   =   "ui_widget_container"
         }
         offerTime   =   {
            bindings   =   {
               tfValue   =   {
                  binding   =   "{(:OfferDC).offer.DurationToStrings().daysCount}"
               }
               tfScale   =   {
                  binding   =   "{(:OfferDC).offer.DurationToStrings().daysLabel}"
               }
            }
            __type   =   "ui_weaponConf_lib::rent_offersDaysCont"
         }
         offerButtons   =   {
            elements   =   {
               crBuyBtn   =   {
                  events   =   {
                     buttonClick   =   {
                        eventRemap   =   "#OfferDC.OnBuyForCredits"
                     }
                  }
                  bindings   =   {
                     tf   =   {
                        binding   =   "{'' + (:OfferDC).offer.cr_cost}"
                     }
                  }
                  __type   =   "ui_weaponConf_lib::rent_creditPurchaseBtn"
               }
               gpBuyBtn   =   {
                  events   =   {
                     buttonClick   =   {
                        eventRemap   =   "#OfferDC.OnBuyForGold"
                     }
                  }
                  bindings   =   {
                     tf   =   {
                        binding   =   "{'' + (:OfferDC).offer.gl_cost}"
                     }
                  }
                  __type   =   "ui_weaponConf_lib::rent_goldPurchaseBtn"
               }
            }
            __type   =   "ui_weaponConf_lib::rent_offerLineNew"
         }
         attachCont   =   {
            elements   =   {
               iconAttach   =   {
                  fixed   =   False
                  bindings   =   {
                     pic   =   {
                        binding   =   "{$UiGlobals.componentsUI[itemId].icon}"
                     }
                  }
                  isCentered   =   True
                  __type   =   "ui_weaponConf_lib::attachPoint"
               }
            }
            __type   =   "ui_widget_container"
         }
      }
      bindings   =   {
         DC   =   {
            binding   =   "{new: 'ui.hf2p_SlidingScreens.hf2p_WeaponConf.hf2p_WeaponConf.WeaponItemLIR', itemId = (:itemId)}"
         }
         itemId   =   {
            binding   =   "{(#parent.#parent)GetRestockItemCount() > (:idx) ? (#parent)[(:idx)] : ''}"
         }
         anim   =   {
            binding   =   "{(:itemId) == '' ? 'inactive' : 'active'}"
         }
         OfferDC   =   {
            binding   =   "{new: 'ui.hf2p_SlidingScreens.hf2p_Restock.hf2p_Restock.RestockMinimalOfferVM', offer = $UiGlobals.componentsShop[itemId].GetMinimalOffer(), itemId = itemId}"
         }
      }
      __type   =   "ui_weaponConf_lib::hf2p_RestockLoadoutItem"
   }
}
__type   =   "ui_wlib"
