class UiStatBarElement : UiWidgetContainer


var   maxLevelPoints    : int = 25

func SetBundle(_offerId: string)
   SetItem(_offerId)
end

func SetLabelColor(_idx: int, _clr: int)
   var propName : string = "lvl" + (string)(_idx + 1) + "Color"
   Set(propName, _clr)
end

func GetLvlLabel(_idx: int): *
   return GetWidget("lvl" + (string)(_idx + 1))
end

func ArrangeLevelLabels(_armorClassCls: string, _armorClassPoints: int) 
   var   maxLevels         : int = 4
   var   levelLabelScale   : int = 230
   var   levelLabelStart   : int = 30

   /*
   var armorClassDesc : params = $uiPlayerInfo.GetArmorClassDesc(_armorClassCls)
   if (! IsVoid(armorClassDesc.levels))
      var   armorClassLevels  : vector = armorClassDesc.levels
      var   i                 : int 
      for i := 0 to maxLevels - 1
         GetLvlLabel(i).Props.visible := false
         SetLabelColor(i, $root.RGB2Clr(112, 148, 167))
      end
      for i := 0 to armorClassLevels.Count() - 1
         var armorClassLevel  : params = armorClassLevels.Get(i)
         var lvlLabel         : * = GetLvlLabel(i)
         lvlLabel.Props.x         := levelLabelStart + (armorClassLevel.threshold - 1) * levelLabelScale / maxLevelPoints
         lvlLabel.Props.visible   := true
         if (_armorClassPoints >= armorClassLevel.threshold)
            SetLabelColor(i, $root.RGB2Clr(255, 255, 255))
         end
      end
   end 
   */
   var   i                 : int 
   for i := 0 to maxLevels - 1
      GetLvlLabel(i).Props.visible := false
      SetLabelColor(i, $root.RGB2Clr(112, 148, 167))
   end
   for i := 0 to maxLevels - 1
      var lvlLabel         : * = GetLvlLabel(i)
      lvlLabel.Props.x         := levelLabelStart + (i * 5 - 1) * levelLabelScale / maxLevelPoints
      lvlLabel.Props.visible   := true
      //if (_armorClassPoints >= armorClassLevel.threshold)
         SetLabelColor(i, $root.RGB2Clr(255, 255, 255))
      //end
   end 
end

func SetProgressBar(_armorClassPoints: int) 
   Widgets.statBarCont.progressOver.scaleX := (float)(_armorClassPoints) / (float)(maxLevelPoints)
end

func SetItem(_itemID: string)
   if (_itemID == "")
      Props.visible := false
   end
   SetItemInternal(_itemID, false)
end

func UpgVal2Str(_val: float): string
   var ret: string
   
   var val: float = _val
   if (val < 0)
      val := -val
      ret := "-"
   else
      ret := "+"
   end
   if (val <= 1)
      val := val * 100.0
   end
   ret := ret + (string)((int)(val)) + "%"
   return ret
end

func SetItemInternal(_itemID: string, _forBundle: bool = false)
   if (_itemID == "")
      Props.visible := false
      return
   end
               
   Props.visible := true
   return
end

end

class ModifierLIneVM
   var item_id : string
   var idx : int
   
   func Init(p : params)
      item_id := p.item_id
      idx := p.idx
   end
   
   func GetModifierText() : wstring
      var ret : wstring
      var compArmor  : GL_ComponentArmor                 = (GL_ComponentArmor)$UiGlobals.componentsArmor.Get(item_id)
      if (idx < compArmor.gameplay_modifiers.Get().Count())
         var modifier   : GL_ComponentArmorGameplayModifier = (GL_ComponentArmorGameplayModifier)compArmor.gameplay_modifiers.Get().Get(idx)
         var compUi     : GL_ComponentUI                    = (GL_ComponentUI)$UiGlobals.componentsUI.Get(modifier.gameplay_modifier_id.Get())
         var t          : params
         t.id     := $UiGlobals.TranslateText((string)compUi.name.Get())
         t.space  := $UiGlobals.String2WString(" ")
         t.value  := $root.FormatArmorModifTempHack((string)modifier.gameplay_modifier_id.Get(), (float)modifier.gameplay_modifier_value.Get())
         ret := t.id + t.space + t.value
      end
      return ret
   end
end
