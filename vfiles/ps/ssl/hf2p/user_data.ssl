/***************************************************************
* UD_WeaponLoadout
*
***************************************************************/   
class UD_WeaponLoadout : UiSslBindableBase
   var primary_weapon         : ObservableProperty = null
   var secondary_weapon       : ObservableProperty = null
   var grenades               : ObservableProperty = null
   var booster                : ObservableProperty = null
   var consumable_first       : ObservableProperty = null
   var consumable_second      : ObservableProperty = null
   var consumable_third       : ObservableProperty = null
   var consumable_fourth      : ObservableProperty = null

// ssl-only
   var crOfferCosts           : ObservableProperty = $OM.Calculated(this, "GetCrOfferCostsVec")
   var gpOfferCosts           : ObservableProperty = $OM.Calculated(this, "GetGpOfferCostsVec")

   func InvalidateCosts()
      crOfferCosts.Invalidate()
      gpOfferCosts.Invalidate()
   end

   func GetCrOfferCostsVec() : vector
      var ret : vector
      var shopShelf  : GL_ShopShelf = $UiGlobals.shop.GetInternalShelf(0, "section_loadouts", "shelf_weapon_loadouts")
      if (shopShelf != null)
         var loadoutIdx : int
         for loadoutIdx := 0 to shopShelf.items.Get().Count() - 1
            var loadoutId    : string = (string)shopShelf.items.Get().Get(loadoutIdx).value.Get()
            var shopComp     : GL_ComponentShop = (GL_ComponentShop)$UiGlobals.componentsShop.Get(loadoutId)
            if (shopComp.offers.Get().Count() > 0)
               var loadoutOffer : GL_ComponentShopOffer = (GL_ComponentShopOffer)shopComp.offers.Get().Get(0)
               ret.Push((string)loadoutOffer.GetCrCost())
            else
               ret.Push("n/a~")
            end
         end
      end
      while (ret.Count() < 5)
         ret.Push("n/a~")
      end
      return ret 
   end

   func GetGpOfferCostsVec() : vector
      var ret : vector
      var shopShelf  : GL_ShopShelf = $UiGlobals.shop.GetInternalShelf(0, "section_loadouts", "shelf_weapon_loadouts")
      if (shopShelf != null)
         var loadoutIdx : int
         for loadoutIdx := 0 to shopShelf.items.Get().Count() - 1
            var loadoutId    : string = (string)shopShelf.items.Get().Get(loadoutIdx).value.Get()
            var shopComp     : GL_ComponentShop = (GL_ComponentShop)$UiGlobals.componentsShop.Get(loadoutId)
            if (shopComp.offers.Get().Count() > 0)
               var loadoutOffer : GL_ComponentShopOffer = (GL_ComponentShopOffer)shopComp.offers.Get().Get(0)
               ret.Push((string)loadoutOffer.GetGlCost())
            else
               ret.Push("n/a~")
            end
         end
      end
      while (ret.Count() < 5)
         ret.Push("n/a~")
      end
      return ret 
   end

   func GetWeaponTint(weaponId :  string) : params
      var   tint     : params = $uiEconomy.GetWeaponPrimaryArrtibuteColor("unknown")
      if (weaponId != "")
         var   weapon   :  GL_ComponentWeapon = (GL_ComponentWeapon)$UiGlobals.componentsWeapon.Get(weaponId)
         if (weapon != null)
            tint := $uiEconomy.GetWeaponPrimaryArrtibuteColor((string)weapon.primary_attribute_id.Get())
         end
      end
      return tint
   end
   
   func IsWeaponTintVisible(weaponId :  string) : bool
      var ret : bool = false
      if (weaponId != "")
         var   weapon   :  GL_ComponentWeapon = (GL_ComponentWeapon)$UiGlobals.componentsWeapon.Get(weaponId)
         if (weapon != null)
            ret := (string)weapon.primary_attribute_id.Get() != "none" and (string)weapon.primary_attribute_id.Get() != ""
         end
      end
      return ret
   end
   
   func RemoveTacticalPackage(p : params) : bool
      $user_service.SetWeaponLoadoutConsumable($hf2pEngine.GetUIPlayerModelId(), p.loadoutIdx, p.tacticalPackageIdx, "")
      return true
   end
   
   
   func GetOfferCostCr(loadoutIdx : int) : string
      var ret     : string
      var costVec : vector = crOfferCosts.Get()
      if (loadoutIdx >= 0 and loadoutIdx < costVec.Count())
         ret := costVec.Get(loadoutIdx)
      end
      return ret
   end
   
   func GetOfferCostGp(loadoutIdx : int) : string
      var ret     : string
      var costVec : vector = gpOfferCosts.Get()
      if (loadoutIdx >= 0 and loadoutIdx < costVec.Count())
         ret := costVec.Get(loadoutIdx)
      end
      return ret
   end
   
   func GetPackageByIdx(idx : int) : string
      var ret : string
      if (idx == 0)
         ret := (string)consumable_first.Get()
      elif (idx == 1)
         ret := (string)consumable_second.Get()
      elif (idx == 2)
         ret := (string)consumable_third.Get()
      elif (idx == 3)
         ret := (string)consumable_fourth.Get()
      end
      return ret
   end   
   
   func GetItemBySlotIdx(idx : int) : string
      var ret : string
      if (idx == 0)
         ret := (string)primary_weapon.Get()
      elif (idx == 1)
         ret := (string)secondary_weapon.Get()
      elif (idx == 2)
         ret := (string)grenades.Get()
      elif (idx == 3)
         ret := (string)consumable_first.Get()
      elif (idx == 4)
         ret := (string)consumable_second.Get()
      elif (idx == 5)
         ret := (string)consumable_third.Get()
      elif (idx == 6)
         ret := (string)consumable_fourth.Get()
      elif (idx == 7)
         ret := (string)booster.Get()
      end
      return ret
   end
   
   func GetSlotTypeAndSubType(idx : int) : params
      return $uiEnums.weaponSlotIdxToItemTypeVec.Get(idx)
   end
end

