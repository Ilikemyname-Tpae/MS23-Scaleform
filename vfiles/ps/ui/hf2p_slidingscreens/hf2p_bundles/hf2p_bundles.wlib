                     }
                     __type   =   "ui_widget_container"
                  }
               }
               bindings   =   {
                  anim2   =   {
                     binding   =   "{$uiEconomy.GetItemType(itemId) == $uiEnums.ITEM_TYPE_ARMOR ? 'icon' : $uiEconomy.GetItemType(itemId) == $uiEnums.ITEM_TYPE_TACTICAL ? 'video' : 'render'}"
                  }
                  anim   =   {
                     binding   =   "{$UiGlobals.componentsUI[itemId].video != 'unknown' ? 'video' : $UiGlobals.componentsUI[itemId].icon_big ? 'icon' : 'render'}"
                  }
               }
               __type   =   "ui_weaponConf_lib::bundleItemTooltipContent"
            }
