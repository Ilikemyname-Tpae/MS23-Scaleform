   Widgets.medals.visible               := false
   Widgets.spaceBg.plrAttach.visible    := false
end

func OnRewardBoxAnimFinished(p : params) : bool
   Finalyze()
   return true
end

func FillStats(anim : bool = true)
   var   statsVector : vector    
   var   stat        : params
   var   i           : int
   /* TEST
   stat.statName     := "stat1"
   stat.statCount    := 111
   stat.statBonuses  := 678
   stat.anim         := anim
   statsVector.Push(stat.Clone())
   
   stat.statName     := "stat2"
   stat.statCount    := 56
   stat.statBonuses  := 768
   stat.anim         := anim
   statsVector.Push(stat.Clone())

   stat.statName     := "stat3"
   stat.statCount    := 345
   stat.statBonuses  := 4545
   stat.anim         := anim
   statsVector.Push(stat.Clone())
   
   Widgets.statsBg.statCont.postMatchStatsList.SetData(statsVector)
   if (anim)
      StatsPanelStopCountAnim(statsVector) : 0.1
   end
   */
   if (statsVec.Count() > 0)    
      for i := 0 to statsVec.Count() - 1
         var statName : string = (string)((GL_ComponentUI)$UiGlobals.componentsUI.Get((string)statsVec.Get(i).id.Get())).name.Get()
         stat.statName     := statName
         stat.statCount    := (int)statsVec.Get(i).count.Get()
         stat.statBonuses  := (int)statsVec.Get(i).xp.Get()
         stat.anim         := anim
         statsVector.Push(stat.Clone())
      end
      Widgets.statsBg.statCont.postMatchStatsList.SetData(statsVector)
      if (anim)
         StatsPanelStopCountAnim(statsVector) : 0
      end
   end
end

func StatsPanelStopCountAnim(_vec :  vector)
   var i : int
   for i := 0 to _vec.Count() - 1
      _vec.Get(i).anim := false
   end
end

func FillRightPanelCont()
   GenerateEvent("uiUpdatePlayerInfoNoAnim")
   Widgets.rightCountersPanel.xp  := (string)xpGained
   Widgets.rightCountersPanel.xpBonus := (string)xpBonus
   Widgets.rightCountersPanel.xpCons := (string)xpCons
   Widgets.rightCountersPanel.xpComplete := (string)xpComplete
   Widgets.rightBoostPanel.xpTotal := (string)xpTotal
   Widgets.rightBoostPanel.xpTotalModif := (string)xpTotalModif
   Widgets.rightBoostPanel.crTotalModif := (string)crTotalModif
   Widgets.rightBoostPanel.crTotal := (string)crTotal
   Widgets.rightBoostPanel.rightCounterItemXPTotal.tfNum.text := (string)xpTotal //"0"
   Widgets.rightBoostPanel.rightCounterItemCreditsTotal.tfNum.text := (string)crTotal //"0"
   Widgets.rightBoostPanel.rightCounterItemXPTotalModif.tfNum.text := (string)xpTotalModif //"0"
   Widgets.rightBoostPanel.rightCounterItemCreditsTotalModif.tfNum.text := (string)crTotalModif //"0"
end

func FillMedalCont()
   /* TEST
   medalsTest.Clear()    
   var   med        : params
   med.name     := "medal_1"
   medalsTest.Push(med.Clone())
   med.name     := "medal_2"
   medalsTest.Push(med.Clone())
   med.name     := "medal_3"
   medalsTest.Push(med.Clone())
   
   Widgets.medals.visible := true
   Widgets.medals.ShowMedals(medalsTest, MedalsCountAnim())
   */
   Widgets.medals.visible := false
   if (medalsVec.Count() > 0)
      dec := 0
      if (medalsVec.Count() > 10)
         Widgets.prevMedalsBtn.visible := false//true
         Widgets.nextMedalsBtn.visible := false//true
      end
      Widgets.medals.visible := true
      Widgets.medals.ShowMedals(medalsVec, MedalsCountAnim())
   end
end

func switchMedalsNext (p : params) : bool
   var total : int = medalsVec.Count()
   if ((total - dec) > 10)
      dec := dec + 10
   end
   if (dec >= 40)
      dec := 40
   end
   Widgets.medals.ShowMedals(medalsVec, MedalsCountAnim(), dec)
   return false
end

func switchMedalsPrev (p : params) : bool
   dec := dec - 10
   if (dec <= 0)
      dec := 0
   end
   Widgets.medals.ShowMedals(medalsVec, dec)
   return false
end

func onMarkClicked0(p : params) : bool
   if (GetStateName() != "StatSequence" and GetStateName() != "StatStatic")
      delay kill, this, STATE_SKIP
      SetStateName("StatStatic")
   end
   return false
end

func onMarkClicked1(p : params) : bool
   if (GetStateName() != "ChallengeSequence" and GetStateName() != "ChallengeStatic")
      delay kill, this, STATE_SKIP
      SetStateName("ChallengeStatic")
   end
   return false
end

func onMarkClicked2(p : params) : bool
   delay kill, this, STATE_SKIP
   SetStateName("Scoreboard")
   return false
end

