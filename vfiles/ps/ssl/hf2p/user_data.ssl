/***************************************************************
* GL_UID
*
***************************************************************/   
class GL_UID : UiSslBindableBase
   native func Equals   (val : *)   : bool
   native func IsValid  ()          : bool
   native func ToStr    ()          : string

   var value  : ObservableProperty = null
   
   func InitDefault()
      if (value == null) 
         value := $OM.Property($UiGlobals.GetInvalidUIDVal())         
      else
         value.Set($UiGlobals.GetInvalidUIDVal())
      end
   end
   
   func GetVal() : *
      return value.Get()
   end
   
   func IsValidVal() : bool
      var uidStr  : string = $UserDataStorage.UID2Str(value.Get())
      var ret     : bool   = (uidStr != "0" and uidStr != "")
      return ret
   end

   func IsValidSSL() : bool
      return IsValidVal()
   end
end

