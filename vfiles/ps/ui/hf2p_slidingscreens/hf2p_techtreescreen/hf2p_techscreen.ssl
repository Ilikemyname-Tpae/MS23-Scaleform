   // ugly tech price centering stuff
   func GetTechPriceSpacing() : float
      return 5
   end
   
   func GetTechPriceLabelWidth() : float
      return wgt.Widgets.unlockBtn.tfPriceCard.tfWidth
   end

   func GetTechPriceWidth() : float
      return wgt.Widgets.unlockBtn.tfNumberCard.tfWidth
   end
   
   func GetTechPriceIconWidth() : float
      return wgt.Widgets.unlockBtn.tpIcon.width
   end
   
   func GetTechPriceContWidth() : float
      return GetTechPriceLabelWidth() + GetTechPriceWidth() + GetTechPriceIconWidth() + GetTechPriceSpacing() * 2
   end
   
   func GetTechPriceLabelXPos() : float
      var totalW  : float = GetTechPriceContWidth() 
      var ret     : float = - totalW / 2
      return ret      
   end
   
   func GetTechPriceXPos() : float
      var totalW  : float = GetTechPriceContWidth() 
      var ret     : float = GetTechPriceLabelXPos() + GetTechPriceLabelWidth () + GetTechPriceSpacing()
      return ret      
   end
   
   func GetTechPriceIconXPos() : float
      var totalW  : float = GetTechPriceContWidth() 
      var ret     : float = GetTechPriceLabelXPos() + GetTechPriceLabelWidth () + GetTechPriceWidth() + GetTechPriceSpacing() * 2
      return ret      
   end
end // class UiTechCardVM
