   Widgets.rightBoostPanel.iconXpBooster.visible := true
   Widgets.rightBoostPanel.iconCrBooster.visible := true
   Widgets.rightBoostPanel.rightCounterItemXPTotalModif.glowAnim.visible := false
   Widgets.rightBoostPanel.rightCounterItemCreditsTotalModif.glowAnim.visible := false
   
   Widgets.rightBoostPanel.rightCounterItemXPTotal.tfName.SetTextSize(38.0)
   Widgets.rightBoostPanel.rightCounterItemXPTotal.tfNum.SetTextSize(38.0)
   Widgets.rightBoostPanel.rightCounterItemCreditsTotal.tfName.SetTextSize(38.0)
   Widgets.rightBoostPanel.rightCounterItemCreditsTotal.tfNum.SetTextSize(38.0)
   Widgets.rightBoostPanel.rightCounterItemCreditsTotalModif.tfName.SetTextSize(26.0)
   Widgets.rightBoostPanel.rightCounterItemCreditsTotalModif.tfNum.SetTextSize(26.0)
   Widgets.rightBoostPanel.rightCounterItemXPTotalModif.tfName.SetTextSize(26.0)
   Widgets.rightBoostPanel.rightCounterItemXPTotalModif.tfNum.SetTextSize(26.0)
   
