   pp.titleTxt       := "msg_exit_game_confirm_title"
   pp.messageTxt     := "msg_exit_game_confirm_message"
   pp.callbackEvent  := "ExitGameMbClosed"
   pp.mbType         := $uiEnums.MB_TYPE_NO_YES
   GenerateEvent("MainMenuDialogRequest", pp)   
   return false
end

func EnablePanelsInput(_enable: bool)
   Widgets().leftPanel.mouseChildren         := _enable
   Widgets().leftPanel.mouseEnabled          := _enable
   Widgets().rightPanel.mouseChildren        := _enable
   Widgets().rightPanel.mouseEnabled         := _enable
   Widgets().playerInfoPanel.mouseChildren   := _enable
   //Widgets().racePanel.mouseChildren         := _enable
   Widgets().playerInfoPanel.mouseEnabled    := _enable
   //Widgets().racePanel.mouseEnabled          := _enable
   Widgets().cashPanel.mouseChildren         := _enable
   Widgets().cashPanel.mouseEnabled          := _enable
   Widgets().rankPanel.mouseChildren         := _enable
   Widgets().rankPanel.mouseEnabled          := _enable
   Widgets().lowerPanel.mouseChildren        := _enable
   Widgets().lowerPanel.mouseEnabled         := _enable
   Widgets().lowerPanelSettings.mouseChildren:= _enable
   Widgets().lowerPanelSettings.mouseEnabled := _enable
   Widgets().lowerPanelExit.mouseChildren    := _enable
   Widgets().lowerPanelExit.mouseEnabled     := _enable
end

func ShowPanels(_show: bool)
   Widgets().leftPanel.visible         := _show
   Widgets().rightPanel.visible        := _show
   Widgets().playerInfoPanel.visible   := _show
   Widgets().cashPanel.visible         := _show
   Widgets().rankPanel.visible         := _show
   Widgets().lowerPanel.visible        := _show
   Widgets().lowerPanelSettings.visible:= _show
   Widgets().lowerPanelExit.visible    := _show
end

func onLeftPanelVisible(p:params):bool
   Log("ui~hf2p_main_menu", "onLeftPanelVisible")
   Widgets().leftPanel.visible := p.visible
   return false
end 
func OnUIPlaySound(p:params): bool
   var soundName: string = "none"
   if (! IsVoid(p.soundName))
      soundName := p.soundName
   end
   if (soundName != "none")
      $root.playSound(soundName)
   end
   return false
end

func OnShowDebugFrame(p:params): bool
   var wgtR : UiWidget = (UiWidget) GetWidget("debugContainer")      
   if (!p.show)
      wgtR.Set("visible", false)
      //wgtR.SetEnableDisplay(false)
   else
      //wgtR.SetEnableDisplay(true)
      wgtR.Set("visible", true)
      var wgt : UiWidget = (UiWidget) wgtR.GetWidget("dbgFrameOutside")      
      
      if ( ((float)p.x) < (1280/2))            
         wgtR.Widgets().dbgWidgetInfo.Set("x", (1280/2) + 50.0)
      else         
         wgtR.Widgets().dbgWidgetInfo.Set("x", 50.0)
      end
      
      wgt.Set("x", ((float)p.x))   
      wgt.Set("y", ((float)p.y))      
      wgt.Set("_width", ((float)p.width))
      wgt.Set("_height", ((float)p.height))      
      
      var wgtInfo : UiWidget = (UiWidget) wgtR.GetWidget("dbgWidgetInfo")      
      var wgtInfoProps : UiWidget = (UiWidget) wgtInfo.GetWidget("PropsList")      
      
      var propsInfo : vector
      
      var curWgt : UiWidget = (UiWidget) p.widget
      
      //var row1 :  params
      //row1.Set("column1", "Name:" + curWgt.GetName())
      //propsInfo.Push(row1)
      var row3 :  params
      row3.Set("column1", "FullName : " + p.FullName)
      propsInfo.Push(row3)      
      var row2 :  params
      row2.Set("column1", "Type : " + p.BaseTypeName)
      propsInfo.Push(row2)      
      var row4 :  params
      row4.Set("column1", "Cls : " + p.ClsName)
      propsInfo.Push(row4)
      var row5 :  params
      row5.Set("column1", "Global bounds : ")
      propsInfo.Push(row5)
      var row6 :  params
      row6.Set("column1", "x : " + (string)p.x + " y : " + (string)p.y)
      propsInfo.Push(row6)
      var row7 :  params
      row7.Set("column1", "width : " + (string)p.width + " height : " + (string)p.height)
      propsInfo.Push(row7)
      
      if (curWgt!=null)
         var row52 :  params
         row52.Set("column1", "Local  bounds : ")
         propsInfo.Push(row52)
      
         var row81 :  params
         row81.Set("column1", "x : " + (string)curWgt.Get("x") + " y : " + (string)curWgt.Get("y"))      
         propsInfo.Push(row81)
         
         var row91 :  params
         row91.Set("column1", "width : " + (string)curWgt.Get("width") + " height : " + (string)curWgt.Get("height"))         
         propsInfo.Push(row91)         
      end
      
      var rowP0 :  params
      rowP0.Set("column1", "")
      propsInfo.Push(rowP0)
      
      // ParentInfo
      var pinfo : vector = p.Get("ParentInfo")
      var i : int
      for i:=0 to pinfo.Count() - 1
         var elem : params = pinfo.Get(i)
         //var rowP1 :  params
         //rowP1.Set("column1", "name: " + (string)elem.Name + " type: " + (string)elem.BaseTypeName)
         //var rowP2 :  params
         //rowP2.Set("column1", "cls : " + (string)elem.ClsName)
         
         //propsInfo.Push(rowP1)
         //propsInfo.Push(rowP2)
         var rowP1 :  params
         rowP1.Set("column1", ":" + (string)elem.Name + " cls : " + (string)elem.ClsName)
         
         propsInfo.Push(rowP1)         
      end
      wgtR.Widgets().dbgWidgetInfo.PropsList.SetData(propsInfo)
      
      //var type : string = (string)curWgt.Get("__type")
      //wgtInfo.
   end
   return false
end

func SetGlobalMouseValue(val : bool)
   Props().global_mouse := val
end

func OnStartUniversalDrag(p: params): bool
   if (! IsVoid(p.dragEvent))
      Widgets().universalDragSymbol.SetDragEvent(p.dragEvent, p.dragTarget)
      var mousePos : params = GetMousePosLocal()
      var universalDragSymbol : * = Widgets().universalDragSymbol
      universalDragSymbol.x   := mousePos.x
      universalDragSymbol.y   := mousePos.y
      universalDragSymbol.StartDragManual()   
   end
   return false
end

handle OnEnteringState("WelcomeInitial")
   if ($root.GetMainMenuState() == "REMATCH" or $root.GetMainStartState() == "WelcomeRelogin")
      Widgets().welcomeScreen.SetStateName("Initial")
   else
      Widgets().welcomeScreen.SetStateName("InitialVisible")
   end   
end

// ssl from states:
handle OnEnterState("WelcomeInitial")
   Log("ui~hf2p_main_menu", "WelcomeInitial_OnEnterState")
   $uiPlayerInfo.InitFromEquipped()

   if ($root.GetMainMenuState() == "REMATCH")
      Props().global_mouse := true
      $root.SetMainMenuState("WELCOME_SCREEN")
      $root.StartAcceptingErrors()
      if ($root.GetIsDisconnect())
         bLog("UI/MMENU", "Main_Menu_DisconnectIngameFlag")
         DisconnectErrorMsgBox(0, (int)$UiGlobals.backend_session.error_code.Get(), (int)$UiGlobals.backend_session.error_code_l10n.Get())
      else
         isLoggedIn := true
         //$hf2pEngine.RequestPostgameStat()
         $hf2pEngine.TermUIScreenSounds()
         //Widgets().rosterPanel.visible := true
         SwitchToPostGame() : 1
      end
   else
      var autoState : string = $root.GetMainStartState()
      $root.SetMainStartState("")
      if (autoState != "")
         if (autoState == "Welcome")
            SetStateName(autoState) : 4.5
         else
            SetStateName(autoState)
         end
      end
   end
end

handle OnExitState("WelcomeInitial")
end

