   func GetIsChallengeRank() : bool
      var ret : bool = false
      var compShop : GL_ComponentShop = (GL_ComponentShop)$UiGlobals.componentsShop.Get(itemId.Get())
      var techId : string = (string)compShop.requirement.Get()
      if $UiGlobals.componentsShop.Exist(techId)
         ret := true
      end   
      return ret
   end

   func GetContentType() : string
      var ret        : string          = "armor"
      var itemType   : int             = $uiEconomy.GetItemType((string)itemId.Get())
      
      if (itemType == $uiEnums.ITEM_TYPE_WEAPON)
         ret := "weapon"
      elif (itemType == $uiEnums.ITEM_TYPE_TACTICAL)
         ret := "tactical"
      elif (itemType == $uiEnums.ITEM_TYPE_ARMOR or itemType == $uiEnums.ITEM_TYPE_ARMOR_SUIT)
         ret := "armor"
      else
         ret := "armor"
      end
      
      return ret
   end
   
   func GetContentAnim() : string
      var ret        : string          = "armor"
      var compUI     : GL_ComponentUI  = (GL_ComponentUI)$UiGlobals.componentsUI.Get(itemId.Get())
      var video      : string          = (string)compUI.video.Get()
      var iconBig    : string          = (string)compUI.icon_big.Get()      
      var itemType   : int             = $uiEconomy.GetItemType((string)itemId.Get())
      var itemSubType: int             = $uiEconomy.GetItemSubType((string)itemId.Get())
      
      if (itemType == $uiEnums.ITEM_TYPE_WEAPON or itemSubType == $uiEnums.ITEM_SUB_TYPE_WPN_GRENADE)
         ret := "weapon"
      elif (itemType == $uiEnums.ITEM_TYPE_TACTICAL)
         ret := "tactical"
      elif (itemType == $uiEnums.ITEM_TYPE_ARMOR or itemType == $uiEnums.ITEM_TYPE_ARMOR_SUIT)
         ret := "armor"
      else
         ret := "armor"
      end
      
      return ret
   end
