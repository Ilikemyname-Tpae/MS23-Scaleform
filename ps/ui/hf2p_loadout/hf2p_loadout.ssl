func loadoutChoiceClick(p: params): bool
   if (GetStateName() == "ChoiceLoadoutBtn")
      if $UiGlobals.DeathScreenLoadoutsMode.Get() == "weapons"
         SetStateName("SelectLoadout")
      else
         SetStateName("SelectArmorLoadout")
      end
      Log("ui~loadoutSelect", "loadoutChoiceClick")
   end
   return false
end

func onCancel(p: params): bool
   Log("ui~loadoutSelect", "onCancel")
   if GetStateName() == "SelectLoadout" or GetStateName() == "SelectArmorLoadout"
      SetStateName("ChoiceLoadoutBtn")
   else
      revertChanges()
   end	  
   return false
end

func AssignSlotsArsenal(p: params):bool
   Log("ui~loadoutSelect", "AssignSlotsArsenal_LOADOUT " + p.itemId)
   var category : string = $UiGlobals.AssigningItemCategory
   if category == "section_weapons_primary"
      minSlotIdx     := 0
      maxSlotIdx     := 0
   elif category == "section_weapons_secondary"
      minSlotIdx     := 1
      maxSlotIdx     := 1
   elif category == "section_weapons_grenade"
      minSlotIdx     := 2
      maxSlotIdx     := 2
   end
   assignItemId   := p.itemId
   prevScr        := p.closeEvent   
   wpnAssign      := true
   SetStateName("Assign2Loadout")
   return false
end

func AssignSlotsTacticalPack(p: params):bool
   Log("ui~loadoutSelect", "AssignSlotsTacticalPack")
   minSlotIdx     := 3
   maxSlotIdx     := 6
   assignItemId   := p.itemId
   prevScr        := p.closeEvent
   wpnAssign      := false
   SetStateName("Assign2Loadout")
   return false
end

func AssignSlotsBooster(p: params):bool
   Log("ui~loadoutSelect", "AssignSlotsBooster")
   minSlotIdx     := 7
   maxSlotIdx     := 7
   assignItemId   := p.itemId
   prevScr        := p.closeEvent
   wpnAssign      := false
   SetStateName("Assign2Loadout")
   return false
end

func OpenLoadoutScr(p:params):bool
   SetStateName("SeeLoadout")
   return false
end

func GetItemName(_itemId:string):string
   var ret:string 
   if (_itemId != "")
      var compUI  : GL_ComponentUI = (GL_ComponentUI)$UiGlobals.componentsUI.Get(_itemId)
      ret := (string)compUI.name.Get()
      return ret
   end
   return ret
end

func GetLoadout(_loadoutIdx:int) : *
   return Widgets().slots.GetWidget("Loadout" + _loadoutIdx)
end

func GetSlotBtn(_slotIdx:int, _btnIdx:int): *
   return Widgets().slots.GetWidget("Loadout" + _slotIdx).Widgets().btnBox.GetWidget("btn" + _btnIdx)
end
   
func onLoadoutSmallBtnClick(p:params): bool
   Log("ui~loadoutSelect", "onLoadoutSmallBtnClicked " + p.widget.idx)
   if $UiGlobals.DeathScreenLoadoutsMode.Get() == "weapons"
      acceptLoadout(p)
      ShowSelectLoadoutButtons()
   else
      $user_service.SetArmorLoadoutActive(0, p.widget.idx)
   end
   return false   
end

handle OnChangeStateAny
   if (GetStateName() == "SeeLoadout" or GetStateName() == "Assign2Loadout" or GetStateName() == "SelectLoadout" or GetStateName() == "SelectLoadoutPregame")
      subscribe := true
      $UserDataStorage.InvalidateWeaponLoadouts()
      GetObservableLoadoutCount().Subscribe(this, "CheckUpdateLoadout")
      var i: int
      for i := 0 to 4
	     UpdateLoadoutStatus(i, true)
      end
      for i:= 1 to 4
         UpdateLoadoutOffersLine(i)
      end
   end
   ShowSelectLoadoutButtons()
end

handle OnEnteringState("Initial")
   if (subscribe)
      GetObservableLoadoutCount().Unsubscribe(this, "CheckUpdateLoadout")
      subscribe := false
   end
   enteringState := "Initial"
   //AddTween("alpha", 0.0, 0.15, "linear")
   Set("visible", false)// : 0.15
