   func UpdateRosterLists()
      var   playersVec        : vector
      var   playersVecLocal   : vector
      var   i                 : int
      var   isTeamModeSet     : bool   = false
      var   maxPlayers        : int    = 8
      var   alwaysTeam        : bool   = false
      var   count1            : int    = 0
      var   count2            : int    = 0
      var   totalIdx          : int    = 0
      var   rosterIdx         : int    = 0
      var   lobbyState        : int    = (int)$UiGlobals.lobby.state.Get()
       var  totalPlayersInList: int    = -1
      
      if (players1Vec.Count() == 0)
         for i := 0 to maxPlayers - 1
            var playerRec1 : GL_LobbyPlayer = new GL_LobbyPlayer()
            var playerRec2 : GL_LobbyPlayer = new GL_LobbyPlayer()
            playerRec1.InitDefault()
            playerRec2.InitDefault()
            players1Vec.Push(playerRec1)
            players2Vec.Push(playerRec2)
         end
      end
      
      var isTeamsAllowed : bool = IsTeamModeAllowed()
      if ((int)$UiGlobals.lobby.team_count.Get() > 1)
         if (isTeamsAllowed)
            isTeamModeSet := true
         end
      end
      //hack
      //isTeamModeSet := true
                  
      var playlist      : string                = (string)$UiGlobals.matchmaking.playlists_selection.Get()
      var plComp        : GL_ComponentPlaylist  = (GL_ComponentPlaylist)$UiGlobals.componentsPlaylist.Get(playlist)
      var maxPlPlayers  : int                   = 0
      if (isTeamModeSet)
         maxPlPlayers := (int)plComp.player_count_max.Get() / 2
      else
         maxPlPlayers := (int)plComp.player_count_max.Get()
      end   
         
      if ($uiPartyMonitor.GetLobbyModeObservable() == $uiPartyMonitor.STATE_FORMATION)
         isTeamModeSet        := false
         playersVec           := internalPlayersParty
         totalPlayersInList   := playersVec.Count()
         
         $root.UiLog("Lobby: players count [formation] = " + (string)playersVec.Count())
         
         for i := 0 to playersVec.Count() - 1
            var   player      : GL_UID    = (GL_UID)playersVec.Get(i)
            var   teamIdx     : int       = 0
            var   curCount    : int
            
            if (! isTeamModeSet)
               teamIdx     := 0
            end
            
            if (teamIdx < 2)
               if (count1 >= maxPlayers or teamIdx == 1)
                  rosterIdx := 1
               else 
                  rosterIdx := 0
               end
            else
               rosterIdx := 0
            end
            teamIdx := rosterIdx
                     
            if (rosterIdx == 0)
               playersVecLocal   := players1Vec
               curCount          := count1
            else
               playersVecLocal   := players2Vec
               curCount          := count2
            end
            
            var playerRec : GL_LobbyPlayer = (GL_LobbyPlayer)playersVecLocal.Get(curCount)
            playerRec.id.value.Set(player.value.Get())
            playerRec.idx.Set(totalIdx)
            playerRec.localIdx.Set(curCount)
            playerRec.isTeamMode.Set(isTeamModeSet)
            playerRec.team_index2.Set(teamIdx)
            if (isTeamModeSet)
               playerRec.isSlotEnabled.Set(curCount < maxPlPlayers)
            else
               playerRec.isSlotEnabled.Set(totalIdx < maxPlPlayers)
            end
            playerRec.isAddSlot.Set(false)
            playerRec.isAddSlot.OnChanged()
            playerRec.lobbyState.Set(GetScreenStateVal())
            playerRec.id.value.OnChanged()

            if (rosterIdx == 0)
               count1 := count1 + 1
            else
               count2 := count2 + 1
            end
            totalIdx := totalIdx + 1
         end         
      elif (lobbyState != $uiEnums.LOBBY_STATE_NONE and lobbyState != $uiEnums.LOBBY_STATE_JOINING_SESSION)
         playersVec := internalPlayersLobby
         totalPlayersInList := playersVec.Count()
         
         $root.UiLog("Lobby: players count [lobby] = " + (string)playersVec.Count())
         for i := 0 to playersVec.Count() - 1
            var   player      : GL_LobbyPlayer  = (GL_LobbyPlayer)playersVec.Get(i)
            var   teamIdx     : int             = (int)player.team_index.Get()
            var   curCount    : int
            
            if (! isTeamModeSet)
               teamIdx     := 0
            end
            
            if (teamIdx < 2)
               if (count1 >= maxPlayers or teamIdx == 1)
                  rosterIdx := 1
               else 
                  rosterIdx := 0
               end
            else
               rosterIdx := 0
            end
            teamIdx := rosterIdx
                     
            if (rosterIdx == 0)
               playersVecLocal   := players1Vec
               curCount          := count1
            else
               playersVecLocal   := players2Vec
               curCount          := count2
            end
            
            var playerRec : GL_LobbyPlayer = (GL_LobbyPlayer)playersVecLocal.Get(curCount)
            playerRec.CopyVals(player)            
            playerRec.idx.Set(totalIdx)
            playerRec.localIdx.Set(curCount)
            playerRec.isTeamMode.Set(isTeamModeSet)
            playerRec.team_index2.Set(teamIdx)
            if (isTeamModeSet)
               playerRec.isSlotEnabled.Set(curCount < maxPlPlayers)
            else
               playerRec.isSlotEnabled.Set(totalIdx < maxPlPlayers)
            end
            playerRec.isAddSlot.Set(false)
            playerRec.isAddSlot.OnChanged()
            playerRec.lobbyState.Set(GetScreenStateVal())
            playerRec.id.value.OnChanged()

            if (rosterIdx == 0)
               count1 := count1 + 1
            else
               count2 := count2 + 1
            end
            totalIdx := totalIdx + 1
         end
      else
         playersVec           := internalPlayersMM
         isTeamModeSet        := false
         totalPlayersInList   := playersVec.Count()
         maxPlPlayers         := (int)plComp.player_count_max.Get()
         
         $root.UiLog("Lobby: players count [MM] = " + (string)playersVec.Count())
         for i := 0 to playersVec.Count() - 1
            var   player      : GL_UID  = (GL_UID)playersVec.Get(i)
            var   teamIdx     : int     = 0
            var   curCount    : int
            
            if (! isTeamModeSet)
               teamIdx     := 0
            end
            
            if (teamIdx < 2)
               if (count1 >= maxPlayers or teamIdx == 1)
                  rosterIdx := 1
               else 
                  rosterIdx := 0
               end
            else
               rosterIdx := 0
            end
            teamIdx := rosterIdx
                     
            if (rosterIdx == 0)
               playersVecLocal   := players1Vec
               curCount          := count1
            else
               playersVecLocal   := players2Vec
               curCount          := count2
            end
            
            var playerRec : GL_LobbyPlayer = (GL_LobbyPlayer)playersVecLocal.Get(curCount)
            playerRec.id.value.Set(player.value.Get())
            playerRec.team_index.Set(0)
            playerRec.idx.Set(totalIdx)
            playerRec.localIdx.Set(curCount)
            playerRec.isTeamMode.Set(isTeamModeSet)
            playerRec.team_index2.Set(teamIdx)
            if (isTeamModeSet)
               playerRec.isSlotEnabled.Set(curCount < maxPlPlayers)
            else
               playerRec.isSlotEnabled.Set(totalIdx < maxPlPlayers)
            end
            playerRec.lobbyState.Set(GetScreenStateVal())
            playerRec.isAddSlot.Set(false)
            playerRec.isAddSlot.OnChanged()
            playerRec.id.value.OnChanged()

            if (rosterIdx == 0)
               count1 := count1 + 1
            else
               count2 := count2 + 1
            end
            totalIdx := totalIdx + 1
         end
      end
      // fill the rest
      
      var isAddSlot : bool = GetScreenStateVal() == $uiEnums.LOBBY_SCREEN_STATE_PLAYLIST
      isAddSlot := isAddSlot and $UserDataStorage.local_user.IsPartyLeader()
      for rosterIdx := 0 to 1
         if (rosterIdx == 1)
            isAddSlot := false
         end
         
         var curCount : int
         if (rosterIdx == 0)
            playersVecLocal   := players1Vec
            curCount          := count1
         else
            playersVecLocal   := players2Vec
            curCount          := count2
         end
         
         while (curCount < maxPlayers)
            var playerRec : GL_LobbyPlayer = (GL_LobbyPlayer)playersVecLocal.Get(curCount)
            playerRec.SetInvalid()
            playerRec.idx.Set(totalIdx)
            playerRec.localIdx.Set(curCount)
            playerRec.isTeamMode.Set(isTeamModeSet)
            if (isTeamModeSet)
               playerRec.team_index2.Set(rosterIdx)
               playerRec.isSlotEnabled.Set(curCount < maxPlPlayers)
            else
               playerRec.team_index2.Set(0)
               playerRec.isSlotEnabled.Set(totalIdx < maxPlPlayers)
            end
            if ($uiPartyMonitor.GetLobbyModeObservable() == $uiPartyMonitor.STATE_FORMATION)
               playerRec.isSlotEnabled.Set(rosterIdx == 0)
            end
            playerRec.isAddSlot.Set(isAddSlot)
            playerRec.isAddSlot.OnChanged()
            playerRec.lobbyState.Set(GetScreenStateVal())
            isAddSlot := false
            //playerRec.id.value.OnChanged()
            
            curCount := curCount + 1
            totalIdx := totalIdx + 1
         end
      end
      
      isTeamMode.Set(isTeamModeSet)     
      //players1VecObservable.OnChanged()
      //players2VecObservable.OnChanged()
   end
   
   func GetTeamPlayers(_rosterTeam : int) : vector          
      var playersVecLocal : vector
      if (_rosterTeam == 0)
         playersVecLocal := players1VecObservable.Get()
      else
         playersVecLocal := players2VecObservable.Get()
      end
      return playersVecLocal
   end
      
