/***************************************************************
* UD_ArmorLoadoutBonuses
*
***************************************************************/   
class UD_ArmorLoadoutBonuses : UiSslBindableBase
   var armor_class_id            : ObservableProperty = null  

   var current_value             : ObservableProperty = null 
   var current_level             : ObservableProperty = null   

   var percent_value   : ObservableProperty = $OM.Calculated(this, "GetPercentValue", true)
   var percent_value2  : ObservableProperty = $OM.Calculated(this, "GetPercentValue2", true)
   var modifiers_text  : ObservableProperty = $OM.Calculated(this, "GetModifiersText", true)
   
   func GetPercentValue() : float
      var ret :  float
      ret := (float)current_value.Get()
      ret := ret / 25.0
      return ret            
   end
   
   func GetPercentValue2() : float
      var ret :  float
      ret := (float)current_value.Get() + 1.0
      ret := ret / 26.0
      return ret            
   end
      
   func GetModifiersText() : string
      var result : string = ""
      return result
   end

end

/***************************************************************
* UD_ArmorLoadout
*
***************************************************************/   
class UD_ArmorLoadout : UiSslBindableBase
   var armor            : ObservableProperty = null

// ssl-only
   var bonuses_sorted         : ObservableProperty = $OM.Calculated(this, "GetBonusesSorted", true)
   var bonuses_sorted_count   : ObservableProperty = $OM.Calculated(this, "GetBonusesSortedCount", true)
   
   var crOfferCosts           : ObservableProperty = $OM.Calculated(this, "GetCrOfferCostsVec")
   var gpOfferCosts           : ObservableProperty = $OM.Calculated(this, "GetGpOfferCostsVec")
   
   func InvalidateCosts()
      crOfferCosts.Invalidate()
      gpOfferCosts.Invalidate()
   end
   
   func GetBonusesSorted() : vector
