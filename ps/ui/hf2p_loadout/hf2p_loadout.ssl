func SetScreenAlpha(_alpha: float)
   Props().alpha := _alpha
end

func OnDialogShowTween(p: params): bool
   var alphaParm : float = p.dialogTweenParm
   if (GetStateName() != "Initial")
      SetScreenAlpha(100.0 - alphaParm * 95)
   end
   return true
end

func EnableFakeBg()
   var p: params
   if (minSlotIdx <= 2)
      p.state := "loadout"      
   else
      p.state := "loadoutTP"
   end
   GenerateEvent("ChangeFakeBackground", p)
end

func StartBlink()
   Props().alpha := 0.0
   AddTween("alpha", 1.0, 0.35, "linear")
   StartBlink2()
end

func StartBlink2()
   if enteringState != "ChoiceLoadoutBtn"
      $root.playSound("armory_screen_appear_hud")
   end
   var t0 : float = 0.0
   Widgets().slots.Loadout0.StartBlink(t0)
   Widgets().slots.Loadout1.StartBlink(t0)
   Widgets().slots.Loadout2.StartBlink(t0)
   Widgets().slots.Loadout3.StartBlink(t0)
   Widgets().slots.Loadout4.StartBlink(t0)
   Widgets().slots.offerPanel1.StartDefaultBlinking(t0 + 0.9)
   Widgets().slots.offerPanel2.StartDefaultBlinking(t0 + 0.9)
   Widgets().slots.offerPanel3.StartDefaultBlinking(t0 + 0.9)
   Widgets().slots.offerPanel4.StartDefaultBlinking(t0 + 0.9)
   Widgets().doneBtn.StartDefaultBlinking(t0 + 0.9)
   Widgets().cancelBtn.StartDefaultBlinking(t0 + 0.9)
end

func weaponsToggleButtonClicked(p : params) : bool
   $UiGlobals.DeathScreenLoadoutsMode.Set("weapons")
   ShowSelectLoadoutButtons()
   return false
end

func armorsToggleButtonClicked(p : params) : bool
   $UiGlobals.DeathScreenLoadoutsMode.Set("armors")
   ShowSelectLoadoutButtons()
   return false
end

func onArmoryLoadoutClicked2(p: params): bool
   //actual selecting armor loadout is in hf2p_ArmoryLoadout.ssl -> UiArmorLoadout::onArmoryLoadoutClicked
   if (GetStateName() == "SelectArmorLoadout")
      SetStateName("ChoiceLoadoutBtn")
   end
   return false
end

func OnLoadoutsModeToggleButtonClicked(p: params): bool
   if $UiGlobals.DeathScreenLoadoutsMode.Get() == "weapons"
      $UiGlobals.DeathScreenLoadoutsMode.Set("armors")
      if (GetStateName() == "SelectLoadout")
         SetStateName("SelectArmorLoadout")
      elif (GetStateName() == "SelectLoadoutPregame")
         SetStateName("SelectArmorLoadoutPregame")
      end
   else
      $UiGlobals.DeathScreenLoadoutsMode.Set("weapons")
      if (GetStateName() == "SelectArmorLoadout")
         SetStateName("SelectLoadout")
      elif (GetStateName() == "SelectArmorLoadoutPregame")
         SetStateName("SelectLoadoutPregame")
      end
   end
   return false
end

func inputEvent(p : params) : bool
   if (GetStateName() == "ChoiceLoadoutBtn")
      if (p.keyCode == $uiKeys.VK_SPACE and ! p.isDown)
         Widgets().RespawnPanel.respawnButton.SetFocus()
         Widgets().RespawnPanel.GenerateEvent("#respawnNowClick")
      end         
   else
      if (p.keyCode != $uiKeys.VK_ENTER and p.keyCode != $uiKeys.VK_SPACE)
         p.eventState.SetIsTerminated()      
      end
      if (p.keyCode == $uiKeys.VK_ESC and ! p.isDown)
         if (Widgets().cancelBtn.visible)
            onCancel(null)
         end
      elif (p.keyCode == $uiKeys.VK_ENTER and ! p.isDown)
         if (Widgets().doneBtn.visible)
            doneA2l(null)
         end
      end      
   end
   return false
end

end

class RespawnPanelVM
   var respawnTimerTxt        : ObservableProperty = $OM.Property("")
   var isRespawnTimerVisible  : ObservableProperty = $OM.Property(false)
   var isRepawnButtonEnabled  : ObservableProperty = $OM.Property(false)
   var isRepawnButtonVisible  : ObservableProperty = $OM.Property(false)
   var repawnButtonLabel      : ObservableProperty = $OM.Property("")
   var isRespawnPanelVisible  : ObservableProperty = $OM.Property(false)
   

   func Init(p : params)
      $UiIngame.state_timer.Subscribe(this, "UpdateControls")
      $UiIngame.respawn.is_auto_respawn_countdown.Subscribe (this, "UpdateControls")
      $UiIngame.respawn.is_early_respawn_enabled.Subscribe  (this, "UpdateControls")
      $UiIngame.respawn.is_early_respawn_requested.Subscribe(this, "UpdateControls")
   end
   
   func Term()
      $UiIngame.state_timer.Unsubscribe(this, "UpdateControls")
      $UiIngame.respawn.is_auto_respawn_countdown.Unsubscribe (this, "UpdateControls")
      $UiIngame.respawn.is_early_respawn_enabled.Unsubscribe  (this, "UpdateControls")
      $UiIngame.respawn.is_early_respawn_requested.Unsubscribe(this, "UpdateControls")
   end
   
   func ShowRespawnPanel(p : params) : bool
      isRespawnPanelVisible.Set(true)
      return true
   end
   
   func HideRespawnPanel(p : params) : bool
      isRespawnPanelVisible.Set(false)
      return true
   end
   
   func UpdateControls(_val : *)
      var is_auto_respawn_countdown       : bool   = (bool)$UiIngame.respawn.is_auto_respawn_countdown.Get()
      var is_early_respawn_enabled        : bool   = (bool)$UiIngame.respawn.is_early_respawn_enabled.Get()
      var is_early_respawn_requested      : bool   = (bool)$UiIngame.respawn.is_early_respawn_requested.Get()
      var timer                           : int    = GetRespawnTimer()
      
      var respawnTimerTxtSet              : string = ""
      var isRepawnButtonEnabledSet        : bool   = false
      var repawnButtonLabelSet            : string = ""
      var isRepawnButtonVisibleSet        : bool   = false
      
      
      if (is_early_respawn_enabled)         
         if (is_early_respawn_requested)            
            if (is_auto_respawn_countdown)
               // wait for auto respawn after request
               isRepawnButtonEnabledSet   := false
               isRepawnButtonVisibleSet   := true
               repawnButtonLabelSet       := "ingame_respawn_requested"
               respawnTimerTxtSet         := "ingame_auto_respawn_timer," + (string)(GetRespawnTimer())
            end
         else
            if (is_auto_respawn_countdown)
               // respawn now
               isRepawnButtonEnabledSet   := true
               isRepawnButtonVisibleSet   := true
               repawnButtonLabelSet       := "ingame_respawn_label_respawn_now"
               respawnTimerTxtSet         := ""
            else
               // do early request
               isRepawnButtonEnabledSet   := true
               isRepawnButtonVisibleSet   := true
               repawnButtonLabelSet       := "ingame_respawn_request"
               respawnTimerTxtSet         := "ingame_respawn_available_timer," + (string)(GetRespawnTimer())
            end
         end
      else
         if (is_auto_respawn_countdown)
            // wait auto respawn
            isRepawnButtonEnabledSet   := false
            isRepawnButtonVisibleSet   := is_auto_respawn_countdown
            if (is_auto_respawn_countdown)
               repawnButtonLabelSet    := "ingame_respawn_requested"
               respawnTimerTxtSet      := "ingame_auto_respawn_timer," + (string)(GetRespawnTimer())
            end
         end
      end
      isRepawnButtonEnabledSet := isRepawnButtonEnabledSet and (bool)isRespawnPanelVisible.Get()
            
      isRespawnTimerVisible.Set(respawnTimerTxtSet != "")
      respawnTimerTxt.Set(respawnTimerTxtSet)
      isRepawnButtonEnabled.Set(isRepawnButtonEnabledSet)
      isRepawnButtonVisible.Set(isRepawnButtonVisibleSet)
      repawnButtonLabel.Set(repawnButtonLabelSet)  
   end

   func respawnNowClick(p : params) : bool
      if ((bool)isRepawnButtonEnabled.Get() and (bool)isRepawnButtonVisible.Get())
         $UiIngame.EarlyRespawnRequest()
      end
      return true
   end

   func GetRespawnTimer() : int
      var timeCur : int = (int)$UiIngame.state_timer.Get()
      return timeCur
   end   
end