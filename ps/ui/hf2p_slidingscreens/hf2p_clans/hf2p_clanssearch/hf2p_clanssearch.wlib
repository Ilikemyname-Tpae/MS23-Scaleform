classes   =   {
   ClansSearchCont   =   {
      sslClass   =   "UiClansSearch"
      sslModule   =   "ui.hf2p_SlidingScreens.hf2p_Clans.hf2p_ClansSearch.hf2p_ClansSearch"
      x   =   -326.5
      y   =   -270.5
      elements   =   {
         membersHeader   =   {
            bindings   =   {
               textField   =   {
                  binding   =   "{'carousel_clan_search_members'}"
               }
            }
            __type   =   "ui_widget_container"
         }
         statisticsHeader   =   {
            bindings   =   {
               textField   =   {
                  binding   =   "{'carousel_clan_search_stats'}"
               }
            }
            __type   =   "ui_widget_container"
         }
         searchHeader   =   {
            bindings   =   {
               textField   =   {
                  binding   =   "{'carousel_clan_search_header'}"
               }
            }
            __type   =   "ui_widget_container"
         }
         searchBar   =   {
            sslClass   =   "UiClansSearchInputTf"
            sslModule   =   "ui.hf2p_SlidingScreens.hf2p_Clans.hf2p_ClansSearch.hf2p_ClansSearch"
            handlers   =   {
               ClanSearchComplete   =   {
                  handlerName   =   "#OnClanSearchComplete"
               }
            }
            bindings   =   {
               defaultText   =   {
                  binding   =   "{'carousel_clan_search_text'}"
               }
               maxChars   =   {
                  binding   =   "{50}"
               }
            }
            __type   =   "ui_clans_lib::searchTextCont"
         }
         membersList   =   {
            bindings   =   {
               items   =   {
                  binding   =   "{GetSelectedClanMemberList() ?? new[]}"
               }
            }
            lir   =   {
               bindings   =   {
                  DC   =   {
                     binding   =   "{new: 'ui.hf2p_RosterDocker.hf2p_rosterDocker.UiRosterPlayerLirVM', uid = (:DC2).user_id}"
                  }
               }
               __type   =   "hf2p_rosterDocker::PlayerLIR"
            }
            __type   =   "ui_clans_lib::hf2p_topContributors"
         }
         searchResult   =   {
            events   =   {
               indexChange   =   {
                  eventRemap   =   "#OnSearchResultIndexChanged"
               }
            }
            bindings   =   {
               items   =   {
                  binding   =   "{SearchResult ?? new []}"
               }
            }
            lir   =   {
               __type   =   "hf2p_ClansSearch::SearchResultLIR"
            }
            __type   =   "ui_clans_lib::hf2p_searchList"
         }
         header   =   {
            x   =   321
            y   =   303
            bindings   =   {
               textField   =   {
                  binding   =   "{'carousel_clan_search'}"
               }
            }
            __type   =   "ui_weaponConf_lib_slide::headerBig_S"
         }
      }
      stateMap   =   {
         startState   =   "Initial"
         states   =   {
            Initial   =   {
            }
            Visible   =   {
            }
            Hidden   =   {
            }
         }
      }
      bindings   =   {
         DC   =   {
            binding   =   "{new:'ui.hf2p_SlidingScreens.hf2p_Clans.hf2p_ClansSearch.hf2p_ClansSearch.ClansSearchVM'}"
         }
      }
      __type   =   "ui_clans_lib::ClansSearchCont"
   }
   SearchResultLIR   =   {
      elements   =   {
         greyOverInst   =   {
            visible   =   False
            __type   =   "ui_widget_container"
         }
         textFieldUp   =   {
            impl   =   {
               propMapping   =   {
                  textFieldUp   =   {
                     isNoTranslate   =   True
                  }
               }
               __type   =   "ui_widget_impl_gfx"
            }
            bindings   =   {
               textFieldUp   =   {
                  binding   =   "{GetClanName()}"
               }
            }
            __type   =   "ui_clans_lib::weaponNameTextCont"
         }
         attachContainerContainer   =   {
            bindings   =   {
               pic   =   {
                  binding   =   "{'unicornEmblem'}"
               }
            }
            __type   =   "ui_clans_lib::attachContainerContainer"
         }
      }
      bindings   =   {
         DC   =   {
            binding   =   "{new: 'ui.hf2p_SlidingScreens.hf2p_Clans.hf2p_ClansSearch.hf2p_ClansSearch.ClanSearchResultItemVM', clan_id= (:DC2)}"
         }
      }
      __type   =   "ui_clans_lib::hf2p_EmblemListLIR_S"
   }
}
__type   =   "ui_wlib"
