class ScannerNearestAI
   native func SetSearchParams      (actor : object, radius : float, team : string = "all", searchSphere : bool = false, alive : bool = true)
   native func FindNearestAI        ()
   native func OnFoundedNearestAI   (f : refFUNC_PTR)
end

class ScannerAI
   native func SetDistEnter(dist : float)
   native func SetDistLeave(dist : float)
