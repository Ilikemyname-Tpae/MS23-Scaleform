                        }
                        __type   =   "ui_widget_text"
                     }
                  }
                  impl   =   {
                     propMapping   =   {
                        htmlText   =   {
                           mapping   =   "htmlText"
                           isNoTranslate   =   True
                        }
                        maxScroll   =   {
                           mapping   =   "textField.maxScrollV"
