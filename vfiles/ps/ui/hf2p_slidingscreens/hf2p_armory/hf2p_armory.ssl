func equipMsgBox(p : params)
   Log("ui~armory", "equipMsgBox")
   var itemName      : string = (string)((GL_ComponentUI)$UiGlobals.componentsUI.Get(p.armorId)).name.Get()
   var   pp          : params
   pp.txtTrans       := false
   pp.isSkip         := true
   pp.itemID         := p.armorId   
   pp.messageTxt     := itemName
   pp.callbackEvent  := "onEquipMsgBoxClosed"
   pp.mbType         := "AssignInfo"
   pp.titleTxt       := "msg_ui_assigned"
   pp.closeTimeout   := 2 
   GenerateEvent("MainMenuDialogRequest", pp)
end

func onEquipMsgBoxClosed() : bool
   Log("ui~armory", "onEquipMsgBoxClosed")
   return false 
end

func equipItem(p : params)
   var armorId   : string = p.armorId
   var armorType : string = p.armorType
   var shopComp : GL_ComponentShop = (GL_ComponentShop)$UiGlobals.componentsShop.Get(armorId)
   
   $uiPlayerInfo.AssignItem2Loadout($UserDataStorage.users.Get($UserDataStorage.local_user.uid.Get()).armor_loadouts.spartan.active_loadout_index.Get(), armorId)   
end

