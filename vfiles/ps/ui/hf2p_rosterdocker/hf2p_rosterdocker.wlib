classes   =   {
   rosterDocker   =   {
      sslClass   =   "UiRosterDocker"
      sslModule   =   "ui.hf2p_RosterDocker.hf2p_rosterDocker"
      handlers   =   {
         closeRosterDockerAsNiceAsYouCan   =   {
            handlerName   =   "OnCloseRosterDockerAsNiceAsYouCan"
         }
         closeRosterDocker   =   {
            handlerName   =   "OnCloseRosterDocker"
         }
         openRosterDocker   =   {
            handlerName   =   "OnOpenRosterDocker"
         }
         openRosterDockerOver   =   {
            handlerName   =   "OnOpenRosterDockerOver"
         }
         SwitchPartyConfirmed   =   {
            handlerName   =   "#OnSwitchPartyConfirmed"
         }
         PartyInviteAccept   =   {
            handlerName   =   "#OnPartyInviteAccept"
         }
         unfollowConfirmClosed   =   {
            handlerName   =   "#OnUnfollowConfirmClosed"
         }
      }
      elements   =   {
         content   =   {
            elements   =   {
               rosterMaskBg   =   {
                  isBlink0Alpha   =   False
                  layer   =   "layer1"
                  __type   =   "ui_activity_lib::rosterMaskBg"
               }
               closeBtn   =   {
                  y   =   769
                  fixed   =   False
                  events   =   {
                     buttonClick   =   {
                        eventRemap   =   "#OnCloseDockerClicked"
                     }
                  }
                  bindings   =   {
                     label   =   {
                        binding   =   "{'main_btn_close'}"
                     }
                     textField2   =   {
                        binding   =   "{'<~'}"
                     }
                  }
                  layer   =   "layer3"
                  __type   =   "ui_activity_lib::Friends_CloseBtn"
               }
               notificationList   =   {
                  bindings   =   {
                     visible   =   {
                        binding   =   "{isNotificationsVisible}"
                     }
                  }
                  lir   =   {
                     elements   =   {
                        levelUPcontainer   =   {
                           bindings   =   {
                              lvlValue   =   {
                                 binding   =   "{'' + lvlVal}"
                              }
                           }
                           __type   =   "ui_widget_container"
                        }
                     }
                     __type   =   "hf2p_rosterDocker::NotificationLIR"
                  }
                  scrollbar   =   {
                     __type   =   "hf2p_WeaponList_lib::wc_ItemsListScrollBarNew"
                  }
                  __type   =   "hf2p_rosterDocker::NotificationsList"
               }
               playersList   =   {
                  bindings   =   {
                     visible   =   {
                        binding   =   "{isPlayersVisible}"
                     }
                  }
                  scrollbar   =   {
                     __type   =   "hf2p_WeaponList_lib::wc_ItemsListScrollBarNew"
                  }
                  __type   =   "hf2p_rosterDocker::PlayersList"
               }
               waitingInfo   =   {
                  x   =   71
                  y   =   79
                  fixed   =   False
                  bindings   =   {
                     visible   =   {
                        binding   =   "{GetIsWaiting()}"
                     }
                  }
                  __type   =   "ui_activity_lib::rotatingWaitingCombined"
               }
               searchModule   =   {
                  y   =   74
                  isNoTranslate   =   True
                  isBlinkable   =   True
                  fixed   =   False
                  propMapping   =   {
                     errField   =   {
                        isNoTranslate   =   True
                     }
                     searchTf   =   {
                        isNoTranslate   =   True
                     }
                  }
                  elements   =   {
                     searchInputTf   =   {
                        sslClass   =   "UiRosterDockerSearchField"
                        sslModule   =   "ui.hf2p_RosterDocker.hf2p_rosterDocker"
                        isNoTranslate   =   True
                        bindings   =   {
                           editable   =   {
                              binding   =   "{true}"
                           }
                           defaultText   =   {
                              binding   =   "{GetDefaultInputText()}"
                           }
                           enabled   =   {
                              binding   =   "{GetIsInputEnabled()}"
                           }
                           focusable   =   {
                              binding   =   "{true}"
                           }
                           actAsButton   =   {
                              binding   =   "{true}"
                           }
                           maxChars   =   {
                              binding   =   "{32}"
                           }
                        }
                        __type   =   "ui_activity_lib::RosterDockerSearchText"
                     }
                     errField   =   {
                        sslClass   =   "UiRosterDockerSearchField"
                        sslModule   =   "ui.hf2p_RosterDocker.hf2p_rosterDocker"
                        bindings   =   {
                           visible   =   {
                              binding   =   "{GetIsSearchErr()}"
                           }
                           text   =   {
                              binding   =   "{searchErr}"
                           }
                        }
                        __type   =   "ui_widget_text"
                     }
                  }
                  bindings   =   {
                     visible   =   {
                        binding   =   "{GetIsSearchModuleVisible()}"
                     }
                  }
                  layer   =   "layer2"
                  __type   =   "ui_activity_lib::SearchModule"
               }
            }
            layers   =   {
               layer1   =   {
                  offset   =   1
               }
               layer2   =   {
                  offset   =   2
               }
               layer3   =   {
                  offset   =   3
               }
            }
            __type   =   "ui_rosterList_lib::rostContent"
         }
      }
      stateMap   =   {
         startState   =   "Initial"
         states   =   {
            Initial   =   {
               transitionsIn   =   {
                  Visible   =   {
                     action   =   {
                        anim   =   "fadeOut"
                        __type   =   "ui_widget_action_anim"
                     }
                  }
                  VisibleForce   =   {
                     action   =   {
                        anim   =   "fadeOut"
                        __type   =   "ui_widget_action_anim"
                     }
                  }
               }
            }
            Visible   =   {
               transitionsIn   =   {
                  any   =   {
                     action   =   {
                        anim   =   "fadeIn"
                        __type   =   "ui_widget_action_anim"
                     }
                  }
               }
            }
            InitialForce   =   {
               transitionsIn   =   {
                  Visible   =   {
                     action   =   {
                        anim   =   "fadeOut"
                        __type   =   "ui_widget_action_anim"
                     }
                  }
                  VisibleForce   =   {
                     action   =   {
                        anim   =   "fadeOut"
                        __type   =   "ui_widget_action_anim"
                     }
                  }
               }
            }
            VisibleForce   =   {
               transitionsIn   =   {
                  any   =   {
                     action   =   {
                        anim   =   "fadeIn"
                        __type   =   "ui_widget_action_anim"
                     }
                  }
               }
            }
         }
      }
      bindings   =   {
         DC   =   {
            binding   =   "{dockerVM}"
         }
      }
      __type   =   "ui_rosterList_lib::RosterDockerContainer"
   }
   NotificationLIR   =   {
      sslClass   =   "UiNotificationsLir"
      sslModule   =   "ui.hf2p_RosterDocker.hf2p_rosterDocker"
      isBlinkable   =   True
      fixed   =   False
      elements   =   {
         levelUPcontainer   =   {
            bindings   =   {
               visible   =   {
                  binding   =   "{isLvlCont}"
               }
               lvlValue   =   {
                  binding   =   "{lvlVal}"
               }
               lvltf   =   {
                  binding   =   "{lvlName}"
               }
            }
            __type   =   "ui_widget_container"
         }
         itemAttach   =   {
            bindings   =   {
               visible   =   {
                  binding   =   "{isIcon}"
               }
               pic   =   {
                  binding   =   "{iconPic}"
               }
            }
            __type   =   "ui_rosterList_lib::notifications_attach_BG"
         }
         tfHeader   =   {
            bindings   =   {
               testText   =   {
                  binding   =   "{tfHeader}"
               }
               visible   =   {
                  binding   =   "{isTfHeader}"
               }
            }
            __type   =   "ui_rosterList_lib::NotificationTextHeader"
         }
         tfName   =   {
            bindings   =   {
               itemNameTf   =   {
                  binding   =   "{tfName}"
               }
               visible   =   {
                  binding   =   "{isTfName}"
               }
            }
            __type   =   "ui_rosterList_lib::NotificationTextName"
         }
         tfDesc   =   {
            bindings   =   {
               testText   =   {
                  binding   =   "{tfDesc}"
               }
               visible   =   {
                  binding   =   "{isTfDesc}"
               }
            }
            __type   =   "ui_rosterList_lib::NotificationTextBody"
         }
         singleBtn   =   {
            events   =   {
               buttonClick   =   {
                  eventRemap   =   "onAcceptClicked"
               }
            }
            elements   =   {
               tf   =   {
                  bindings   =   {
                     testText   =   {
                        binding   =   "{okLBL}"
                     }
                  }
                  __type   =   "ui_rosterList_lib::NotifInsideBtnTFCont"
               }
            }
            bindings   =   {
               visible   =   {
                  binding   =   "{isSingleBtn}"
               }
            }
            __type   =   "ui_rosterList_lib::NotificationLIR_BigButton"
         }
         cancelBtn   =   {
            events   =   {
               buttonClick   =   {
                  eventRemap   =   "onCancelClicked"
               }
            }
            elements   =   {
               tf   =   {
                  bindings   =   {
                     testText   =   {
                        binding   =   "{cancelLBL}"
                     }
                  }
                  __type   =   "ui_rosterList_lib::NotifInsideBtnTFCont"
               }
            }
            bindings   =   {
               visible   =   {
                  binding   =   "{!isSingleBtn and hasCancel}"
               }
            }
            __type   =   "ui_rosterList_lib::NotificationLIR_CancelBtn"
         }
         acceptBtn   =   {
            events   =   {
               buttonClick   =   {
                  eventRemap   =   "onAcceptClicked"
               }
            }
            elements   =   {
               tf   =   {
                  bindings   =   {
                     testText   =   {
                        binding   =   "{okLBL}"
                     }
                  }
                  __type   =   "ui_rosterList_lib::NotifInsideBtnTFCont"
               }
            }
            bindings   =   {
               visible   =   {
                  binding   =   "{!isSingleBtn and hasOK}"
               }
            }
            __type   =   "ui_rosterList_lib::NotificationLIR_AcceptBtn"
         }
         themeBG   =   {
            bindings   =   {
               visible   =   {
                  binding   =   "{isBg}"
               }
               pic   =   {
                  binding   =   "{bgPic}"
               }
            }
            __type   =   "ui_rosterList_lib::notifications_attach_BG"
         }
         itemQualityCont   =   {
            bindings   =   {
               anim   =   {
                  binding   =   "{itemQ}"
               }
            }
            __type   =   "ui_widget_container"
         }
      }
      bindings   =   {
         mouseChildren   =   {
            binding   =   "{true}"
         }
      }
      __type   =   "ui_rosterList_lib::NotificationLIR"
   }
   NotificationsList   =   {
