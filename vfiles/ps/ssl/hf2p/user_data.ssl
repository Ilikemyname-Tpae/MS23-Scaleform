/***************************************************************
* UD_Challenge
*
***************************************************************/   
class UD_Challenge : UiSslBindableBase
   var id         : ObservableProperty = null

   var progress   : ObservableProperty = null

   var counters   : ObservableProperty = null
   
   //ssl-extensions
   func IsCompleted() : bool
      var progressVal   : float  = (float)progress.Get()
      var ret           : bool   = progressVal >= 1.0
      return ret
   end   
   
   func GetCountersCount() : int
      var countersVec : vector = counters.Get()
      return countersVec.Count()
   end
   
   func GetCounter(_idx : int) : UD_ChallengeCounter
      var ret           : UD_ChallengeCounter   = null
      var countersVec   : vector                = counters.Get()
      if (_idx >= 0 and _idx < countersVec.Count())
         ret := countersVec.Get(_idx)
      end
      return ret
   end
end

