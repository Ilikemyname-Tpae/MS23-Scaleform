/*************************************************************
* UiChat
* 
*************************************************************/
class UiChat : UiWidgetContainer
   func FocusInputText()
      Widgets().inputCont.inputTf.SetFocus()
   end
   
   func ClearInputText()
      Widgets().inputCont.inputTf.text := ""
   end
   
   func TweenChatSize(updType:string)
      GetDC().TweenChatSize(updType)
   end
   
   func CustomSet(propName : string, propVal : *) : bool
      if (propName == "tabsData")
         GetDC().SetTabsData(propVal)
         return true
      end
      return false
   end
   
   func focusIn(p : params) : bool
      if (! IsVoid(p.toWidget))
         var toWidget : UiWidget = p.toWidget
         if (toWidget.IsChildOf(this))
            //GetDC().FocusReceived()
         end
      end
      return false
   end
   
   func focusOut(p : params) : bool
      if (! IsVoid(p.toWidget))
         var toWidget   : UiWidget = p.toWidget
         if (! toWidget.IsChildOf(this))
            //GetDC().FocusLost()            
         end
      else
         //GetDC().FocusLost()
      end
      return false
   end
   
   func ProcessMouseDown(target : UiWidget)      
      var chatExpand = (UiWidget)(Widgets().expandBtn.object)
      var chatTabs   = (UiWidget)(Widgets().tabsCont.object)
      if (target.IsChildOf(this))
         if (!target.IsChildOf(chatExpand) and !target.IsChildOf(chatTabs))
            ClickedInside()
         end
      else
         ClickedOutside()
      end      
   end
   
   func ClickedInside()
      GetDC().FocusReceived()
   end
   
   func ClickedOutside()
      GetDC().FocusLost()      
   end   
end

/*************************************************************
* UiTabVM
* 
*************************************************************/
class UiTabVM
   var tabIdx           : int = 0
   var data             : ObservableProperty = $OM.Property("")
   var isSelected       : ObservableProperty = $OM.Property(false)
   
   func OnTabSelected()
      
   end
   
   func OnTabOut()
   end
end

/*************************************************************
* UiTabsVM
* 
*************************************************************/
class UiTabsVM
   var items         : vector
   var selectedTab   : ObservableProperty = $OM.Property(0)
   
   func GetMaxTabs() : int
      return 0
   end
   
   func GetDefaultEntry() : *
      var ret : params
      return ret
   end
   
   func GetTabs() : vector
      var ret : vector
      return ret
   end
   
   func SetItems(_items : vector)
      items :=_items
      ArrangeTabs()
   end
   
   func Refresh()
      var tabs          : vector = GetTabs()
      if (tabs.Count() > 0)
         var selectedIdx : int = GetSelectedTabIdx()
         if (selectedIdx >= tabs.Count())
            selectedIdx := tabs.Count() - 1
         elif (selectedIdx < 0)
            selectedIdx := 0
         end
         SetSelectedTabIdx(selectedIdx)
      end
   end
   
   func SetSelectedTabIdx(_tabIdx : int)
      selectedTab.Set(_tabIdx)
      var tabs : vector = GetTabs()
      var i    : int
      for i := 0 to tabs.Count() - 1
         var tab : UiTabVM = (UiTabVM)tabs.Get(i)
         if (_tabIdx == i)
            tab.OnTabSelected()
         else
            tab.OnTabOut()
         end
         tab.isSelected.Set(_tabIdx == i)
      end
   end
   
   func GetSelectedTabIdx() : int
      return (int)selectedTab.Get()
   end
   
   func GetSelectedTab() : UiTabVM
      var selectedIdx : int = GetSelectedTabIdx()
      var ret : UiTabVM = GetTabs().Get(selectedIdx)
      return ret
   end
   
   func GetSelectedTabData() : ObservableProperty
      var selectedIdx : int = GetSelectedTabIdx()
      var ret : UiTabVM = GetTabs().Get(selectedIdx)
      return ret.data
   end
   
   func ArrangeTabs()
      
   end
      
   func GetItems() : vector
      return items
   end
   
   func GetTabsCount() : int
      var ret : int = GetTabs().Count()
      return ret
   end
         
   func TabClicked(p : params) : bool
      var tab : UiTabVM = p.widget.GetWidget("_parent").GetDC()
      SetSelectedTabIdx(tab.tabIdx)
      return true
   end
end

/*************************************************************
* UiChatTabVMData
* 
*************************************************************/
class UiChatTabVMData
   var idx        : int       = 0
   var channel    : int       = 1
   var name       : wstring   = ""
   var privateUid : *         = $UserDataStorage.GetInvalidUID()
end

/*************************************************************
* UiChatTabVM
* 
*************************************************************/
class UiChatTabVM : UiTabVM
   var xoffset          :  ObservableProperty   = $OM.Property(0.0)
   var isValidTab       :  ObservableProperty   = $OM.Property(false)
   var tabWidth         :  ObservableProperty   = $OM.Property(100.0)
   var tabOffset        :  ObservableProperty   = $OM.Property(0.0)
   var notifOffset      :  ObservableProperty   = $OM.Property(0.0)
   var tabScale         :  ObservableProperty   = $OM.Property(1.0)
   var tabScaleInv      :  ObservableProperty   = $OM.Property(1.0)
   var isNewMessages    :  ObservableProperty   = $OM.Calculated(this, "GetIsNewMessages")
   var newMessagesCount :  ObservableProperty   = $OM.Calculated(this, "GetNewMessagesCountStr")
            
   func SetTabData(_data : *)
      data.Set(_data)
   end
   
   func GetChatData() : UiChatTabVMData
      return (UiChatTabVMData)data.Get()
   end
   
   func GetMessageStream() : GL_ChatStream
      var channel : int             = GetChatData().channel      
      var ret     : GL_ChatStream   = null
      if (channel == $uiEnums.CHAT_CHANNEL_ALL)
         ret := $UiGlobals.chat.general
      elif (channel == $uiEnums.CHAT_CHANNEL_PARTY)
         ret := $UiGlobals.chat.party
      elif (channel == $uiEnums.CHAT_CHANNEL_GAME_ALL)
         ret := $UiGlobals.chat.game_all_channel
      elif (channel == $uiEnums.CHAT_CHANNEL_PRIVATE)
         ret := $UiGlobals.chat.private_channel
      end
      return ret      
   end
   
   func GetChannelMessages() : vector
      var stream  : GL_ChatStream = GetMessageStream()
      var ret     : vector
      if (stream != null)
         ret := GetMessageStream().GetMessages()
      end
      return ret      
   end
   
   func GetCurrentMessagesCount() : int
      var ret : int = GetChannelMessages().Count()
      return ret
   end
   
   func GetIsNewMessages() : bool
      var ret : bool = !(bool)isSelected.Get() and GetNewMessagesCount() > 0
      return ret
   end
   
   override OnTabSelected//()
      UpdateTimestamp()
   end
   
   func GetLastViewTime() : *
      var stream  : GL_ChatStream   = GetMessageStream()
      var ret     : *               = $UiGlobals.IntToInt64(0)
      if (stream != null)
         ret := GetMessageStream().GetLastViewTime()
      end
      return ret
   end
      
   func UpdateTimestamp()
      var stream  : GL_ChatStream   = GetMessageStream()
      if (stream != null)
         GetMessageStream().UpdateLastViewTime()
         newMessagesCount.Invalidate()
      end
   end
   
   override OnTabOut//()
      if ((bool)isSelected.Get())
         UpdateTimestamp()
      end
   end
   
   func GetNewMessagesCount() : int
      var mes        : GL_ChatStreamMessage  = null
      var messages   : vector                = GetChannelMessages()
      var ret        : int                   = 0
      var i          : int
      var curCount   : int                   = GetCurrentMessagesCount() // subscribe to messsageCount
      
      for i := 0 to messages.Count() - 1
         mes := messages.Get(i)
         if ($UiGlobals.CmpInt64(GetLastViewTime(), mes.timestamp.Get()) < 0)
            ret := ret + 1
         end
      end
      return ret
   end      
   
   func GetNewMessagesCountStr() : string
      var ret : string  = (string)GetNewMessagesCount()
      return ret
   end      
end


/*************************************************************
* UiChatTabsVM
* 
*************************************************************/
class UiChatTabsVM : UiTabsVM
   var tabs             : vector
   var validTabsCount   : int = 0
   var totalWidth       : int = 730
   var offsets          : vector
   
   override GetMaxTabs//() : int
      return 10
   end
   
   override GetDefaultEntry//() : *
      var tabData :  UiChatTabVMData = null
      tabData           := new UiChatTabVMData()
      tabData.idx       := -1
      tabData.name      := ""
      tabData.channel   := -1
      return tabData
   end
   
   override GetTabs//() : vector      
      var ret : vector = tabs
      if (ret.Count() == 0)
         var i : int
         for i := 0 to GetMaxTabs() - 1
            var tab : UiChatTabVM = new UiChatTabVM()
            tab.tabIdx := i
            ret.Push(tab)
         end
      end
      return ret
   end
   
   func GetOffsets() : vector 
      var ret : vector = offsets
      if (ret.Count() == 0)
         var i : int
         
      end
      return ret      
   end
   
   override ArrangeTabs//()
      var i          : int
      var validTabs  : int = 0
      for i := 0 to GetMaxTabs() - 1
         var tab : UiChatTabVM = GetTab(i)
         if ((bool)tab.isValidTab.Get())
            validTabs := validTabs + 1
         end
      end  
      if (validTabs > 0)
         var tabWidth   : float  = (float)totalWidth / (float)validTabs 
         var tabIdx     : int    = 0
         for i := 0 to GetMaxTabs() - 1
            var tab : UiChatTabVM = GetTab(i)
            if ((bool)tab.isValidTab.Get())
               var baseWidth : float = 70.0
               if (i > 0 and i <= 2)
                  baseWidth := 71.0
               elif (i == 0 or i == (GetMaxTabs() - 1))
                  baseWidth := 85.0
               end
               tab.tabWidth.Set     (tabWidth)
               tab.tabScale.Set     (tabWidth / baseWidth)
               tab.tabScaleInv.Set  (1.0 / (float)tab.tabScale.Get())
               tab.tabOffset.Set    (tabIdx * tabWidth)
               tab.notifOffset.Set  (tabWidth - 32)
               tabIdx            := tabIdx + 1
            end
         end           
      end
   end
   
   func GetTab(_idx : int) : UiChatTabVM
      return GetTabs().Get(_idx)
   end
   
   func SetTabData(_idx : int, _data : *, _isValid : bool)
      GetTab(_idx).SetTabData(_data)
      GetTab(_idx).isValidTab.Set(_isValid)
   end
   
   override SetItems//(_items : vector)
      items.Clear()
      var i : int
      for i := 0 to GetMaxTabs() - 1
         var dataIdx : int = -1
         if (i == (GetMaxTabs() - 1))
            if (_items.Count() > 1)
               dataIdx := _items.Count() - 1
            end
         else
            if (i < _items.Count() - 1)
               dataIdx := i
            end
         end         
         if (dataIdx == -1)
            SetTabData(i, GetDefaultEntry(), false)
         else
            SetTabData(i, _items.Get(dataIdx), true)
         end
      end      
      ArrangeTabs()
   end
end


/*************************************************************
* UiChatVM
* 
*************************************************************/
class UiChatVM
   var tabs                   : UiChatTabsVM       = new UiChatTabsVM()
   var wgt                    : UiChat             = null
   var privateMessagesTarget  : ObservableProperty = $OM.Property($UiGlobals.GetInvalidUIDVal())
   var isMembersPanelEnabled  : ObservableProperty = $OM.Property(true)
   var isCollapsed            : ObservableProperty = $OM.Property(true)
   var isPlayerCardVisible    : ObservableProperty = $OM.Property(false)
   var chatSizeDiff           : ObservableProperty = $OM.Property((float)0)
   var chatSizeDiffDelayed    : ObservableProperty = $OM.Property((float)0)
   var rosterCard             : RosterCardVM       = new RosterCardVM()
   var playerUID              : GL_UID             = $UserDataStorage.NewEmptyUID()
   var chatDragStart          : float              = 0
   var userContext            : UserContextMenu    = new UserContextMenu()
   var chatStyleSheet         : UiSSMainChat       = new UiSSMainChat()
   var fullSize               : float              = 500
   
   func Init(p : params)
      wgt := p.widget
      tabs.selectedTab.Subscribe(this, "OnTabChange")
   end
   
   func Term()
      tabs.selectedTab.Unsubscribe(this, "OnTabChange")
   end
   
   func OnTabChange(_val : *)
      FocusReceived()
      if (! CanSendMessage())
         wgt.ClearInputText()
      end
   end
      
   func SetTabsData(tabsData : vector)
      tabs.SetItems(tabsData)
      tabs.Refresh()
   end
   
   func IsInParty() : bool
      var partyVec   : vector = $UiGlobals.party.members.Get()
      var ret        : bool   = partyVec.Count() > 1
      return ret
   end
      
   func IsInLobby() : bool
      var partyState : int    = (int)$UiGlobals.party.state.Get()
      var ret        : bool   = partyState == $uiEnums.PARTY_STATE_IN_GAME
      return ret
   end

   func GetTabsData() : vector
      var p    : params
      var vec  : vector
      
      var tabData : UiChatTabVMData = null
      
      tabData           := new UiChatTabVMData()
      tabData.idx       := vec.Count()
      tabData.name      := $UiGlobals.String2WString("main_chat_channel_news")
      tabData.channel   := $uiEnums.CHAT_CHANNEL_NEWS
      vec.Push(tabData)

      tabData           := new UiChatTabVMData()
      tabData.idx       := vec.Count()
      tabData.name      := $UiGlobals.String2WString("main_chat_channel_general")
      tabData.channel   := $uiEnums.CHAT_CHANNEL_ALL
      vec.Push(tabData)
      
      if (IsInParty())
         tabData           := new UiChatTabVMData()
         tabData.idx       := vec.Count()
         tabData.name      := $UiGlobals.String2WString("main_chat_channel_party")
         tabData.channel   := $uiEnums.CHAT_CHANNEL_PARTY
         vec.Push(tabData)
      end
      
      if (IsInLobby())
         tabData           := new UiChatTabVMData()
         tabData.idx       := vec.Count()
         tabData.name      := $UiGlobals.String2WString("main_chat_channel_lobby")
         tabData.channel   := $uiEnums.CHAT_CHANNEL_GAME_ALL
         vec.Push(tabData)
      end
      
      var ud : UserData = $UserDataStorage.GetLocalUserData()
      if ((bool)ud.has_base.Get())
         if (! $UiGlobals.IsZeroInt64(ud.base.clan_id.Get()))
            tabData           := new UiChatTabVMData()
            tabData.idx       := vec.Count()
            tabData.name      := $UiGlobals.String2WString("main_chat_channel_clan")
            tabData.channel   := $uiEnums.CHAT_CHANNEL_CLAN
            vec.Push(tabData)         
         end
      else
         $user_service.RequestData($UserDataStorage.local_user.uid.Get(), $uiEnums.USER_DATA_BASE)
      end     
      
      if (CanSendPrivate())
         tabData           := new UiChatTabVMData()
         tabData.idx       := vec.Count()
         tabData.name      := $UiGlobals.String2WString("main_chat_channel_private")
         tabData.channel   := $uiEnums.CHAT_CHANNEL_PRIVATE
         vec.Push(tabData)      
      end
      
      return vec
   end
      
   func UiChatVM()
   end
   
   func IsNewsVisible() : bool
      var selectedChannel : int = GetSelectedChannel()
      return selectedChannel == $uiEnums.CHAT_CHANNEL_NEWS
   end
   
   func IsMembersVisible() : bool
      var selectedChannel  : int    = GetSelectedChannel()
      var ret              : bool   = (bool)isMembersPanelEnabled.Get() and ! GetIsCollapsed() and selectedChannel != $uiEnums.CHAT_CHANNEL_NEWS
      return ret
   end
      
   func GetMembersPanelState() : string
      var isMembersVisible : bool   = IsMembersVisible()
      var ret              : string = "Hidden"
      if (isMembersVisible)
         ret := "Visible"
      end
      return ret
   end
   
   func IsMessagesVisible() : bool
      var selectedChannel : int = GetSelectedChannel()
      return selectedChannel != $uiEnums.CHAT_CHANNEL_NEWS
   end
      
   func GetMessagesPanelState() : string
      var isMembersVisible : bool   = IsMembersVisible()
      var ret              : string = "Small"
      if (! isMembersVisible)
         ret := "Full"
      end
      return ret
   end
   
   var testIdx : int = 0
   func ToggleMembers(p : params) : bool      
      isMembersPanelEnabled.Set(!(bool)isMembersPanelEnabled.Get())
      //isMembersPanelEnabled.Set(true)
      //testIdx := testIdx + 1
      
      //wgt.Widgets().testText.htmlText := "LINK test " + (string)testIdx + ": <a href=\"event:LNK1\"><font color=\"#FF0000\">LINK1</font></a>, <a href=\"event:LNK2\"><font color=\"#00FF00\">LINK2</font></a>"
      
      //wgt.Widgets().listMembers.txtArea.htmlText := GetMembersTxt()
      //wgt.Widgets().listMembers.txtAreaCont.htmlText := GetMembersTxt()
      //wgt.Widgets().listMembers.txtAreaCont.txtArea.scrollBar := "DefaultScrollBarSkinned"
      //wgt.Widgets().testText.htmlText := "LINK test " + (string)testIdx + ": <font color=\"#FF0000\">LINK1</font>, <font color=\"#00FF00\">LINK2</font>"
      //					htmlText   =   {
	//					binding   =   "{'LINK test: <a href='event:LNK1'><font color='#FF0000'>LINK1</font></a>, <a href='event:LNK2'><font color='#00FF0000'>LINK2</font></a>'}"
		//			}

