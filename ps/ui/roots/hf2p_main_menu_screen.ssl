func OnMouseDown(p : params) : bool
   var target : UiWidget = p.target
   var rankPanel = (UiWidget)GetWidget("rankPanel")
   var rosterDocker = (UiWidget)rankPanel.GetWidget("rosterDocker")
   var rosterDockerState = rosterDocker.GetStateName()
   var contextMenu = (UiWidget)GetWidget("contextMenu")
   var messageBox = (UiWidget)GetWidget("messageBox")
   
   if (contextMenu != null)
      if (target.IsChildOf(contextMenu))
         return true
      end
   end
   if !target.IsChildOf(rankPanel) and !target.IsChildOf(messageBox) and (rosterDockerState == "Visible" or rosterDockerState == "VisibleForce")
      rankPanel.GenerateEvent("onRankPanelRosterClick")
   end
      
   var chatPanel  = (UiChat)(Widgets().lowerPanel.chatCont.object)
   chatPanel.ProcessMouseDown(target)
   
   return true
end

