func StartRematch() 
   if (! $root.GetIsDisconnect())
      Log("ui~hf2p_main_menu", "MAINMENU::StartRematch")
      isRematch         := true
      isRematchScreens  := true
      if (! $uiPartyMonitor.GetIsLeavedGame()) 
         $uiMatchmaking.SetIsRematch()
      end
      EnableGiftShop()
      SetStateName("Postgame")
   end
end

