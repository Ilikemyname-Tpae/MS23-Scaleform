import ssl.lib.types
import ssl.lib.ui.ui_widget_container
import ssl.lib.ui.ui_widget_list_item
import ssl.observables
import ssl.hf2p.ui_globals
import ssl.hf2p.user_data

class UiDefListLIR : UiWidgetListItem

override SetData
   var text : string
   if (! IsVoid(p.text)) 
      text := p.text
   end
   Props.label := text
end
end

class DefaultContextMenuItemVM
   var wgt : UiWidget = null
   var VisibleIndex : int = -1
   var Command : ObservableProperty = $OM.Calculated(this, "GetCommand")
   var MenuDC : DefaultContextMenuVM = null
   
   func Init(p : params)
      wgt := p.widget
      VisibleIndex := p.visibleIndex
      MenuDC := p.MenuDC
   end
   
   func CommandHandler(p : params) : bool
      wgt.GenerateEvent(Command.Get().eventName, Command.Get().eventParams)
      p.widget.CloseContextMenu()
      return true
   end
   
   func GetCommand() : params
      var result : params
      if VisibleIndex == -1
         result := MenuDC.DefaultCommand
      else
         result := MenuDC.wgt.Get("Command" + VisibleIndex)
      end
      return result
   end
end

class DefaultContextMenuVM
   var wgt : UiWidget = null
   var ButtonCount : ObservableProperty = $OM.Calculated(this, "GetButtonCount")
   var DefaultCommand : params
   
   func DefaultContextMenuVM()
      DefaultCommand.label := ""
      DefaultCommand.isEnabled := false
      DefaultCommand.isVisible := false
      DefaultCommand.eventName := ""
      DefaultCommand.eventParams := new params
      DefaultCommand.index := -1
   end
   
   func Init(p : params)
      wgt := p.widget
      if ((bool)wgt.Get("CanOpen"))
         wgt.Widgets.contentAttach.contextMenuContent.btn0.SetFocus()         
      else
         wgt.Props.visible := false
      end
      CheckClose() : 0
   end
   
   func CheckClose()
      if (!(bool)wgt.Get("CanOpen"))
         wgt.CloseContextMenu()
      end
   end   
      
   func GetSettings(idx : int) : params
      var settings : params = wgt.Get("Command" + idx)
      return settings
   end
   
   func GetVisibleCommandIdx(idx : int) : int
      var i : int
      var curVisibleIdx : int = -1
      for i := 0 to 8
         var command : params = wgt.Get("Command" + i)
         if command.isVisible
            curVisibleIdx += 1
         end
         if curVisibleIdx == idx
            return i
         end
      end
      return -1
   end

   func GetButtonCount() : int
      var i : int
      var visibleCount : int = 0
      for i := 0 to 8
         var command : params = wgt.Get("Command" + i)
         if command.isVisible
            visibleCount += 1
         end
      end
      return visibleCount
   end

   func inputEvent(p : params) : bool
      var isTerminated  : bool   = true
      var keyCode       : int    = p.keyCode
      if (p.isDown == false)
         if (keyCode == $uiKeys.VK_ESC)
            wgt.CloseContextMenu()
         end
      end
      if (keyCode == $uiKeys.VK_ENTER)
         isTerminated := false
      end
      if (isTerminated)
         p.eventState.SetIsTerminated(isTerminated)
      end
      return true
   end   
end

