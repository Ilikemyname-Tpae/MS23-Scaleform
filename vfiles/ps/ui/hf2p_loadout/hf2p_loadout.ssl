func ViewItemInShop(loadoutIdx :  int, slot : int)
   var weaponLoadouts   : vector             = $UserDataStorage.GetLocalUserData().weapon_loadouts.spartan.loadouts.Get()
   var loadout          : UD_WeaponLoadout   = weaponLoadouts.Get(loadoutIdx)
   var item             : string             = loadout.GetItemBySlotIdx(slot)
   var slotItemTypes    : params             = loadout.GetSlotTypeAndSubType(slot)
   
   $root.GotoShopItem(item, slotItemTypes.itemType, slotItemTypes.itemSubType)
end 

func onPerksSlotClicked(p:params): bool
   var loadoutIdx : int = p.widget.GetParentWidget().GetParentWidget().Props.idx
   var slotElementIdx   : int = p.widget.btnIdx - 1
   var perkIdx : int = p.widget.btnIdx - 4
   Log("ui~loadoutSelect", "onPerksSlotClicked " + (string)(loadoutIdx) + ", " + (string)(perkIdx))
   if GetStateName() == "SeeLoadout"
      ViewItemInShop(loadoutIdx, slotElementIdx)
   else
      if (minSlotIdx > 3)   
         if (perkIdx >= 0 and perkIdx <= 3)
            $user_service.SetCharacterActive(loadoutIdx)
            $user_service.EquipCharacterWithSlot(assignItemId, perkIdx)
            clickFlag := true
            $UiBiLogger.LogWeaponLoadoutEvent("Select", p.widget.btnIdx, "" , 0)
            $UiBiLogger.LogWeaponLoadoutEvent("Assign", p.widget.btnIdx, assignItemId , perkIdx + 3)
         end
         return false
      end
   end
   return true      
end

func onLoadoutElementClicked(p:params): bool
   /*
   var loadoutIdx       : int = p.widget.GetParentWidget().GetParentWidget().Props.idx
   var slotElementIdx   : int = p.widget.btnIdx - 1
   if (minSlotIdx <= 3)   
      if (slotElementIdx >= 0 and slotElementIdx <= 2)
         if (slotElementIdx == 0 or slotElementIdx == 1)
            $user_service.SetWeaponLoadoutWeapon(GetRaceIdx(), loadoutIdx, assignItemId)
         elif (slotElementIdx == 2)
            $user_service.SetWeaponLoadoutGrenade(GetRaceIdx(), loadoutIdx, assignItemId)
         end
         clickFlag := true
      end
      return false
   end
   */
   var loadoutIdx       : int = p.widget.GetParentWidget().GetParentWidget().Props.idx
   var slotElementIdx   : int = p.widget.btnIdx - 1
   if GetStateName() == "SeeLoadout"
      ViewItemInShop(loadoutIdx, slotElementIdx)
   end   
   return true      
end

func onBoosterSlotClicked(p:params): bool
   /*
   if (minSlotIdx > 3)
      var loadoutIdx : int = p.widget.GetParentWidget().GetParentWidget().Props.idx
      $user_service.SetWeaponLoadoutBooster(GetRaceIdx(), loadoutIdx, assignItemId)
      clickFlag := true      
      return false
   end
   return true
   */
   
   var loadoutIdx : int = p.widget.GetParentWidget().GetParentWidget().Props.idx
   if GetStateName() == "SeeLoadout"
      ViewItemInShop(loadoutIdx, 7)
   else
      if (minSlotIdx > 3)   
         //$user_service.SetLoadout(assignItemId)
         $user_service.SetCharacterActive(loadoutIdx)
         $user_service.EquipCharacter(assignItemId)
         clickFlag := true
         $UiBiLogger.LogWeaponLoadoutEvent("Select", loadoutIdx, "" , 0)
         $UiBiLogger.LogWeaponLoadoutEvent("Assign", loadoutIdx, assignItemId , 7)
         return false
      end
   end
   return true      
end

func onLoadoutMouseOver(p:params): bool
