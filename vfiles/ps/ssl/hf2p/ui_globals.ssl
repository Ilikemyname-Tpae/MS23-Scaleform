      var ret : string = "main_ui_item_unlock"
      return ret
   end
   
   func GetDesc() : wstring
      var ret : wstring
      var p : params
      var i : int
      var items : vector = new_items.Get()
      for i := 0 to items.Count() - 1
         var uiComp : GL_ComponentUI  = (GL_ComponentUI)$UiGlobals.componentsUI.Get((string)items.Get(i).value.Get())
         p.txt0 := $UiGlobals.TranslateText((string)uiComp.name.Get())
         p.txt1 := $UiGlobals.String2WString("\n")
         ret := p.txt0 + p.txt1
      end
      p.txt2 := $UiGlobals.String2WString("~")
      return ret + p.txt2
   end   
   
   func GetBG() : string
      return "notif_bg_item_bg_norm"
   end   
   
   func GetItemQ() : string
      var ret     : string = ""
      var items   : vector = new_items.Get()
      if (items.Count() > 0)
         var itemId : string = (string)items.Get(0).value.Get()
         var uiComp : GL_ComponentUI  = (GL_ComponentUI)$UiGlobals.componentsUI.Get(itemId)
         ret := (string)uiComp.quality.Get()
      end
      return ret
   end
   
   func GetIcon() : string
      var ret     : string = ""
      var items   : vector = new_items.Get()
      if (items.Count() > 0)
         var itemId : string = (string)items.Get(0).value.Get()
         var uiComp : GL_ComponentUI  = (GL_ComponentUI)$UiGlobals.componentsUI.Get(itemId)
         ret := (string)uiComp.icon.Get()
      end
      return ret
   end
end

