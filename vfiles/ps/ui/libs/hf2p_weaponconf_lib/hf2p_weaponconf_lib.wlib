                           }
                           anim   =   {
                              anim   =   "fadeIn"
                              __type   =   "ui_widget_action_anim"
                           }
                        }
                        __type   =   "ui_widget_action_list"
                     }
                  }
               }
            }
            Initial   =   {
            }
         }
      }
      bindings   =   {
         state   =   {
            binding   =   "{descModelState}"
         }
      }
