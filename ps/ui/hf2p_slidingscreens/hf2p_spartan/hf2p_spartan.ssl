func InitSpartanParts(_delay : float = 0)
   // layout
   Widgets().spartanCont.visible := true
   Widgets().spartanCont.grid.visible := true
   Widgets().rotateImg.visible := true
   Widgets().plrCam.alpha := 0
   Widgets().lineImg.visible := false
   Widgets().listSubHead.visible := false
   Widgets().subMarks.visible := false
   Widgets().spartanMarks.visible := false
   Widgets().colorList.visible := false
   Widgets().listMask.visible := false
   Widgets().listSubHead.visible := false
   Widgets().assignColorsBtn.visible := false
   Widgets().assignColorsHeader.visible := false
   var blinkTime : float = 0.2 + _delay
   var i : int
   for i := 1 to 5
      Widgets().Get("paintBtn" + i).visible := false
      Widgets().spartanCont.Get("spartanBtn" + i).visible := true
      Widgets().spartanCont.Get("spartanBtn" + i).StartDefaultBlinking(blinkTime + i * 0.05)
   end
   Widgets().spartanCont.StartDefaultBlinking(0.0)
   //Widgets().spartanCont.tabSc1.StartDefaultBlinking(_delay + 0.15)
   //Widgets().spartanCont.tabSc2.StartDefaultBlinking(_delay + 0.20)
   //Widgets().spartanCont.tabSc3.StartDefaultBlinking(_delay + 0.25)
   
   Widgets().spartanLoadoutPanel.StartDefaultBlinking(_delay + 0.30)
   //Widgets().spartanLoadoutPanel.spartanLoadoutSelect1.selected := true
   //Widgets().spartanLoadoutPanel.spartanLoadoutSelect2.enabled := false
   //Widgets().spartanLoadoutPanel.spartanLoadoutSelect3.enabled := false
   //Widgets().spartanLoadoutPanel.spartanLoadoutSelect4.enabled := false
   //Widgets().spartanLoadoutPanel.spartanLoadoutSelect5.enabled := false
   // lefft part
   PartsPanelUpdate(curLoadout)
   StatsPanelUpdate()
   GenerateEvent("#OnCancelBtn")
end
