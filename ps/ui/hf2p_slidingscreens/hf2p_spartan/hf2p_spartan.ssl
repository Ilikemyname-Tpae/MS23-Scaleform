func onPaintBtnClicked(p:params):bool
   curPaintTag := p.widget.paintTag
   curNumTag   := p.widget.numTag
   var i:int 
   for i := 1 to 5
      Widgets().Get("paintBtn" + i).selected := false
   end
   p.widget.selected := true
   SetSubHead(curPaintTag)
   SaveDefColor(curNumTag)
   populateColorList()
   Log("ui~content", "onPaintBtnClicked " + curPaintTag + " " + (string)(curNumTag))
   //SetListSelection(curNumTag)
   return false
end

func onColorListItemClick(p:params):bool
   Log("ui~content", "onColorListItemClick " + Params2Str(p))
   var color:params
   var clrName : string
   color := Widgets().colorList.GetItemData(p.index)
   // rgb2int = 65536 * r + 256 * g + b;
   clrName := color.name
   selectedColors.Set(curNumTag, clrName)
   ApplyColors(clrName, true)
   defColorPar := getClrParFromName(clrName)
   unsavedChanges := true
   //SaveDefColor(curNumTag)
   return false
end

func onPaletteListItemRollOver(p:params):bool
   //KillDelays()
   var color:params
   var clrName : string
   color := Widgets().colorList.GetItemData(p.index)
   clrName := color.name
   ApplyColors(clrName, false)// : 0.05, PAINT_ROLLOVER
   return false
end

func onPaletteListItemRollOut(p:params):bool
   var defClr : string = (string)(defColorPar.name)
   //KillDelays()
   ApplyColors(defClr, false)// : 0.25, PAINT_ROLLOUT
   return false
end

