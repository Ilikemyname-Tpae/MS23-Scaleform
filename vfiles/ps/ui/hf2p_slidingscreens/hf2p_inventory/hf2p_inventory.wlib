classes   =   {
   InventoryScreen   =   {
      sslClass   =   "InventoryScreen"
      sslModule   =   "ui.hf2p_SlidingScreens.hf2p_Inventory.hf2p_Inventory"
      x   =   165
      isBlinkable   =   True
      handlers   =   {
         InventoryLIRDoubleClick   =   {
            handlerName   =   "#InventoryLIRDoubleClick"
            isGlobal   =   False
         }
      }
      elements   =   {
         inventoryDrop1   =   {
            elements   =   {
               dropFilter   =   {
                  bindings   =   {
                     items   =   {
                        binding   =   "{(#parent.#parent)typeFilterList}"
                     }
                  }
                  __type   =   "ui_inventory_lib_as3::inventoryDropdown"
               }
            }
            bindings   =   {
               DC   =   {
                  binding   =   "{typeDrop}"
               }
            }
            __type   =   "hf2p_Inventory::InventoryFilter"
         }
         inventoryDrop2   =   {
            elements   =   {
               dropFilter   =   {
                  bindings   =   {
