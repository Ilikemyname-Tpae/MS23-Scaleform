classes   =   {
   st_RebindKeys   =   {
      sslClass   =   "UiStRebindKeys"
      sslModule   =   "ui.libs.hf2p_settings_lib.hf2p_settings_lib"
      handlers   =   {
         PrimaryKeyClick   =   {
            handlerName   =   "onPrimaryKeyClick"
         }
         altMouseIn   =   {
            handlerName   =   "OnAltMouseIn"
         }
         primaryMouseIn   =   {
            handlerName   =   "OnPrimaryMouseIn"
         }
      }
      elements   =   {
         labelList   =   {
            events   =   {
               itemClick   =   {
                  eventRemap   =   "PrimaryKeyClick"
               }
            }
            customProps   =   [
               {
                  propName   =   "minThumbSize"
                  propVal   =   {
                     val   =   48
                     __type   =   "ui_widget_desc_prop_float"
                  }
               },
               {
                  propName   =   "wrapping"
                  propVal   =   {
                     val   =   "stick"
                     __type   =   "ui_widget_desc_prop_string"
                  }
               }
            ]
            lir   =   {
               __type   =   "hf2p_settings_lib::st_rebindLIR"
            }
            scrollbar   =   {
               __type   =   "hf2p_settings_lib::st_scrollbar"
            }
            __type   =   "ui_widget_list"
         }
      }
      __type   =   "ui_settings_lib::SettingsKeyListContainer"
   }
   st_bottomButton   =   {
      __type   =   "ui_weaponConf_lib::hf2pPanelLeftBtn"
   }
   st_button   =   {
      events   =   {
         rollOut   =   {
            eventRemap   =   "OnMouseOut"
         }
         rollOver   =   {
            eventRemap   =   "OnMouseIn"
         }
      }
      customProps   =   [
         {
            propName   =   "label"
            propVal   =   {
               val   =   ""
               __type   =   "ui_widget_desc_prop_string"
            }
         }
      ]
      __type   =   "ui_weaponConf_lib::hf2pPanelBookmarkBtn"
   }
   st_checkbox   =   {
      sslClass   =   "UiStCheckbox"
      sslModule   =   "ui.libs.hf2p_settings_lib.hf2p_settings_lib"
      isBlinkable   =   True
      events   =   {
         buttonClick   =   {
            eventRemap   =   "onCheckBoxValueChange"
         }
         rollOut   =   {
            eventRemap   =   "OnMouseOut"
         }
         rollOver   =   {
            eventRemap   =   "OnMouseIn"
         }
      }
      soundMap   =   {
         soundMaps   =   {
            this   =   {
               mapping   =   {
                  buttonClick   =   {
                     uiSoundEvent   =   "sub_tab_select"
                  }
               }
            }
         }
      }
      customProps   =   [
         {
            propName   =   "toggle"
            propVal   =   {
               val   =   True
               __type   =   "ui_widget_desc_prop_bool"
            }
         }
      ]
      __type   =   "ui_settings_lib::hf2pCheckBox"
   }
   st_mainMenuBtn   =   {
      events   =   {
         buttonClick   =   {
            eventRemap   =   "OnSettingsMenuBtnClick"
         }
      }
      __type   =   "ui_weaponConf_lib::hf2pPanelLeftBtn"
   }
   st_optionLabel   =   {
      propMapping   =   {
         text   =   {
            mapping   =   "textField.text"
         }
      }
      __type   =   "ui_settings_lib::hf2p_settings_header"
   }
   st_rebindLIR   =   {
      sslClass   =   "UiStRebindLIR"
      sslModule   =   "ui.libs.hf2p_settings_lib.hf2p_settings_lib"
      isBlinkable   =   True
      elements   =   {
         tfLabels   =   {
            elements   =   {
               tfAction   =   {
                  __type   =   "ui_widget_container"
               }
            }
            __type   =   "ui_widget_button"
         }
         tfPrimary   =   {
            events   =   {
               buttonClick   =   {
                  eventRemap   =   "primaryMouseIn"
               }
            }
            elements   =   {
               tfAction   =   {
                  __type   =   "ui_widget_container"
               }
            }
            __type   =   "ui_widget_button"
         }
         tfAlternative   =   {
            events   =   {
               buttonClick   =   {
                  eventRemap   =   "altMouseIn"
               }
            }
            elements   =   {
               tfAction   =   {
                  __type   =   "ui_widget_container"
               }
            }
            __type   =   "ui_widget_button"
         }
      }
      __type   =   "ui_settings_lib::itemInputWTF_LIR"
   }
   st_scrollbar   =   {
      __type   =   "hf2p_WeaponList_lib::wc_ItemsListScrollBarNew"
   }
   st_scrollbar_empty   =   {
      __type   =   "ui_settings_lib::SettingsKeyListScrollbarEmpty"
   }
   st_slider   =   {
      sslClass   =   "UiStSlider"
      sslModule   =   "ui.libs.hf2p_settings_lib.hf2p_settings_lib"
      handlers   =   {
         OnMouseIn   =   {
            handlerName   =   "OnMouseIn"
         }
         OnMouseOut   =   {
            handlerName   =   "OnMouseOut"
         }
         OnSliderValueChange   =   {
            handlerName   =   "OnSliderValueChange"
         }
      }
      events   =   {
         CLIK_focusIn   =   {
            eventRemap   =   "OnFocusIn"
         }
         CLIK_focusOut   =   {
            eventRemap   =   "OnFocusOut"
         }
      }
      elements   =   {
         textbox   =   {
            x   =   430
            propMapping   =   {
               text   =   {
                  mapping   =   "textField.text"
               }
            }
            customProps   =   [
               {
                  propName   =   "text"
                  propVal   =   {
                     __type   =   "ui_widget_desc_prop_string"
                  }
               }
            ]
            __type   =   "ui_weaponConf_lib::headerBig"
         }
         track   =   {
            x   =   23
            y   =   17
            __type   =   "hf2p_settings_lib::st_slider_track"
         }
      }
      propMapping   =   {
         maximum   =   {
            mapping   =   "track.maximum"
         }
         minimum   =   {
            mapping   =   "track.minimum"
         }
         value   =   {
            mapping   =   "track.value"
         }
      }
      customProps   =   [
         {
            propName   =   "textvisible"
            propVal   =   {
               val   =   True
               __type   =   "ui_widget_desc_prop_bool"
            }
         }
      ]
      __type   =   "hf2p_Loadout_lib::wc_container"
   }
   st_slider_track   =   {
      events   =   {
         mouseOut   =   {
            eventRemap   =   "OnMouseOut"
         }
         mouseOver   =   {
            eventRemap   =   "OnMouseIn"
         }
         valueChange   =   {
            eventRemap   =   "OnSliderValueChange"
         }
      }
      __type   =   "ui_settings_lib::SettingsSlider"
   }
   st_stepper   =   {
      sslClass   =   "UiStStepper"
      sslModule   =   "ui.libs.hf2p_settings_lib.hf2p_settings_lib"
      isBlinkable   =   True
      events   =   {
         indexChange   =   {
            eventRemap   =   "onStepperIndexChange"
         }
         buttonClick   =   {
            eventRemap   =   "onStepperButtonClick"
         }
         mouseOut   =   {
            eventRemap   =   "OnMouseOut"
         }
         mouseOver   =   {
            eventRemap   =   "OnMouseIn"
         }
      }
      elements   =   {
         nextBtn   =   {
            animated   =   False
            __type   =   "ui_settings_lib::OptionStepper_rightArrow"
         }
         prevBtn   =   {
            animated   =   False
            __type   =   "ui_settings_lib::OptionStepper_leftArrow"
         }
      }
      soundMap   =   {
         soundMaps   =   {
            this   =   {
               mapping   =   {
                  indexChange   =   {
                     uiSoundEvent   =   "thumbnail_slide"
                  }
               }
            }
         }
      }
      __type   =   "ui_settings_lib::SettingsOptionStepper"
   }
   wc_container   =   {
      layer   =   "Layer2"
      __type   =   "ui_weaponConf_lib_slide::hf2pWCContainer"
   }
}
__type   =   "ui_widget_lib"
