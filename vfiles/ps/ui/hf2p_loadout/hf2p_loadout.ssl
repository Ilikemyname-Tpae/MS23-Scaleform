handle OnEnteringState("ChoiceLoadoutBtn")
   $UiBiLogger.LogGlobalStateChange($uiEnums.UI_BI_DEATH_SCREEN)
   $hq.RenderLocalLoadouts()
   enteringState := "ChoiceLoadoutBtn"
   Log("ui~loadoutSelect", "LoadoutPS_OnEntering_Visible_State_ChoiceLoadoutBtn")

   Widgets.cancelBtn.visible := false
   //Widgets.LoadoutGoldButton.visible := false
   Widgets.doneBtn.visible := false
   Widgets.header.textField := "carousel_select_loadout"
   Widgets.header.visible := false
   //Widgets.background.alpha := 0	
   Widgets.slots.visible := false
   Widgets.RespawnPanel.viewLoadoutsButton.visible := false
   var isChatActive: bool = $UiIngame.chat.GetState() == $uiEnums.INGAME_CHAT_STATE_INPUT_ALL or $UiIngame.chat.GetState() == $uiEnums.INGAME_CHAT_STATE_INPUT_TEAM
   if (!isChatActive)
      Widgets.RespawnPanel.respawnButton.SetFocus()      
   end
   Widgets.KillerInfo.state := "Visible" // (tmp) false
   Widgets.KillerInfo.ShowKillerInfo()
   Set("visible", true)
   if (!isChatActive)
      InitFocus()
   end
   StartBlink()
   //AddTween("alpha", 1.0, Props.adelay, "linear")
end

