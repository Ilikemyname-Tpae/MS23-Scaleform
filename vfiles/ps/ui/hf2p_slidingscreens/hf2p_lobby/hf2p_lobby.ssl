   end
   
   func SortByUiListId (p1 : params, p2 :  params): int
      var ret : int = 0
      var x   : int = 0
      var y   : int = 0
      
      if (! IsVoid(p1.uiListId))
         x := (int)(p1.uiListId)
      end
      if (! IsVoid(p2.uiListId))
         y := (int)(p2.uiListId)
      end
      
      if (x < y)
         ret := -1
      elif (x > y)
         ret := 1 
      end
      return ret
   end
   
   func StringsVecToStepperList(_vec : vector) : vector
      var ret        : vector
      var i          : int
      for i := 0 to _vec.Count() - 1
         var rec  : GL_String = (GL_String)_vec.Get(i)
         var id   : string = (string)rec.value.Get()
         var name : string = ""
         if (id != "")
            name := $UiGlobals.componentsUI.Get(id).name.Get()
         end
         var listElem      : params
         listElem.id       := id
         listElem.label    := name
         ret.Push(listElem)         
      end
      return ret
   end

   func GetGameModes() : vector
      var ret : vector = StringsVecToStepperList($UiGlobals.matchmaking.custom_game_modes.Get())
      return ret
   end
   
   func GetGameMaps() : vector
      var ret : vector = StringsVecToStepperList($UiGlobals.matchmaking.custom_game_maps.Get())
      return ret
   end

   func GetPlaylists() : vector
      if (playlistsNames.Count() == 0)
         var playlistsVec        : vector = $UiGlobals.matchmaking.playlists.Get()
         var playlistsVecChecked : vector
         var i                   : int
         for i := 0 to playlistsVec.Count() - 1
            var rec        : GL_String             = (GL_String)playlistsVec.Get(i)
            var id         : string                = (string)rec.value.Get()
            var pl         : GL_ComponentPlaylist  = (GL_ComponentPlaylist)$UiGlobals.componentsPlaylist.Get(id)
            var maxparty   : int                   = (int)pl.party_size_max.Get()
            if (maxparty > 1)
               playlistsVecChecked.Push(playlistsVec.Get(i))
            end
         end
         playlistsNames := StringsVecToStepperList(playlistsVecChecked)
      end
      return playlistsNames
   end
   
