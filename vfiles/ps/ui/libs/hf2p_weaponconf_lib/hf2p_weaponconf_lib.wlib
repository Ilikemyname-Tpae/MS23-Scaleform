                  propMapping   =   {
                     tfOldPriceWidth   =   {
                        mapping   =   "tfOldPrice.textWidth"
                     }
                  }
                  elements   =   {
                     lineOldPrice   =   {
                        fixed   =   False
                        __type   =   "ui_widget_container"
                     }
                  }
                  bindings   =   {
                     visible   =   {
                        binding   =   "{!!gpDiscount}"
                     }
                     tfOldPrice   =   {
                        binding   =   "{gpOldCost}"
                     }
                  }
                  __type   =   "ui_widget_container"
               }
               tfNewPriceAnim   =   {
                  bindings   =   {
                     visible   =   {
                        binding   =   "{!!gpDiscount}"
                     }
                     tfNewPrice   =   {
                        binding   =   "{gpCost}"
                     }
                  }
                  __type   =   "ui_widget_container"
               }
            }
            bindings   =   {
