end

func SetTutorialState(_stage: int)
   ui_tutorialStage := _stage
end

func SetMainMenu(_mainMenu : UiHf2pMainMenu)
   mainMenu := _mainMenu
end

func GetMainMenu() :  UiHf2pMainMenu
