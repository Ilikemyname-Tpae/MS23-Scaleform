class UiPodiumLoadout : UiWidgetContainer
   handle OnEnteringState("Winner")
      Props().visible := true
      $root.playSound("podium_stats_loadout_appear")
   end
   handle OnEnteringState("Visible") // (name : string)
      Props().visible := true
   end
   handle OnEnterState("Win") // (name : string)
      Props().visible := true
      GotoAndPlay("fadeIn")
   end
   handle OnEnterState("Visible") // (name : string)
      SetStateName("Initial") : 1.0
   end   
   handle OnEnterState("Initial") // (name : string)
      Props().visible := false
   end   
end

class UiPodiumPoints : UiWidgetContainer
   handle OnEnteringState("Winner") // (name : string)
      Props().visible := true
   end
   handle OnEnteringState("Visible") // (name : string)
