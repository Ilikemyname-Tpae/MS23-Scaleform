func SetListSelection(numTag : int)
   var clrName : string
   var i : int
   var listIdx : int
   clrName := selectedColors.Get(numTag)
   for i := 0 to colorVec.Count() - 1   
      if (clrName == colorVec.Get(i).name)
         listIdx := i
         Widgets().colorList.SetSelectionIdx(i)
      end
   end
end

func populateColorList()
   Log("ui~content", "populateColorList")
   Widgets().colorList.visible := true
   Widgets().colorList.StartDefaultBlinking(0.20)
   //var colorVec : vector
   var rgbPar   : params
   var colorList: vector = $UiGlobals.componentsColor.GetKeys()
   var i        : int
   
   colorVec.Clear()

   var clrType : int = 0
   for i := 0 to colorList.Count() - 1
      var clrName : string = colorList.Get(i)
      if (clrName != "")
         var colorComp  : GL_ComponentColor  = (GL_ComponentColor)$UiGlobals.componentsColor.Get(clrName)
         if (curNumTag == (int)colorComp.type.Get())
            // + TYPE + UI_DESC_ID + RACE_ID
            rgbPar.name       := clrName
            rgbPar.r          := (int)(colorComp.r.Get())
            rgbPar.g          := (int)(colorComp.g.Get())
            rgbPar.b          := (int)(colorComp.b.Get())
            rgbPar.uiListId   := (int)(colorComp.orderId.Get())
            colorVec.Push(rgbPar.Clone())
         end
      end
   end
   colorVec.Sort(this, "SortByListId")
   Widgets().colorList.SetData(colorVec)
   SetListSelection(curNumTag)
end

func SortByListId (p1 : params, p2 :  params): int
   var ret : int = 0
   var x   : int = 0
   var y   : int = 0
   
   if (! IsVoid(p1.uiListId))
      x := (int)(p1.uiListId)
   end
   if (! IsVoid(p2.uiListId))
      y := (int)(p2.uiListId)
   end
   
   if (x < y)
      ret := -1
   elif (x > y)
      ret := 1 
   end
   return ret
end
