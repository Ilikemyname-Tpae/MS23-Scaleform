classes   =   {
   ChatCont   =   {
      sslClass   =   "UiChat"
      sslModule   =   "ui.libs.hf2p_Chat_lib.hf2p_Chat_lib"
      visible   =   False
      fixed   =   False
      handlers   =   {
         SetChatPrivateUser   =   {
            handlerName   =   "#OnSetChatPrivateUser"
         }
      }
      elements   =   {
         expandBtn   =   {
            sslClass   =   "ChatExpandBtn"
            sslModule   =   "ui.libs.hf2p_Chat_lib.hf2p_Chat_lib"
            dragEnabled   =   True
            handlers   =   {
               ChatDrag   =   {
                  handlerName   =   "OnChatDrag"
               }
            }
            events   =   {
               doubleClick   =   {
                  eventRemap   =   "#ToggleCollapsed2"
               }
            }
            bindings   =   {
               focusable   =   {
                  binding   =   "{false}"
               }
               doubleClickEnabled   =   {
                  binding   =   "{true}"
               }
            }
            __type   =   "ui_chat_lib::ChatExpandBtn"
         }
         userShowBtn   =   {
            events   =   {
               buttonClick   =   {
                  eventRemap   =   "#ToggleMembers"
               }
            }
            bindings   =   {
               visible   =   {
                  binding   =   "{!IsNewsVisible()}"
               }
               selected   =   {
                  binding   =   "{IsMembersBtnVisible()}"
               }
               y   =   {
                  binding   =   "{GetMembersBtnYPos()}"
               }
               focusable   =   {
                  binding   =   "{false}"
               }
            }
            __type   =   "ui_chat_lib::ChatUserShowBtn"
         }
         tabsCont   =   {
            __type   =   "hf2p_Chat_lib::ChatTabs"
         }
         inputCont   =   {
            elements   =   {
               inputTf   =   {
                  sslClass   =   "UiChatMessage"
                  sslModule   =   "ui.libs.hf2p_Chat_lib.hf2p_Chat_lib"
                  isNoTranslate   =   True
                  impl   =   {
                     __type   =   "ui_widget_impl_gfx"
                  }
                  bindings   =   {
                     editable   =   {
                        binding   =   "{true}"
                     }
                     defaultText   =   {
                        binding   =   "{GetDefaultInputText()}"
                     }
                     enabled   =   {
                        binding   =   "{CanSendMessage()}"
                     }
                     focusable   =   {
                        binding   =   "{true}"
                     }
                     actAsButton   =   {
                        binding   =   "{true}"
                     }
                     maxChars   =   {
                        binding   =   "{250}"
                     }
                  }
                  __type   =   "ui_chat_lib::ChatTextInputSkinned"
               }
            }
            bindings   =   {
               visible   =   {
                  binding   =   "{IsSendVisible()}"
               }
               y   =   {
                  binding   =   "{GetInputContYPos()}"
               }
            }
            __type   =   "ui_chat_lib::ChatInputCont"
         }
         listMessages   =   {
            fixed   =   False
            __type   =   "hf2p_Chat_lib::MessagesListCont"
         }
         listMembers   =   {
            y   =   31
            fixed   =   False
            elements   =   {
               chatMask   =   {
                  bindings   =   {
                     _height   =   {
                        binding   =   "{GetUsersBgHeight()}"
                     }
                  }
                  __type   =   "ui_widget_container"
               }
               bg   =   {
                  bindings   =   {
                     _height   =   {
                        binding   =   "{GetUsersBgHeight()}"
                     }
                  }
                  __type   =   "ui_chat_lib::CharUserBg"
               }
            }
            __type   =   "hf2p_Chat_lib::MembersListCont"
         }
         bg   =   {
            bindings   =   {
               _height   =   {
                  binding   =   "{GetBgHeight()}"
               }
               focusable   =   {
                  binding   =   "{true}"
               }
            }
            __type   =   "ui_chat_lib::ChatBgPic"
         }
         rosterCard   =   {
            x   =   -243
            y   =   -31
            fixed   =   False
            impl   =   {
               __type   =   "ui_widget_impl_gfx"
            }
            bindings   =   {
               visible   =   {
                  binding   =   "{isVisible and (#parent)isPlayerCardVisible}"
               }
               DC   =   {
                  binding   =   "{GetPlayerCardVM()}"
               }
            }
            __type   =   "hf2p_rosterList_lib::rosterCardRight"
         }
         newsList   =   {
            x   =   19
            y   =   43
            fixed   =   False
            bindings   =   {
               visible   =   {
                  binding   =   "{(#parent)IsNewsVisible()}"
               }
               _height   =   {
                  binding   =   "{(#parent)GetNewsListHeight()}"
               }
            }
            layer   =   "layer0"
            __type   =   "hf2p_News_lib::NewsList"
         }
         motd   =   {
            x   =   32
            fixed   =   False
            impl   =   {
               propMapping   =   {
                  motdMessage   =   {
                     isNoTranslate   =   True
                  }
               }
               __type   =   "ui_widget_impl_gfx"
            }
            bindings   =   {
               motdHeader   =   {
                  binding   =   "{'main_motd_header'}"
               }
               motdMessage   =   {
                  binding   =   "{$UiGlobals.motd.message}"
               }
               visible   =   {
                  binding   =   "{IsNewsVisible()}"
               }
               y   =   {
                  binding   =   "{GetMOTDYPos()}"
               }
            }
            layer   =   "layer0"
            __type   =   "ui_menu_lib::motdContainer"
         }
      }
      bindings   =   {
         DC   =   {
            binding   =   "{new: 'ui.libs.hf2p_Chat_lib.hf2p_Chat_lib.UiChatVM'}"
         }
         y   =   {
            binding   =   "{GetChatYPos()}"
         }
         tabsData   =   {
            binding   =   "{GetTabsData()}"
         }
      }
      __type   =   "ui_chat_lib::ChatCont"
   }
   MessagesLIR   =   {
      elements   =   {
         tf   =   {
            impl   =   {
