var stateContainerChilds : vector
override GetStateContainerChilds // () : vector
   var ret : vector = stateContainerChilds
   if (ret.Count() == 0)
      var childRec   : params   
      childRec.name  := slidingScreens.GetName()
      childRec.layer := 0
      ret.Push(childRec.Clone())
      
      childRec.name  := slidingSettingsScreen.GetName()
      childRec.layer := 0
      ret.Push(childRec.Clone())

      childRec.name  := slidingScreensClans.GetName()
      childRec.layer := 0
      ret.Push(childRec.Clone())

      childRec.name  := slidingScreensLoot.GetName()
      childRec.layer := 0
      ret.Push(childRec.Clone())

      childRec.name  := "loadoutSelect"
      childRec.layer := 1
      ret.Push(childRec.Clone())
      
      childRec.name  := "armorLoadout"
      childRec.layer := 1
      ret.Push(childRec.Clone())
      
      childRec.name  := "newsScreen"
      childRec.layer := 1
      ret.Push(childRec.Clone())
      
      childRec.name  := "goldScreen"
      childRec.layer := 2
      ret.Push(childRec.Clone())
   end
   return ret
end

