func OnApplyColorsClick(p : params) : bool
   //$user_service.SetArmorLoadoutColors(GetRaceIdx(), 0, )
   var loadoutIndex : int = $UserDataStorage.users.Get($UserDataStorage.local_user.uid.Get()).armor_loadouts.spartan.active_loadout_index.Get()
   $user_service.SetArmorLoadoutColors(GetRaceIdx(), loadoutIndex, selectedColors.Get(0), selectedColors.Get(1), selectedColors.Get(2), selectedColors.Get(3), selectedColors.Get(4))
   unsavedChanges := false
   
   var   pp          : params
   pp.isSkip         := true
   pp.itemID         := ""
   pp.messageTxt     := "msg_spartan_paint_assigned_msg"
   pp.mbType         := "AssignInfo"
   pp.titleTxt       := "msg_ui_assigned"
   pp.closeTimeout   := 2 
   GenerateEvent("MainMenuDialogRequest", pp)
   
   return false
end

func ApplyColors(colorName:string, _doSave:bool = false)
   Log("ui~content", "ApplyColors " + colorName)
   //$hq.ShowroomBegin()
   if (colorName != "")
      $hq.ShowroomTryOnColor(GetRaceIdx(), colorName)
      if (_doSave) 
         //$user_service.SetArmorLoadoutColor(GetRaceIdx(), 0, colorName)
         //SetBtnColor(tagIdx)
         //SetPaletteBtnColor()// : 0.25
         SetPartBtnColor(getClrParFromName(colorName))
      end
   end
end

func GetRaceIdx() : int
   var idx: int = (int)$UserDataStorage.local_user.race.Get() //$hf2pEngine.GetUIPlayerModelId()
   return idx
end

func ShowPaintTmp()
   Widgets().spartanCont.tabSc1.enabled := false
   Widgets().spartanCont.tabSc2.enabled := false
   Widgets().spartanCont.tabSc3.selected := true
   SetPaletteBtnColor()
   InitSpartanPaint()
end

handle OnEnterState("Initial")
   Set("visible", false)            
end          

handle OnEnteringState("Visible")
   Set("visible", true)
   $hq.ShowroomBegin()   
   $hq.isInShowroom := true
end

handle OnEnterState("Visible")
   SetHeader()
   blinkDelay := 0.0
   //ShowPaintTmp()
end

handle OnExitState("Visible") // (name : string)
   $hq.ShowroomEnd()   
   $hq.isInShowroom := false
end

handle OnEnteringState("SpartanVisible")
   //Set("visible", true)
   $hq.ShowroomBegin()
   $hq.isInShowroom := true
end

handle OnEnterState("SpartanVisible")
   SetHeader()
   SetPaletteBtnColor()
end

handle OnExitState("SpartanVisible")
   $hq.ShowroomEnd()   
   $hq.isInShowroom := false
end

func PrepareSlide()
   if (GetStateName() != "Visible")
      SetStateName("Visible")
   end
   EnableFakeBg()
   $hq.ShowroomEnd()
   $hq.isInShowroom := false
   $hq.ShowroomBegin()
   $hq.isInShowroom := true
   //selectedTab := "parts"
   //InitSpartanParts(0.3)
   selectedTab := "paint"
   SetStateName("SpartanVisible")
   InitSpartanPaint()
end

func PrepareHideSlide()
end

func DisableSlide()
   if (GetStateName() != "Initial")
      SetStateName("Initial")
   end
end

func EnableFakeBg()
   var p: params
   p.state := "spartan"
   GenerateEvent("ChangeFakeBackground", p)
end

func OnCloseConfirmation(onAgree : refFUNC_PTR)
   if selectedTab == "paint" and unsavedChanges
      closeConfirmationAgreeCallback := onAgree
      var pp : params
      pp.titleTxt       := "msg_spartan_unsaved_paint_ttl"
      pp.messageTxt     := "msg_spartan_unsaved_paint_msg"
      pp.callbackEvent  := "unsavedPaintConfirmationClosed"
      pp.isSaveFocus    := true
      pp.mbType         := $uiEnums.MB_TYPE_NO_YES
      GenerateEvent("MainMenuDialogRequest", pp)   
   else
      onAgree.Call()
   end
end

func OnUnsavedPaintConfirmationClosed(p : params) : bool
   if p.isOK and closeConfirmationAgreeCallback != null
      closeConfirmationAgreeCallback.Call()
   end
   var nullPtr : refFUNC_PTR
   closeConfirmationAgreeCallback := nullPtr
   return false
end

func OnUnsavedPaintConfirmationClosed2(p : params) : bool
   if p.isOK
      SetStateName("Visible")
      InitSpartanParts(0)
      selectedTab := gotoMark
   end
   return false
end

func HasUnsavedChanges() : bool
   return selectedTab =="paint" and unsavedChanges
end

end


class ArmorClassBonusViewModel
   var Index : int
   var Parent : SpartanScreenViewModel = null

   var ArmorLoadoutBonus : ObservableProperty = $OM.Calculated(this, "ArmorLoadoutBonusGetter")

   var Name : ObservableProperty = $OM.Calculated(this, "GetName")
   var IconName : ObservableProperty = $OM.Calculated(this, "GetIconName")
   var Points : ObservableProperty = $OM.Calculated(this, "GetPoints")
   var Percent : ObservableProperty = $OM.Calculated(this, "GetPercent")
   var NewPoints :  ObservableProperty = $OM.Calculated(this, "GetNewPoints")
   var NewPercent :  ObservableProperty = $OM.Calculated(this, "GetNewPercent")
   
   var BonusLevels : vector
   var CurrentBonusLevelIndex : ObservableProperty = $OM.Calculated(this, "GetCurrentBonusLevelIndex")
   var NewBonusLevelIndex : ObservableProperty = $OM.Calculated(this, "GetNewBonusLevelIndex")
   
   func Init(p : params)
      //ArmorLoadoutBonus.Subscribe(this, "ArmorLoadoutBonusChanged")
      Name.Invalidate()
      IconName.Invalidate()
      Points.Invalidate()
      NewPoints.Invalidate()
      Percent.Invalidate()
      NewPercent.Invalidate()
      CurrentBonusLevelIndex.Invalidate()
      var i : int
      for i := 0 to 4
         var bonusLevel : ObservableProperty = $OM.Calculated(this, "GetBonusLevel" + i)
         BonusLevels.Push(bonusLevel)
         bonusLevel.Invalidate()
      end
   end
   
   func Term(p : params)
      BonusLevels.Clear()
      //ArmorLoadoutBonus.Unsubscribe(this, "ArmorLoadoutBonusChanged")
   end
      
   func ArmorLoadoutBonusGetter() : *
      var ud : UserData = (UserData) $UserDataStorage.users.Get($UserDataStorage.local_user.uid.Get())
      var al :  UD_ArmorLoadout = (UD_ArmorLoadout)ud.armor_loadouts.spartan.loadouts.Get().Get(ud.armor_loadouts.spartan.active_loadout_index.Get())
      return null
   end
      
   func GetName() : *
      return ""
   end
   
   func GetIconName() : *
      return ""
   end
   
   func GetPoints() : *
      return 0
   end

   func GetPercent() : *
      return (float)0
   end

   func GetNewPoints() : *
      if Parent.ShoppingState.Get() != 1
         return Points.Get()
      end
      return Points.Get()
   end

   func GetNewPercent() : *
      if Parent.ShoppingState.Get() != 1
         return Percent.Get()
      end
      return Percent.Get()
   end
   
   func GetCurrentBonusLevelIndex() : *
      return -1
   end
   
   func GetNewBonusLevelIndex() : *
      if Parent.ShoppingState.Get() != 1
         return CurrentBonusLevelIndex.Get()
      end
      return GetCurrentBonusLevelIndex()
   end
   
   func GetBonusLevel0() : *
      var result : * = GetBonusLevel(0)
      if (result.Text != "")
         result:=result
      end
      return result
   end
   
   func GetBonusLevel1() : *
      var result : * = GetBonusLevel(1)
      if (result.Text != "")
         result:=result
      end
      return result
   end
   
   func GetBonusLevel2() : *
      var result : * = GetBonusLevel(2)
      if (result.Text != "")
         result:=result
      end
      return result
   end
   
   func GetBonusLevel3() : *
      var result : * = GetBonusLevel(3)
      if (result.Text != "")
         result:=result
      end
      return result
   end
   
   func GetBonusLevel4() : *
      var result : * = GetBonusLevel(4)
      if (result.Text != "")
         result:=result
      end
      return result
   end
   
   func GetBonusLevel(index : int) : *
      var bl : params
      bl.PointsRequired := 0
      bl.Text := ""
      return bl
   end
   
   func OnMouseOver(p : params) : bool
      Parent.SelectedArmorClassBonusIndex.Set(Index)
      return true
   end
   
   func OnMouseOut(p : params) : bool
      Parent.SelectedArmorClassBonusIndex.Set(-1)
      return true
   end
   
end

class SpartanScreenViewModel
   var SelectedLoadoutIdx : ObservableProperty = $OM.Calculated(this, "GetSelectedLoadoutIdx")
   var SelectedLoadout    : ObservableProperty = $OM.Calculated(this, "GetSelectedLoadout")
   var ArmrLoadoutCount   : ObservableProperty = $OM.Calculated(this, "GetArmrLoadoutCount")
   
   var ArmorClassBonuses       : vector
   var ArmorClassBonusRemapped : vector
   var SelectedArmorClassBonusIndex : ObservableProperty = $OM.Property(-1)
   var SelectedArmorClassBonus      : ObservableProperty = $OM.Calculated(this, "GetSelectedArmorClassBonus")
   var DefaultArmorClassBonus       : params
   
   var ShoppingState : ObservableProperty = $OM.Property(-1)
   var wgt : animatedContent_contentContainer_UiContent_5 = null
   var confirmLoadoutIdx : int = -1
   
   func GetSelectedLoadoutIdx() : *
      var ud : UserData = (UserData) $UserDataStorage.users.Get($UserDataStorage.local_user.uid.Get())
      var loadoutIndex :  int = (int)ud.armor_loadouts.spartan.active_loadout_index.Get()
      return loadoutIndex
   end
   
   func GetSelectedLoadout() : *
      var ud : UserData = (UserData) $UserDataStorage.users.Get($UserDataStorage.local_user.uid.Get())
      var al :  UD_ArmorLoadout = (UD_ArmorLoadout)ud.armor_loadouts.spartan.loadouts.Get().Get(ud.armor_loadouts.spartan.active_loadout_index.Get())
      return al
   end
   
   func GetArmrLoadoutCount() : int
      var ret : int
      var udLocal : UserDataLocal = $UserDataStorage.local_user
      ret := (int)udLocal.armor_loadouts_unlocked.Get()
      return ret
   end
   
   func GetSelectedArmorClassBonus() : *
      if (int)SelectedArmorClassBonusIndex.Get() >= 0
         return ArmorClassBonuses.Get(SelectedArmorClassBonusIndex.Get())
      end
      return DefaultArmorClassBonus
   end
   
   func Init(p : params)
      wgt := p.widget
      var i : int
      for i := 0 to 4
         var ac : ArmorClassBonusViewModel = new ArmorClassBonusViewModel()
         ac.Index := i
         ac.Parent := this
         ac.Points.Subscribe(this, "ReorderArmorClassBonus")
         ac.NewPoints.Subscribe(this, "ReorderArmorClassBonus")
         ArmorClassBonuses.Push(ac)
         ArmorClassBonusRemapped.Push($OM.Property(DefaultArmorClassBonus))
      end
      for i := 0 to 4
         var ac : ArmorClassBonusViewModel = ArmorClassBonuses.Get(i)
         ac.Init(p)
      end
      DefaultArmorClassBonus.Name := ""
      DefaultArmorClassBonus.IconName := ""
      DefaultArmorClassBonus.Points := 0
      DefaultArmorClassBonus.NewPoints := 0
      DefaultArmorClassBonus.Percent := 0.0385
      DefaultArmorClassBonus.NewPercent := 0.0385
      DefaultArmorClassBonus.BonusLevels := new vector
      for i := 0 to 4
         DefaultArmorClassBonus.BonusLevels.Push(new params)
         DefaultArmorClassBonus.BonusLevels.Get(i).Text := ""
      end
      DefaultArmorClassBonus.CurrentBonusLevelIndex := -1
      DefaultArmorClassBonus.NewBonusLevelIndex := -1
      //SelectedLoadout.Invalidate()
      ShoppingState.Subscribe(this, "OnShoppingStateChanged")
      SelectedLoadoutIdx.Subscribe(this, "SelectedLoadoutIdxChanged")
      SelectedLoadoutIdx.Invalidate()
   end
   
   func ReorderArmorClassBonus(val : *)
      var i : int
      var j : int
      var nextIndex : int = 0
      for i := 0 to 4
         var acbVM : ArmorClassBonusViewModel = (ArmorClassBonusViewModel)ArmorClassBonuses.Get(i)
         var points : int = (int)acbVM.Points.Get()
         var newPoints : int = (int)acbVM.NewPoints.Get()
         ArmorClassBonusRemapped.Get(i).Set(DefaultArmorClassBonus)
         if points > 0 or newPoints > 0
            ArmorClassBonusRemapped.Get(nextIndex).Set(acbVM)
            nextIndex += 1
         end
      end
   end
   
   func Term(p : params)
      SelectedLoadoutIdx.Unsubscribe(this, "SelectedLoadoutIdxChanged")
      ShoppingState.Unsubscribe(this, "OnShoppingStateChanged")
      var i : int
      for i := 0 to 4
         var ac : ArmorClassBonusViewModel = ArmorClassBonuses.Get(i)
         ac.Term(p)
         ac.NewPoints.Unsubscribe(this, "ReorderArmorClassBonus")
         ac.Points.Unsubscribe(this, "ReorderArmorClassBonus")
         ac.Parent := null
      end
      wgt := null
   end
   
   func SelectedLoadoutIdxChanged(newVal : *)
      if ($hq.isInShowroom)
         $hq.ShowroomEnd()
         $hq.ShowroomBegin()
         Fire("SelectedLoadoutChanged")
      end
   end
   
   func ArmorPartHeadClicked(p : params) : bool
      ShoppingState.Set(1)
      var p1 : params
      p1.index := 0
      Fire("SpartanSetDropDownSelection", p1)
      return true
   end
   
   func ArmorPartTorsoClicked(p : params) : bool
      ShoppingState.Set(1)
      var p1 : params
      p1.index := 1
      Fire("SpartanSetDropDownSelection", p1)
      return true
   end
   
   func ArmorPartShouldersClicked(p : params) : bool
      ShoppingState.Set(1)
      var p1 : params
      p1.index := 2
      Fire("SpartanSetDropDownSelection", p1)
      return true
   end
   
   func ArmorPartHandsClicked(p : params) : bool
      ShoppingState.Set(1)
      var p1 : params
      p1.index := 3
      Fire("SpartanSetDropDownSelection", p1)
      return true
   end
   
   func ArmorPartLegsClicked(p : params) : bool
      ShoppingState.Set(1)
      var p1 : params
      p1.index := 4
      Fire("SpartanSetDropDownSelection", p1)
      return true
   end
   
   func OnCancelBtn(p : params) : bool
      ShoppingState.Set(0)
      return true
   end
   
   func OnShoppingStateChanged(val : *)
      if val == 1
         $root.isSpartanShop := true
         Fire("OnSpartanStoreOpen")
      end
   end
   
   global event OnSpartanStoreClose()
      ShoppingState.Set(0)
      wgt.Widgets().spartanCont.StartDefaultBlinking(0.0)
      wgt.Widgets().spartanCont.tabSc1.StartDefaultBlinking(0.0)
      wgt.Widgets().spartanCont.tabSc2.StartDefaultBlinking(0.05)
      wgt.Widgets().spartanCont.tabSc3.StartDefaultBlinking(0.10)
      wgt.Widgets().spartanCont.spartanBtn1.StartDefaultBlinking(0.0)
      wgt.Widgets().spartanCont.spartanBtn2.StartDefaultBlinking(0.05)
      wgt.Widgets().spartanCont.spartanBtn3.StartDefaultBlinking(0.10)
      wgt.Widgets().spartanCont.spartanBtn4.StartDefaultBlinking(0.15)
      wgt.Widgets().spartanCont.spartanBtn5.StartDefaultBlinking(0.20)
   end

   func LoadoutSelectButtonClicked(p : params) : bool
      var loadoutIndex : int = (int)p.widget.Get("idx")
      if loadoutIndex != SelectedLoadoutIdx.Get() and wgt.HasUnsavedChanges()
         var pp : params
         pp.titleTxt       := "msg_spartan_unsaved_paint_ttl"
         pp.messageTxt     := "msg_spartan_unsaved_paint_msg"
         pp.callbackEvent  := "unsavedPaintConfirmationClosed3"
         pp.mbType         := $uiEnums.MB_TYPE_NO_YES
         confirmLoadoutIdx := loadoutIndex
         p.widget.GenerateEvent("MainMenuDialogRequest", pp)
      else
         $user_service.SetArmorLoadoutActive(0, loadoutIndex)
      end
      return true
   end

   func OnUnsavedPaintConfirmationClosed3(p : params) : bool
      if p.isOK
         $user_service.SetArmorLoadoutActive(0, confirmLoadoutIdx)
      end
      return false
   end
end
