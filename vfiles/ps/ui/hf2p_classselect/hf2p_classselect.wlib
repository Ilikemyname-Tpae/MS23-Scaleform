         }
         blink   =   {
            bindings   =   {
               mouseEnabled   =   {
                  binding   =   "{false}"
               }
               mouseChildren   =   {
                  binding   =   "{false}"
               }
               visible   =   {
                  binding   =   "{selectedRaceIdx == (:idx)}"
               }
            }
            __type   =   "ui_widget_container"
         }
         iconRace   =   {
            bindings   =   {
               pic   =   {
                  binding   =   "{''}"
               }
               mouseEnabled   =   {
                  binding   =   "{false}"
               }
               mouseChildren   =   {
                  binding   =   "{false}"
               }
            }
            __type   =   "ui_weaponConf_lib::attachPoint"
         }
      }
      bindings   =   {
         enabled   =   {
            binding   =   "{true}"
         }
         selected   =   {
            binding   =   "{selectedRaceIdx == (:raceIdx)}"
         }
      }
      customProps   =   [
         {
            propName   =   "raceIdx"
            propVal   =   {
               __type   =   "ui_widget_desc_prop_int"
            }
         }
      ]
      __type   =   "ui_weaponConf_lib::selectRaceCard"
   }
}
__type   =   "ui_wlib"
