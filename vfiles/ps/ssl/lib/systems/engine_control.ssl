   native func GetRegionLocaleShort(): string
   native func GotoWebLink(link: string, closeGame: bool)
   native func ShowCameraPosition(show: bool)
   native func IsShowCameraPosition() : bool
   native func ShowSoundsDbgInfo(show: bool)
   native func IsShowSoundsDbgInfo() : bool
   native func ShowMPDbgInfo(show: bool)
   native func IsShowMPDbgInfo() : bool
   native func UpdateMPDbgInfo(info: string)
   native func OnManagedHostChanged(name: string)
   native func SetOnPreLevelLoad(funcName: refFUNC_PTR)
   native func CheckNetType(netType: string, cb: refFUNC_PTR)
end
