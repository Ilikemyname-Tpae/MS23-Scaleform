func GetItemName(_itemId:string):string
   var ret:string 
   if (_itemId != "")
      var compUI  : GL_ComponentUI = (GL_ComponentUI)$UiGlobals.componentsUI.Get(_itemId)
      ret := (string)compUI.name.Get()
      return ret
   end
   return ret
end

handle OnChangeStateAny
   if (GetStateName() != "SeeArmorLoadout")
      Get("DC2").IsSeeState.Set(false)
   else
      Get("DC2").IsSeeState.Set(true)
   end
end

handle OnEnteringState("Initial")
end          

handle OnEnterState("Initial")
   Set("visible", false)           
end      

func BlinkWholeScreen()
   $root.playSound("armory_screen_appear_hud")
   StartDefaultBlinking()
end

func PrepareEnterLoadout(_showParts : bool)
   $hq.ShopVideoEndSafe()
   $hq.RenderLocalPlayer()
   $user_service.RequestData($UserDataStorage.local_user.uid.Get(), $uiEnums.USER_DATA_ARMOR_LOADOUT)
   $hq.ShowroomEnd()
   $hq.isInShowroom := false   
   viewParts := _showParts
   InitFocus()
   ShowPartsOrStats(viewParts)
   CamView()
end

func inputEvent(p : params) : bool
   if (GetStateName() != "ChoiceLoadoutBtn")
      if (p.keyCode != $uiKeys.VK_ENTER and p.keyCode != $uiKeys.VK_SPACE)
         p.eventState.SetIsTerminated()      
      end
      if (!IsChangingStateInProgress() and p.keyCode == $uiKeys.VK_ESC and ! p.isDown)
         if (Widgets().cancelBtn.visible)
            CloseArmoryLoadout(null)
         end
      elif (!IsChangingStateInProgress() and p.keyCode == $uiKeys.VK_ENTER and ! p.isDown)
         if (Widgets().doneBtn.visible)
            AcceptArmoryLoadout(null)
         end
      end
   end
   return false
end

handle OnEnteringState("SeeArmorLoadout")   
   PrepareEnterLoadout(true)
   
   Widgets().header.text            := "carousel_see_armor_loadout"
   Widgets().header.visible         := true
   Widgets().cancelBtn.visible      := true
   Widgets().cancelBtn.label        := "main_btn_back"
   Widgets().doneBtn.visible        := false
   Widgets().alslots.visible        := true
   //Widgets().tree.visible           := true
   //Widgets().viewStatsBtn.visible   := true
   Set("visible", true)
   //TmpDisable()
   AddTween("alpha", 1.0, Props().adelay, "linear")
   var i:int
   for i := 0 to 4
      Widgets().alslots.Get("armorLoadout" + i).mouseChildren := false
      //Widgets().alslots.Get("armorLoadout" + i).mouseEnabled := true  
   end  
   EnableFakeBg()
   BlinkWholeScreen()
end

handle OnLeavingState("SeeArmorLoadout")
   //
end

