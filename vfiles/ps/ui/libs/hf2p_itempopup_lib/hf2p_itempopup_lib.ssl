   var isEquipped          : ObservableProperty    = $OM.Property(true)
   var headerText          : ObservableProperty    = $OM.Property("main_itempopup_equipped")
   
   // Armors
   var armorModifs         : ObservableProperty    = $OM.Calculated(this, "GetArmorModifs")
   var armorBonusesTxt     : ObservableProperty    = $OM.Calculated(this, "GetArmorBonusesTxt")
   var armorStats          : UiArmorStatsHelper    = new UiArmorStatsHelper()
   var armorStatComp       : ObservableProperty    = $OM.Calculated(this, "GetArmorStatComp")
   var armorStatCompCmp    : ObservableProperty    = $OM.Calculated(this, "GetArmorStatCompCmp")
   
   // Progress Bars  
   var weaponComp          : ObservableProperty    = $OM.Calculated(this, "GetWeaponComp")
   var weaponCompCmp       : ObservableProperty    = $OM.Calculated(this, "GetWeaponCompCmp")
   var clipSize            : ObservableProperty    = $OM.Calculated(this, "GetClipSize")
   var barColor            : ObservableProperty    = $OM.Calculated(this, "GetBarColor")
   var tfColor             : ObservableProperty    = $OM.Calculated(this, "GetTfColor")
   
   // Tactical stats 
   var perkDuration        : ObservableProperty    = $OM.Calculated(this, "GetDuration")
   var perkCost            : ObservableProperty    = $OM.Calculated(this, "GetCost")
   var perkCooldown        : ObservableProperty    = $OM.Calculated(this, "GetCooldown")
   var textStatsVectorObs  : ObservableProperty    = $OM.Calculated(this, "GetTextStatsVector")
   var textStatsVector     : vector
   // TODO : Grenade & Boost
   
   //common
   var icon                : ObservableProperty    = $OM.Calculated(this, "GetIcon")
   var iconMed             : ObservableProperty    = $OM.Calculated(this, "GetIconMed")
   var name                : ObservableProperty    = $OM.Calculated(this, "GetName")
   var desc                : ObservableProperty    = $OM.Calculated(this, "GetDesc")
   var techClass           : ObservableProperty    = $OM.Calculated(this, "GetTechClass")
   var techClassIcon       : ObservableProperty    = $OM.Calculated(this, "GetTechClassIcon")
   var techClassName       : ObservableProperty    = $OM.Calculated(this, "GetTechClassName")
   var challengeRank       : ObservableProperty    = $OM.Calculated(this, "GetChallengeRank")
   var isChallengeRank     : ObservableProperty    = $OM.Calculated(this, "GetIsChallengeRank")
   
   var wgt                 : UiWidget              = null
   var contentType         : ObservableProperty    = $OM.Calculated(this, "GetContentType")
   var contentAnim         : ObservableProperty    = $OM.Calculated(this, "GetContentAnim")
   var contentWidth        : ObservableProperty    = $OM.Property(300.0)
   var contentHeight       : ObservableProperty    = $OM.Property(300.0)
   var contentMaskWidth    : ObservableProperty    = $OM.Property(300.0)
   var contentMaskHeight   : ObservableProperty    = $OM.Property(300.0)
   
   func InvalidateSize()
      if (wgt != null)
         var content : UiWidget = (UiWidget)wgt.GetWidget("content")
         
         var txt        : string = content.Widgets.desc.textField.text
         var textH      : float  = content.Widgets.desc.textField.textHeightEx
         var textBottom : float  = content.Widgets.desc.y + textH
         var yBottom    : float  = textBottom
         
         var contentTypeVal : string = (string)contentType.Get()
         if (contentTypeVal == "weapon")
            var itemType : int = $uiEconomy.GetItemType((string)itemId.Get())            
            if (itemType == $uiEnums.ITEM_TYPE_WEAPON)
               textBottom := textBottom + 16
               content.Widgets.progressBars.y := textBottom
               yBottom := textBottom + content.Widgets.progressBars.height - 12
            else
               textBottom := textBottom + 16
               yBottom := textBottom
            end
         elif (contentTypeVal == "tactical")
            textBottom := textBottom - 4
            content.Widgets.textStats.y := textBottom
            yBottom := textBottom + content.Widgets.textStats.height - 48
         elif (contentTypeVal == "armor")
            textBottom := textBottom
            content.Widgets.armorModifiersCont.y := textBottom
            yBottom := textBottom
            if (content.Widgets.armorModifiersCont.textArmorStats3.visible)
               yBottom := textBottom + content.Widgets.armorModifiersCont.height
            elif (content.Widgets.armorModifiersCont.textArmorStats2.visible)
               yBottom := textBottom + content.Widgets.armorModifiersCont.textArmorStats3.y
            elif (content.Widgets.armorModifiersCont.textArmorStats1.visible)
               yBottom := textBottom + content.Widgets.armorModifiersCont.textArmorStats2.y
            elif (content.Widgets.armorModifiersCont.textArmorStats0.visible)
               yBottom := textBottom + content.Widgets.armorModifiersCont.textArmorStats1.y
            end
            yBottom := yBottom + 8
         end
         
         contentWidth.Set(300.0)
         contentHeight.Set(yBottom)
         contentMaskWidth.Set((float)contentWidth.Get() - 2)
         contentMaskHeight.Set((float)contentHeight.Get() - 2)
      end
   end
      
   func Init(itemIdVal : string)
      itemId.Set(itemIdVal)
      InvalidateTextStats()
   end
   
   func Term()
      itemId.Set("")
   end
   
