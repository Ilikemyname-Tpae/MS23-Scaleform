   Widgets().alslots.visible        := true
   //Widgets().tree.visible           := false
   //Widgets().viewStatsBtn.visible   := false
   Set("visible", true)
   //TmpDisable()   
   AddTween("alpha", 1.0, Props().adelay, "linear")
   var i:int
   for i := 0 to 4
      Widgets().alslots.Get("armorLoadout" + i).mouseChildren := false
   end
   EnableFakeBg()
   BlinkWholeScreen()
end

func EnableFakeBg()
   var p: params
   if (viewParts)
      p.state := "spartanUnit"
   else
      p.state := "spartanLoadout"
   end
   GenerateEvent("ChangeFakeBackground", p)
end

handle OnLeavingState("AssignArmor2Loadout")
   //      
end

func SetScreenAlpha(_alpha: float)
   Props().alpha := _alpha
end

func OnDialogShowTween(p: params): bool
   var alphaParm : float = p.dialogTweenParm
   if (GetStateName() != "Initial")
      SetScreenAlpha(100.0 - alphaParm * 95)
   end
   return true
end

end

class ArmorLoadoutsViewModel
   var IsStatsVisible : ObservableProperty = $OM.Property(false)
   var IsSeeState     : ObservableProperty = $OM.Property(false)
   var counter        : ObservableProperty = $OM.Calculated(this, "GetArmorLoadoutCounter")
   
   func GetArmorLoadoutCounter() : int
      var ret : int
      var udLocal : UserDataLocal = $UserDataStorage.local_user
      ret := (int)udLocal.armor_loadouts_unlocked.Get()
      return ret
   end
   
   func OfferPanelVisible(_loadoutIdx : int) : bool
      var ret : bool
      var udLocal : UserDataLocal = $UserDataStorage.local_user
      var unlockedArmorLoadouts : int = (int)udLocal.armor_loadouts_unlocked.Get()
      return ret
   end
   
   func OfferLineVisible(_loadoutIdx : int) : bool
      var ret : bool
      var hasLoadout : bool
      hasLoadout := _loadoutIdx < (int)counter.Get()
      if ((bool)IsSeeState.Get())
         if (hasLoadout)
            ret := false
         else
            ret := true
         end
      else
         ret := false
      end
      return ret
   end
   
   func EnableOfferBtns(_loadoutIdx : int) : bool
      var ret : bool
      if (_loadoutIdx > (int)counter.Get())
         ret := false
      else
         ret := true
      end
      return ret
   end
   
   func SetOfferPanelHeader(_loadoutIdx : int) : string
      var ret : string
      if (_loadoutIdx > (int)counter.Get())
         ret := "carousel_ui_btn_unavailable"
      else
         ret := "carousel_txt_non_purchased"
      end
      return ret
   end

end

