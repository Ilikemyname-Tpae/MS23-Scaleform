func presenceTimeoutMbClose(p: params): bool
   if (! IsVoid(p.newState) and p.newState != "")
      SetStateName(p.newState)
   end
   return false
end

func genericErrorMessageBoxClosed(p :  params) : bool
   if (! IsVoid(p.newState) and p.newState != "")
      if (p.newState == "WelcomeInitial")         
         $root.SetMainStartState("Welcome")   
      end
      SetStateName(p.newState)
   end
   return false
end

global event uiErrorMessageBox(message: string)
   var   pp             : params
   var   doShowError    : bool = true
   var   autoClose      : bool = true
   var   newState       : string = ""
         
   if ($root.IsAcceptingErrors())
      $root.StopAcceptingErrors()
      Log("ui~hf2p_main_menu", "uiErrorMessageBox : message = [" + message + "]")
      
      if (message == "join_failed_host_timed_out")
         pp.titleTxt       := "msg_connection_error_title"
         pp.messageTxt     := "msg_connection_error"
         pp.callbackEvent  := "hostTimeOutError"
      else if (message == "join_failed_generic_error")
         pp.titleTxt       := "msg_connection_error_title"
         pp.messageTxt     := "msg_connection_error_genric"
         pp.callbackEvent  := "genericJoinError"
      else if (message == "join_failed_invalid_executable_type")
         pp.titleTxt       := "msg_connection_error_title"
         pp.messageTxt     := "msg_connection_error_exe_type"
         pp.callbackEvent  := "joinInvalidExecutableType"
      else if (message == "presence_timeout")
         pp.titleTxt       := "msg_connection_error_title"
         pp.messageTxt     := "msg_presence_error"
         pp.callbackEvent  := "genericErrorMessageBoxClosed"
         newState          := "WelcomeInitial"
         autoClose         := false
      else if (message == "presence_session_failed")
         pp.titleTxt       := "msg_connection_error_title"
         pp.messageTxt     := "msg_presence_connect_failed"
         pp.callbackEvent  := "genericErrorMessageBoxClosed"
         newState          := "WelcomeInitial"
      else
         pp.titleTxt       := "msg_connection_error_title"
         pp.messageTxt     := message
         pp.callbackEvent  := "genericErrorMessageBoxClosed"
         newState          := "WelcomeInitial"
      end
      Widgets().timer.Reset()

      if (doShowError)
         pp.mbType         := "Info"
         pp.newState       := newState
         if (autoClose)
            pp.closeTimeout:= 10
         end
         bLog("UI/MMENU", "Main_Menu_ErrorMessageBox: " + message)
         GenerateEvent("MainMenuDialogRequest", pp)   
      end   
   end
end

global event PresenceSessionConnectFailed()
   uiErrorMessageBox("presence_session_failed")
end 

