      var i    : int      
      for i := 0 to shelves.Get().Count() - 1
         var shelf :  GL_ShopShelf = shelves.Get().Get(i)
         if (shelf.HasNewItems())
            ret := true
            break
         end
      end
      return ret
   end
   
end

