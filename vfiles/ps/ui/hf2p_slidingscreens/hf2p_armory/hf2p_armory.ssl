class UiArmorStatsHelper
   
   func GetPartModifiersText(part_id : string) : wstring
      var ret : wstring = $UiGlobals.String2WString("")
      if part_id != ""
         var t : params
         t.mod_span_begin := $UiGlobals.String2WString("<br><span class=\"mod\">")
         t.mod_span_end := $UiGlobals.String2WString("</span>")
         var compArmor : GL_ComponentArmor = (GL_ComponentArmor)$UiGlobals.componentsArmor.Get(part_id)
         var i : int
         for i := 0 to compArmor.gameplay_modifiers.Get().Count() - 1
            var modif   : GL_ComponentArmorGameplayModifier = compArmor.gameplay_modifiers.Get().Get(i)
            var compUI  : GL_ComponentUI = (GL_ComponentUI)$UiGlobals.componentsUI.Get((string)modif.gameplay_modifier_id.Get())
            t.id     := $UiGlobals.TranslateText((string)compUI.name.Get())
            t.space  := $UiGlobals.String2WString(" ")
            t.value  := $root.FormatArmorModifTempHack((string)modif.gameplay_modifier_id.Get(), (float)modif.gameplay_modifier_value.Get())
            ret := ret + t.mod_span_begin + t.id + t.space + t.value + t.mod_span_end
         end
      end
      return ret
   end

   func GetItemSuitId(_itemId : string) : string
      var ret        : string
      var compArmor  : GL_ComponentArmor = (GL_ComponentArmor)$UiGlobals.componentsArmor.Get(_itemId)
      ret := (string)compArmor.suitId.Get()
      return ret
   end
   
   func AddWStrings(s1 : *, s2 : *, s3 : *) : wstring
      var ret : params
      ret.s1   := s1
      ret.s2   := s2
      ret.s3   := s3
      ret.ret  := s1
      ret.ret  := ret.ret + s2
      ret.ret  := ret.ret + s3
      return ret.ret
   end

   func GetArmorModifiers(loadout : UD_ArmorLoadout, writeCompletenessStatus : bool = false) : params
      var loadoutParams : params
      loadoutParams.armor     := loadout.armor.Get()
      return GetArmorModifiersFromParams(loadoutParams, writeCompletenessStatus)
   end
   
   func GetArmorModifiersFromParams(loadout : params, writeCompletenessStatus : bool = false) : params
      var ret  : params
      var t    : params
      var text : wstring
      t.part_span_begin_first := $UiGlobals.String2WString("<span class=\"part\">")
      t.part_span_begin       := $UiGlobals.String2WString("<br><span class=\"part\">")
      t.part_span_end         := $UiGlobals.String2WString("</span>")
      t.mod_span_begin        := $UiGlobals.String2WString("<br><span class=\"mod\">")
      t.mod_span_end          := $UiGlobals.String2WString("</span>")
      t.complete_span_begin   := $UiGlobals.String2WString("<span class=\"completeSet\">")
      t.incomplete_span_begin := $UiGlobals.String2WString("<span class=\"incompleteSet\">")
      t.span_end              := $UiGlobals.String2WString("</span>")
      t.br                    := $UiGlobals.String2WString("<br>")
      
      t.armor := loadout.armor
      
      t.armor_txt := (string)$UiGlobals.componentsUI.Get(t.armor).name.Get()
      t.armor_mod := GetPartModifiersText(t.armor)

      text := t.armor_txt + " " + t.armor_mod
      
      ret.text := text
      
      return ret
   end   
end

