class UiHudMedalsVM : UiWidgetContainer
   var   isSubscribed      : bool                     = false
   var   wgt               : UiHudMedals              = null
   var   currentMedal      : string                   = ""
   var   medalIdx          : int                      = 0
   var   medal1            : UiHudMedalVM             = new UiHudMedalVM()
   var   medal2            : UiHudMedalVM             = new UiHudMedalVM()
   var   medal3            : UiHudMedalVM             = new UiHudMedalVM()
   var   scoringEvents     : UiScoringEventsListVM    = new UiScoringEventsListVM()
   var   scoringTotal      : UiScoringEventsTotalVM   = new UiScoringEventsTotalVM()
   var   loopSoundPlaying  : bool                     = false
   
   var   medalsDuration       : float                    = 2.0
   var   medalsStayDuration   : float                    = 1.5
   
   var   entryDuration        : float                    = 2.0
   var   entryDurationGrow    : float                    = 1.0
   var   entryAddDuration     : float                    = 1.0
   var   entryAddDurationGrow : float                    = 1.0

   
   func Init(p : params)
      wgt := p.widget
      scoringEvents.InitWgt((UiWidget)wgt.GetWidget("scoreEventsList"), entryDuration, entryDurationGrow, entryAddDuration, entryAddDurationGrow)
      scoringTotal.InitWgt((UiWidget)wgt.GetWidget("scoringEventTotals"), entryDuration, entryDurationGrow, entryAddDuration, entryAddDurationGrow)
   end

   func Term()
      UnsubscribeFromEvents()
   end

   func SubscribeToEvents()
      if (! isSubscribed)
         isSubscribed := true
         scoringTotal.EnableTweenVM()
         $UiIngame.scoring_event.Subscribe(this, "UpdateScoringEvents")
         $UiIngame.medal.Subscribe(this, "UpdateMedals")
         UpdateScoringEvents()
         UpdateMedals()
      end
   end

   func UnsubscribeFromEvents()
      StopMedalFadeout()
      if (isSubscribed)
         scoringTotal.DisableTweenVM()
         $UiIngame.scoring_event.Unsubscribe(this, "UpdateScoringEvents")
         $UiIngame.medal.Unsubscribe(this, "UpdateMedals")
         isSubscribed := false
      end      
      StopLoopingSounds()
   end

   func StopLoopingSounds()
      $root.stopSound("score_tally_looping")
      loopSoundPlaying := false
   end

   func HudMedalsVisible()
      loopSoundPlaying := false
      SubscribeToEvents()
   end

   func HudMedalsInitial()
      UnsubscribeFromEvents()
   end
      
   func HudMedalAnimFinished()
      StopMedalFadeout()
      StartMedalFadeout() : (medalsStayDuration), FADE_OUT_MEDALS
      $UiIngame.MedalNext() 
   end

   func HudScoringEventFinished()
      $UiIngame.ScoringEventNext()
   end
   
   func HudScoringTotalsFadedOut()
      $UiIngame.ScoringEventNext()
   end
   
   func HudScoringEventFinishedAll()
      $root.playSound("score_tally_end")
      scoringTotal.FinishTween()
   end
         
   func OnTotalsGrowFinished()
      StopLoopingSounds()
      scoringEvents.SetIsIdleTotals(true)
   end
      
   func StartMedalFadeout()
      StartMedalShow("")
   end
   
   func StopMedalFadeout()
      delay kill, this, FADE_OUT_MEDALS
   end

   func UpdateScoringEventOrMedal(_eventId : string, _isMedal : bool)
      if (_eventId != "")
         if (_isMedal)
            StartMedalShow(_eventId)
         else
            StartEventShow(_eventId)
         end
      end      
   end   

   func UpdateScoringEvents()
      if (! scoringTotal.IsFadingOut())
         var eventId : string = (string)$UiIngame.scoring_event.Get()
         UpdateScoringEventOrMedal(eventId, false)
      end
   end   
   
   func UpdateMedals()
      var eventId: string = (string)$UiIngame.medal.Get()
      UpdateScoringEventOrMedal(eventId, true)
   end   
   
   func StartEventShow(_scoringEventId: string)     
      if (_scoringEventId != "")
         scoringEvents.AddNewEvent(_scoringEventId)
         scoringTotal.AddNewEvent(_scoringEventId)
         if (_scoringEventId != "")
            if (! loopSoundPlaying)
               loopSoundPlaying := true
               $root.playSound("score_tally_start")
               $root.playSound("score_tally_looping")
            end
         end
      end      
   end 
   
   func StartMedalShow(_scoringEventId: string)      
      StopMedalFadeout()
      if (wgt != null)
         medal1.SetMedalId(currentMedal)
         medal2.SetMedalId(_scoringEventId)
         wgt.StartMedalAnim(medalsDuration)
         currentMedal := _scoringEventId
         if (currentMedal != "")
            $root.playSound("medals_popup")
         end
      end
   end
end
