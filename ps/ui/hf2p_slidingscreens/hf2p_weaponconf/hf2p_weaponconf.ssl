class UiContent : UiWidgetContainer

var isSlidingElement :  bool     = false

func OpenBuyDialogue(p : params) : bool
   var itemId : string = p.itemId
   var offer : GL_ComponentShopOffer = p.offer
   var isGold : bool = p.isGold
   var playerCurrency = 0
   var offerString : string
   var offerCost : int
   if offer == null
      return true
   end
   if isGold
      playerCurrency := (int)$UserDataStorage.local_user.gold.Get()
      offerString := (string)offer.gl_offer.Get()
      offerCost := (int)offer.gl_cost.Get()
   else
      playerCurrency := (int)$UserDataStorage.local_user.cr.Get()
      offerString := (string)offer.cr_offer.Get()
      offerCost := (int)offer.cr_cost.Get()
   end
   if offerString != ""
      var par: params
      par.itemID        :=  itemId
      par.offer         := offerString
      if isGold
         par.priceGold     := offerCost
      else
         par.priceCredit   := offerCost
      end
      if (offerCost <= playerCurrency)
         // is rent ?
         var ret : int = 0
         ret := (int)offer.rent_duration.Get()
         if (ret > 0)
            par.isRent := true
         end
         // end 
         par.mbType           := "ConfirmBuy"
         par.callbackEvent    := "OnItemPurchased"
         par.callbackTarget   := Props()
      else
         par.mbType     := "Info"
         par.titleTxt   := "msg_ui_warning"
         if isGold
            par.messageTxt := "msg_ui_not_enough_gp"
         else
            par.messageTxt := "msg_ui_not_enough_cr"
         end
      end
      $sslWidgetMgr.GenerateEvent("MainMenuDialogRequest", par)
   end
   return true
end

func OnLeaveLobby() : bool
   Log("ui~content", " WeaponConfig::OnLeaveLobby() ")
   GenerateEvent("LeaveLobby")
   return false
end

func SwitchToScreen()   
   Widgets().weaponList.SetFocus()   
end

func OnOpenLoadoutBtnClicked(p:params):bool
   Log("ui~content", "OnOpenLoadoutBtnClicked")
   GenerateEvent("SeeLoadout", p)
   return false
end

handle OnEnteringState("Initial")
   Log("ui~content", "Weapon Config OnEntering Initial!!!")
end          

handle OnEnterState("Initial")
   Log("ui~content", "Weapon Config onEnter Initial!!!")
   Set("visible", false)            
end          

handle OnEnteringState("Visible")
   Log("ui~content", "Weapon Config OnEntering VISIBLE!!!")         
   Set("visible", true)
end  

handle OnEnterState("Visible")
   Log("ui~content", "Weapon Config onEnter VISIBLE!!!")         
end

func PrepareSlide()
   if (GetStateName() != "Visible")
      SetStateName("Visible")
   end
   EnableFakeBg()
   GenerateEvent("#OpenedWeaponConfig")
   StartDefaultBlinking(0.3)
end

func PrepareHideSlide()
end

func OnBlinkItemList(p : params) : bool
   Widgets().weaponList.SetSelectionIdx(0)
   Widgets().weaponList.StartDefaultBlinking(0.0)
   Widgets().loadoutSelector.StartDefaultBlinking(0.0)
   BarsBlink() : 0
   $root.playSound("screen_rollout")
   return false
end

func BarsBlink()
   Widgets().progressBars.StartDefaultBlinking(-0.4, 1.1)
end

func DisableSlide()
   if (GetStateName() != "Initial")
      SetStateName("Initial")
   end
end

func EnableFakeBg()
   var p: params
   p.state := "weapons"
   GenerateEvent("ChangeFakeBackground", p)
end

func OnItemPurchased(p : params) : bool
   if (p.isOK)
      GenerateEvent("#OnWeaponPurchased", p)
   end
   return true
end

func SetListSelection(p : params) : bool
   Widgets().weaponList.SetSelectionIdx(p.idx)
   return false
end

end

class WeaponItemLIR
   var wgt           : UiWidget = null
   var itemId        : ObservableProperty = $OM.Property("")

   var minOffer      : ObservableProperty = $OM.Calculated(this, "GetMinOffer") 
   var maxDiscount   : ObservableProperty = $OM.Calculated(this, "GetMaxDiscount") 

   var weaponTint    : ObservableProperty = $OM.Calculated(this, "GetWeaponTint")
   var isWeaponTintVisible : ObservableProperty = $OM.Calculated(this, "GetIsWeaponTintVisible")
   var offerGp       : ObservableProperty = $OM.Calculated(this, "GetOfferGp")
   var offerCr       : ObservableProperty = $OM.Calculated(this, "GetOfferCr")
   var ownType       : ObservableProperty = $OM.Calculated(this, "GetOwnType")
   var isOffers      : ObservableProperty = $OM.Calculated(this, "GetIsOffers")
   var rentStatus    : ObservableProperty = $OM.Calculated(this, "GetRentStatus")
   var rentStatusColor :  ObservableProperty = $OM.Calculated(this, "GetRentStatusColor")
   var weaponIndicatorScaleX    : ObservableProperty = $OM.Calculated(this, "GetWeaponIndicatorScaleX")
   var isGpCrLock    : ObservableProperty = $OM.Calculated(this, "GetIsGpCrLock")
   var equipIcn      : ObservableProperty = $OM.Calculated(this, "GetEquipIcon") 
   var isNew         : ObservableProperty = $OM.Calculated(this, "GetIsNew")
   var itemQuality   : ObservableProperty = $OM.Calculated(this, "GetWeaponQuality")
   
   func Init(p : params)
      wgt := p.widget
      if (! IsVoid(p.itemId))
         itemId.Set(p.itemId)
      end
      wgt.Props().mouseChildren := true
   end
   
   func Update(p : params)
      itemId.Set(p.itemId)
   end
   
   func OnItemPriceGoldClicked(p : params) : bool
      var p2 : params
      p2.itemId := itemId.Get()
      p2.offer := $UiGlobals.componentsShop.Get(itemId.Get()).GetMinimalOffer()
      p2.isGold := true
      wgt.GenerateEvent("#OpenBuyDialogue", p2)
      return true
   end
   
   func OnItemPriceCrClicked(p : params) : bool
      var p2 : params
      p2.itemId := itemId.Get()
      p2.offer := $UiGlobals.componentsShop.Get(itemId.Get()).GetMinimalOffer()
      p2.isGold := false
      wgt.GenerateEvent("#OpenBuyDialogue", p2)
      return true
   end
   
   func OnItemLirClicked(p : params) : bool
      var x : * = wgt.Props().mouseChildren
      
      if isNew.Get() == true
         $hq.ShopNewClear((string)itemId.Get())
      end
      return true
   end
   
   func GetMinOffer() : GL_ComponentShopOffer
      var ret : GL_ComponentShopOffer = null
      if ((bool)isOffers.Get())
         var shopComp : GL_ComponentShop = (GL_ComponentShop)$UiGlobals.componentsShop.Get((string)itemId.Get())
         if (shopComp.offers.Get().Count() > 0)
            ret := shopComp.GetMinimalOffer()
         end
      end
      return ret
   end
      
   func GetMaxDiscount() : string
      var ret : string = ""
      if ((bool)isOffers.Get())
         var shopComp : GL_ComponentShop = (GL_ComponentShop)$UiGlobals.componentsShop.Get((string)itemId.Get())
         if (shopComp.offers.Get().Count() > 0)
            var maxDisc : float = 0
            var i : int
            for i := 0 to shopComp.offers.Get().Count() - 1
               var offer : GL_ComponentShopOffer = shopComp.offers.Get().Get(i)
               if (float)offer.cr_sale_percentage.Get() > maxDisc
                  maxDisc := (float)offer.cr_sale_percentage.Get()
               end
               if (float)offer.gl_sale_percentage.Get() > maxDisc
                  maxDisc := (float)offer.gl_sale_percentage.Get()
               end
            end
            if maxDisc > 0
               ret := "-" + (string)(int)(maxDisc * 100) + "%"
            end
         end
      end
      return ret
   end
      
   func GetIsGpCrLock() : bool
      var ret : bool
      ret := IsCrLock() and IsGlLock()
      return ret
   end
   
   func GetWeaponTint() : params
      var itemIdS :  * = itemId.Get()
      var itemIdStr :  string = (string)itemId.Get()
      var   tint     : params = $uiEconomy.GetWeaponPrimaryArrtibuteColor("unknown")
      if (itemIdStr != "")
         var   weapon   :  GL_ComponentWeapon = (GL_ComponentWeapon)$UiGlobals.componentsWeapon.Get(itemIdStr)
         if (weapon != null)
            tint := $uiEconomy.GetWeaponPrimaryArrtibuteColor((string)weapon.primary_attribute_id.Get())
         end
      end
      return tint
   end
   
   func GetIsWeaponTintVisible() : bool
      var itemIdS :  * = itemId.Get()
      var itemIdStr :  string = (string)itemId.Get()
      var ret     : bool = false
      if (itemIdStr != "")
         var   weapon   :  GL_ComponentWeapon = (GL_ComponentWeapon)$UiGlobals.componentsWeapon.Get(itemIdStr)
         if (weapon != null)
            ret := (string)weapon.primary_attribute_id.Get() != "none" and (string)weapon.primary_attribute_id.Get() != ""
         end
      end
      return ret
   end
   
   func GetWeaponQuality() : string
      var ret : string = "common"
      var itemIdStr : string = (string)itemId.Get()
      if (itemIdStr != "")
         ret := (string)$UiGlobals.componentsUI.Get(itemIdStr).quality.Get()
      end
      return ret  
   end
   
   func GetWeaponIndicatorScaleX() : float
      var ret : float
      var ownTypeVal :  int = GetOwnType()
      if (ownTypeVal == $uiEnums.ITEM_OWN_TYPE_NONE)
         ret := 1.0
      else
         ret := 2.625
      end
      return ret
   end
   
   func GetEquipIcon() : bool
      var ret : bool
      var uiInventoryItem : GL_ComponentInventory = (GL_ComponentInventory)$UiGlobals.componentsInventory.Get((string)itemId.Get())
      var equipType : int = (int)uiInventoryItem.equipped_state.Get()
      if (equipType == 2)
         ret := true
      else   
         ret := false
      end
      return ret
   end 
   
   func GetIsNew() : bool
      var ret = $uiEconomy.GetIsItemNew((string)itemId.Get())
      return ret
   end
   
   func GetOfferGp() : string
      if minOffer.Get() != null
         var offer = (GL_ComponentShopOffer)minOffer.Get()
         return (string)(int)offer.gl_cost.Get()
      else
         return "carousel_offer_na_small"
      end
   end
   
   func GetOfferCr() : string
      if minOffer.Get() != null
         var offer = (GL_ComponentShopOffer)minOffer.Get()
         return (string)(int)offer.cr_cost.Get()
      else
         return "carousel_offer_na_small"
      end
   end

   func GetOwnType() : int
      return $uiEconomy.GetItemOwnType((string)itemId.Get())
   end
   
   func GetIsOffers() : bool
      var ret : bool
      //if (GetOwnType() == $uiEnums.ITEM_OWN_TYPE_NONE and (IsGlLock() or IsCrLock()))         
      //if (GetOwnType() == $uiEnums.ITEM_OWN_TYPE_NONE or IsGlLock() or IsCrLock())         
      if (GetOwnType() == $uiEnums.ITEM_OWN_TYPE_NONE)         
         ret := true
      else
         ret := false
      end
      return ret
   end
   
   func GetRentTime() : int
      var ret        : int = 0
      var ownTypeVal : int = (int)ownType.Get()
      if (ownTypeVal == $uiEnums.ITEM_OWN_TYPE_RENTED)
         var uiInventoryItem : GL_ComponentInventory = (GL_ComponentInventory)$UiGlobals.componentsInventory.Get((string)itemId.Get())
         var ownTime : int = (int)uiInventoryItem.ownership_time.Get() - (int)$UiGlobals.timer.Get()
         ret := ownTime
      end
      return ret      
   end
      
   func IsLocked() : bool
      return $uiEconomy.IsItemLocked((string)itemId.Get())
   end
   
   func IsGlLock() : bool
      return $uiEconomy.IsItemLockedGl((string)itemId.Get())
   end

   func IsCrLock() : bool
      return $uiEconomy.IsItemLockedCr((string)itemId.Get())
   end
   
   func GetRentStatusColor() : int
      return $uiEconomy.GetItemRentTintColor((string)itemId.Get())
   end
   
   func GetRentStatus() : string
      var ret        : string      
      
      var ownTypeVal : int = (int)ownType.Get()
      if (ownTypeVal == $uiEnums.ITEM_OWN_TYPE_PURCHASED)
         ret := "carousel_rent_time_purchased"
      elif (ownTypeVal == $uiEnums.ITEM_OWN_TYPE_RENTED)
         var ownTime : int = GetRentTime()
         if (ownTime > 0)
            ret := $root.MakeUiTimerStringMinutes(ownTime, true)
         else
            ret := "carousel_rent_time_expiring"
         end
      end
      
      return ret
   end
 end

class ItemDescPanelVM
   var itemId           : ObservableProperty = $OM.Property("")
   var itemDesc         : ObservableProperty = $OM.Calculated(this, "GetItemDesc")
   var itemSubDesc      : ObservableProperty = $OM.Calculated(this, "GetItemSubDesc")
   var itemName         : ObservableProperty = $OM.Calculated(this, "GetItemName")
   var isLockLineGp     : ObservableProperty = $OM.Calculated(this, "GetIsLockLineGp")
   var lockLineGp       : ObservableProperty = $OM.Calculated(this, "GetLockLineGp")
   var lockLineGpCoordY : ObservableProperty = $OM.Calculated(this, "GetLockLineGpCoordY")
   var isLockLineCr     : ObservableProperty = $OM.Calculated(this, "GetIsLockLineCr")
   var lockLineCr       : ObservableProperty = $OM.Calculated(this, "GetLockLineCr")
   var lockLineCrCoordY : ObservableProperty = $OM.Calculated(this, "GetLockLineCrCoordY")
   var weaponClr        : ObservableProperty = $OM.Calculated(this, "GetWeaponColor")
      
   func GetItemDesc() : string
      var ret     : string
      var compUI  : GL_ComponentUI = (GL_ComponentUI)$UiGlobals.componentsUI.Get((string)itemId.Get())
      ret := (string)compUI.desc.Get()
      return ret
   end
   
   func GetWeaponColor() : int
      var itemIdS   : * = itemId.Get()
      var itemIdStr : string = (string)itemId.Get()
      var tint      : params = $uiEconomy.GetWeaponPrimaryArrtibuteColor("unknown")
      var clr       : int = 0 
      if (itemIdStr != "")
         var   weapon   :  GL_ComponentWeapon = (GL_ComponentWeapon)$UiGlobals.componentsWeapon.Get(itemIdStr)
         if (weapon != null)
            tint := $uiEconomy.GetWeaponPrimaryArrtibuteColor((string)weapon.primary_attribute_id.Get())
            clr := $root.RGB2Clr(tint.r, tint.g, tint.b)
         end
      end
      return clr
   end
   
   func GetOwnType() : int
      return $uiEconomy.GetItemOwnType((string)itemId.Get())
   end
   
   func GetItemName() : string
      var ret     : string
      var compUI  : GL_ComponentUI = (GL_ComponentUI)$UiGlobals.componentsUI.Get((string)itemId.Get())
      ret := (string)compUI.name.Get()
      return ret
   end

   func GetItemSubDesc() : string
      var ret     : string = ""
      return ret
   end
   
   func GetIsLockLineGp() : bool
      return $uiEconomy.IsItemLockedGl((string)itemId.Get()) or $uiEconomy.IsItemLockedCr((string)itemId.Get())
   end
   
   func GetLockLineGp() : string
      var ret : string = ""
      if (GetIsLockLineGp())
         ret := (string)$uiEconomy.GetItemLockedGlLvl((string)itemId.Get())
      end
      return ret
   end
   
   func GetLockLineGpCoordY() : float
      var ret : float = 3
      if (GetIsLockLineCr())
         ret := -24
      end
      return ret
   end
   
   func GetIsLockLineCr() : bool
      return false
   end
   
   func GetLockLineCr() : string
      var ret : string = ""
      if (GetIsLockLineCr())
         ret := (string)$uiEconomy.GetItemLockedCrLvl((string)itemId.Get())
      end
      return ret
   end
   
   func GetLockLineCrCoordY() : float
      var ret : float = 3
      return ret
   end
   
   func UpdateItemId(val : string)
      itemId.Set(val)
   end
end

