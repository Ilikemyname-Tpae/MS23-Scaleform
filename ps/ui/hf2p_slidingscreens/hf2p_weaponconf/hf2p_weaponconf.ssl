   //var cmpBarColor   : ObservableProperty = $OM.Calculated(this, "GetCmpBarColor")
   
   func UpdateItemId(val : string)
      itemId.Set(val)
   end
   
   func GetScaleDmgBar() : float
      var ret : float
      var selectedWpn  :  GL_ComponentWeapon = GetWpnStats()
      var wpnStat      :  float = 0
      var myWpn        :  GL_ComponentWeapon = GetMyWeapon()
      var myWpnStat    :  float = 0 
      if (selectedWpn == null or myWpn == null)
         return 0
      end
      // null check
      wpnStat := (float)selectedWpn.damage.Get()
      myWpnStat := (float)myWpn.damage.Get()
      if (wpnStat >= myWpnStat)
         ret := myWpnStat
      else
         ret := wpnStat
      end
      return ret
   end
   
