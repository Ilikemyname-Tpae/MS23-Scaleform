   ShopDescPanel   =   {
      sslClass   =   "UiShopDescPanel"
      sslModule   =   "ui.libs.hf2p_WeaponConf_lib.hf2p_WeaponConf_lib"
      elements   =   {
         animDescHead   =   {
            propMapping   =   {
               stateTextColor   =   {
                  mapping   =   "stateText.textColor"
               }
            }
            elements   =   {
               classIcon   =   {
                  elements   =   {
                     placeHolder   =   {
                        visible   =   False
                        __type   =   "ui_weaponConf_lib_slide::placeHolderContent"
                     }
                  }
                  bindings   =   {
                     pic   =   {
                        binding   =   "{GetTechIcon()}"
                     }
                  }
                  isCentered   =   True
                  __type   =   "ui_weaponConf_lib_slide::attachPointArmrStat"
               }
               medal2   =   {
                  bindings   =   {
                     anim   =   {
                        binding   =   "{GetChallengeRank() >= 2 ? 'gold' : 'gray'}"
                     }
                     visible   =   {
                        binding   =   "{GetEagleVisible()}"
                     }
                  }
                  __type   =   "ui_weaponConf_lib_slide::medalChallenge"
               }
               medal1   =   {
                  bindings   =   {
                     anim   =   {
                        binding   =   "{GetChallengeRank() >= 1 ? 'silver' : 'gray'}"
                     }
                     visible   =   {
                        binding   =   "{GetEagleVisible()}"
                     }
                  }
                  __type   =   "ui_weaponConf_lib_slide::medalChallenge"
               }
               medal0   =   {
                  bindings   =   {
                     anim   =   {
                        binding   =   "{GetChallengeRank() >= 0 ? 'bronze' : 'gray'}"
                     }
                     visible   =   {
                        binding   =   "{GetEagleVisible()}"
                     }
                  }
                  __type   =   "ui_weaponConf_lib_slide::medalChallenge"
               }
            }
            bindings   =   {
               className   =   {
                  binding   =   "{GetTechName()}"
               }
               itemName   =   {
                  binding   =   "{GetName()}"
               }
               description   =   {
                  binding   =   "{GetDescription()}"
               }
               stateText   =   {
                  binding   =   "{GetUnlockDescTxt()}"
               }
               stateTextColor   =   {
                  binding   =   "{GetStateTextColor()}"
               }
            }
            __type   =   "ui_widget_container"
         }
         animDescShop   =   {
            bindings   =   {
               description   =   {
                  binding   =   "{GetDescription()}"
               }
            }
            __type   =   "ui_widget_container"
         }
      }
      stateMap   =   {
         startState   =   "Initial"
         states   =   {
            Collapsed   =   {
               transitionsIn   =   {
                  any   =   {
                     action   =   {
                        anim   =   "fadeOut"
                        __type   =   "ui_widget_action_anim"
                     }
                  }
               }
            }
            Full   =   {
               transitionsIn   =   {
                  any   =   {
                     action   =   {
                        anim   =   "fadeIn"
                        __type   =   "ui_widget_action_anim"
                     }
                  }
               }
            }
            Initial   =   {
            }
         }
      }
      bindings   =   {
         DC   =   {
            binding   =   "{new: 'ui.libs.hf2p_WeaponConf_lib.hf2p_WeaponConf_lib.ShopDescPanelVM', itemId = descpanelVM.itemId}"
         }
      }
      __type   =   "ui_weaponConf_lib_slide::ArmoryDescriptionDescNew"
   }
