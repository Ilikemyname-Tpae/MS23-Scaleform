                        }
                        bindings   =   {
                           DC   =   {
                              binding   =   "{loadoutVM.userData.GetActiveCharacter()}"
                           }
                           selected   =   {
                              binding   =   "{true}"
                           }
                           UD   =   {
                              binding   =   "{loadoutVM.userData}"
