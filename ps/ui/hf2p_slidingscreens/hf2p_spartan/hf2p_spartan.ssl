func KillDelays()
   delay kill, this, PAINT_ROLLOVER 
   delay kill, this, PAINT_ROLLOUT 
end

func onSpartanMarkClicked(p:params):bool
   Log("ui~content", "onSpartanMarkClicked")
   var mark : string = p.widget.markTag
   if (mark == "parts" and selectedTab != "parts")
      if selectedTab == "paint" and unsavedChanges
         var pp : params
         pp.titleTxt       := "msg_spartan_unsaved_paint_ttl"
         pp.messageTxt     := "msg_spartan_unsaved_paint_msg"
         pp.callbackEvent  := "unsavedPaintConfirmationClosed2"
         pp.mbType         := $uiEnums.MB_TYPE_NO_YES
         gotoMark := "parts"
         GenerateEvent("MainMenuDialogRequest", pp)
      else
         SetStateName("Visible")
         InitSpartanParts(0)
         selectedTab := mark
      end
   else if (mark == "acc" and selectedTab != "acc")  
      selectedTab := mark
   else if (mark == "paint" and selectedTab != "paint")
      SetStateName("SpartanVisible")
      InitSpartanPaint()
      selectedTab := mark
   end
   return false
end
