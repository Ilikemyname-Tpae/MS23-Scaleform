   end
   
   func IsMembersBtnVisible() : bool
      var selectedChannel  : int    = GetSelectedChannel()
      var ret              : bool   = (bool)isMembersPanelEnabled.Get() and ! GetIsCollapsed() and selectedChannel != $uiEnums.CHAT_CHANNEL_NEWS
      return ret
   end
   
   func GetBgHeight() : float
      var ret : float = 103 //+ GetSizeDifference()
      return ret      
   end
   
   func GetUsersBgHeight() : float
      var ret : float = 56 + GetSizeDifference()
      return ret      
   end
   
   func GetUsersBgHeightDelayed() : float
      var ret : float = 56 + GetSizeDifferenceDelayed()
      return ret      
   end
   
   func GetChatHeight() : float
      var ret : float = 0
      //if (! GetIsCollapsed())
         ret := (float)chatSizeDiff.Get()         
      //end
      return ret
   end
      
   func GetChatHeightDelayed() : float
      var ret : float = 0
      ret := (float)chatSizeDiffDelayed.Get()         
      return ret
   end
   
   func ChatStartDrag(p : params) : bool
      chatDragStart     := (float)chatSizeDiff.Get()
      var pp: params
      pp.dragEvent   := "ChatDrag"
      pp.dragTarget  := wgt.Widgets().expandBtn.object
      StopSizeTween()
      wgt.Widgets().expandBtn.SetFocus()
      wgt.GenerateEvent("StartUniversalDrag", pp)
      return true
   end
   
   var dragCounter : int = 0
   func ChatDrag(p : params) : bool
      if (p.updateType == "update" or p.updateType == "start")
         var newSize : float = (float)(chatDragStart - p.mouseOffset.y)
         if (newSize < 0)
            newSize := 0
         end
         if (newSize > 700)
            newSize := 700
         end
         if (newSize > 0)
            isCollapsed.Set(false)
         else
            isCollapsed.Set(true)
         end
         chatSizeDiff.Set(newSize)
         if (dragCounter == 0)
            chatSizeDiffDelayed.Set(newSize)
         end
         dragCounter := dragCounter + 1
         if (dragCounter == 15)
            dragCounter := 0
         end
      elif (p.updateType == "end")
         fullSize := (float)chatSizeDiff.Get()
         chatSizeDiffDelayed.Set(chatSizeDiff.Get())
         if (! GetIsCollapsed())
            wgt.SetFocus()
         end
      end
      return true
   end
   
   func GetSizeDifference() : float
      var ret : float = 0
      ret := GetChatHeight()
      return ret
   end
   
   func GetSizeDifferenceDelayed() : float
      var ret : float = 0
      ret := (float)chatSizeDiffDelayed.Get()
      return ret
   end
   
   func IsSendVisible() : bool
      var selectedChannel  : int    = GetSelectedChannel()
      var ret              : bool   = selectedChannel != $uiEnums.CHAT_CHANNEL_NEWS
      return ret
   end

   func GetMembersBtnYPos() : float
      var ret              : float  = 94.5 + GetSizeDifference()
      return ret      
   end
   
   func GetInputContYPos() : float      
      var ret              : float  = 93 + GetSizeDifference()
      return ret      
   end

   func GetSelectedChannel() : int
      var tabData : UiChatTabVMData = (UiChatTabVMData)tabs.GetSelectedTabData().Get()
      var ret     : int             = tabData.channel
      return ret
   end
   
   func FocusReceived()
      if (GetIsCollapsed())
         ToggleCollapsed(null)
      end
   end
   
   func FocusLost()
      if (! GetIsCollapsed())
         ToggleCollapsed(null)
      end
   end
   
   func ToggleCollapsed(p : params) : bool
      var curSize : float  = (float)chatSizeDiff.Get()
      var newSize : float  = curSize
      if (curSize == 0)
         newSize := fullSize
         if (newSize < 50)
            newSize := 500
         end
      else
         newSize := 0
      end
      var tweenParm : params
      tweenParm.propName   := "chatSize"
      tweenParm.startVal   := curSize         
      tweenParm.endVal     := newSize
      tweenParm.duration   := 0.128
      tweenParm.fadeType   := "linear"

      StopSizeTween()
      wgt.AddTweenCb("TweenChatSize", tweenParm) 
      //isCollapsed.Set(!GetIsCollapsed())
      return true
   end
   
   func StopSizeTween()
      wgt.RemTweens()      
   end
   
   func TweenChatSize(updType : string)
      var chatSize : float = (float)wgt.Get("chatSize")
      if (chatSize > 0)
         isCollapsed.Set(false)
      else
         isCollapsed.Set(true)
      end
      chatSizeDiff.Set(chatSize)
      if (updType == "complete")
         chatSizeDiffDelayed.Set(chatSize)         
         OnMessagesChanged(null)
      end
   end
   
   func GetIsCollapsed() : bool
      return (bool)isCollapsed.Get()
   end
   
   func GetChatYPos() : float
      var ret              : float  = -GetSizeDifference()
      return ret
   end
         
   func GetMembersListHeight() : float
      var ret              : float  = 37 + GetSizeDifferenceDelayed()
      return ret
   end
   
   func GetMessagesListHeight() : float
      var ret              : float  = 57 + GetSizeDifferenceDelayed()
      return ret
   end
   
   func GetMessagesListWidth() : float
      var ret              : float  = 695
      if (IsMembersVisible())
         ret := 495
      end
      return ret
   end
   
   func GetMessagesLIRWidth() : float
      var ret : float =  GetMessagesListWidth() - 30
      return ret
   end
      
   func GetNewsListHeight() : float
      var ret              : float  = 57 + GetSizeDifferenceDelayed()
      return ret
   end
   
   func GetMOTDYPos() : float      
      var ret              : float  = 105 + GetSizeDifference()
      return ret
   end
   
   func GetChatStream() : GL_ChatStream
      var ret              : GL_ChatStream   = null
      var selectedChannel  : int             = GetSelectedChannel()
      if (selectedChannel == $uiEnums.CHAT_CHANNEL_ALL)
         ret := $UiGlobals.chat.general
      elif (selectedChannel == $uiEnums.CHAT_CHANNEL_PARTY)
         ret := $UiGlobals.chat.party
      elif (selectedChannel == $uiEnums.CHAT_CHANNEL_GAME_ALL)
         ret := $UiGlobals.chat.game_all_channel
      elif (selectedChannel == $uiEnums.CHAT_CHANNEL_CLAN)
         ret := $UiGlobals.chat.clan_channel
      elif (selectedChannel == $uiEnums.CHAT_CHANNEL_PRIVATE)
         ret := $UiGlobals.chat.private_channel
      end
      return ret
   end
   
   func GetMembers() : vector
      var ret  : vector      
      if (IsMembersVisible())
         var stream : GL_ChatStream = GetChatStream()
         if (stream != null)
            ret := stream.GetMembers()
         end
      end      
      return ret      
   end
   
   func GetMessages() : vector
      var ret  : vector
      if (IsMessagesVisible())
         ret := $UiGlobals.GetChatMessages(GetSelectedChannel())
      end
      return ret
   end
   
   func UpdateStreamTimestamp()
      var stream : GL_ChatStream = GetChatStream()
      if (stream != null)
         stream.UpdateLastViewTime()
      end
   end
   
   func GetMessagesTxt() : wstring
      var messages   : vector = GetMessages()
      var ret        : wstring
      var mes        : GL_ChatStreamMessage= null      
      
      var i          : int
      for i := 0 to messages.Count() - 1
         var p : params
         mes   := messages.Get(i)
         p.msg := mes.GetFormattedText(true, false)
         ret   := ret + p.msg
      end
      
      UpdateStreamTimestamp()
      
      var str  : string
      var wp   : params
      wp.str   := ret
      str      := wp.str
      return ret
   end
   
   func GetMembersTxt() : wstring
      var members    : vector = GetMembers()
      var ret        : wstring
      var i          : int
      var member     : GL_UID = null
      for i := 0 to members.Count() - 1
         member := members.Get(i)         
         var ud      : UserData  = (UserData)$UserDataStorage.users.Get(member.value.Get())
         var nick    : wstring    = ud.base.full_nickname.Get()
         var isValid : bool      = true
         
         if ((bool)ud.has_base.Get())
         else
            if ($UserDataStorage.IsValidUID(member.value.Get()))
               $user_service.RequestData(member.value.Get(), $uiEnums.USER_DATA_BASE) : 0
            end
            if (nick == $UiGlobals.String2WString(""))
               isValid := false
            end
         end
         if (isValid)
            var link : string    = $UserDataStorage.UID2Str(member.value.Get())
            var p    : params         
            p.tilde  := $UiGlobals.String2WString("~")
            p.nl     := $UiGlobals.String2WString("\n~")
            p.nick   := nick
            p.nick   := p.nick + p.tilde
            p.nick   := $root.MakeLinkWText(p.nick, link, $UserDataStorage.GetUserColorCode(member.value.Get()))
            ret      := ret + p.nick
            ret      := ret + p.nl         
         end
      end
      var str  : string
      var wp   : params
      wp.str   := ret
      str      := wp.str
      return ret
   end
   
   func AutoScrollMemebers()
      wgt.Widgets().listMembers.txtAreaCont.txtArea.position := wgt.Widgets().listMembers.txtAreaCont.txtArea.maxScroll
   end
   
   func OnMembersChanged(p : params) : bool
      //AutoScrollMemebers()
      return true
   end
   
   func AutoScrollMessages()
      wgt.Widgets().listMessages.txtAreaCont.txtArea.position := wgt.Widgets().listMessages.txtAreaCont.txtArea.maxScroll   
   end
   
   func OnMessagesChanged(p : params) : bool
      AutoScrollMessages() : 0
      return true      
   end
   
   func GetMessagesHeight() : float
      var ret : float = 0
      ret := 44 + GetChatHeight()
      return ret      
   end
   
   func GetMessagesHeightDelayed() : float
      var ret : float = 0
      ret := 44 + GetChatHeightDelayed()
      return ret      
   end
   
   func GetMessagesWidth() : float
      var ret : float = 700
      if (IsMembersVisible())
         ret := 490
      end
      return ret      
   end
   
   func GetMembersHeight() : float
      var ret : float = 0
      ret := 44 + GetChatHeight()
      return ret      
   end
   
   func GetMembersHeightDelayed() : float
      var ret : float = 0
      ret := 44 + GetChatHeightDelayed()
      return ret      
   end
   
   func GetMembersWidth() : float
      var ret : float = 290
      return ret      
   end
   
   func SendMessage(p : params) : bool
      var txt     : string    = wgt.Widgets().inputCont.inputTf.text
      var wtxt    : wstring   = wgt.Widgets().inputCont.inputTf.wtext
      wgt.Widgets().inputCont.inputTf.text := ""
      if (txt != "" and CanSendMessage())
         var command : wstring = $hq.ChatExtractCommand(wtxt)
         if (command == $UiGlobals.String2WString(""))
            // send message
            var selectedChannel : int = GetSelectedChannel()
            if (selectedChannel == $uiEnums.CHAT_CHANNEL_ALL)
               $hq.ChatSendGeneral(wtxt)
            elif (selectedChannel == $uiEnums.CHAT_CHANNEL_PARTY)
               $hq.ChatSendParty(wtxt)
            elif (selectedChannel == $uiEnums.CHAT_CHANNEL_GAME_ALL)
               $hq.ChatSendGameAll(wtxt)
            elif (selectedChannel == $uiEnums.CHAT_CHANNEL_CLAN)
               $hq.ChatSendClan(wtxt)
            elif (selectedChannel == $uiEnums.CHAT_CHANNEL_PRIVATE)
               $hq.ChatSendPrivate(privateMessagesTarget.Get(), wtxt)
            end
         else
            $hq.ChatSendCommand(command)
         end
      end
      return true
   end
   
   func CanSendMessage() : bool
      var ret : bool  = true      
      var selectedChannel : int = GetSelectedChannel()
      if (selectedChannel == $uiEnums.CHAT_CHANNEL_NEWS)
         ret := false
      elif (selectedChannel == $uiEnums.CHAT_CHANNEL_PRIVATE)
         ret := CanSendPrivate()
      end
      return ret
   end
   
   func GetDefaultInputText() : wstring
      var ret : wstring = $UiGlobals.String2WString("main_chat_input")
      var selectedChannel : int = GetSelectedChannel()
      if (selectedChannel == $uiEnums.CHAT_CHANNEL_PRIVATE)
         if (CanSendPrivate())
            var ud   : UserData = (UserData)$UserDataStorage.users.Get(privateMessagesTarget.Get())
            var p    : params
            p.lb     := $UiGlobals.String2WString("[")
            p.nick   := ud.base.full_nickname.Get()
            p.rb     := $UiGlobals.String2WString("]: ~")
            ret      := p.lb
            ret      := ret + p.nick
            ret      := ret + p.rb
         else
            ret := $UiGlobals.String2WString("main_chat_input_private")
         end
      else if (!CanSendMessage())
         ret := $UiGlobals.String2WString("main_chat_input_disabled")
      end
      return ret      
   end
   
   func CanSendPrivate() : bool
      var ret : bool = false
      ret := $UserDataStorage.IsValidUID(privateMessagesTarget.Get()) and ! $UserDataStorage.IsLocalUID(privateMessagesTarget.Get())
      return ret
   end
   
   func OnSetChatPrivateUser(p : params) : bool
      if (! IsVoid(p.uid))
         SwithToPrivate(p.uid)
      end
      return true
   end
   
   func GetPlayerCardVM() : RosterCardVM 
      return rosterCard
   end
   
   func SwithToPrivate(_uid : *)
      privateMessagesTarget.Set(_uid)
      tabs.SetSelectedTabIdx(9)
   end
   
   func OnLinkClicked(p : params) : bool
      if (!IsVoid(p.text) and p.text != "")
         //SwithToPrivate($UiGlobals.String2Int64(p.text))
         isPlayerCardVisible.Set(false)
      end
      return true
   end
   
   func OnLinkMouseOver(p : params) : bool
      if (!IsVoid(p.text) and p.text != "")
         userContext.uid      := $UiGlobals.String2Int64(p.text)
         userContext.canOpen  := true
         isPlayerCardVisible.Set(false)
      else
         userContext.canOpen  := false
         isPlayerCardVisible.Set(false)
      end
      playerUID.value.Set($UiGlobals.GetInvalidUIDVal())
      rosterCard.SetUID(playerUID)
      return true
   end
   
   func OnLinkMouseOut(p : params) : bool      
      userContext.canOpen  := false
      playerUID.value.Set(userContext.uid)
      rosterCard.SetUID(playerUID)
      isPlayerCardVisible.Set(false)
      return true
   end
   
   func GetStyleSheet() : vector
      return chatStyleSheet.GetStyleSheet()
   end
end

/*************************************************************
* UiChatMessageLIRVM
* 
*************************************************************/
class UiChatMessageLIRVM
   var mes           : ObservableProperty = $OM.Property(null)
   var userContext   : UserContextMenu    = new UserContextMenu()
   
   func Init(p : params)
      if (! IsVoid(p.message))         
         var mesVal : GL_ChatStreamMessage = (GL_ChatStreamMessage)p.message
         if ($UserDataStorage.IsValidUID(mesVal.sender_user_id.Get()))
            $user_service.RequestData(mesVal.sender_user_id.Get(), $uiEnums.USER_DATA_BASE)
            userContext.uid := mesVal.sender_user_id.Get()
         end
         mes.Set(mesVal)
      end
   end
   
   func GetMessage() : GL_ChatStreamMessage
      var ret : GL_ChatStreamMessage = (GL_ChatStreamMessage)mes.Get()
      return ret
   end
      
   func GetText() : wstring
      var ret : wstring
      var mesVal : GL_ChatStreamMessage = GetMessage()
      if (mesVal != null)
         var ud : UserData = (UserData)$UserDataStorage.users.Get(mesVal.sender_user_id.Get())
         var p : params
         if ($UserDataStorage.IsValidUID(mesVal.sender_user_id.Get()))
            var nickName : wstring = ud.base.full_nickname.Get()
            p.nick   := $root.MakeColorCodedWText(nickName, $UserDataStorage.GetPlayerStatusColorCode(mesVal.sender_user_id.Get()))
         else
            p.nick   := $root.MakeColorCodedWText($UiGlobals.String2WString("SYSTEM"), "#FFFF00")
         end
         p.time      := $root.MakeColorCodedWText($UiGlobals.String2WString("[00:00] "), "#808080")
         p.delim     := $root.MakeColorCodedWText($UiGlobals.String2WString(" : "), "#808080")
         p.mes       := mesVal.text.Get()
         
         ret := ret + p.time
         ret := ret + p.nick
         ret := ret + p.delim
         ret := ret + p.mes
      end
      return ret
   end
end

/*************************************************************
* UiChatMembersLIRVM
* 
*************************************************************/
class UiChatMembersLIRVM
   var uid           : ObservableProperty = $OM.Property($UiGlobals.GetInvalidUIDVal())
   //var mes           : ObservableProperty = $OM.Property("")
   var userContext   : UserContextMenu    = new UserContextMenu()
   
   func Init(p : params)
      uid.Set($UiGlobals.GetInvalidUIDVal())
      if (! IsVoid(p.uid))
         if ($UserDataStorage.IsValidUID(p.uid))
            $user_service.RequestData(p.uid, $uiEnums.USER_DATA_BASE)
            userContext.uid := p.uid
         end
         uid.Set(p.uid)
      end
   end
   
   func GetUID() : *
      return uid.Get()
   end
   
   func GetUserData() : UserData
      var ud : UserData = (UserData)$UserDataStorage.users.Get(GetUID())
      return ud
   end
   
   func GetNickname() : wstring
      var ud   : UserData  = GetUserData()
      var ret  : wstring    = ud.base.full_nickname.Get()
      ret := $root.MakeColorCodedWText(ret, $UserDataStorage.GetPlayerStatusColorCode(GetUID()))
      return ret
   end   
end


/*************************************************************
* UiChatMessage
* 
*************************************************************/
class UiChatMessage : UiWidgetContainer
   func inputEvent(p : params) : bool
      var isTerminated  : bool   = false
      var keyCode       : int    = p.keyCode
      if (p.isDown == false)
         if (keyCode == $uiKeys.VK_ENTER)
            GenerateEvent("#SendMessage")
            isTerminated := true
         end
      end
      if (keyCode == $uiKeys.VK_DOWN or keyCode == $uiKeys.VK_UP or keyCode == $uiKeys.VK_TAB)
         isTerminated := true
      end
      if (isTerminated)
         p.eventState.SetIsTerminated(isTerminated)
      end
      return false
   end
   
   func focusIn(p : params) : bool
      return false
   end
end


