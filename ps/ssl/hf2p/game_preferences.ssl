native class GAME_PREFERENCES_SSL
	native func GetToggleCrouch () : bool
	native func SetToggleCrouch (on : bool)
	native func GetHUDShake () : bool
	native func SetHUDShake (on : bool)
	native func GetDisplayHints () : bool
	native func SetDisplayHints (on : bool)
	native func GetTeamColor () : int
	native func SetTeamColor (on : int)
	native func GetCameraFOV () : int
	native func SetCameraFOV (on : int) 
	native func ResetTutorial ()

	// multiplayer settings
	native func GetMatchmakingRegion () : int
	native func SetMatchmakingRegion (value : int)

	// video settings
	native func GetScreenResolutionList          (pseudoFullscreen : bool) : vector
	native func GetScreenResolution              () : params
	native func GetDefaultVideoSettings          () : params
   native func GetAdvancedVideoPresetParams     (preset : int) : params
   native func CheckVideoSettingsForApply       (p : params) : int
	native func GetDefaultControlsSettings       () : params
	native func GetDefaultSoundSettings          () : params
	native func GetDefaultGameplaySettings       () : params
	native func SetScreenResolution              (width : int, height : int)
   native func GetQualityPresetOptions          () : vector
   native func GetQualityPreset                 (p : params) : int
	native func GetBrightness                    () : int
	native func SetBrightness                    (value : int)
	native func GetFullscreen                    () : bool
	native func SetFullscreen                    (on : bool)
	native func GetVSync                         () : bool
	native func SetVSync                         (on : bool)
	native func GetAntialiasing                  () : bool
	native func SetAntialiasing                  (on : bool)
   
   // video settings advanced
   native func GetTextureResolutionOptions      () : vector
   native func GetTextureResolution             () : int
   native func SetTextureResolution             (value : int)
   native func GetTextureFilteringQualityOptions() : vector
   native func GetTextureFilteringQuality       () : int
   native func SetTextureFilteringQuality       (value : int)
   native func GetLightingQualityOptions        () : vector
   native func GetLightingQuality               () : int
   native func SetLightingQuality               (value : int)
   native func GetEffectsQualityOptions         () : vector
   native func GetEffectsQuality                () : int
   native func SetEffectsQuality                (value : int)
   native func GetShadowQualityOptions          () : vector
   native func GetShadowQuality                 () : int
   native func SetShadowQuality                 (value : int)
   native func GetDetailsQualityOptions         () : vector
   native func GetDetailsQuality                () : int
   native func SetDetailsQuality                (value : int)
