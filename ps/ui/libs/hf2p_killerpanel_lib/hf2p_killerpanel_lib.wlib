                        }
                     }
                     __type   =   "ui_widget_impl_gfx"
                  }
                  bindings   =   {
                     nameText   =   {
                        binding   =   "{killerUserData.base.full_nickname}"
                     }
                  }
                  customProps   =   [
                     {
                        propName   =   "nameText"
                        propVal   =   {
                           val   =   "Name"
