native class EngineControl
   native func InitEngine()
   native func LoadLevel(level : string)
   native func ShowLoadingScreen(name : string)
   native func HideLoadingScreen()
   native func CreatePlayer(cls : string, name : string)
   native func DestroyPlayer(name : string)
   native func IsMenuLevel() : bool
