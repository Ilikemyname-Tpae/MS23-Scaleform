end

class LeftMenuVM
   
   var pListName :  ObservableProperty = $OM.Calculated(this, "GetPlayListName")
   var pListIcn  :  ObservableProperty = $OM.Calculated(this, "GetPlayListIcon")
   
   func GetPlayListName() : string
      var ret : string
      var playlistId : string = $uiPartyMonitor.GetPlaylistId()
      ret := (string)$UiGlobals.componentsUI.Get(playlistId).name.Get()
      return ret   
   end

   func GetPlayListIcon() : string
      var ret : string
      var playlistId : string = $uiPartyMonitor.GetPlaylistId()
      ret := (string)$UiGlobals.componentsUI.Get(playlistId).icon.Get()
      return ret   
   end
   
end