   func OnPlayerLIRPlusClicked(p : params) : bool
      var filter : int = GetFilter()
      if (filter == FILTER_USER_ALL or filter == FILTER_USER_RECENT)
         $user_service.RequestFollow(p.uid)
      end         
      return false
   end
      
   func OnPlayerLIRMinusClicked(p : params) : bool
      var filter : int = GetFilter()
      if (filter == FILTER_USER_FRIENDS)
         var ud : UserData = (UserData)$UserDataStorage.users.Get(p.uid)
         var pp : params
         pp.titleTxt       := "msg_unfollow_confirm_title"
         pp.messageTxt     := $UiGlobals.String2WString("msg_unfollow_confirm_msg,")
         pp.messageTxt     += ud.base.full_nickname.Get()
         pp.callbackEvent  := "unfollowConfirmClosed"
         pp.mbType         := $uiEnums.MB_TYPE_NO_YES
         pp.callbackParams := p
         wgt.GenerateEvent("MainMenuDialogRequest", pp)
      end         
      return false
   end

   func OnUnfollowConfirmClosed(p : params) : bool
      if p.isOK
         $user_service.RequestUnfollow(p.callbackParams.uid)
      end
      return false
   end

   func OnPlayerLIRJoinClicked(p : params) : bool
      var filter : int = GetFilter()
      if (filter == FILTER_USER_FRIENDS)
         $hq.PartyInviteSend(p.uid)
      end         
      return false
   end
   
   func ComparePlayers(userA : GL_UID, userB : GL_UID) : int
      var udA     : UserData  = (UserData)$UserDataStorage.users.Get(userA.value.Get())
      var udB     : UserData  = (UserData)$UserDataStorage.users.Get(userB.value.Get())      
      var ret     : int       = $UiGlobals.CmpWStrings(udA.base.nickname.Get(), udB.base.nickname.Get())
      return ret
   end 
   
   func SortPlayersList(_playersVec : vector) : vector
      var i    : int
      var ret  : vector
      for i := 0 to _playersVec.Count() - 1
         var user : GL_UID = (GL_UID)_playersVec.Get(i)
         if ($UserDataStorage.IsValidUID(user.value.Get()))
            $user_service.RequestData(user.value.Get(), $uiEnums.USER_DATA_BASE)
            var ud : UserData = (UserData)$UserDataStorage.users.Get(user.value.Get())
            if ((bool)ud.has_base.Get())
               ret.Push(user)
            end            
         end         
      end
      ret.Sort(this, "ComparePlayers")
      return ret
   end
   
   func GetPlayersList() : vector
      var   ret         : vector
      
      if ((bool)isCollapsed.Get() or ! IsPlayersMode())
         return ret
      end
      
      var pp : params
      pp.nick := wgt.GetSearchText()
      var   filter      : int    = GetFilter()
      var   isSearchRet : bool   = true

      var playerRec : params
      playerRec.uid  := $UserDataStorage.local_user.uid.Get()      
      var isValidNickVal : bool = (bool)isValidNick.Get()
      
      if (IsSearchActive())
         isSearchRet := false
      else
         if (pp.nick == $UiGlobals.String2WString(""))
            if (filter == FILTER_USER_FRIENDS)
               var ud : UserData = (UserData)$UserDataStorage.users.Get($UserDataStorage.local_user.uid.Get())
               ret := ud.social.following.Get()
            elif (filter == FILTER_USER_RECENT)
               ret := $UserDataStorage.local_user.recent_users.Get()
            end
         elif (isValidNickVal)
            var searchResult : vector = $UiGlobals.async_operations.find_users.result.Get()
            ret := searchResult
            UpdateSearchStatus(null)
         end
      end
      
      if (isSearchRet and IsSearchComplete() and isValidNickVal)
         if (ret.Count() > 0)
            searchErr.Set("")
         else
            searchErr.Set("msg_nothing_found")
         end
      else
         searchErr.Set("")
      end
      
      if (ret.Count() > 0)
         ret := SortPlayersList(ret)
      end
      return ret
   end
   
   func IsSearchActive() : bool
      var searchState : int = (int)$UiGlobals.async_operations.find_users.progress.state.Get()
      var ret : bool
      ret := searchState == $uiEnums.BACKEND_REQUEST_STATE_IN_PROGRESS
      return ret
   end
   
   func IsSearchComplete() : bool
      var searchState : int = (int)$UiGlobals.async_operations.find_users.progress.state.Get()
      var ret : bool
      ret := searchState == $uiEnums.BACKEND_REQUEST_STATE_COMPLETE
      return ret
   end
   
   func DoSearch(p : params) : bool
      var pp : params
      pp.nick := wgt.GetSearchText()
      var filter  : int    = GetFilter()
      if (pp.nick == $UiGlobals.String2WString(""))
            isValidNick.Set(false)
         playersList.Invalidate()
      elif (! IsSearchActive() and filter > 0)
         var nickCheckRet  : int       = $user_service.IsValidNickname(pp.nick)
         if (nickCheckRet == 0)
            isValidNick.Set(true)
            $UiGlobals.async_operations.find_users.progress.state.Set($uiEnums.BACKEND_REQUEST_STATE_NONE)
            $user_service.AsyncFindUsers(pp.nick, filter)         
         else
            isValidNick.Set(false)
            searchErr.Set("msg_nick_err_" + (string)nickCheckRet)
         end
      end
      return true
   end
   
   func IsValidPlayerIndex(_idx : int) : bool
      var players : vector = playersList.Get()
      return _idx >= 0 and _idx < players.Count()
   end

   func GetPlayerUIDByIdx(_idx : int) : *
      var players : vector = playersList.Get()
      return players.Get(_idx).value.Get()
   end
   
   func friendsRosterLIR_Clicked(p : params) : bool   
      var idx : int = p.index
      if (IsValidPlayerIndex(idx))
         
      end
      return true
   end
      
   func GetSelectedPlayerUID() : *
      if (wgt != null)
         var childWgt : * = wgt.Widgets().content.playersList.object
         if (childWgt.mouseOverItem.Get() != null)
            var listItem : GL_UID = childWgt.mouseOverItem.Get()
            selectedGLUID.value.Set(listItem.value.Get())
         else
            selectedGLUID.value.Set($UserDataStorage.invalidUID.value.Get())
         end
      else
         selectedGLUID.value.Set($UserDataStorage.invalidUID.value.Get())
      end
      return selectedGLUID
   end
   
   func GetSelectedIdx() : int
      var ret : int = 0
      if (wgt != null)
         ret := (int)wgt.Widgets().content.playersList.object.mouseOverIdx.Get()
      end
      return ret
   end
   
   func SetSelectedUID(val : *)
      //uid.value.Set(val)
   end
   
   func friendsRosterLIR_RollOver(p : params) : bool   
      var idx : int = p.index
      if (IsValidPlayerIndex(idx))
         //selectedIdx.Set(idx)
         //SetSelectedUID(GetPlayerUIDByIdx(idx))
      end
      return true
   end
   
   func friendsRosterLIR_RollOut(p : params) : bool   
      //selectedIdx.Set(0)
      //SetSelectedUID($UserDataStorage.invalidUID.value.Get())
      //var idx : int = p.index
      //if (IsValidPlayerIndex(idx))
      //end
      return true
   end 
