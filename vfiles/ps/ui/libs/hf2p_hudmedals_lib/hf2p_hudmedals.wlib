         scoringEventTotals   =   {
            sslClass   =   "UiScoringEventsTotal"
            sslModule   =   "ui.libs.hf2p_HudMedals_lib.hf2p_HudMedals"
            elements   =   {
               scoringTotalAnimCont   =   {
                  elements   =   {
                     totalsAnimCont   =   {
                        elements   =   {
                           scoreTxt   =   {
                              elements   =   {
                                 orangeGlow   =   {
                                    bindings   =   {
                                       visible   =   {
                                          binding   =   "{true}"
                                       }
                                       _width   =   {
                                          binding   =   "{glowWidth}"
                                       }
                                    }
                                    __type   =   "ui_hud_medals_lib::OrangeGlowCont"
                                 }
                              }
                              propMapping   =   {
                                 txt   =   {
                                    isNoTranslate   =   True
                                 }
                              }
                              bindings   =   {
                                 txt   =   {
                                    binding   =   "{scoringTotalTxt}"
                                 }
                              }
                              __type   =   "ui_hud_medals_lib::ScoringEventsTotalAnimTxt"
                           }
                        }
                        __type   =   "ui_hud_medals_lib::ScoringEventTotalAnimInCont"
                     }
                  }
                  __type   =   "ui_hud_medals_lib::ScoringEventsTotalAnim"
               }
            }
            propMapping   =   {
               textW   =   {
                  mapping   =   "scoringTotalAnimCont.totalsAnimCont.scoreTxt.txt.textWidthEx"
               }
            }
            bindings   =   {
               DC   =   {
                  binding   =   "{scoringTotal}"
               }
            }
            __type   =   "ui_hud_medals_lib::ScoringEventsTotal"
         }
      }
      stateMap   =   {
         startState   =   "Initial"
         states   =   {
            Initial   =   {
            }
            Visible   =   {
            }
         }
      }
      bindings   =   {
         DC   =   {
            binding   =   "{new: 'ui.libs.hf2p_HudMedals_lib.hf2p_HudMedals.UiHudMedalsVM'}"
         }
      }
      __type   =   "ui_hud_medals_lib::HudMedalsContainer"
   }
