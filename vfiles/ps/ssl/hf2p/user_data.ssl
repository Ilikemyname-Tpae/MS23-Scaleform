      var result : int = 0
      return result
   end
   

   func GetCrOfferCostsVec() : vector
      var ret : vector
      var shopShelf  : GL_ShopShelf = $UiGlobals.shop.GetInternalShelf(0, "section_loadouts", "shelf_armor_loadouts")
      if (shopShelf != null)
         var loadoutIdx : int
         for loadoutIdx := 0 to shopShelf.items.Get().Count() - 1
            var loadoutId    : string = (string)shopShelf.items.Get().Get(loadoutIdx).value.Get()
            var shopComp     : GL_ComponentShop = (GL_ComponentShop)$UiGlobals.componentsShop.Get(loadoutId)
            if (shopComp.offers.Get().Count() > 0)
               var loadoutOffer : GL_ComponentShopOffer = (GL_ComponentShopOffer)shopComp.offers.Get().Get(0)
               ret.Push((string)loadoutOffer.GetCrCost())
            else
               ret.Push("n/a~")
            end
         end
      end
      while (ret.Count() < 5)
         ret.Push("n/a~")
      end
      return ret 
   end

   func GetGpOfferCostsVec() : vector
      var ret : vector
      var shopShelf  : GL_ShopShelf = $UiGlobals.shop.GetInternalShelf(0, "section_loadouts", "shelf_armor_loadouts")
