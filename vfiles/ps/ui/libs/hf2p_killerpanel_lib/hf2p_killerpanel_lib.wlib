                                       selected   =   {
                                          binding   =   "{true}"
                                       }
                                    }
                                    __type   =   "hf2p_Loadout_lib::loadoutElementPerk"
                                 }
                                 btn1   =   {
                                    bindings   =   {
                                       selected   =   {
                                          binding   =   "{true}"
                                       }
                                    }
                                    __type   =   "hf2p_Loadout_lib::loadoutElement"
                                 }
                                 btn2   =   {
                                    bindings   =   {
                                       selected   =   {
                                          binding   =   "{true}"
                                       }
                                    }
                                    __type   =   "hf2p_Loadout_lib::loadoutElement"
                                 }
                                 btn3   =   {
                                    bindings   =   {
                                       selected   =   {
                                          binding   =   "{true}"
                                       }
                                    }
                                    __type   =   "hf2p_Loadout_lib::loadoutElement"
                                 }
                                 btn0   =   {
                                    elements   =   {
                                       camContainer   =   {
                                          elements   =   {
                                             attachContainer   =   {
                                                visible   =   False
                                                __type   =   "ui_weaponConf_lib_slide::attachContainer"
                                             }
                                             render0   =   {
                                                bindings   =   {
                                                   visible   =   {
                                                      binding   =   "{(:UD).customizations.character_active_index == 0}"
                                                   }
                                                }
                                                __type   =   "ui_rtts_container::rtts_loadout_biped_0"
                                             }
                                             render1   =   {
                                                bindings   =   {
                                                   visible   =   {
                                                      binding   =   "{(:UD).customizations.character_active_index == 1}"
                                                   }
                                                }
                                                __type   =   "ui_rtts_container::rtts_loadout_biped_1"
                                             }
                                             render2   =   {
                                                bindings   =   {
                                                   visible   =   {
                                                      binding   =   "{(:UD).customizations.character_active_index == 2}"
