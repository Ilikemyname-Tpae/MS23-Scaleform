   end
   
   func IsTechItemGrenade() : bool
      var ret :bool = false
      if ((int)itemType.Get() == $uiEnums.ITEM_TYPE_UNKNOWN)
         // HACK
         if ((string)unlockItem.Get() == "frag_grenade" or (string)unlockItem.Get() == "plasma_grenade" or (string)unlockItem.Get() == "spike_grenade" or (string)unlockItem.Get() == "fire_grenade")
            ret := true
