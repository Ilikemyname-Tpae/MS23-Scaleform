class UiPostgame : UiSlidingScreenPageMainMenu

var   xpGained          : int = 0
var   xpBonus           : int = 0
var   xpCons            : int = 0
var   xpComplete        : int = 0
var   xpTotal           : int = 0
var   xpTotalModif      : int = 0
var   xpBoost           : bool = false
var   crGained          : int = 0
var   crBonus           : int = 0
var   crTotal           : int = 0
var   crTotalModif      : int = 0
var   crBoost           : bool = false
var   dec               : int = 0
var   curCounter        : *
var   statsVec          : vector
var   medalsVec         : vector
var   medalsTest        : vector
var   subscribe         : bool = false
var   isReplay          : bool = false

handle OnChangeStateAny // ()
   //delay kill, this, STATE_SKIP
end

handle OnChangeState("StatWaiting")
   OnEnterStatWaiting()
   if ($UiGlobals.notifications.session_reward_replayIdx != $uiEnums.NOTIFICATION_SESSION_REWARDS_UNDEFINED)
      isReplay := true
   end
   StartWaitingReward()
end

handle OnEnterState("StatSequence")
   delay kill, this, STATE_SKIP
   $hf2pEngine.SetUIMusicId(2)
   StatStateLayout() : 0.5
   OnEnterPmStatStatic() : 6 , STATE_SKIP
   //OnEnterPmChallengeState() : 6 , STATE_SKIP
end

handle OnLeavingState("StatSequence")
   PlayStatAnim("fadeOut")
end

handle OnEnteringState("Visible")
   GenerateEvent("#PostgameOpen")
   var stateName : string = GetStateName()
   OnEnteringVisible()
end

handle OnChangeState("Visible")
   OnEnterVisible()
end

handle OnEnterState("ChallengeSequence")
   // $root.CheckAllNotifications()
   delay kill, this, STATE_SKIP
   ChallengeStateLayout() : 1
   EnterPmChallengeStatic() : 2 , STATE_SKIP
end

handle OnLeavingState("ChallengeSequence")
   //PlayChallengesAnim("fadeOut")
end

func EnterPmChallengeStatic()
   SetStateName("ChallengeStatic")
end

handle OnEnterState("ChallengeStatic")
   ChallengeStateLayout()
   //$root.CheckAllNotifications() : 1
end

handle OnEnterState("StatStatic")
   StatStateLayout()
   $root.CheckAllNotifications() : 1
   GenerateEvent("PostmatchSkip")
end

handle OnEnteringState("Initial")
   factLog("UI/POSTGAME", "Initial")
   StopRewardWaiting()
end

handle OnEnterState("Initial")
   GenerateEvent("#PostgameClose")
   Props.visible := false
end 

func ChallengeStateLayout()
   Widgets.statsBg.visible             := false
   Widgets.rightCountersPanel.visible  := false
   Widgets.rightBoostPanel.visible     := false
   Widgets.consPanel.visible           := false
   Widgets.nextMedalsBtn.visible       := false
   Widgets.prevMedalsBtn.visible       := false
   Widgets.medals.visible              := false
   Widgets.challengesGrid.visible      := true
   Widgets.bookmarkBtn0.visible        := true
   //Widgets.bookmarkBtn1.visible        := true
   //Widgets.bookmarkBtn2.visible        := true
   if (GetStateName() == "ChallengeSequence")
      PlayChallengesAnim("fadeIn")
      Widgets.challengesGrid.StopBlinking()
      Widgets.challengesGrid.StartDefaultBlinking(0 , 0.5)
   elif (GetStateName() == "ChallengeStatic")
      PlayChallengesAnim("none", false)
      Widgets.challengesGrid.StopBlinking()
   end   
end

func StartWaitingReward()
   if (!$UiGlobals.notifications.IsWaitingRewardStats())
      UpdateStats(null)
   else      
      if (! subscribe)
         subscribe := true
         $UiGlobals.notifications.isWaitingRewardStats.Subscribe(this, "UpdateStats")         
      end
   end
end

func StopRewardWaiting()
   if (subscribe)
      subscribe := false
      $UiGlobals.notifications.isWaitingRewardStats.Unsubscribe(this, "UpdateStats")         
   end
end

func FirePostmatchStarted()
   GenerateEvent("PostmatchStarted")   
end

func OnEnteringVisible()   
   isReplay                   := false
   Props.visible              := false
   FirePostmatchStarted()
   factLog("UI/POSTGAME", "OnEntering")
   GenerateEvent("AddXpNoAnim")
   //$user_service.RequestData($UserDataStorage.local_user.uid.Get(), $uiEnums.USER_DATA_ARMOR_LOADOUT)
   $hq.TextureRenderBipedPostmatch($UserDataStorage.local_user.uid.Get())
   //$hq.TextureRenderBipedClassSelection($UserDataStorage.local_user.uid.Get(), GetClassKit(0), false)
end

func OnEnterVisible()
   Log("ui~postgame", "PostGame OnChangeState Visible")
   Props.visible := true
   Widgets.waitingInfo.visible := false
   Widgets.prevMedalsBtn.visible := false
   Widgets.nextMedalsBtn.visible := false
   Widgets.challengesGrid.visible := false
   Widgets.bookmarkBtn0.visible := true
   //Widgets.bookmarkBtn1.visible := true
   //Widgets.bookmarkBtn2.visible := true
   Widgets.statsBg.visible := true
   Widgets.medals.visible := true
   Widgets.rightCountersPanel.visible := true
   Widgets.rightBoostPanel.visible := true
   Widgets.consPanel.visible := true
   Widgets.spaceBg.plrAttach.visible := true
   Widgets.spaceBg.GotoAndStop("none")
   StopRewardWaiting()
   SetStateName("StatWaiting")
end

func OnEnterPmChallengeState()
   GenerateEvent("#InvalidatePmChallenges")
   SetStateName("ChallengeSequence")
end

func OnEnterPmStatStatic()
   SetStateName("StatStatic")
end

func PlayStatAnim(state : string, play : bool = true)
   // fadeIn fadeOut none
   if play
      Widgets.statsBg.GotoAndPlay(state)
      Widgets.medals.GotoAndPlay(state)
      Widgets.rightCountersPanel.GotoAndPlay(state)
      Widgets.consPanel.GotoAndPlay(state)
      Widgets.rightBoostPanel.GotoAndPlay(state)
   else
      Widgets.statsBg.GotoAndStop(state)
      Widgets.medals.GotoAndStop(state)
      Widgets.rightCountersPanel.GotoAndStop(state)
      Widgets.consPanel.GotoAndStop(state)
      Widgets.rightBoostPanel.GotoAndStop(state)
   end
end

func PlayConsecutiveAnim(state : string, play : bool = true)
   if play
      Widgets.consPanel.consecutiveBar.GotoAndPlay(state)
   else
      Widgets.consPanel.consecutiveBar.GotoAndStop(state)
   end
end

func PlayChallengesAnim(state : string, play : bool = true)
   if play
      Widgets.challengesGrid.GotoAndPlay(state)
   else
      Widgets.challengesGrid.GotoAndStop(state)
   end   
end

func GetIsWait() : bool
   var isWaiting : bool = (bool) $UiGlobals.notifications.isWaitingRewardStats.Get()
   return isWaiting   
end

override SaveState //() : params
   var stateName : string = GetStateName()
   if (stateName == "StatWaiting")
      stateName := "Visible"
   else 
      stateName := "StatStatic"
   end
   var ret : params
   ret.stateName := stateName
   return ret
end

override LoadState //() : params
   if (! IsVoid(p.stateName))
      var stateName : string = p.stateName
      if (stateName != GetStateName())
         SetStateName(p.stateName)
      end
   end
   return true
end

func UpdateStats(val : *)
   if (GetIsWait())
      return 
   end
   
   StopRewardWaiting()
   
   factLog("UI/POSTGAME", "UpdateStats")
   var rewards    : vector             = $UiGlobals.notifications.session_rewards.Get()
   var versionIdx : int                = rewards.Count() - 1
   if (isReplay)
      versionIdx := $UiGlobals.notifications.session_reward_replayIdx
      $UiGlobals.notifications.session_reward_replayIdx := -1
   end
   var notif      : NT_SessionRewards  = rewards.Get(versionIdx)
   xpGained := (int)(notif.xp.Get())
   xpBonus := (int)(notif.xp_bonus.Get())
   xpCons  := (int)(notif.xp_consecutive_bonus.Get())
   xpComplete := (int)(notif.xp_game_complete_bonus.Get())
   xpTotal := xpGained + xpBonus + xpCons + xpComplete
   xpTotalModif := (int)(notif.xp_boosted.Get())
   xpBoost := (bool)(notif.xp_has_booster.Get())
   crGained := (int)(notif.cr.Get())
   crBonus := (int)(notif.cr_bonus.Get())
   crTotal := crGained + crBonus
   crTotalModif := (int)(notif.cr_boosted.Get())
   crBoost := (bool)(notif.cr_has_booster.Get())
   if (notif.stats.Get().Count() > 0)
      statsVec := notif.stats.Get()
   end
   if (notif.medals.Get().Count() > 0)
      medalsVec := notif.medals.Get()
   end
   
   CheckAccountModifiers()

   $UiGlobals.notifications.MarkNotNew($uiEnums.NOTIFICATION_SESSION_LVLUP)
   $UiGlobals.notifications.MarkNotNew($uiEnums.NOTIFICATION_CHALLENGE_COMPLETE)
   $UiGlobals.notifications.MarkProcessedFirstByType($uiEnums.NOTIFICATION_SESSION_REWARDS)
   
   if (GetStateName() == "StatWaiting")
      if (bool)$UiGlobals.IsPostMatchStatic.Get()
         SetStateName("StatStatic")
      else   
         SetStateName("StatSequence")
      end
      $UiGlobals.IsPostMatchStatic.Set(true)
   end
end

func StatStateLayout()
   Widgets.waitingInfo.visible         := false
   Widgets.bookmarkBtn0.visible        := true
   //Widgets.bookmarkBtn1.visible        := true
   //Widgets.bookmarkBtn2.visible        := true
   Widgets.statsBg.visible             := true
   Widgets.rightCountersPanel.visible  := true
   Widgets.rightBoostPanel.visible     := true
   Widgets.consPanel.visible           := true
   Widgets.spaceBg.plrAttach.visible   := true
   Widgets.challengesGrid.visible      := false
   FillStats(false)
   FillMedalCont()
   FillRightPanelCont()
   if (GetStateName() == "StatSequence")   
      PlayStatAnim("fadeIn")
      if (GetConsecutiveIdx() == -1)
         PlayConsecutiveAnim("none")
      else
         PlayConsecutiveAnim("bar" + GetConsecutiveIdx())
      end
      ShowHidePlrRender(false)
      ShowHidePlrRender(true) : 0.3
   elif (GetStateName() == "StatStatic") 
      PlayStatAnim("none" , false)
      if (GetConsecutiveIdx() == -1)
         PlayConsecutiveAnim("staticNone", false)
      else   
         PlayConsecutiveAnim("staticBar" + GetConsecutiveIdx(), false)
      end   
   end
end
   
func ShowHidePlrRender(showRender : bool)
   if (showRender)
      Widgets.spaceBg.plrAttach.SetStateName("Visible")
   else
      Widgets.spaceBg.plrAttach.SetStateName("Hidden")
   end
end

func GetConsecutiveIdx() : int
   var ret : int = -1
   var vec : vector = $UiGlobals.consecutiveBonuses.Get()
   if (vec.Count() > 0)
      var i : int
      for i := 0 to vec.Count() - 1
         var consecutive : GL_Consecutive_Bonus = (GL_Consecutive_Bonus)vec.Get(i)
         if (xpCons == (int)consecutive.xp_amount.Get())
            ret := i
            break
         end
      end   
   end
   return ret
end

func MedalsCountAnim() : bool
   var ret : bool = false
   if (GetStateName() == "StatSequence")
      return true
   end
   return ret
end

func GetClassKit(idx: int) : string
      var ret : string
      if (! IsVoid($UiGlobals.shop.race_shops.Get()) and $UiGlobals.shop.race_shops.Get().Count() > 0)
         var shop       :  GL_ShopRace    = (GL_ShopRace)$UiGlobals.shop.race_shops.Get().Get((int)$UserDataStorage.local_user.race.Get())
         var section : GL_ShopSection = shop.FindInternalSection("section_career")
         if section != null
            var shelf :  GL_ShopShelf = section.FindShelf("shelf_bundles_start_kits")
            if shelf != null
               if shelf.items.Get().Count() > idx
                  ret := (string)shelf.items.Get().Get(idx).value.Get()
               end
            end
         end
      end
      return ret
   end  

