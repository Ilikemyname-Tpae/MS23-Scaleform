class UiWidget_Lobby : UiSlidingScreenPageMainMenu

var   isSlidingElement  :  bool  = true
var   MAX_TEAM          :  int   = 16

func onLeftItemClicked(p:params):bool
   return true
end

func onLeftItemOver(p:params):bool
   return true
end

func onLeftItemOut(p:params):bool
   return true
end

func onRightItemClicked(p:params):bool
   return true
end

func onRightItemOver(p:params):bool
   return true
end

func onRightItemOut(p:params):bool
   return true
end  

//
//  MAP/MODE
//     

func SetTeamMode(_isTeamMode : bool)
   if (_isTeamMode)
      Widgets.superContainer.ArrangeRosters(2)
      Widgets.rosterCardLeft.x    := 23
      Widgets.rosterCardLeft.y    := 253
      Widgets.rosterCardRight.x   := 1563
      Widgets.rosterCardRight.y   := 253
      Widgets.waitingInfo.x       := 704
   else
      Widgets.superContainer.ArrangeRosters(1)
      Widgets.rosterCardLeft.x    := 106
      Widgets.rosterCardLeft.y    := 240
      Widgets.rosterCardRight.x   := 106
      Widgets.rosterCardRight.y   := 240
      Widgets.waitingInfo.x       := 1135
   end
end

func UpdateMapMode()
   var p: params
   p.state := "assymLobby"
   GenerateEvent("ChangeFakeBackground", p)
end      

func StartRosterLoop()
   if (GetStateName() == "Initial")
      return
   end
   Log("ui~content", "LOBBY::StartRosterLoop")
   $hq.ShowroomEnd()
   $hq.isInShowroom := false
end

func StopRosterLoop()
   Log("ui~content", "LOBBY::StopRosterLoop")
end

func StartHost()   
   Log("ui~content", "LOBBY::StartHost")      
   UpdateRightBtn(true)
end    

func onMPCountdownTimer(p:params): bool
   UpdateRightBtn(false)
   return true
end

func UpdateRightBtn(enableButton: bool = true)
   Widgets.superContainer.rightBtn.label := "lobby_btn_start_game"
   Widgets.superContainer.rightBtn.btnHighlight.frame := "green"
   Widgets.superContainer.rightBtn.btnBg.frame := "green"
   if (enableButton)
      Widgets.superContainer.rightBtn.enabled := true
   end
end

func IsCancellableMatch(_timerTime:int): bool
   return _timerTime >= 0 and _timerTime <= 5
end

func UnlockStartBtn()
   Widgets.superContainer.rightBtn.enabled := true
end
   
func InitFocus(_isStartGame : bool = false)
   if (_isStartGame)
      Widgets.superContainer.rightBtn.SetFocus()         
   else
      Widgets.superContainer.SetFocus()   
   end
end

handle OnEnterState("LobbyMatchmaking")
   Log("ui~content", "OnEnter LobbyMatchmaking")
   InitFocus()
   Widgets.superContainer.redTeam.SetSelectionIdx(0)
   StartRosterLoop()
   $uiPartyMonitor.EnterLobby($uiPartyMonitor.STATE_MATCHMAKING)
   GenerateEvent("#OnEnterLobbyMatchmaking")
end

handle OnExitState("LobbyMatchmaking")
   StopRosterLoop()
end

handle OnEnterState("Initial")
   Widgets.superContainer.SetStateName("Initial")
   GenerateEvent("#OnEnterLobbyInitial")
end

handle OnEnterState("LobbySelectPlaylist")
   Log("ui~content", "OnEnter LobbySelectPlaylist")
   $uiPartyMonitor.EnterLobby($uiPartyMonitor.STATE_FORMATION)
   Widgets.superContainer.redTeam.SetSelectionIdx(0)	            
   InitFocus(true)
   GenerateEvent("#OnEnterLobbyPlaylist")
end

handle OnExitState("LobbySelectPlaylist")
end

func SetScreenAlpha(_alpha: float)
end

func OnDialogShowTween(p: params): bool
   var alphaParm : float = p.dialogTweenParm
   if (GetStateName() != "Initial")
      SetScreenAlpha(100.0 - alphaParm * 95)
   end
   return true
end

func GetLobbyStateFromPartyMonitor(): string
   return $uiPartyMonitor.GetLobbyMode()
end

override PrepareSlide // ()
   var lobbyState : string = GetLobbyStateFromPartyMonitor()
   Log("ui~content", "PrepareSlide lobby state = " + lobbyState + ", curState = " + GetStateName())
   $hq.ShowroomEnd()
   $hq.isInShowroom := false
   if (lobbyState != "")
      Log("ui~content", "PrepareSlide lobby CHANGING")
      $UiBiLogger.LogGlobalStateChange($uiEnums.UI_BI_LOBBY)
      SetStateName(lobbyState)
   end   
   GenerateEvent("#OnPrepareLobbyScreen")
   StartDefaultBlinking(0.3)
end

override PrepareHideSlide // ()
   GenerateEvent("#OnHideLobbyScreen")
end

override DisableSlide // ()
   if (GetStateName() != "Initial")
      SetStateName("Initial")
   end
end

override SwitchToScreen //()
   $hq.ShowroomEnd()
   $hq.isInShowroom := false
end

end

class MapModeVM
   var icon          : ObservableProperty = $OM.Property("")
   var name          : ObservableProperty = $OM.Property("")
   var modeIcon      : ObservableProperty = $OM.Property("")
   var modeName      : ObservableProperty = $OM.Property("")
   var isMapMode     : ObservableProperty = $OM.Property(true)
   var isCustom      : ObservableProperty = $OM.Property(false)
   
   func Init()
      isMapMode.Subscribe(this, "UpdateMapMode") 
   end
   
   func Term()
      isMapMode.Unsubscribe(this, "UpdateMapMode") 
   end
   
   func UpdateMapMode()
      if ((bool)isCustom.Get())
         SetCustomMapMode()
      else
         if ((bool)isMapMode.Get())
            SetCurrentMapMode()
         else
            SetCurrentPlaylist()            
         end
      end
   end
   
   func SetCustomMapMode()
      var mapUIComp  : GL_ComponentUI  = (GL_ComponentUI)$UiGlobals.componentsUI.Get($UiGlobals.matchmaking.custom_game_maps_selection.Get())
      icon.Set(mapUIComp.icon.Get())
      name.Set(mapUIComp.name.Get())
      //$root.UiLog("Lobby: custom map = [" + (string)$UiGlobals.matchmaking.custom_game_maps_selection.Get() + "]")
      
      var modeUIComp  : GL_ComponentUI  = (GL_ComponentUI)$UiGlobals.componentsUI.Get($UiGlobals.matchmaking.custom_game_modes_selection.Get())
      modeIcon.Set("")
      //modeIcon.Set(modeUIComp.icon.Get())
      modeName.Set(modeUIComp.name.Get())
      //$root.UiLog("Lobby: custom mode = [" + (string)$UiGlobals.matchmaking.custom_game_modes_selection.Get() + "]")
   end
   
   func SetCurrentMapMode()
      var mapUIComp  : GL_ComponentUI  = (GL_ComponentUI)$UiGlobals.componentsUI.Get($UiGlobals.lobby.map_id.Get())
      icon.Set(mapUIComp.icon.Get())
      name.Set(mapUIComp.name.Get())
      //$root.UiLog("Lobby: current map = [" + (string)$UiGlobals.lobby.map_id.Get() + "]")
      
      var modeUIComp  : GL_ComponentUI  = (GL_ComponentUI)$UiGlobals.componentsUI.Get($UiGlobals.lobby.game_mode_id.Get())
      modeIcon.Set(modeUIComp.icon.Get())
      modeName.Set(modeUIComp.name.Get())
      //$root.UiLog("Lobby: current mode = [" + (string)$UiGlobals.lobby.game_mode_id.Get() + "]")
   end
   
   func GetMapName() : string
      UpdateMapMode()
      return (string)name.Get()
   end
   
   func GetMapIcon() : string
      UpdateMapMode()
      return (string)icon.Get()
   end
      
   func GetModeName() : string
      UpdateMapMode()
      return (string)modeName.Get()
   end
   
   func GetModeIcon() : string
      UpdateMapMode()
      return (string)modeIcon.Get()
   end
   
   func SetCurrentPlaylist()
      SetPlaylist((string)$UiGlobals.matchmaking.playlists_selection.Get())
   end
   
   func SetPlaylist(_id : string)
      if (_id != "")
         var uiComp : GL_ComponentUI  = (GL_ComponentUI)$UiGlobals.componentsUI.Get(_id)
         icon.Set(uiComp.icon_big.Get())
         name.Set(uiComp.name.Get())         
         //$root.UiLog("Lobby: current playlist = [" + _id + "]")
      else
         icon.Set("")
         name.Set("")
      end
      modeIcon.Set("slayerMode")
      var plComp: GL_ComponentPlaylist = (GL_ComponentPlaylist)$UiGlobals.componentsPlaylist.Get($UiGlobals.matchmaking.playlists_selection.Get())
      modeName.Set("lobby_playlist_desc," + (string)(int)plComp.player_count_min.Get() + "," + (string)(int)plComp.player_count_max.Get() + "," + (string)(int)plComp.party_size_max.Get())
   end
   
   func Invalidate()
      UpdateMapMode()
   end
end

class LobbyVM : UiSlidingScreenMainMenuPageVM   
   var isScreenActive         : ObservableProperty = $OM.Property(false)
   var SelectedUID            : ObservableProperty = $OM.Property(0)
   var isVotingPhase          : ObservableProperty = $OM.Calculated(this, "GetIsVotingPhase")
   var playersList1           : ObservableProperty = $OM.Calculated(this, "GetPlayersList1")
   var playersList2           : ObservableProperty = $OM.Calculated(this, "GetPlayersList2")
   var rosterCardLeft         : PlayerCardVM       = new PlayerCardVM()
   var rosterCardRight        : PlayerCardVM       = new PlayerCardVM()
   var selectedPlayerIdx      : ObservableProperty = $OM.Property(0)
   var selectedPlayerIdx1     : ObservableProperty = $OM.Property(0)
   var selectedPlayerIdx2     : ObservableProperty = $OM.Property(0)
   var savedPlayerIdx         : ObservableProperty = $OM.Property(0)
   var savedPlayerIdx1        : ObservableProperty = $OM.Property(0)
   var savedPlayerIdx2        : ObservableProperty = $OM.Property(0)
   var selectedPlayerUID      : ObservableProperty = $OM.Property($UserDataStorage.invalidUID)
   var selectedPlayerUID1     : ObservableProperty = $OM.Calculated(this, "GetSelectedPlayerUID1")
   var selectedPlayerUID2     : ObservableProperty = $OM.Calculated(this, "GetSelectedPlayerUID2")
   var playlistsList          : ObservableProperty = $OM.Calculated(this, "GetPlaylists")
   var gameModesList          : ObservableProperty = $OM.Calculated(this, "GetGameModes")
   var gameMapsList           : ObservableProperty = $OM.Calculated(this, "GetGameMaps")
   var playlistsNames         : vector
   var selectedPlaylistIdx    : ObservableProperty = $OM.Property(0)
   var selectedGameModeIdx    : ObservableProperty = $OM.Property(0)
   var selectedGameMapIdx     : ObservableProperty = $OM.Property(0)
   var selectedPlaylist       : ObservableProperty = $OM.Property("")
   var selectedGameMode       : ObservableProperty = $OM.Property("")
   var selectedGameMap        : ObservableProperty = $OM.Property("")
   var mapMode                : MapModeVM          = new MapModeVM()
   var isWaiting              : ObservableProperty = $OM.Calculated(this, "GetIsWaiting")
   var screenState            : ObservableProperty = $OM.Property($uiEnums.LOBBY_SCREEN_STATE_NONE)
   var isTeamMode             : ObservableProperty = $OM.Property(false)
   var isTeamModeRoster       : ObservableProperty = $OM.Calculated(this, "GetIsTeamModeRoster")
   var wgt                    : UiWidget_Lobby     = null
   var waitingText            : ObservableProperty = $OM.Property("")
   var lobbyStateTxt          : ObservableProperty = $OM.Property("")
   var players1Vec            : vector
   var players2Vec            : vector
   var players1VecObservable  : ObservableProperty = $OM.Property(players1Vec)
   var players2VecObservable  : ObservableProperty = $OM.Property(players2Vec)
   
   var isPlaylistVisible      : ObservableProperty = $OM.Property(false)
   var isGameModeVisible      : ObservableProperty = $OM.Property(false)
   var isGameMapVisible       : ObservableProperty = $OM.Property(false)
   var isMapSelectorVisible   : ObservableProperty = $OM.Property(false)
   var isModeSelectorVisible  : ObservableProperty = $OM.Property(false)
   var isMapModeVisible       : ObservableProperty = $OM.Property(false)
   var isVotingMapsVisible    : ObservableProperty = $OM.Property(false)
   var isPlayers1Visible      : ObservableProperty = $OM.Property(false)
   var isPlayers2Visible      : ObservableProperty = $OM.Property(false)
   var isPlayers1Enabled      : ObservableProperty = $OM.Property(false)
   var isPlayers2Enabled      : ObservableProperty = $OM.Property(false)
   var isStartBtnVisible      : ObservableProperty = $OM.Property(false)
   var isCloseBtnVisible      : ObservableProperty = $OM.Property(true)
   var isWaitingMode          : ObservableProperty = $OM.Property(false)
   var isFlowPanelVisible     : ObservableProperty = $OM.Property(true)
   var isLobbyMode            : ObservableProperty = $OM.Property(true)
   
   var lobbyPlayerLocal       : GL_LobbyPlayer = new GL_LobbyPlayer()
   var lobbyPlayerInvalid     : GL_LobbyPlayer = new GL_LobbyPlayer()
   
   var internalPlayersLobby   :  vector
   var internalPlayersMM      :  vector
   var internalPlayersParty   :  vector
   
   
   override InitOverride //(p : params)
      rosterCardLeft.isLeft.Set(false)
      rosterCardRight.isLeft.Set(true)
      
      lobbyPlayerLocal.InitDefault()
      lobbyPlayerInvalid.InitDefault()
      UpdateLocalUid()
      
      wgt := p.widget
      selectedPlayerUID.Subscribe(this, "UpdateSelectedUID")
      selectedPlayerUID1.Subscribe(this, "UpdateSelectedUID")
      selectedPlayerUID2.Subscribe(this, "UpdateSelectedUID")
      isTeamModeRoster.Subscribe(this, "UpdateTeamMode")
      isFlowPanelVisible.Subscribe(this, "UpdateFlowPanelVisible")
      isLobbyMode.Subscribe(this, "UpdateIsLobbyMode")
      $UiGlobals.lobby.state.Subscribe(this, "UpdateLobbyState")
      $UiGlobals.matchmaking.state.Subscribe(this, "UpdateLobbyState")      
      $UiGlobals.matchmaking.queue.Subscribe(this, "UpdateLobbyState")
      $UserDataStorage.local_user.isPartyLeader.Subscribe(this, "UpdateLobbyState")
      
      $UiGlobals.matchmaking.playlists_selection.Subscribe(this, "UpdateMapMode")
      $UiGlobals.lobby.map_id.Subscribe(this, "UpdateMapMode")
      $UiGlobals.lobby.game_mode_id.Subscribe(this, "UpdateMapMode")
      
      $uiPartyMonitor.lobbyModeObservable.Subscribe(this, "UpdatePartyMonitorLobbyState")
      mapMode.Init()
      
      $UserDataStorage.local_user.uid.Subscribe(this, "UpdateLocalUid")

      screenState.Subscribe(this, "OnScreenStateChanged")         
      
      $UiGlobals.lobby.players.Subscribe(this, "UpdatePlayerVectors")
      $UiGlobals.matchmaking.group.Subscribe(this, "UpdatePlayerVectors")
      $UiGlobals.party.members.Subscribe(this, "UpdatePlayerVectors")
      $UiGlobals.lobby.team_count.Subscribe(this, "UpdatePlayerVectors")
   end
   
   override TermOverride //()
      $UiGlobals.party.members.Unsubscribe(this, "UpdatePlayerVectors")
      $UiGlobals.matchmaking.group.Unsubscribe(this, "UpdatePlayerVectors")
      $UiGlobals.lobby.players.Unsubscribe(this, "UpdatePlayerVectors")
      $UiGlobals.lobby.team_count.Unsubscribe(this, "UpdatePlayerVectors")
      mapMode.Term()      
      $UiGlobals.lobby.state.Unsubscribe(this, "UpdateLobbyState")
      $UiGlobals.matchmaking.state.Unsubscribe(this, "UpdateLobbyState")
      $UiGlobals.matchmaking.queue.Unsubscribe(this, "UpdateLobbyState")
      $UserDataStorage.local_user.isPartyLeader.Unsubscribe(this, "UpdateLobbyState")
      
      selectedPlayerUID.Unsubscribe(this, "UpdateSelectedUID")
      selectedPlayerUID1.Unsubscribe(this, "UpdateSelectedUID")
      selectedPlayerUID2.Unsubscribe(this, "UpdateSelectedUID")
      
      screenState.Unsubscribe(this, "OnScreenStateChanged")
      
      isTeamModeRoster.Unsubscribe(this, "UpdateTeamMode")
      isFlowPanelVisible.Unsubscribe(this, "UpdateFlowPanelVisible")
      isLobbyMode.Unsubscribe(this, "UpdateIsLobbyMode")
      
      $UiGlobals.matchmaking.playlists_selection.Unsubscribe(this, "UpdateMapMode")
      $UiGlobals.lobby.map_id.Unsubscribe(this, "UpdateMapMode")
      $UiGlobals.lobby.game_mode_id.Unsubscribe(this, "UpdateMapMode")
      
      $uiPartyMonitor.lobbyModeObservable.Unsubscribe(this, "UpdatePartyMonitorLobbyState")
      
      $UserDataStorage.local_user.uid.Unsubscribe(this, "UpdateLocalUid")
      
      $uiPartyMonitor.FinishMatchCountdown()
   end
   
   func UpdatePlayerVectors()
      if (wgt != null and wgt.GetStateName() != "Initial")
         internalPlayersLobby := $UiGlobals.lobby.players.Get()
         internalPlayersMM    := $UiGlobals.matchmaking.group.Get()
         internalPlayersParty := $UiGlobals.party.members.Get()
         UpdateRosterLists()
         UpdatePlayerSelections()
      end
   end
   
   func UpdatePartyMonitorLobbyState(_val : *)
      if (wgt != null)
         wgt.PrepareSlide()
      end
   end
   
   func votingMapClick(p:params) : bool
      var voteIdx : int = (int)p.widget.Props.voteIdx
      
      //var mapId : string = (string)p.widget.GetDC().map_id.Get()
      $hq.LobbyVote(voteIdx)
      $UiGlobals.lobby.UpdateVoteSetLength()
      
      return true
   end   

   func GetIsVotingPhase() : *
      var ret           : bool = false
      var lobbyStateIdx : int = (int)$UiGlobals.lobby.state.Get()      
      var voteVersion   : int = (int)$UiGlobals.lobby.vote_set_version.Get()
      ret := lobbyStateIdx == $uiEnums.LOBBY_STATE_VOTING
      if (lobbyStateIdx == $uiEnums.LOBBY_STATE_VOTING)
         ret := true
      end
      
      $UiGlobals.lobby.UpdateVoteSetLength()      
          
      
      return ret
   end   
   
   func LobbyVM()
   end
   
   func OnScreenStateChanged(_val : *)
      LobbyBlink(true)
   end
   
   func LobbyBlink(fast : bool = false)
      var delayBlink : float = 0.3
      var blinkSpeed : float = 1.0
      if (fast)
         delayBlink := 0.15
         blinkSpeed := 2.0
      end
      if (wgt != null)
         wgt.StartDefaultBlinking(delayBlink, blinkSpeed)
         wgt.GenerateEvent("SlidingScreenBlink")
      end
   end
   
   func IsCustomGame() : bool
      return (int)$UiGlobals.matchmaking.queue.Get() == $uiEnums.MM_QUEUE_TYPE_CUSTOM
   end
   
   func OnEnterLobby() : bool
      SetScreenActive(true)
      screenState.Set($uiEnums.LOBBY_SCREEN_STATE_MATCHMAKING)
      InvalidateAll(false)
      LobbyBlink()
      return true
   end
      
   func OnEnterLobbyPlaylist() : bool
      SetScreenActive(true)
      screenState.Set($uiEnums.LOBBY_SCREEN_STATE_PLAYLIST)
      InvalidateAll(true)
      LobbyBlink()
      return true
   end
   
   func OnEnterLobbyMatchmaking() : bool
      SetScreenActive(true)
      screenState.Set($uiEnums.LOBBY_SCREEN_STATE_MATCHMAKING)
      InvalidateAll(false)
      LobbyBlink()
      return true
   end      
   
   func OnEnterLobbyInitial() : bool
      SetScreenActive(false)
      screenState.Set($uiEnums.LOBBY_SCREEN_STATE_NONE)
      InvalidateAll(false)
      return true
   end      
   
   func InvalidateAll(reselectPLaylist : bool)
      var plIdx : int = GetPlaylistIdx((string)$UiGlobals.matchmaking.playlists_selection.Get())
      if (plIdx == -1)
         plIdx := 0
      end
      selectedPlaylistIdx.Set(plIdx)
      var playlists : vector = GetPlaylists()
      if playlists.Count() > selectedPlaylistIdx.Get()
         selectedPlaylist.Set(playlists.Get(selectedPlaylistIdx.Get()).id)
      end
      if (reselectPLaylist)
         ApplyCurrentPlaylist()
      end
      $hq.ShopVideoEndSafe()
      $hq.RenderLocalPlayer()
      UpdateRosterLists()
      playersList1.Invalidate()
      playersList2.Invalidate()
      playlistsNames.Clear()
      playlistsList.Invalidate()
      mapMode.Invalidate() 
      UpdateLobbyStateInternal(true)
      ResetPlayerSelections()
      UpdateMapMode()
      UpdatePlayerVectors()
      
      isCloseBtnVisible.Set(true)
      UpdateCloseBtnVisible()
   end
   
   func SetScreenActive(_active : bool)
      rosterCardLeft.isActive.Set(_active)
      rosterCardRight.isActive.Set(_active)
      isScreenActive.Set(_active)
   end
   
   func IsScreenActive() : bool
      var ret : bool = false
      ret := (bool)isScreenActive.Get()
      return ret
   end
   
   func ResetPlayerSelections()
      savedPlayerIdx1.Set(0)
      savedPlayerIdx2.Set(0)
      selectedPlayerIdx1.Set(0)
      selectedPlayerIdx2.Set(0)
      selectedPlayerIdx.Set(0)
      selectedPlayerUID.Set(GetPlayerUID(0, 0))
      selectedPlayerUID.Invalidate()
      selectedPlayerUID1.Invalidate()
      selectedPlayerUID2.Invalidate()
   end
   
   func GetPlayerTeamIdx(_uid : *) : int
      var i    : int
      var ret  := 0
      for i := 0 to players1Vec.Count() - 1
         var player : GL_LobbyPlayer = players1Vec.Get(i)
         if ($UserDataStorage.IsEqualUIDs(_uid, player.id.value.Get()))
            ret := (int)player.team_index2.Get()
            break
         end
      end
      for i := 0 to players2Vec.Count() - 1
         var player : GL_LobbyPlayer = players2Vec.Get(i)
         if ($UserDataStorage.IsEqualUIDs(_uid, player.id.value.Get()))
            ret := (int)player.team_index2.Get()
            break
         end
      end
      return ret
   end
   
   func UpdateSelectedUID(_uid : * = null)
      if ((bool)isTeamModeRoster.Get())
         rosterCardLeft.SetUID((GL_UID)selectedPlayerUID1.Get())
         rosterCardRight.SetUID((GL_UID)selectedPlayerUID2.Get())     
         rosterCardLeft.SetTeam((bool)isTeamMode.Get(), GetPlayerTeamIdx(((GL_UID)selectedPlayerUID1.Get()).value.Get()))
         rosterCardRight.SetTeam((bool)isTeamMode.Get(), GetPlayerTeamIdx(((GL_UID)selectedPlayerUID2.Get()).value.Get()))
      else
         rosterCardLeft.SetUID((GL_UID)selectedPlayerUID.Get())
         rosterCardRight.SetUID(lobbyPlayerInvalid.id)
         rosterCardLeft.SetTeam((bool)isTeamMode.Get(), GetPlayerTeamIdx(((GL_UID)selectedPlayerUID.Get()).value.Get()))
         rosterCardRight.SetTeam((bool)isTeamMode.Get(), 0)
      end
   end
   
   func GetPlayerUID(_teamIdx : int, _idx : int) : GL_UID
      var uid     : GL_UID = lobbyPlayerLocal.id
      var players : vector
      if (_teamIdx == 0)
         players := players1Vec
      elif (_teamIdx == 1)
         players := players2Vec
      end
      if ((bool)isTeamModeRoster.Get())
         uid := lobbyPlayerInvalid.id
      end      
      if (_idx >= 0 and _idx < players.Count())  
         var plr : GL_LobbyPlayer = (GL_LobbyPlayer)players.Get(_idx)
         uid := plr.GetUID()
      end
      if (! uid.IsValidVal())
         uid := lobbyPlayerLocal.id
      end
      return uid
   end      
         
   func GetSelectedPlayerUID1() : *
      var uid : GL_UID = lobbyPlayerLocal.id
      if ((bool)isTeamModeRoster.Get())
         uid := lobbyPlayerInvalid.id
      end
      var players    : vector = players1Vec
      var idx        : int    = (int)selectedPlayerIdx1.Get()
      if (idx >= 0 and idx < players.Count())  
         var plr : GL_LobbyPlayer = (GL_LobbyPlayer)players.Get(idx)
         uid := plr.GetUID()
      end
      if (idx == 0 and ! uid.IsValidVal())
         uid := lobbyPlayerLocal.id
      end
      return uid
   end
   
   func GetSelectedPlayerUID2() : *
      var uid : GL_UID = lobbyPlayerInvalid.id
      if ((bool)isTeamModeRoster.Get())
         uid := $UserDataStorage.invalidUID
      end
      var players   : vector = players2Vec
      var idx       : int    = (int)selectedPlayerIdx2.Get()
      if (idx >= 0 and idx < players.Count())  
         var plr : GL_LobbyPlayer = (GL_LobbyPlayer)players.Get(idx)
         uid := plr.GetUID()
      end
      if (idx == 0 and ! uid.IsValidVal())
         uid := lobbyPlayerLocal.id
      end
      return uid
   end
   
   func InvalidateSelectedPlayer(_renderModelIdx : int = -1)
      selectedPlayerUID1.Invalidate()
      selectedPlayerUID2.Invalidate()      
      selectedPlayerUID.Invalidate()
      UpdateSelectedUID()
      if (_renderModelIdx != -1)
         var uid : GL_UID = lobbyPlayerInvalid.id
         if (_renderModelIdx == 0)
            uid := (GL_UID)selectedPlayerUID.Get()
         elif (_renderModelIdx == 1)
            uid := (GL_UID)selectedPlayerUID1.Get()
         elif (_renderModelIdx == 2)
            uid := (GL_UID)selectedPlayerUID2.Get()
         end
      end
   end

   func GetSelectionLIRData(_listIdx : int, _idx : int) : GL_LobbyPlayer
      var ret     : GL_LobbyPlayer  = null
      var selIdx  : int             = _idx
      var data    : vector
      if (_listIdx == 1)
         data     := GetPlayersList2()
         //selIdx   := wgt.Widgets.superContainer.blueTeam.selection
         //ret := wgt.Widgets.superContainer.GetWidget("blueTeam").selectionItem.Get()
         //return ret
      elif (_listIdx == 0)
         data     := GetPlayersList1()
         //selIdx   := wgt.Widgets.superContainer.redTeam.selection
         //ret := wgt.Widgets.superContainer.GetWidget("redTeam").selectionItem.Get()
         //return ret
      end
      if (data != null and selIdx >= 0 and selIdx < data.Count())
         ret := data.Get(selIdx)
      end
      return ret
   end
   
