/***************************************************************
* UserDataLocal
*
***************************************************************/   
class UserDataLocal : UiSslBindableBase
   var uid                       : ObservableProperty = null
   var gold                      : ObservableProperty = null
   var cr                        : ObservableProperty = null
   var race                      : ObservableProperty = null
   var level                     : ObservableProperty = null
   var level_id                  : ObservableProperty = null  
   var level_next                : ObservableProperty = null
   var level_next_id             : ObservableProperty = null
   var level_progress            : ObservableProperty = null
   var class_id                  : ObservableProperty = null   

   var weapon_loadouts_unlocked  : ObservableProperty = null
   var armor_loadouts_unlocked   : ObservableProperty = null

   var token_renames             : ObservableProperty = null
   var token_class_selection     : ObservableProperty = null
   var tokens                    : ObservableProperty = null

   var is_ui_tutorial_complete   : ObservableProperty = null

   var recent_users              : ObservableProperty = null

   var challenges                : UD_Challenges = null

//extensions
   var currentLoadout            : ObservableProperty = $OM.Calculated(this, "GetCurrentLoadout", true)
   var isPartyLeader             : ObservableProperty = $OM.Calculated(this, "IsPartyLeader", true)
   var goldVal                   : ObservableProperty = $OM.Calculated(this, "GetGold", true)
   var crVal                     : ObservableProperty = $OM.Calculated(this, "GetCredits", true)
   var currentArmorLoadoutIdx    : ObservableProperty = $OM.Calculated(this, "GetCurrentArmorLoadoutIdx", true)
   var currentWeaponLoadoutIdx   : ObservableProperty = $OM.Calculated(this, "GetCurrentWeaponLoadoutIdx", true)
   var isWaitingLoadout          : ObservableProperty = $OM.Calculated(this, "GetIsWaitingLoadout", true)
   
   func GetCurrentArmorLoadoutIdx() : int
      var ud : UserData = (UserData) $UserDataStorage.users.Get($UserDataStorage.local_user.uid.Get())
      return (int)ud.armor_loadouts.spartan.active_loadout_index.Get()
   end
   
   func GetArmorLoadout(_idx : int = -1) : UD_ArmorLoadout
      var ret : UD_ArmorLoadout  = null
      var idx : int              = _idx
      if (idx == -1)
         idx := GetCurrentArmorLoadoutIdx()
      end
      var ud         : UserData  = (UserData) $UserDataStorage.users.Get($UserDataStorage.local_user.uid.Get())
      var loadouts   : vector    = ud.armor_loadouts.spartan.loadouts.Get()
      if (idx >= 0 and idx < loadouts.Count())
         ret := loadouts.Get(idx)
      end
      return ret
   end
   
   func GetShowroomArmorLoadout(_idx : int = -1) : UD_ArmorLoadout
      var ret : UD_ArmorLoadout  = null
      var idx : int              = _idx
      if (idx == -1)
         idx := (int)$UiGlobals.showroom.armor_loadouts.spartan.active_loadout_index.Get()
      end
      var loadouts : vector = $UiGlobals.showroom.armor_loadouts.spartan.loadouts.Get()
      if (idx >= 0 and idx < loadouts.Count())
         ret := loadouts.Get(idx)
      end
      return ret
   end
   
   func GetCurrentWeaponLoadoutIdx() : int
      var ud : UserData = (UserData) $UserDataStorage.users.Get($UserDataStorage.local_user.uid.Get())
      return (int)ud.weapon_loadouts.spartan.active_loadout_index.Get()
   end
   
   func GetWeaponLoadout(_idx : int = -1) : UD_WeaponLoadout
      var ret : UD_WeaponLoadout  = null
      var idx : int              = _idx
      if (idx == -1)
         idx := GetCurrentWeaponLoadoutIdx()
      end
      var ud         : UserData  = (UserData) $UserDataStorage.users.Get($UserDataStorage.local_user.uid.Get())
      var loadouts   : vector    = ud.weapon_loadouts.spartan.loadouts.Get()
      if (idx >= 0 and idx < loadouts.Count())
         ret := loadouts.Get(idx)
      end
      return ret
   end
   
   func GetCurrentLoadout() : UD_ArmorLoadout
      var ud : UserData = (UserData) $UserDataStorage.users.Get($UserDataStorage.local_user.uid.Get())
      var lInd :  int = (int)ud.armor_loadouts.spartan.active_loadout_index.Get()
      var al :  UD_ArmorLoadout = (UD_ArmorLoadout)ud.armor_loadouts.spartan.loadouts.Get().Get(ud.armor_loadouts.spartan.active_loadout_index.Get())
      return al
   end
   
   func IsPartyLeader() : bool
      var pd : GL_ComponentUserPartyData = (GL_ComponentUserPartyData) $UiGlobals.componentsUserPartyData.Get($UserDataStorage.local_user.uid.Get())
      return (bool)pd.is_party_leader.Get()
   end
   
   func IsPartyLeaderVisible() : bool
      var partyMembers : vector = $UiGlobals.party.members.Get()
      return partyMembers.Count() > 1
   end
   
   func IsInParty() : bool
      var partyMembers : vector = $UiGlobals.party.members.Get()
      return partyMembers.Count() > 1
   end
   
   func GetTokenCount(tokenId : string) : *
      var ret  : * = $UiGlobals.IntToInt64(0)
      var i    : int
      var tokensVec : vector = tokens.Get()
      for i := 0 to tokensVec.Count() - 1
         var tokenState : GL_TokenState   = tokensVec.Get(i)
         var id         : string          = (string)tokenState.name.Get()
         if (id == tokenId)
            ret := tokenState.value.Get()
            break
         end
      end
      return ret
   end
   
   func GetGold() : *
      var ret  : * = GetTokenCount($uiEnums.TOKEN_GOLD)
      return ret
   end
   
   func GetCredits() : *
      var ret  : * = GetTokenCount($uiEnums.TOKEN_CREDITS)
      return ret
   end
   
   func GetIsWaitingLoadout() : bool
      var ret  : bool      = false      
      var ud   : UserData  = (UserData) $UserDataStorage.users.Get($UserDataStorage.local_user.uid.Get())
      
      if (!(bool)ud.has_character_spartan_slot_0.Get())
         ret := true
         $user_service.RequestData($UserDataStorage.local_user.uid.Get(), $uiEnums.USER_DATA_CHARACTER_SLOT_0)
      end
      
      if (!(bool)ud.has_character_spartan_slot_1.Get())
         ret := true
         $user_service.RequestData($UserDataStorage.local_user.uid.Get(), $uiEnums.USER_DATA_CHARACTER_SLOT_1)
      end
      
      if (!(bool)ud.has_character_spartan_slot_2.Get())
         ret := true
         $user_service.RequestData($UserDataStorage.local_user.uid.Get(), $uiEnums.USER_DATA_CHARACTER_SLOT_2)
      end
      
      if (!(bool)ud.has_customizations.Get())
         ret := true
         $user_service.RequestData($UserDataStorage.local_user.uid.Get(), $uiEnums.USER_DATA_CUSTOMIZATIONS)
      end
      
      return ret
   end
   
   func GetEmblemId() : string
      var ret : string = $UserDataStorage.GetPlayerEmblemId(uid.Get())
      return ret
   end
   
   func GetEmblemIcon() : string
      var ret : string = $UserDataStorage.GetPlayerEmblemIcon(uid.Get())
      return ret
   end
end

/***************************************************************
* UserDataStorage
*
***************************************************************/   
class UserDataStorage : UiSslBindableBase
   var local_user : UserDataLocal      = null
   var users      : UiSslBindableMap   = null
   var invalidUID : GL_UID             = null
   var tmpUID     : GL_UID             = null
   
   func UserDataStorage()
      $UiGlobals.Init()
   end

   func GetUserDataAndData(_uid : *, _requestBase : bool = false) : UserData
      var ret : UserData = (UserData)users.Get(_uid)
      if (_requestBase and !(bool)ret.has_base.Get() and IsValidUID(_uid))
         $user_service.RequestData(_uid, $uiEnums.USER_DATA_BASE)
      end
      return ret
   end

   func GetInvalidUID() : *
      return invalidUID.value.Get()
   end
   
   func IsValidUID(_uid : *) : bool
      return UID2Str(_uid) != "0"
   end
   
   func UID2Str(_uid : *) : string
      tmpUID.value.Set(_uid)
      var ret : string = tmpUID.ToStr()
      return ret
   end
   
   func NewEmptyUID() : GL_UID
      var ret :  GL_UID = new GL_UID()
      ret.InitDefault()
      return ret
   end
   
   func IsEqualUIDs(_uid1 : *, _uid2 : *) : bool
      var uid1Str : string = UID2Str(_uid1)
      var uid2Str : string = UID2Str(_uid2)
      var ret     : bool   = uid1Str == uid2Str
      return ret
   end
   
   func IsLocalUID(_uid : *) : bool
      return IsEqualUIDs(_uid, local_user.uid.Get())
   end
   
   func IsInParty(_uid : *) : bool
      var ret        : bool      = false
      var partyVec   : vector    = $UiGlobals.party.members.Get()
      var i          : int
      for i := 0 to partyVec.Count() - 1
         var partyUID : GL_UID  = (GL_UID)partyVec.Get(i)
         if ($UserDataStorage.IsEqualUIDs(_uid, partyUID.value.Get()))
            ret := true
            break
         end
      end      
      return ret
   end
      
   func IsFriend(_uid : *) : bool
      var ret        : bool      = false
      var ud         : UserData  = (UserData)$UserDataStorage.users.Get($UserDataStorage.local_user.uid.Get())
      var friendsVec : vector    = ud.social.following.Get()
      var i          : int
      for i := 0 to friendsVec.Count() - 1
         var friendUID : GL_UID  = (GL_UID)friendsVec.Get(i)
         if ($UserDataStorage.IsEqualUIDs(_uid, friendUID.value.Get()))
            ret := true
            break
         end
      end      
      return ret
   end
   
   func IsClanmate(_uid : *) : bool
      var ud         : UserData  = GetUserDataAndData(_uid, true)
      var udLocal    : UserData  = GetUserDataAndData(local_user.uid.Get(), true)      
      var ret        : bool      = false
      if (IsValidUID(udLocal.base.clan_id.Get()))
         ret := IsEqualUIDs(ud.base.clan_id.Get(), udLocal.base.clan_id.Get())
      end
      return ret
   end
   
   func GetUserColorCode(uid : *) : string
      if IsLocalUID(uid)
         return "me"
      elif IsClanmate(uid)
         return "clanmate"
      elif IsFriend(uid)
         return "friend"
      end
      return "defuser"
   end
   
   func GetPlayerStatusColorCode(_uid : *) : string
      var isLocal       :  bool     = IsLocalUID(_uid)
      var colorTag      :  string   = GetColorDefault()
      if (isLocal) 
         colorTag := GetColorLocal()
      else 
         var isFriend      :  bool     = IsFriend(_uid)
         var isClanmate    :  bool     = IsClanmate(_uid)
         if (isClanmate)
            colorTag := GetColorClanmate()         
         elif (isFriend)
            colorTag := GetColorFriend()
         end
      end
      return colorTag      
   end
   
   func GetPlayerEmblemId(_uid : *) : string
      var ret : string = "dummy"
      return ret
   end
   
   func GetPlayerLabel(uid : *, big : bool = false) : string
      var ret : string  =  ""
      var ud : UserData = $UserDataStorage.GetUserDataAndData(uid, true)
      if (!(bool)(ud.has_customizations.Get()))
         if ($UserDataStorage.IsValidUID(uid))
            $user_service.RequestData(uid, $uiEnums.USER_DATA_CUSTOMIZATIONS)
         end
      else
         var uiComp : GL_ComponentUI = (GL_ComponentUI)$UiGlobals.componentsUI.Get(ud.customizations.account_label.Get())
         if (big)
            ret := (string)uiComp.icon_big.Get()
         else
            ret := (string)uiComp.icon.Get()
         end
      end
      if (big and (ret == "" or ret == "unknown" or ret == "no_icon"))
         ret := "playerCardDefault"
      elif (ret == "" or ret == "unknown" or ret == "no_icon")
         ret := "defaultPlayerNameplate"
      end
      return ret
   end
   
   func GetPlayerEmblemIcon(_uid : *) : string
      var ret : string = ""  
      //if (IsEqualUIDs(local_user.uid.Get(), _uid))
      //   ret := "emb_standart2"
      //end
      var ud : UserData  = GetUserDataAndData(_uid, true)
      var compUi : GL_ComponentUI = (GL_ComponentUI)$UiGlobals.componentsUI.Get(ud.customizations.emblem.Get())
      ret := (string)compUi.icon.Get()
      if (ret == "") // tmp
         ret := "emb_standart1"
      end   
      return ret
   end
   
   func GetColorLocal() : string
      return "#f0e91e"
   end
   
   func GetColorPrivate() : string
      return "#CB5DCD"
   end
   
   func GetColorTeam() : string
      return "#FFC000"
   end
   
   func GetColorTeamRed() : string
      return "#f42727"
   end
   
   func GetColorTeamBlue() : string
      return "#466DF3"
   end
   
   func GetColorFriend() : string
      return "#52e800"
   end
   
   func GetColorClanmate() : string
      return "#FFA5FA"
   end
   
   func GetColorDefault() : string
      return "#FFFFFF"
   end
   
   func GetColorParty() : string
      return "#33FF99"
   end
   
   func GetColorSelected() : string
      return "#0072FF"
   end
   

   func GetPlayerPresenceColorCode(_uid : *) : string
      var ud         : UserData  = (UserData)$UserDataStorage.users.Get(_uid)
      var pState     : int       = (int)ud.presence.presence_state.Get()            
      var colorTag   : string    = "#808080"
      if (pState == $uiEnums.USER_PRESENCE_STATE_OFFLINE)
         colorTag := "#808080"
      elif (pState == $uiEnums.USER_PRESENCE_STATE_ONLINE)
         colorTag := "#00FF00"
      elif (pState == $uiEnums.USER_PRESENCE_STATE_INGAME)
         colorTag := "#FFFF00"
      else         
         colorTag := "#000000"
      end
      return colorTag      
   end
   
   func IsOnline(_uid : *) : bool
      var ud            : UserData  = (UserData)users.Get(_uid)
      var presenseState : int       = (int)ud.presence.presence_state.Get()
      return presenseState == $uiEnums.USER_PRESENCE_STATE_ONLINE or presenseState == $uiEnums.USER_PRESENCE_STATE_INGAME
   end
   
   func GetLocalUserData() : UserData
      var ud : UserData := (UserData)users.Get(local_user.uid.Get())
      return ud
   end
   
   func InvalidateWeaponLoadouts()
      var ud   : UserData = (UserData)$UserDataStorage.users.Get(local_user.uid.Get())
      var i    : int
      for i := 0 to ud.armor_loadouts.spartan.loadouts.Get().Count() - 1
         var ld : UD_WeaponLoadout = ud.weapon_loadouts.spartan.loadouts.Get().Get(i)
         ld.InvalidateCosts()
      end
   end
   
   func InvalidateArmorLoadouts()
      var ud   : UserData = (UserData)$UserDataStorage.users.Get(local_user.uid.Get())
      var i    : int
      for i := 0 to ud.armor_loadouts.spartan.loadouts.Get().Count() - 1
         var ld : UD_ArmorLoadout = ud.armor_loadouts.spartan.loadouts.Get().Get(i)
         ld.InvalidateCosts()
      end
   end
end
var $UserDataStorage : UserDataStorage
