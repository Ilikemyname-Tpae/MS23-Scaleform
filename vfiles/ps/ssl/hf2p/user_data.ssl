class UD_Stats : UiSslBindableBase
   var xp_level_current                : ObservableProperty = null
   var xp_level_next                   : ObservableProperty = null
   var kills                           : ObservableProperty = null
   var deaths                          : ObservableProperty = null
   var suicides                        : ObservableProperty = null
   var assists                         : ObservableProperty = null
   var kd                              : ObservableProperty = null
