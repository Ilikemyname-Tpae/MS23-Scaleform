   func GetStepperIndexById(_elems : vector, _id : string) : int
      var ret        : int = 0
      var i          : int
      if (_id != "")
         for i := 0 to _elems.Count() - 1
            var elem : params = _elems.Get(i)
            if (elem.id == _id)
               ret := i
               break
            end
         end
      end
      return ret
