/*---------------------------------------------------------
* UiRosterDocker
-----------------------------------------------------------*/
class UiRosterDocker : UiWidgetContainer
   
func GetVM() : UiRosterDockerVM
   return (UiRosterDockerVM)GetDC()
end

func DoBlink()
   StartDefaultBlinking(0)   
end

func SetVMActivated(_isActivated : bool)
   if (!IsVoid(GetDC()))
      if (GetVM() != null)
         GetVM().SetIsActivated(_isActivated)
      end
   end
end

handle OnEnteringState("Visible")
   GenerateEvent("dockerPanelOpen")
   SetVMActivated(true)
   Props().visible := true
   StartDefaultBlinking(-0.25)
   $root.playSound("friends_list_appear")
end   

handle OnEnterState("Visible")
   $UiGlobals.isDockerOpened.Set(true)
   GenerateEvent("#dockerPanelOpen")
end

handle OnEnteringState("Initial")
   SetVMActivated(false)
   StartDefaultBlinking(-0.25)
   $root.playSound("friends_list_appear")
end

handle OnEnterState("Initial")
   $UiGlobals.isDockerOpened.Set(false)
   Props().visible := false
   GenerateEvent("#dockerPanelClose")
   GenerateEvent("dockerPanelClose")
end

// force states
handle OnEnteringState("VisibleForce")
   SetVMActivated(true)
   Props().visible := true
   StartDefaultBlinking(-0.25)
   $root.playSound("friends_list_appear")
end   

handle OnEnteringState("InitialForce")
   SetVMActivated(false)
   StartDefaultBlinking(-0.25)
   $root.playSound("friends_list_appear")
end

handle OnEnterState("VisibleForce")
   $UiGlobals.isDockerOpened.Set(true)
   GenerateEvent("#dockerPanelOpen")
end

handle OnEnterState("InitialForce")
   $UiGlobals.isDockerOpened.Set(false)
   GenerateEvent("#dockerPanelClose")
end

func OnCloseRosterDocker(p : params) : bool
   SetStateName("InitialForce")
   return true
end

func OnOpenRosterDocker(p : params) : bool
   SetStateName("VisibleForce")
   return true   
end

func OnOpenRosterDockerOver(p : params) : bool
   SetStateName("Visible")
   return true   
end

func GetSearchText() : wstring
   var ret : wstring
   ret := Widgets().content.searchModule.searchInputTf.wtext
   return ret
end

func FocusOnSearchText()
   //Widgets().content.searchModule.searchInputTf.SetFocus()
end

func ResetSearchText()
   Widgets().content.searchModule.searchInputTf.text := ""
end

func OnPlayerLIRPlusClicked(p : params) : bool
   GenerateEvent("#OnPlayerLIRPlusClicked", p)
   return false
end

func OnPlayerLIRMinusClicked(p : params) : bool
   GenerateEvent("#OnPlayerLIRMinusClicked", p)
   return false
end

func OnPlayerLIRJoinClicked(p : params) : bool
   GenerateEvent("#OnPlayerLIRJoinClicked", p)
   return false
end

func SelectNotif(_idx : int)
   Widgets().content.notificationList.SetSelectionIdx(_idx)
end

end

/*---------------------------------------------------------
* UiRosterDockerVM
-----------------------------------------------------------*/
class UiRosterDockerVM
   var DOCKER_STATE_PLAYERS   : int                = 0
   var DOCKER_STATE_NOTIF     : int                = 1
   
   var FILTER_USER_NONE       : int                = 0
   var FILTER_USER_ALL        : int                = 1
   var FILTER_USER_FRIENDS    : int                = 2
   var FILTER_USER_RECENT     : int                = 3
   
   var FILTER_NOTIF_NONE      : int                = 0
   var FILTER_NOTIF_ALL       : int                = 1
   
   var notifications          : ObservableProperty = $OM.Calculated(this, "GetNotifications")
   var playersList            : ObservableProperty = $OM.Calculated(this, "GetPlayersList")
   var isNotificationsVisible : ObservableProperty = $OM.Property(false)
   var isPlayersVisible       : ObservableProperty = $OM.Property(true)
   var dockerState            : ObservableProperty = $OM.Property(DOCKER_STATE_PLAYERS)
   var filterSelection        : ObservableProperty = $OM.Property(0)
   var friendsFilter          : ObservableProperty = $OM.Property(1)
   var wgt                    : UiRosterDocker     = null
   var searchErr              : ObservableProperty = $OM.Property("")
   var isValidNick            : ObservableProperty = $OM.Property(false)
   var isCollapsed            : ObservableProperty = $OM.Property(true)
   var selectedPlayerUID      : ObservableProperty = $OM.Calculated(this, "GetSelectedPlayerUID")
   var selectedGLUID          : GL_UID             = $UserDataStorage.NewEmptyUID()
   var selectedIdx            : ObservableProperty = $OM.Calculated(this, "GetSelectedIdx")
   var isPlusEnabled          : ObservableProperty = $OM.Calculated(this, "GetIsPlusEnabled")
   var isMinusEnabled         : ObservableProperty = $OM.Calculated(this, "GetIsMinusEnabled")
   var isJoinEnabled          : ObservableProperty = $OM.Calculated(this, "GetIsJoinEnabled")
   var isNewPartyInvites      : ObservableProperty = $OM.Calculated(this, "GetIsNewPartyInvites")
   var isNewPartyKicks        : ObservableProperty = $OM.Calculated(this, "GetIsNewPartyKicks")
   var invitesNotifState      : ObservableProperty = $OM.Property("Hidden")
   var isActivated            : ObservableProperty = $OM.Property(false)
   
   func Init(_wgt :  UiWidget)
      wgt := (UiRosterDocker)_wgt
      wgt.ResetSearchText()
      selectedPlayerUID.Invalidate()
      selectedIdx.Invalidate()
      isNewPartyInvites.Get()
      isNewPartyKicks.Get()
      isNewPartyInvites.Subscribe(this, "UpdatePartyInvites")
      isNewPartyKicks.Subscribe(this, "UpdatePartyKicks")
   end
   
   func Term()
      isNewPartyInvites.Unsubscribe(this, "UpdatePartyInvites")
      isNewPartyKicks.Unsubscribe(this, "UpdatePartyKicks")
   end
   
   func SetIsActivated(_isActivated : bool)
      isActivated.Set(_isActivated)
   end
   
   func GetIsActivated() : bool
      return (bool)isActivated.Get()
   end
      
   func SubscribeToSearch()
      
   end
   
   func UnsubscribeToSearch()
      
   end
   
   func OnCloseDockerClicked(p : params) : bool
      wgt.GenerateEvent("onRankPanelRosterClick")
      return true
   end
      
   func GetIsNewPartyInvites() : bool
      return $UiGlobals.notifications.IsNewNotificationByType($uiEnums.NOTIFICATION_PARTY_INVITE)
   end
   
   func GetIsNewPartyKicks() : bool
      return $UiGlobals.notifications.IsNewNotificationByType($uiEnums.NOTIFICATION_PARTY_KICK)
   end

   func UpdatePartyInvites()
      if (GetIsNewPartyInvites())
         if ($root.mainMenu.GetStateName() == "MainMenuInitial")
            var notif         : NT_Notification = $UiGlobals.notifications.GetFirstUnprocessedByType($uiEnums.NOTIFICATION_PARTY_INVITE)
            var inviteNotif   : NT_PartyInvite  = (NT_PartyInvite)$UiGlobals.notifications.GetNotifDetails(notif)
            
            var pp         : params
            pp.mbType            := $uiEnums.MB_TYPE_NO_YES
            pp.titleTxt          := "msg_accept_invite_hdr"
            pp.messageTxt        := "msg_accept_invite_txt"
            pp.callbackEvent     := "PartyInviteAccept"
            pp.callbacktarget    := wgt.Props()
            pp.isPartyInvite     := true
            pp.InviteUid         := inviteNotif.from_user.Get()
            wgt.GenerateEvent("MainMenuDialogRequest", pp)            
            
            notif.isProcessed.Set(true)            
         else
            invitesNotifState.Set("Visible")
            invitesNotifState.OnChanged()
         end         
      end
   end
   
   func OnPartyInviteAccept(p : params) : bool
      if (p.isOK and ! IsVoid(p.InviteUid))
         DoAcceptInvite(p.InviteUid)
      end
      return true
   end
   
   func UpdatePartyKicks()
      if (GetIsNewPartyKicks())
         var par: params
         par.mbType     := "Info"
         par.titleTxt   := "msg_party_kick_hdr"
         par.messageTxt := "msg_party_kick_txt"
         $sslWidgetMgr.GenerateEvent("MainMenuDialogRequest", par)
         return
      end      
   end
   
   func GetIsPlayerMode() : bool
      return IsPlayersMode()
   end
   
   func GetIsCollapsed() : bool
      return (bool)isCollapsed.Get()
   end
   
   func GetIsPlusEnabled() : bool
      var ret        : bool   = false
      var filterVal  : int    = GetFilter()
      if (IsPlayersMode())
         if (filterVal == FILTER_USER_ALL or filterVal == FILTER_USER_RECENT)
            ret := true
         end
      end
      return ret      
   end
   
   func GetIsMinusEnabled() : bool
      var ret        : bool   = false
      var filterVal  : int    = GetFilter()
      if (IsPlayersMode())
         if (filterVal == FILTER_USER_FRIENDS and ! IsSelectPlaylist())
            ret := true
         end
      end
      return ret      
   end

   func GetIsJoinEnabled() : bool
      var ret        : bool   = false
      var filterVal  : int    = GetFilter()
      if (IsPlayersMode() and IsSelectPlaylist())
         if (filterVal == FILTER_USER_FRIENDS)
            ret := true
         end
      end
      return ret      
   end
   
   func IsSelectPlaylist() : bool
      return $uiPartyMonitor.IsSelectPlaylist()
   end
   
   func IsMatchMaking() : bool
      return $uiMatchmaking.GetIsMathmakingObservable()
   end

   func dockerPanelOpen(p : params) : bool
      isCollapsed.Set(false)
      FocusSearch()
      wgt.SetFocus()
      if (IsPlayersMode())
         ResetSearch()
      else
         ClearNotifications()
      end
      return true
   end
   
   func dockerPanelClose(p : params) : bool
      isCollapsed.Set(true)
      return true
   end
   
   func SelectLastNotif()
      if (GetNotifications().Count() > 0)
         wgt.SelectNotif(GetNotifications().Count() - 1)
      end
   end
   
   func GetIsSearchErr() : bool
      return (string)searchErr.Get() != ""
   end
   
   func UpdateSearchStatus(_val : *)
      var searchStatus : int = (int)$UiGlobals.async_operations.find_users.progress.state.Get()
      if (searchStatus == $uiEnums.BACKEND_REQUEST_STATE_COMPLETE)
         OnFinishedSearch()
      end
   end
   
   func OnFinishedSearch()
      wgt.GenerateEvent("OnFinishedSearch")
   end
   
   func GetIsWaiting() : bool
      return IsSearchActive()
   end
   
   func GetDefaultInputText() : string
      return "main_search_user_default_txt"
   end
   
   func GetIsInputEnabled() : bool
      return ! GetIsWaiting()
   end
   
   func GetIsSearchModuleVisible() : bool
      return (int)dockerState.Get() == DOCKER_STATE_PLAYERS and GetFilter() == FILTER_USER_ALL
   end
   
   func IsPlayersMode() : bool
      return (int)dockerState.Get() == DOCKER_STATE_PLAYERS
   end
   
   func ResetSearch()
      wgt.ResetSearchText()
      isValidNick.Set(false)
      if ((int)dockerState.Get() == DOCKER_STATE_PLAYERS)
         playersList.Invalidate()
      else
         notifications.Invalidate()
      end
   end   
   
   func FocusSearch()
      if (IsPlayersMode())
         wgt.FocusOnSearchText()
      end      
   end
   
   func ToggleContent()
      if ((int)dockerState.Get() == DOCKER_STATE_PLAYERS)
         dockerState.Set(DOCKER_STATE_NOTIF)
      else
         dockerState.Set(DOCKER_STATE_PLAYERS)
      end
      ResetSearch()
      var isPlayers : bool = (int)dockerState.Get() == DOCKER_STATE_PLAYERS      
      isPlayersVisible.Set(isPlayers and ! GetIsWaiting())
      isNotificationsVisible.Set(!isPlayers and ! GetIsWaiting())
      
      if (GetIsPlayerMode())
         filterSelection.Set((int)friendsFilter.Get())
      else
         filterSelection.Set(1)
      end
      FocusSearch()
      if (!(bool)isCollapsed.Get() and (int)dockerState.Get() == DOCKER_STATE_NOTIF)
         ClearNotifications()
      end
   end
   
   func SetFilterSelection(_filterSelection : int)
      ResetSearch()      
      filterSelection.Set(_filterSelection)
      if (GetIsPlayerMode())
         friendsFilter.Set(_filterSelection)
      end
   end
   
   func GetFilter() : int
      return (int)filterSelection.Get()
   end
   
   func GetNotifications() : vector
      var ret        : vector
      if ((bool)isCollapsed.Get() or IsPlayersMode())
         return ret
      end
      
      var notifVec   : vector = $UiGlobals.notifications.notifications.Get()
      var i          : int
      
      for i := 0 to notifVec.Count() - 1
         var notifRec         : NT_Notification    = (NT_Notification)notifVec.Get(i)
         var notifRecDetails  : *                  = $UiGlobals.notifications.GetNotifDetails(notifRec)
         var notifType        : int                = (int)notifRec.type.Get()
         
         if (notifRecDetails != null)
            var isDisplayable : bool = false
            if (notifType == $uiEnums.NOTIFICATION_SESSION_REWARDS or notifType == $uiEnums.NOTIFICATION_SESSION_LVLUP)
               isDisplayable := true
            end
            if (notifType == $uiEnums.NOTIFICATION_SESSION_UNLOCK)
               isDisplayable := true
            end
            if (notifType == $uiEnums.NOTIFICATION_CHALLENGE_COMPLETE)
               isDisplayable := true
            end
            if (notifType == $uiEnums.NOTIFICATION_PARTY_INVITE or notifType == $uiEnums.NOTIFICATION_CLAN_INVITE)
               isDisplayable := true
            end
            
            if (isDisplayable)
               notifRecDetails.idx        := (int)notifRec.index.Get()
               notifRecDetails.listIdx    := ret.Count()
               notifRecDetails.heapIdx    := i
               ret.Push(notifRecDetails)
            end
         end
      end
      
      //for i:= 0 to 32
      //   notif.txt   := " Test Text " + (string)i
      //   notif.id    := "ID"         
      //   ret.Push(notif.Clone())
      //end
      
      return ret
   end
   
   func invalidateNotifCounter(p : params)
      if (!IsVoid(p.notif) and !IsVoid(p.notif.heapIdx))
         var notif : NT_Notification = $UiGlobals.notifications.GetByIdx(p.notif.heapIdx)
         notif.isProcessed.Set(true)
      end
   end


   func ClearInvites()
      if ((string)invitesNotifState.Get() == "Visible")
         invitesNotifState.Set("Hidden")
      end      
   end
   
   func ClearNotifications()
      isNewPartyInvites.Invalidate()
      isNewPartyKicks.Invalidate()
   end
   
   func onAcceptNotificationRec(_notif : *)
      if (_notif != null)
         var notif : * = _notif
         var pp : params
         if (notif.type == $uiEnums.NOTIFICATION_SESSION_REWARDS)
            pp.session_reward_idx := notif.idx
            $sslWidgetMgr.GenerateEvent("ShowPostgameReplay", pp)
         elif (notif.type == $uiEnums.NOTIFICATION_SESSION_LVLUP)
            var lvlUpvec    : vector = $UiGlobals.notifications.level_ups.Get()
            var lvlUpIdx    : int = (int)notif.idx 
            var levelId     : string = (string)lvlUpvec.Get(lvlUpIdx).level_id.Get()
            var levelIdPrev : string = (string)lvlUpvec.Get(lvlUpIdx).level_id_previous.Get()
            var level       : int =  (int)lvlUpvec.Get(lvlUpIdx).level.Get()
            var levelPrev   : int = (int)lvlUpvec.Get(lvlUpIdx).level_previous.Get() 
            var levelPromo  : bool = (bool)lvlUpvec.Get(lvlUpIdx).is_special_promotion.Get()
            var levelUnlockItemsVec : vector = lvlUpvec.Get(lvlUpIdx).level_up_rewards.Get()
            pp.rewardType     := "lvlUpReplay"
            pp.showInPm       := false
            pp.levelName      := levelId
            pp.levelNamePrev  := levelIdPrev
            pp.level          := level
            pp.levelPromo     := levelPromo
            pp.levelPrev      := levelPrev
            pp.lvlRewards     := levelUnlockItemsVec
            $sslWidgetMgr.GenerateEvent("RewardRequest", pp)
         elif (notif.type == $uiEnums.NOTIFICATION_CHALLENGE_COMPLETE)
            var completeChallenge  : vector = $UiGlobals.notifications.challenge_complete.Get()
            var challengeCmpIdx    : int = (int)notif.idx
            var challengeCmpId     : string = completeChallenge.Get(challengeCmpIdx).challenge_id.Get()
            var challengeRewards   : vector = completeChallenge.Get(challengeCmpIdx).rewards_tokens.Get()
            pp.reward := challengeRewards
            pp.challengeId := challengeCmpId
            $sslWidgetMgr.GenerateEvent("ChallengeCompleteRequest", pp)
         elif (notif.type == $uiEnums.NOTIFICATION_SESSION_UNLOCK)
            var unlockItems : vector = $UiGlobals.notifications.new_items.Get()
            var unlockIdx   : int = (int)notif.idx
            var unlockItemsVec : vector = unlockItems.Get(unlockIdx).new_items.Get()
            pp.rewardType     := "itemUnlockReplay"
            pp.showInPm       := false
            if (unlockItemsVec.Count() > 0)
               pp.unlcItemsVec := unlockItemsVec
            end   
            $sslWidgetMgr.GenerateEvent("RewardRequest", pp)
         elif (notif.type == $uiEnums.NOTIFICATION_PARTY_INVITE)
            var invites :  vector = $UiGlobals.notifications.party_invites.Get()
            var invite  : NT_PartyInvite = (NT_PartyInvite)invites.Get(notif.idx)
            OnInviteAcceptDialog(invite.from_user.Get())
         elif (notif.type == $uiEnums.NOTIFICATION_CLAN_INVITE)
            var invites :  vector = $UiGlobals.notifications.clan_invites.Get()
            var invite  : NT_ClanInvite = (NT_ClanInvite)invites.Get(notif.idx)
            var ud : UserData = (UserData)$UserDataStorage.users.Get($UserDataStorage.local_user.uid.Get())
            if ($UserDataStorage.IsValidUID(ud.base.clan_id.Get()))
               var par: params
               par.mbType     := "Info"
               par.titleTxt   := "msg_ui_warning"
               if ($UserDataStorage.IsEqualUIDs(ud.base.clan_id.Get(), invite.to_clan_id.Get()))
                  par.messageTxt := "msg_already_in_this_clan"
               else
                  par.messageTxt := "msg_already_in_another_clan"
               end
               $sslWidgetMgr.GenerateEvent("MainMenuDialogRequest", par)
               return
            end
            OnClanInviteAccept(invite.to_clan_id.Get())
         end
      end
   end
   
   func OnSwitchPartyConfirmed(p : params) : bool
      if (p.isOK and ! IsVoid(p.InviteUid))
         DoAcceptInvite(p.InviteUid)
      end
      return true
   end
   
   func AskSwitchPartyConfirmation(_uid : *)
      var pp : params
      pp.mbType            := $uiEnums.MB_TYPE_NO_YES
      pp.titleTxt          := "msg_switch_party_hdr"
      pp.messageTxt        := "msg_switch_party_txt"
      pp.callbackEvent     := "SwitchPartyConfirmed"
      pp.callbacktarget    := wgt.Props()
      pp.InviteUid         := _uid
      wgt.GenerateEvent("MainMenuDialogRequest", pp)
   end
   
   func ShowInviteAcceptUnavailableDialog()
      var pp : params
      pp.mbType            := $uiEnums.MB_TYPE_INFO
      pp.titleTxt          := "msg_invite_accept_na_hdr"
      pp.messageTxt        := "msg_invite_accept_na_txt"
      wgt.GenerateEvent("MainMenuDialogRequest", pp)
   end
   
   func DoAcceptInvite(_uid : *)
      $UiGlobals.async_operations.party_invite_accept.Start(_uid, "OnInviteAcceptFinished")
   end

   func OnInviteAcceptDialog(_uid : *)
      if ($UserDataStorage.IsValidUID(_uid))
         ClearInvites()
         if ((int)$UiGlobals.party.state.Get() == $uiEnums.PARTY_STATE_NONE)
            DoAcceptInvite(_uid)
         else
            ShowInviteAcceptUnavailableDialog()
         end
      end
   end
   
   func OnClanInviteAccept(_clanUid : *)
      if ($UserDataStorage.IsValidUID(_clanUid))
         $UiGlobals.async_operations.clan_invite_accept.Start(_clanUid, "OnClanInviteAcceptFinished")
      end
   end

   func onCancelNotificationRec(_notif : NT_Notification)
      if  (_notif != null)
         var notif : * = _notif
         var pp : params
         if (notif.type == $uiEnums.NOTIFICATION_PARTY_INVITE)
            var invites :  vector = $UiGlobals.notifications.party_invites.Get()
            var invite  : NT_PartyInvite = (NT_PartyInvite)invites.Get(notif.idx)
            //$hq.invite(invite.from_user.Get())
         end   
      end
   end
   
   func onAcceptNotification(p : params) : bool
      if (!IsVoid(p.notif) and !IsVoid(p.notif.idx))
         onAcceptNotificationRec(p.notif)
      end
      return true
   end
   
   func onCancelNotification(p : params) : bool
      if (!IsVoid(p.notif) and !IsVoid(p.notif.idx))
         onAcceptNotificationRec(p.notif)
      end
      return true
   end

