func onPerksSlotClicked(p:params): bool
   var loadoutIdx : int = p.widget.GetWidget("_parent").GetWidget("_parent").Props().idx
   var perkIdx : int = p.widget.btnIdx - 4
   Log("ui~loadoutSelect", "onPerksSlotClicked " + (string)(loadoutIdx) + ", " + (string)(perkIdx))
   if (minSlotIdx > 2)   
      if (perkIdx >= 0 and perkIdx <= 3)
         $user_service.SetWeaponLoadoutConsumable(GetRaceIdx(), loadoutIdx, perkIdx, assignItemId)
         $user_service.SetWeaponLoadoutActive(GetRaceIdx(), loadoutIdx)
         clickFlag := true
      end
      return false
   end
   return true      
end

