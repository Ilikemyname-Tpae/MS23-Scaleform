   func GetSelectedItem() : GL_String
      var selectedIdxInt   : int = (int)selectedIdx.Get()
      var itemsList        : vector = GetItemList()
      if (selectedIdxInt >= 0 and selectedIdxInt < itemsList.Count())
         return itemsList.Get(selectedIdxInt)
      end
      return null
   end
   
   func GetMaxSections() : int
      return 5
   end
   
   func GetSections() : vector
      var sections   : vector
      if (! IsVoid($UiGlobals.shop.race_shops) and $UiGlobals.shop.race_shops.Get().Count() > 0)
         var shop       :  GL_ShopRace    = (GL_ShopRace)$UiGlobals.shop.race_shops.Get().Get((int)$UserDataStorage.local_user.race.Get())
         var i          : int
         for i := 0 to shop.weapons.Get().Count() - 1
            var subshop : GL_ShopSection = (GL_ShopSection)shop.weapons.Get().Get(i)
            var uiID    : string = (string)subshop.section_id.Get()
            var name    : string  = (string)((GL_ComponentUI)$UiGlobals.componentsUI.Get(uiID)).name.Get()
            if (name == "")
               name := uiID
            end
            var sectionDesc : params
            sectionDesc.label    := name
            sectionDesc.is_hot   := false
            sectionDesc.has_new  := subshop.HasNewItems()
            sections.Push(sectionDesc.Clone())
         end
      end
      while (sections.Count() < GetMaxSections())
         var sectionDesc : params
         sectionDesc.label    := ""
         sectionDesc.is_hot   := false
         sectionDesc.has_new  := false
         sections.Push(sectionDesc.Clone())
      end
      return sections
   end
   
   func GetItemCategories() : vector
      var itemCatList   : vector
      if (! IsVoid($UiGlobals.shop.race_shops) and $UiGlobals.shop.race_shops.Get().Count() > 0)
         var shop          :  GL_ShopRace    = (GL_ShopRace)$UiGlobals.shop.race_shops.Get().Get((int)$UserDataStorage.local_user.race.Get())
         if (! IsVoid(shop.weapons.Get()) and shop.weapons.Get().Count() > (int)itemQuality.Get())
            var subshop       :  GL_ShopSection = (GL_ShopSection)shop.weapons.Get().Get((int)(itemQuality.Get()))              
            var i             : int
            
            for i := 0 to subshop.shelves.Get().Count() - 1
               var shelf         : GL_ShopShelf    = (GL_ShopShelf)subshop.shelves.Get().Get(i) 
               var listElem      : params
               listElem.name     := (string)((GL_ComponentUI)$UiGlobals.componentsUI.Get(shelf.shelf_id.Get())).name.Get()
               listElem.id       := (string)shelf.shelf_id.Get()
               listElem.has_new  := shelf.HasNewItems()
               itemCatList.Push(listElem)
            end
         end
      end
      return itemCatList      
   end
   
   func CompareShopItems(itemA : GL_String, itemB : GL_String) : int
      var itemIdA    : string             = (string)itemA.value.Get()
      var itemIdB    : string             = (string)itemB.value.Get()
      var shopCompA  : GL_ComponentShop   = (GL_ComponentShop)$UiGlobals.componentsShop.Get(itemIdA)
      var shopCompB  : GL_ComponentShop   = (GL_ComponentShop)$UiGlobals.componentsShop.Get(itemIdB)
      var availA     : int                = (int)shopCompA.availability.Get()
      var availB     : int                = (int)shopCompB.availability.Get()
      var ret        : int                = 0      
      
      if (availA > availB)
         ret := 1
      elif (availA < availB)
         ret := -1
      end
      
      return ret      
   end
   
   func SortShopItems(items : vector) : vector
      var ret : vector = items
      ret.Sort(this, "CompareShopItems")
      return ret
   end
         
   func GetItemList() : vector
      var ret : vector = new vector
      if isActive.Get() == true
         if (! IsVoid($UiGlobals.shop.race_shops) and $UiGlobals.shop.race_shops.Get().Count() > 0)
            var shop       :  GL_ShopRace    = (GL_ShopRace)$UiGlobals.shop.race_shops.Get().Get((int)$UserDataStorage.local_user.race.Get())
            if (! IsVoid(shop.weapons.Get()) and shop.weapons.Get().Count() > (int)itemQuality.Get())
               var subshop    :  GL_ShopSection = (GL_ShopSection)shop.weapons.Get().Get((int)(itemQuality.Get()))
               if (! IsVoid(subshop.shelves.Get()) and subshop.shelves.Get().Count() > (int)itemCat.Get())
                  var shelf      :  GL_ShopShelf   = (GL_ShopShelf)subshop.shelves.Get().Get((int)(itemCat.Get()))
                  if (! IsVoid(shelf.items.Get()))
                     ret := SortShopItems(shelf.items.Get())
                  end
               end
            end         
         end
      end
      return ret
   end      
   
   func GetSelectedItemId() : string
      var item :  string      
      var items : vector = itemList.Get()
      
      var idx : int = (int)selectedIdx.Get()
      if (idx >= 0 and idx < items.Count())  
         var glitem :  GL_String = (GL_String)items.Get(idx)
         item := (string)glitem.value.Get()
      end
      
      return item
   end

   func GetMouseOverItemId() : string
      var item :  string      
      var items : vector = itemList.Get()
      
      var idx : int = (int)mouseOverIdx.Get()
      if (idx >= 0 and idx < items.Count())  
         var glitem :  GL_String = (GL_String)items.Get(idx)
         item := (string)glitem.value.Get()
      end
            
      return item
   end   
   
   func HideShop(p : params) : bool
      isActive.Set(false)
      BiLogShopState("Hidden")
      return true
   end
   
   func CloseShop(p : params) : bool
      BiLogShopState("Initial")
      return true
   end
   
   func GetBiShopName() : string
      return $uiEnums.UI_BI_SHOP_WEAPON
   end
   
   func BiLogShopState(shopState : string = "Visible")
      if (shopState == "Visible")
         $UiBiLogger.LogGlobalStateChange($uiEnums.UI_BI_SHOP)
      end
      $UiBiLogger.LogShopState(GetBiShopName(), shopState, GetCurrentSectionId(), GetCurrentSubSectionId())      
   end
   
   func GetCurrentSectionId() : string
      var ret           : string = "undefined"
      var sectionIdx    : int    = (int)itemQuality.Get()
      var sectionsVec   : vector = sections.Get()
      if (sectionIdx >= 0 and sectionIdx < sectionsVec.Count())
         var rec : params = sectionsVec.Get(sectionIdx)
         ret := rec.label
      end
      return ret
   end
   
   func GetCurrentSubSectionId() : string
      var ret           : string = "undefined"
      var categoriesIdx : int    = (int)itemCat.Get()
      var categoriesVec : vector = itemCategories.Get()      
      if (categoriesIdx >= 0 and categoriesIdx < categoriesVec.Count())
         var rec : params = categoriesVec.Get(categoriesIdx)
         ret := rec.id
      end
      return ret
   end
   
   override LoadoutPanelSlotClicked // (p : params) : bool
      $root.GotoShopItem(p.itemId, p.itemType, p.itemSubType)
      return true
   end
end

class WeaponConfVM : ItemShopBaseVM
   var isItemInspectionMode   : ObservableProperty = $OM.Property(false)
   var isItemInspectionToggle : ObservableProperty = $OM.Property(false)
   var contentAlpha           : ObservableProperty = $OM.Property(100.0)
   var descModelState         : ObservableProperty = $OM.Property("Initial")
   var itemStats              : UiItemStatsVM      = new UiItemStatsVM()
   //
   func WeaponConfVM()
      shopType := $uiEnums.SHOP_TYPE_WEAPON
      isVideoIcons.Set(true)
      isRentTimer.Set(true)
   end   
   
   override GetLoadoutsObservable //() : ObservableProperty
      var udLocal : UserDataLocal = $UserDataStorage.local_user
      return udLocal.weapon_loadouts_unlocked
   end
      
   override OnPanelButtonClicked
      Log("ui~content", "wc_OnPanelButtonClicked: " + Params2Str(p))
      if (! IsVoid(p.widget.itemType) and ! p.widget.selected)
         var itemType :  int = p.widget.itemType
         if (itemType >= 0)
            itemCat.Set(0)
            itemQuality.Set(itemType)
            BiLogShopState()
         end
      end
      UpdateSelectedItem(mouseOverItemId.Get())
      DoBlink()
      return false
   end
   
   func ContentFade(isFadeIn : bool, isInstant : bool)
      var animName : string
      if (isFadeIn)
         if (isInstant)
            animName := "fadeOut"
         else
            animName := "fadeIn"
         end
      else
         if (isInstant)
            animName := "initial"
         else
            animName := "fadeOut"
         end
      end      
      if (isInstant)
         wgt.GotoAndStop(animName)
      else
         wgt.GotoAndPlay(animName)
      end
      ((UiWeaponConfScreen)wgt).OnToggleInspection()
   end
      
   func OnToggleInspectionMode(p : params) : bool
      if ((bool)isItemInspectionToggle.Get() == false)
         isItemInspectionToggle.Set(true)
         if ((bool)isItemInspectionMode.Get())
            isItemInspectionMode.Set(false)
            descModelState.Set("Collapsed")
            ContentFade(true, false)
         else
            descModelState.Set("Full")
            ContentFade(false, false)
         end
      end
      return true
   end
   
   override inputEvent//(p: params) : bool
      var ret : bool = true
      
      if ((bool)isItemInspectionMode.Get())
         var code          : int    = p.keyCode
         var isTerminated  : bool   = false
         if (code == $uiKeys.VK_ESC)
            isTerminated := true
            OnToggleInspectionMode(null)
         end
                  
         if (isTerminated)
            p.eventState.SetIsTerminated(true)
            ret := false
         end
      end
      
      return ret
   end

   
   func ShopDescModelOpened(p : params) : bool
      isItemInspectionMode.Set(true)
      isItemInspectionToggle.Set(false)
      return true
   end
   
   func ShopDescModelCollapsed(p : params) : bool
      isItemInspectionToggle.Set(false)
      return true
   end
   
   func StartWeaponUniversalDrag(p : params) : bool
      wgt.GenerateEvent("StartUniversalDrag", p)
      return true
   end

   override TermOverride //(p : params)
      //mouseOverItemId.Unsubscribe(descpanelVM, "UpdateItemId")
      BaseTerm()
   end
         
   func OpenedWeaponConfig(p : params) : bool
      isActive.Set(true)
      sections.Invalidate()
      itemCategories.Invalidate()
      itemQuality.OnChanged()
      itemList.Invalidate()   
      offersModuleVM.isWide.Set(true)
      catCount.Invalidate()
      if ($UiGlobals.shop.openParams.isValid)         
         $UiGlobals.shop.openParams.isValid := false
         itemQuality.Set($UiGlobals.shop.openParams.sectionIdx)
         itemCat.Set($UiGlobals.shop.openParams.shelfIdx)
         selectedIdx.Set($UiGlobals.shop.openParams.itemIdx)
         SetListSelection($UiGlobals.shop.openParams.itemIdx)
      else
         itemCat.Set(0)
         itemQuality.Set(0)
         SetListSelection(0)
      end
      BiLogShopState()
      ContentFade(true, true)
      isItemInspectionToggle.Set(false)
      isItemInspectionMode.Set(false)
      descModelState.Set("Initial")
      return true
   end
         
   override UpdateSelectedItem
      descpanelVM.itemId.Set(mouseOverItemId.Get())
      offersModuleVM.UpdateItemId((string)mouseOverItemId.Get())
      itemStats.itemId.Set(mouseOverItemId.Get())
      itemStats.compareItemId.Set($uiPlayerInfo.GetDefaultComparisonItem((string)mouseOverItemId.Get()))
   end   
   
   func OnWeaponPurchased(p : params) : bool
      offersModuleVM.Go2LoadoutAfterPurchase(p.itemID)
      return true
   end  
   
   func OnGotoInventoryBtnClicked(p : params) : bool
      $root.GotoInventoryItem(GetMouseOverItemId(), $uiEnums.ITEM_TYPE_WEAPON)
      return true
   end
end

