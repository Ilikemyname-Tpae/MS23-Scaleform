	playerCard = {
		__type = "ui_widget_container"

		symbol  = "playerCard" 
		lib     = playercard_lib 

		elements {
			nameplateAttach {
				__type = "ui_widget_container"

				x         = 8
				y         = 360
			} 
			stats {
				__type = "ui_widget_container"

				propMapping {
					value1 = {
						mapping = "value1.text"
					}
					value2 = {
						mapping = "value2.text"
					}
					value3 = {
						mapping = "value3.text"
					}
					value4 = {
						mapping = "value4.text"
					}
					value5 = {
						mapping = "value5.text"
					}
					value6 = {
						mapping = "value6.text"
					}
					value7 = {
						mapping = "value7.text"
					}
					name1 = {
						mapping = "name1.text"
					}
					name2 = {
						mapping = "name2.text"
					}
					name3 = {
						mapping = "name3.text"
					}
					name4 = {
						mapping = "name4.text"
					}
					name5 = {
						mapping = "name5.text"
					}
					name6 = {
						mapping = "name6.text"
					}
					name7 = {
						mapping = "name7.text"
					}
				}
				x         = 61.95
				y         = 423.85
			} 
			renderAttach {
				__type = "ui_widget_container"

				x         = 11
				y         = 11
			} 
			waitingCont {
				__type = "ui_widget_container"

				x         = 31.45
				y         = 16.9

				elements {
					statsAnim {
						__type = "ui_widget_container"

						x         = 94.55
						y         = 480
					} 
					renderAnim {
						__type = "ui_widget_container"

						x         = 0
						y         = 0
						scaleX    = 0.8938
						scaleY    = 0.8939
					} 
				}
			} 
			flagCont {
				__type = "ui_widget_container"

				x         = 20.8
				y         = 11.15

				elements {
					flag {
						__type = "ui_widget_container"

						x         = -36.8
						y         = 2.85
						scaleX    = 1.401
						scaleY    = 1.4215
					} 
				}
				animated  = true
			} 
			videoAttach {
				__type = "ui_widget_container"

				x         = 11
				y         = 11
				animated  = true
			} 
			bgAttach {
				__type = "ui_playercard_lib::playerCard_imageAttach"
				x         = 0
				y         = 0
				animated  = true
			} 
		}
	}

