func StartBlinking(blink : float)
   StopBlinking()
   StartDefaultBlinking(blink)
end

func skipPostMatchBtnClick(p:params):bool
   delay kill, this, STATE_SKIP
   if (GetStateName() == "StatSequence")
      //OnEnterPmChallengeState()
      SetStateName("StatStatic")
   elif (GetStateName() == "ChallengeSequence")
      SetStateName("ChallengeStatic")
   elif (GetStateName() == "StatStatic" or GetStateName() == "ChallengeStatic" or GetStateName() == "Scoreboard")
      //DoPostgameOut()
   end
   
   return false
end

func Finalyze()
   Log("ui~postgame", "Postgame_Finalyze")
   //SetStateName("ChallengeStatic")
end

override PrepareSlide // ()
   if (GetStateName() != "Visible")
      SetStateName("Visible")
   end

end

override PrepareHideSlide // ()
   if (GetStateName() != "Initial")
      SetStateName("Initial")
   end
end

override DisableSlide // ()
end

end

class UiPostgameVM : UiSlidingScreenMainMenuPageVM
   
   var wgt           : UiPostgame = null
   var nick          : ObservableProperty = $OM.Calculated(this, "GetPlrName")
   var pmChallenges  : ObservableProperty = $OM.Calculated(this, "GetPmChallenges")
   var pmState       : ObservableProperty = $OM.Calculated(this, "GetPmState")
   var closeVisible  : ObservableProperty = $OM.Calculated(this, "IsCloseBtnVisible")
   var isOpened      : ObservableProperty = $OM.Property(false) 
   
   override InitOverride // (p : params)
      wgt := p.widget
   end
   
   func GetPlrName() : *
      var ud   :  UserData = (UserData)$UserDataStorage.users.Get($UserDataStorage.local_user.uid.Get())
      var val  : wstring    = ud.base.full_nickname.Get()
      return val
   end
   
   func PostgameOpen(p : params) : bool
      isOpened.Set(true)
      return true
   end
   
   func PostgameClose(p : params) : bool
      isOpened.Set(false)
      return true
   end
   
   func GetPmState() : string
      var ret : string = ""
      if (wgt.IsChangingStateInProgress() == false)
         ret := wgt.GetStateName()
      end
      return ret
   end
   
   func SkipBtnLabel() : string
      return "lobby_btn_skip"
   end
   
   func GetConsecutiveBarLabel(idx : int) : string
      var ret : string = ""
      var vec : vector = $UiGlobals.consecutiveBonuses.Get()
      if (bool)isOpened.Get()
         if (vec.Count() >= idx)
            var consecutive : GL_Consecutive_Bonus = (GL_Consecutive_Bonus)vec.Get(idx)
            ret := (string)(int)consecutive.xp_amount.Get() + " XP"
         end
      end   
      return ret   
   end
   
   func IsCloseBtnVisible() : bool
      var ret : bool = false
      if ((string)pmState.Get() == "StatSequence" or (string)pmState.Get() == "ChallengeSequence")
         ret := true
      end
      return ret
   end
   
   func InvalidatePmChallenges(p:params) : bool
      pmChallenges.Invalidate()
      return true
   end
   
   func GetPmChallenges() : vector     
      if (!(bool)isOpened.Get())
         return new vector
      end
      var tmpVec : vector = $UiGlobals.GetUpcomingChallenges(6)      
      var ret : vector
      var i : int
      for i := 0 to tmpVec.Count() -1
         var p : params
         p.challengeItemId := tmpVec.Get(i).itemId
         ret.Push(p)
      end
      return ret 
   end
   
end
