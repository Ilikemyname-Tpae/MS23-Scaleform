handle OnInit
   isConsoleEnabled := (bool)($sslOptionsSys.GetVariable("Debug.EnableConsole"))
   
   ui_init_enums()
   ui_init_matchmaking()
   ui_init_economy()
   ui_init_player_info()
   ui_init_party_monitor()
   $uiPlayerInfo.Init()
   
   // TODO: Oleg. Remove LOG
   Log("ui~Root", "*** ROOT *** : OnInit()")
   ui_sounds         := GetData("ui_sounds").ui_sounds
   ui_damage_types   := GetData("ui_damage_types").ui_damage_types.ui_damage_types
   
end

handle OnTerm
   Hide("in_game_menu")
   Hide("menu_manager_as3")
   BackendConnectDisconnect($uiEnums.BACKEND_SESSION_OFFLINE)
   UnsubscribeFromSessionState()
   ui_term_matchmaking()
   ui_term_economy()
   ui_term_player_info()
   ui_term_party_monitor()   
   ui_term_enums()
end

func SubscribeToSessionState()
   if (! isSubscribedToSessionState)
      $UiGlobals.backend_session.state.Subscribe(this, "UpdateSessionState")
      $UiGlobals.party.state.Subscribe(this, "UpdatePartyState")
      isSubscribedToSessionState := true
   end
end

func UnsubscribeFromSessionState()
   if (isSubscribedToSessionState)
      $UiGlobals.party.state.Unsubscribe(this, "UpdatePartyState")
      $UiGlobals.backend_session.state.Unsubscribe(this, "UpdateSessionState")
      isSubscribedToSessionState := false
   end
end

func RecreateUiObjects()
   ui_recreate_enums()
   ui_recreate_matchmaking()
   ui_recreate_economy()
   ui_recreate_player_info()
   ui_recreate_party_monitor()
end

var gMainMenuState            : string    = "WELCOME_SCREEN"
var mainStartState            : string    = ""
var activeWidget              : string    = "MAINMENU"

func BackendConnectDisconnect(_connectionState : int)
   if (_connectionState == $uiEnums.BACKEND_SESSION_ONLINE)
      $UiGlobals.async_operations.BackendConnect()
      $UiGlobals.backend_requests.BackendConnect()
   else
      $UiGlobals.async_operations.BackendDisconnect()
      $UiGlobals.backend_requests.BackendDisconnect()
   end
end

func UpdateSessionState()
   BackendConnectDisconnect((int)$UiGlobals.backend_session.state.Get())
   $sslWidgetMgr.GenerateEvent("UpdateBackendSessionState")
end

func UpdatePartyState()
   $sslWidgetMgr.GenerateEvent("UpdatePartyState")
end

func GetMainStartState(): string
   return mainStartState
end

func SetMainStartState(_state: string)
   mainStartState := _state
end

func GetMainMenuState(): string
   return gMainMenuState
end

func SetMainMenuState(state : string)
   gMainMenuState := state
end

func GetIsDisconnect() : bool
   var backendSessionState : int = (int)$UiGlobals.backend_session.state.Get()
   var ret                 : bool = backendSessionState != $uiEnums.BACKEND_SESSION_ONLINE
   return ret
end

global event onHaloDisposeFromOldMap()
   $hq.SetCanRender(false)
   $sslWidgetMgr.GenerateEvent("HaloDisposeFromOldMap")
   gMainMenuState := "REMATCH"
   Reset()
   ForceUpdate(0)
end

func ReloadWidgets(_activeWidget : string)
   Hide("menu_manager_as3")
   activeWidget := _activeWidget
   Show("menu_manager_as3")   
end

global event OnLevelLoaded(state : int)
   $hf2pEngine.SuppressIngameInput(true)
   $hf2pEngine.InitUIScreenSounds()
   $hq.SetCanRender(true)
   SetMainStartState("Welcome")
   ReloadWidgets("MAINMENU")
end

global event OnIngameLevelLoaded(state : int)
   //$hf2pEngine.SuppressIngameInput(false)
   $root.pregameLevel := (int)$UserDataStorage.local_user.level.Get()
   $root.pregameLevelProgress := (float)$UserDataStorage.local_user.level_progress.Get()
   $root.pregameLevelId := (string)$UserDataStorage.local_user.level_id.Get()
   $root.pregameLevelNextId := (string)$UserDataStorage.local_user.level_next_id.Get()
   $root.pregameCredit := (int)$UserDataStorage.local_user.cr.Get()
   
   $hf2pEngine.TermUIScreenSounds()
   $hq.SetCanRender(false)
   $uiPartyMonitor.SetIsLeavedGame(false)
   ReloadWidgets("INGAME")
end

func CheckAllNotifications() : bool
   var ret  : bool = CheckLevelUp()
   if (!ret) 
      ret := CheckItemUnlocks()
   end
   if (!ret)
      ret := CheckChallengeUnlocks()
   end
   return ret
end

func CheckLevelUp() : bool
   var ret : bool = false
   var lastNotif : NT_Notification = $UiGlobals.notifications.GetFirstUnprocessedByType($uiEnums.NOTIFICATION_SESSION_LVLUP)
   var p : params
   if (lastNotif != null)
      var lvlUp : NT_LevelUp = (NT_LevelUp)$UiGlobals.notifications.GetNotifDetails(lastNotif)
      var levelId : string = (string)lvlUp.level_id.Get()
      var levelIdPrev : string = (string)lvlUp.level_previous.Get()
      var level : int =  (int)lvlUp.level.Get()
      var levelPrev : int = (int)lvlUp.level_previous.Get()
      var levelPromo : bool = (bool)lvlUp.is_special_promotion.Get()
      var levelUnlockItemsVec : vector = lvlUp.level_up_rewards.Get() // count
      p.rewardType     := "lvlUp"
      //p.showInPm       := showPm
      p.levelName      := levelId
      p.levelNamePrev  := levelIdPrev
      p.level          := level  
      p.levelPrev      := levelPrev
      p.levelPromo     := levelPromo
      p.lvlRewards     := levelUnlockItemsVec
      $sslWidgetMgr.GenerateEvent("RewardRequest", p)
      ret := true
   end   
   return ret
end   

func CheckItemUnlocks() : bool
   var ret : bool = false
   var lastNotif : NT_Notification = $UiGlobals.notifications.GetFirstUnprocessedByType($uiEnums.NOTIFICATION_SESSION_UNLOCK)
   var p : params
   if (lastNotif != null)
      var itemUnlocks : NT_NewItemsAvailable = (NT_NewItemsAvailable)$UiGlobals.notifications.GetNotifDetails(lastNotif)
      var unlockItemsVec : vector = itemUnlocks.new_items.Get()
      p.rewardType     := "itemUnlock"
      //p.showInPm       := showPm
      if (unlockItemsVec.Count() > 0)
         p.unlcItemsVec := unlockItemsVec
         $sslWidgetMgr.GenerateEvent("RewardRequest", p)
         ret := true
      end   
   end   
   return ret
end 

func CheckChallengeUnlocks() : bool
   var ret : bool = false
   var lastNotif : NT_Notification = $UiGlobals.notifications.GetFirstUnprocessedByType($uiEnums.NOTIFICATION_CHALLENGE_COMPLETE)
   var p : params
   if (lastNotif != null)
      var challengeComplete : NT_ChallengeComplete = (NT_ChallengeComplete)$UiGlobals.notifications.GetNotifDetails(lastNotif)
      p.challengeId := (string)challengeComplete.challenge_id.Get()
      p.reward := challengeComplete.rewards_tokens.Get()
      $sslWidgetMgr.GenerateEvent("ChallengeCompleteRequest", p)
      ret := true
   end   
   return ret
end

func uiPlaySound(snd : int)
	$hf2pEngine.PlaySound(snd)
end

var disabledSounds: params
global event playSound(id:string, section: string = "menu")
// scrolling list events: focusIn, focusOut, select, change, rollOver, rollOut, itemClick, itemDoubleClick, itemPress, itemRollOver, itemRollOut
// button events: focusIn, focusOut, select, rollOver, rollOut, press, doubleClick, click
//???msgbox events?
   var snd: * = ui_sounds.Get(section).Get(id) 
   if(!IsVoid(snd))
      if(IsVoid(disabledSounds.Get(snd)))
         Log("ui~Root", "->playSound(" + id + " -> " + snd + ")")
        // $music.PlaySound(snd)
 	     uiPlaySound((int)(snd))
      else
         Log("ui~Root", "->playSound(" + id + " -> " + snd + "(disabled))")
      end
   else
      Log("ui~Root", "->playSound(" + id + " -> " + snd + ")")
   end
end

global event stopSound(id: string, section: string = "menu")
   var snd: * = ui_sounds.Get(section).Get(id) 
   if(!IsVoid(snd))      
 	   $hf2pEngine.StopSound((int)(snd))
   else
      Log("ui~Root", "->stopSound(" + id + " -> " + snd + ")")
   end   
end
      
func RGB2Clr(r:int, g:int, b:int, a:int = 255): int
   var ret: int = r * 65536 + g * 256 + b
   return ret
end   
   
func GetDamageIcon(_damageType: int): string
   var ret : string = "__EMPTY__"
   if (_damageType >= 0 and _damageType < ui_damage_types.Count())
      ret := ui_damage_types.Get(_damageType).icon
   end
   return ret
end

func GetDamageDesc(_damageType: int): string
   var ret : string = ""
   if (_damageType >= 0 and _damageType < ui_damage_types.Count())
      ret := ui_damage_types.Get(_damageType).desc
   end
   return ret
end

func GetDamageName(_damageType: int): string
