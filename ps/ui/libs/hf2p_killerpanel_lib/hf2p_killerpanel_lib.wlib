classes   =   {
   killer_cont_old   =   {
      sslClass   =   "UiKillerCont"
      sslModule   =   "ui.libs.hf2p_KillerPanel_lib.hf2p_KillerPanel_lib"
      elements   =   {
         KillerPanelInst   =   {
            elements   =   {
               wpn_attach_point   =   {
