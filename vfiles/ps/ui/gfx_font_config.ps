default = {
    fontlib = "fonts_en.swf"
    mappings = [
        {
            name = "$NormalFont"
            newName = "Blender Pro Book"
            style = normal
        },
        {
            name = "$TitleFont"
            newName = "Korataki Rg"
            style = normal
        },
        {
            name = "$SmallFont"
            newName = "Blender Pro Medium"
            style = normal
        },
        {
            name = "$System"
            newName = "Magistral Medium"
            style = normal
        }
    ]
}