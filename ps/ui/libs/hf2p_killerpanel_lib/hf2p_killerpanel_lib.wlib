   killer_cont   =   {
      sslClass   =   "UiKillerCont"
      sslModule   =   "ui.libs.hf2p_KillerPanel_lib.hf2p_KillerPanel_lib"
      elements   =   {
         KillerPanelInst   =   {
            elements   =   {
               showLoadoutButton   =   {
                  events   =   {
                     buttonClick   =   {
                        eventRemap   =   "#ToggleKillerLoadout"
                     }
                  }
                  elements   =   {
                     txt   =   {
                        bindings   =   {
                           textField   =   {
                              binding   =   "{loadoutButtonTxt}"
                           }
                        }
                        __type   =   "ui_widget_container"
                     }
                  }
                  __type   =   "ui_death_screen_lib::ViewEnemyLoadoutBtn"
               }
               loadoutPanel   =   {
                  __type   =   "hf2p_KillerPanel_lib::KillerLoadout"
               }
               WpnNameDesc   =   {
                  bindings   =   {
                     tf   =   {
                        binding   =   "{$UiGlobals.componentsUI[killingDamage].name}"
                     }
                  }
                  __type   =   "ui_widget_container"
               }
               wpn_desc   =   {
                  impl   =   {
                     propMapping   =   {
                        txt   =   {
                           mapping   =   "tf.text"
                           isNoTranslate   =   True
                        }
                     }
                     __type   =   "ui_widget_impl_gfx"
                  }
                  bindings   =   {
                     txt   =   {
                        binding   =   "{true ? '' : damageTypeTxt}"
                     }
                  }
                  __type   =   "ui_widget_container"
               }
               killerRankName   =   {
                  bindings   =   {
                     tf   =   {
                        binding   =   "{$UiGlobals.componentsUI[killerUserData.base.level_id].name}"
                     }
                  }
                  __type   =   "ui_widget_container"
               }
               level   =   {
                  bindings   =   {
                     tf   =   {
                        binding   =   "{'' + killerUserData.base.level}"
                     }
                  }
                  __type   =   "ui_widget_container"
               }
               armorClassTxt   =   {
                  customProps   =   [
                     {
                        propName   =   "tf"
                        propVal   =   {
                           __type   =   "ui_widget_desc_prop_string"
                        }
                     }
                  ]
                  __type   =   "ui_widget_container"
               }
               KilledBy_header   =   {
                  customProps   =   [
                     {
                        propName   =   "tf"
                        propVal   =   {
                           val   =   "ingame_killer_killed_by"
                           __type   =   "ui_widget_desc_prop_string"
                        }
                     }
                  ]
                  __type   =   "ui_widget_container"
               }
               Emblem   =   {
                  bindings   =   {
                     pic   =   {
                        binding   =   "{'tigerEmblem'}"
                     }
                  }
                  __type   =   "ui_death_screen_lib::Weapon_attach"
               }
               ClanTag_field   =   {
                  impl   =   {
                     propMapping   =   {
                        tf   =   {
                           isNoTranslate   =   True
                        }
                     }
                     __type   =   "ui_widget_impl_gfx"
                  }
                  bindings   =   {
                     tf   =   {
                        binding   =   "{killerUserData.base.clan_tag ? '[' + killerUserData.base.clan_tag + ']' : ''}"
                     }
                  }
                  __type   =   "ui_widget_container"
               }
               TagName_field   =   {
                  impl   =   {
                     propMapping   =   {
                        tf   =   {
                           isNoTranslate   =   True
                        }
                     }
                     __type   =   "ui_widget_impl_gfx"
                  }
                  bindings   =   {
                     tf   =   {
                        binding   =   "{killerUserData.base.nickname}"
                     }
                  }
                  __type   =   "ui_widget_container"
               }
               wpn_attach_point   =   {
                  impl   =   {
                     __type   =   "ui_widget_impl_gfx_image"
                  }
                  bindings   =   {
                     pic   =   {
                        binding   =   "{$UiGlobals.componentsUI[killingDamage].icon}"
                     }
                  }
                  isCentered   =   True
                  __type   =   "ui_widget_image"
               }
               armorTexture   =   {
                  elements   =   {
                     rtts_killer_biped   =   {
                        x   =   -24
                        y   =   -22
                        __type   =   "ui_rtts_container::rtts_killer_biped"
                     }
                  }
                  impl   =   {
                     __type   =   "ui_widget_impl_gfx"
                  }
                  bindings   =   {
                     visible   =   {
                        binding   =   "{isValidData}"
                     }
                  }
                  __type   =   "ui_widget_container"
               }
               rank   =   {
                  bindings   =   {
                     pic   =   {
                        binding   =   "{$UiGlobals.componentsUI[killerUserData.base.level_id].icon}"
                     }
                  }
                  __type   =   "ui_death_screen_lib::Weapon_attach"
               }
               flag   =   {
                  bindings   =   {
                     frame   =   {
                        binding   =   "{killerTeamFrame}"
                     }
                  }
                  __type   =   "ui_widget_container"
               }
               waitingInfo   =   {
                  bindings   =   {
                     visible   =   {
                        binding   =   "{!isValidData}"
                     }
                  }
                  __type   =   "ui_activity_lib::rotatingWaitingCombined"
               }
            }
            __type   =   "ui_death_screen_lib::KillerPanel"
         }
      }
      stateMap   =   {
         states   =   {
            Initial   =   {
            }
            Visible   =   {
            }
         }
      }
      bindings   =   {
         DC   =   {
            binding   =   "{new: 'ui.libs.hf2p_KillerPanel_lib.hf2p_KillerPanel_lib.UiKillerContVM'}"
         }
      }
      __type   =   "ui_death_screen_lib::KillerPanelContainer"
   }
