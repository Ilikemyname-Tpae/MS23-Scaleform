class UiWeaponConfScreen : UiSlidingScreenPageMainMenu

var isSlidingElement : bool   = false
var isHidden         : bool   = true

func focusOut(p : params) : bool
   if (IsVoid(p.toWidget))
      SetWeaponModelFocus()
   end
   return false
end

func OpenBuyDialogue(p : params) : bool
   var itemId : string = p.itemId
   var offer : GL_ComponentShopOffer = p.offer
   var isGold : bool = p.isGold
   var playerCurrency = 0
   var offerString : string
   var offerCost : int
   if offer == null
      return true
   end
   if isGold
      playerCurrency := (int)$UserDataStorage.local_user.gold.Get()
      offerString := (string)offer.gl_offer.Get()
      offerCost := (int)offer.gl_cost.Get()
   else
      playerCurrency := (int)$UserDataStorage.local_user.cr.Get()
      offerString := (string)offer.cr_offer.Get()
      offerCost := (int)offer.cr_cost.Get()
   end
   if offerString != ""
      var par: params
      par.itemID        :=  itemId
      par.offer         := offerString
      par.priceAmount   := offerCost
      if isGold
         par.priceUnit  := $uiEnums.TOKEN_GOLD
      else
         par.priceUnit  := $uiEnums.TOKEN_CREDITS
      end
      if (offerCost <= playerCurrency)
         // is rent ?
         var ret : int = 0
         ret := (int)offer.rent_duration.Get()
         if (ret > 0)
            par.isRent := true
         end
         // end 
         par.mbType           := "ConfirmBuy"
         par.callbackEvent    := "OnItemPurchased"
         par.callbackTarget   := Props
      else
         par.mbType     := "Info"
         par.titleTxt   := "msg_ui_warning"
         if isGold
            par.messageTxt := "msg_ui_not_enough_gp"
         else
            par.messageTxt := "msg_ui_not_enough_cr"
         end
      end
      $sslWidgetMgr.GenerateEvent("MainMenuDialogRequest", par)
   end
   return true
end

func SetWeaponModelFocus()
   Widgets.itemDescModel.animWeaponsBig.SetFocus()   
end

func OnToggleInspection()
   SetWeaponModelFocus()
end

func inputEvent(p: params) : bool
   var code          : int    = p.keyCode
   var isTerminated  : bool   = false
   var ret           : bool   = GetDC().inputEvent(p)
   
   if (ret)   
      if (code == $uiKeys.VK_DOWN or code == $uiKeys.VK_UP or code == $uiKeys.VK_LEFT or code == $uiKeys.VK_RIGHT)
         isTerminated := true
      end
      
      if (code == $uiKeys.VK_W or code == $uiKeys.VK_A or code == $uiKeys.VK_S or code == $uiKeys.VK_D)
         isTerminated := true
      end
      
      if (isTerminated)
         $hf2pEngine.OnWeaponScreenKeyDown($uiEnums.UI_RTTS_WEAPONS_SHOP, code, p.isDown)
         p.eventState.SetIsTerminated(true)
      end
      ret := !isTerminated
   end
   return ret
end

func OnLeaveLobby() : bool
   Log("ui~content", " WeaponConfig::OnLeaveLobby() ")
   GenerateEvent("LeaveLobby")
   return false
end

override SwitchToScreen//()   
end

func OnOpenLoadoutBtnClicked(p:params):bool
   Log("ui~content", "OnOpenLoadoutBtnClicked")
   GenerateEvent("SeeLoadout", p)
   return false
end

handle OnEnteringState("Initial")
   Log("ui~content", "Weapon Config OnEntering Initial!!!")
end          

handle OnEnterState("Initial")
   Log("ui~content", "Weapon Config onEnter Initial!!!")
   Set("visible", false)            
   GenerateEvent("#CloseShop")
end          

handle OnEnteringState("Visible")
   Log("ui~content", "Weapon Config OnEntering VISIBLE!!!")         
   Set("visible", true)
end  

handle OnEnterState("Visible")
   Log("ui~content", "Weapon Config onEnter VISIBLE!!!")         
end

override PrepareSlide//()
   if (GetStateName() != "Visible")
      SetStateName("Visible")
   end
   EnableFakeBg()
   GenerateEvent("#OpenedWeaponConfig")
   if (isHidden)
      isHidden := false
      StartDefaultBlinking(0.3)
   end   
end

override PrepareHideSlide//()
   GenerateEvent("#HideShop")
   isHidden := true
end

func OnBlinkItemList(p : params) : bool
   Widgets.weaponConfContent.weaponList.SetSelectionIdx(0)
   Widgets.weaponConfContent.weaponList.StartDefaultBlinking(0.0)
   BarsBlink() : 0
   $root.playSound("screen_rollout")
   return false
end

func BarsBlink()
   Widgets.weaponConfContent.progressBars.StartDefaultBlinking(-0.4, 1.1)
end

override DisableSlide //()
   if (GetStateName() != "Initial")
      SetStateName("Initial")
   end
   isHidden := true
end

func EnableFakeBg()
   var p: params
   p.state := "weapons"
   GenerateEvent("ChangeFakeBackground", p)
end

func OnItemPurchased(p : params) : bool
   if (p.isOK)
      GenerateEvent("#OnWeaponPurchased", p)
   end
   return true
end

func SetListSelection(p : params) : bool
   Widgets.weaponConfContent.weaponList.SetSelectionIdx(p.idx)
   return false
end

override SaveState //() : params
   var ret : params = GetDC().SaveState()
   return ret
end

override LoadState // (p : params) : bool
   var ret : bool = GetDC().LoadState(p)
   return true
end

end

class WeaponItemLIR
   var wgt           : UiWidget = null
   var itemId        : ObservableProperty = $OM.Property("")

   var minOffer      : ObservableProperty = $OM.Calculated(this, "GetMinOffer") 
   var maxDiscount   : ObservableProperty = $OM.Calculated(this, "GetMaxDiscount") 

   var weaponTint    : ObservableProperty = $OM.Calculated(this, "GetWeaponTint")
   var isWeaponTintVisible : ObservableProperty = $OM.Calculated(this, "GetIsWeaponTintVisible")
   var offerGp       : ObservableProperty = $OM.Calculated(this, "GetOfferGp")
   var offerCr       : ObservableProperty = $OM.Calculated(this, "GetOfferCr")
   var ownType       : ObservableProperty = $OM.Calculated(this, "GetOwnType")
   var isOffers      : ObservableProperty = $OM.Calculated(this, "GetIsOffers")
   var rentStatus    : ObservableProperty = $OM.Calculated(this, "GetRentStatus")
   var rentStatusColor :  ObservableProperty = $OM.Calculated(this, "GetRentStatusColor")
   var weaponIndicatorScaleX    : ObservableProperty = $OM.Calculated(this, "GetWeaponIndicatorScaleX")
   var isGpCrLock    : ObservableProperty = $OM.Calculated(this, "GetIsGpCrLock")
   var isLevelLock   : ObservableProperty = $OM.Calculated(this, "GetIsLevelLock")
   var equipIcn      : ObservableProperty = $OM.Calculated(this, "GetEquipIcon")
   var equipLabel    : ObservableProperty = $OM.Calculated(this, "IsLabelEquip")
   var equipEmblem   : ObservableProperty = $OM.Calculated(this, "IsEmblemEquip")
   var isNew         : ObservableProperty = $OM.Calculated(this, "GetIsNew")
   var itemQuality   : ObservableProperty = $OM.Calculated(this, "GetWeaponQuality")
   
   func Init(p : params)
      wgt := p.widget
      if (! IsVoid(p.itemId))
         itemId.Set(p.itemId)
      end
      wgt.Props.mouseChildren := true
   end
   
   func Update(p : params)
      itemId.Set(p.itemId)
   end
   
   func OnItemPriceGoldClicked(p : params) : bool
      var p2 : params
      p2.itemId := itemId.Get()
      p2.offer := $UiGlobals.componentsShop.Get(itemId.Get()).GetMinimalOffer()
      p2.isGold := true
      wgt.GenerateEvent("#OpenBuyDialogue", p2)
      return true
   end
   
   func OnItemPriceCrClicked(p : params) : bool
      var p2 : params
      p2.itemId := itemId.Get()
      p2.offer := $UiGlobals.componentsShop.Get(itemId.Get()).GetMinimalOffer()
      p2.isGold := false
      wgt.GenerateEvent("#OpenBuyDialogue", p2)
      return true
   end
   
   func OnItemLirClicked(p : params) : bool
      var x : * = wgt.Props.mouseChildren
      if isNew.Get() == true
         $hq.ShopNewClear((string)itemId.Get())
      end
      return true
   end
   
   func GetMinOffer() : GL_ComponentShopOffer
      var ret : GL_ComponentShopOffer = null
      if ((bool)isOffers.Get())
         var shopComp : GL_ComponentShop = (GL_ComponentShop)$UiGlobals.componentsShop.Get((string)itemId.Get())
         if (shopComp.offers.Get().Count() > 0)
            ret := shopComp.GetMinimalOffer()
         end
      end
      return ret
   end
      
   func GetMaxDiscount() : string
      var ret : string = ""
      if ((bool)isOffers.Get())
         var shopComp : GL_ComponentShop = (GL_ComponentShop)$UiGlobals.componentsShop.Get((string)itemId.Get())
         if (shopComp.offers.Get().Count() > 0)
            var maxDisc : float = 0
            var i : int
            for i := 0 to shopComp.offers.Get().Count() - 1
               var offer : GL_ComponentShopOffer = shopComp.offers.Get().Get(i)
               if (float)offer.cr_sale_percentage.Get() > maxDisc
                  maxDisc := (float)offer.cr_sale_percentage.Get()
               end
               if (float)offer.gl_sale_percentage.Get() > maxDisc
                  maxDisc := (float)offer.gl_sale_percentage.Get()
               end
            end
            if maxDisc > 0
               ret := "-" + (string)(int)(maxDisc * 100) + "%"
            end
         end
      end
      return ret
   end
      
   func GetIsGpCrLock() : bool
      var ret : bool
      ret := IsCrLock() and IsGlLock()
      return ret
   end
   
   func GetIsLevelLock() : bool
      var ret : bool = false
      var userLvl  : int = (int)$UserDataStorage.local_user.level.Get()
      var shopComp : GL_ComponentShop = (GL_ComponentShop)$UiGlobals.componentsShop.Get((string)itemId.Get())
      var itemLevel : int = (int)shopComp.unlock_level.Get()
      if itemLevel > userLvl
         ret := true
      end
      return ret
   end
   
   func GetWeaponTint() : params
      var itemIdS :  * = itemId.Get()
      var itemIdStr :  string = (string)itemId.Get()
      var   tint     : params = $uiEconomy.GetWeaponPrimaryArrtibuteColor("unknown")
      if (itemIdStr != "")
         var   weapon   :  GL_ComponentWeapon = (GL_ComponentWeapon)$UiGlobals.componentsWeapon.Get(itemIdStr)
         if (weapon != null)
            tint := $uiEconomy.GetWeaponPrimaryArrtibuteColor((string)weapon.primary_attribute_id.Get())
         end
      end
      return tint
   end
   
   func GetIsWeaponTintVisible() : bool
      var itemIdS :  * = itemId.Get()
      var itemIdStr :  string = (string)itemId.Get()
      var ret     : bool = false
      if (itemIdStr != "")
         var   weapon   :  GL_ComponentWeapon = (GL_ComponentWeapon)$UiGlobals.componentsWeapon.Get(itemIdStr)
         if (weapon != null)
            ret := (string)weapon.primary_attribute_id.Get() != "none" and (string)weapon.primary_attribute_id.Get() != ""
         end
      end
      return ret
   end
   
   func GetWeaponQuality() : string
      var ret : string = "common"
      var itemIdStr : string = (string)itemId.Get()
      if (itemIdStr != "")
         ret := (string)$UiGlobals.componentsUI.Get(itemIdStr).quality.Get()
      end
      return ret  
   end
   
   func GetWeaponIndicatorScaleX() : float
      var ret : float
      var ownTypeVal :  int = GetOwnType()
      if (ownTypeVal == $uiEnums.ITEM_OWN_TYPE_NONE)
         ret := 1.0
      else
         ret := 2.625
      end
      return ret
   end
   
   func GetEquipIcon() : bool
      var ret : bool
      var uiInventoryItem : GL_ComponentInventory = (GL_ComponentInventory)$UiGlobals.componentsInventory.Get((string)itemId.Get())
      var equipType : int = (int)uiInventoryItem.equipped_state.Get()
      if (equipType == 2)
         ret := true
      else   
         ret := false
      end
      return ret
   end 
   
   func IsLabelEquip() : bool
      var ret     : bool   = false
      var myLabel : string = ""
      myLabel := $UserDataStorage.GetPlayerLabel($UserDataStorage.local_user.uid.Get())
      if (myLabel == (string)itemId.Get())
         ret := true
      end
      return ret
   end
   
   func IsEmblemEquip() :  bool
      var ret : bool = false
      var myEmblem : string = ""
      var ud : UserData = (UserData) $UserDataStorage.users.Get($UserDataStorage.local_user.uid.Get())
      myEmblem := (string)ud.customizations.emblem.Get()
      if (myEmblem == (string)itemId.Get())
         ret := true
      end
      return ret 
   end
   
   func GetIsNew() : bool
      var ret = $uiEconomy.GetIsItemNew((string)itemId.Get())
      return ret
   end
   
   func GetOfferGp() : string
      var ret : string = "carousel_offer_na_small"
      if minOffer.Get() != null
         var offer = (GL_ComponentShopOffer)minOffer.Get()
         if ((int)offer.gl_cost.Get() > 0)
            ret := (string)(int)offer.gl_cost.Get()
         end   
      end
      return ret
   end
   
   func GetOfferCr() : string
      var ret : string = "carousel_offer_na_small"
      if minOffer.Get() != null
         var offer = (GL_ComponentShopOffer)minOffer.Get()
         if ((int)offer.cr_cost.Get() > 0)   
            ret := (string)(int)offer.cr_cost.Get()
         end
      end
      return ret
   end

   func GetOwnType() : int
      return $uiEconomy.GetItemOwnType((string)itemId.Get())
   end
   
   func GetIsOffers() : bool
      var ret : bool
      //if (GetOwnType() == $uiEnums.ITEM_OWN_TYPE_NONE and (IsGlLock() or IsCrLock()))         
      //if (GetOwnType() == $uiEnums.ITEM_OWN_TYPE_NONE or IsGlLock() or IsCrLock())         
      if (GetOwnType() == $uiEnums.ITEM_OWN_TYPE_NONE)         
         ret := true
      else
         ret := false
      end
      return ret
   end
   
   func GetRentTime() : int
      var ret        : int = 0
      var ownTypeVal : int = (int)ownType.Get()
      if (ownTypeVal == $uiEnums.ITEM_OWN_TYPE_RENTED)
         var uiInventoryItem : GL_ComponentInventory = (GL_ComponentInventory)$UiGlobals.componentsInventory.Get((string)itemId.Get())
         var ownTime : int = (int)uiInventoryItem.ownership_time.Get() - (int)$UiGlobals.timer.Get()
         ret := ownTime
      end
      return ret      
   end
      
   func IsLocked() : bool
      return $uiEconomy.IsItemLocked((string)itemId.Get())
   end
   
   func IsGlLock() : bool
      return $uiEconomy.IsItemLockedGl((string)itemId.Get())
   end

   func IsCrLock() : bool
      return $uiEconomy.IsItemLockedCr((string)itemId.Get())
   end
   
   func GetRentStatusColor() : int
      return $uiEconomy.GetItemRentTintColor((string)itemId.Get())
   end
   
   func GetRentStatus() : string
      var ret        : string      
      
      var ownTypeVal : int = (int)ownType.Get()
      if (ownTypeVal == $uiEnums.ITEM_OWN_TYPE_PURCHASED)
         ret := "carousel_rent_time_purchased"
      elif (ownTypeVal == $uiEnums.ITEM_OWN_TYPE_RENTED)
         var ownTime : int = GetRentTime()
         if (ownTime > 0)
            ret := $root.MakeUiTimerStringMinutes(ownTime, true)
         else
            ret := "carousel_rent_time_expiring"
         end
      end
      
      return ret
   end
 end

class ItemDescPanelVM
   var itemId           : ObservableProperty = $OM.Property("")
   var itemDesc         : ObservableProperty = $OM.Calculated(this, "GetItemDesc")
   var itemSubDesc      : ObservableProperty = $OM.Calculated(this, "GetItemSubDesc")
   var itemName         : ObservableProperty = $OM.Calculated(this, "GetItemName")
   var isLockLineGp     : ObservableProperty = $OM.Calculated(this, "GetIsLockLineGp")
   var lockLineGp       : ObservableProperty = $OM.Calculated(this, "GetLockLineGp")
   var lockLineGpCoordY : ObservableProperty = $OM.Calculated(this, "GetLockLineGpCoordY")
   var isLockLineCr     : ObservableProperty = $OM.Calculated(this, "GetIsLockLineCr")
   var lockLineCr       : ObservableProperty = $OM.Calculated(this, "GetLockLineCr")
   var lockLineCrCoordY : ObservableProperty = $OM.Calculated(this, "GetLockLineCrCoordY")
   var weaponClr        : ObservableProperty = $OM.Calculated(this, "GetWeaponColor")
      
   func GetItemDesc() : string
      var ret     : string
      var compUI  : GL_ComponentUI = (GL_ComponentUI)$UiGlobals.componentsUI.Get((string)itemId.Get())
      ret := (string)compUI.desc.Get()
      return ret
   end
   
   func GetWeaponColor() : int
      var itemIdS   : * = itemId.Get()
      var itemIdStr : string = (string)itemId.Get()
      var tint      : params = $uiEconomy.GetWeaponPrimaryArrtibuteColor("unknown")
      var clr       : int = 0 
      if (itemIdStr != "")
         var   weapon   :  GL_ComponentWeapon = (GL_ComponentWeapon)$UiGlobals.componentsWeapon.Get(itemIdStr)
         if (weapon != null)
            tint := $uiEconomy.GetWeaponPrimaryArrtibuteColor((string)weapon.primary_attribute_id.Get())
            clr := $root.RGB2Clr(tint.r, tint.g, tint.b)
         end
      end
      return clr
   end
   
   func GetOwnType() : int
      return $uiEconomy.GetItemOwnType((string)itemId.Get())
   end
   
   func GetItemName() : string
      var ret     : string
      var compUI  : GL_ComponentUI = (GL_ComponentUI)$UiGlobals.componentsUI.Get((string)itemId.Get())
      ret := (string)compUI.name.Get()
      return ret
   end

   func GetItemSubDesc() : string
      var ret     : string = ""
      return ret
   end
   
   func GetIsLockLineGp() : bool
      return $uiEconomy.IsItemLockedGl((string)itemId.Get()) or $uiEconomy.IsItemLockedCr((string)itemId.Get())
   end
   
   func GetLockLineGp() : string
      var ret : string = ""
      if (GetIsLockLineGp())
         ret := (string)$uiEconomy.GetItemLockedGlLvl((string)itemId.Get())
      end
      return ret
   end
   
   func GetLockLineGpCoordY() : float
      var ret : float = 3
      if (GetIsLockLineCr())
         ret := -24
      end
      return ret
   end
   
   func GetIsLockLineCr() : bool
      return false
   end
   
   func GetLockLineCr() : string
      var ret : string = ""
      if (GetIsLockLineCr())
         ret := (string)$uiEconomy.GetItemLockedCrLvl((string)itemId.Get())
      end
      return ret
   end
   
   func GetLockLineCrCoordY() : float
      var ret : float = 3
      return ret
   end
   
   func UpdateItemId(val : string)
      itemId.Set(val)
   end
end

class OffersLineVM
   var itemId     : ObservableProperty = $OM.Property("")
   var offerIdx   : ObservableProperty = $OM.Property(0)
   var isVisible  : ObservableProperty = $OM.Property(false)
   var isWide     : ObservableProperty = $OM.Property(false)
   var yPos       : ObservableProperty = $OM.Property(0.0)
   var isLvlLock  : ObservableProperty = $OM.Calculated(this, "IsLvlLock")
   var offer      : ObservableProperty = $OM.Calculated(this, "GetOffer")
   var isGpOffer  : ObservableProperty = $OM.Calculated(this, "GetIsGpOffer")
   var gpOffer    : ObservableProperty = $OM.Calculated(this, "GetGpOffer")
   var gpCost     : ObservableProperty = $OM.Calculated(this, "GetGpCost")
   var gpOldCost  : ObservableProperty = $OM.Calculated(this, "GetGpOldCost")
   var gpDiscount : ObservableProperty = $OM.Calculated(this, "GetGpDiscount")
   var gpAlpha    : ObservableProperty = $OM.Calculated(this, "GetGpAlpha")
   var isCrOffer  : ObservableProperty = $OM.Calculated(this, "GetIsCrOffer")
   var crOffer    : ObservableProperty = $OM.Calculated(this, "GetCrOffer")
   var crCost     : ObservableProperty = $OM.Calculated(this, "GetCrCost")
   var crOldCost  : ObservableProperty = $OM.Calculated(this, "GetCrOldCost")
   var crDiscount : ObservableProperty = $OM.Calculated(this, "GetCrDiscount")
   var crAlpha    : ObservableProperty = $OM.Calculated(this, "GetCrAlpha")
   var durationTxt   : ObservableProperty = $OM.Calculated(this, "GetDurationTxt")
   var durationLabel : ObservableProperty = $OM.Calculated(this, "GetDurationLabel")
   var shopWidget : UiWidget = null
      
   func OnUnlockWpnGoldBtnClick(p : params) : bool
      var p2 : params
      p2.itemId := itemId.Get()
      p2.offer := offer.Get()
      p2.isGold := true
      shopWidget.GenerateEvent("#OpenBuyDialogue", p2)
      return true
   end
         
   func OnUnlockWpnCrBtnClick(p : params) : bool
      var p2 : params
      p2.itemId := itemId.Get()
      p2.offer := offer.Get()
      p2.isGold := false
      shopWidget.GenerateEvent("#OpenBuyDialogue", p2)
      return true
   end
   
   func GetOffer() : GL_ComponentShopOffer
      var itemIdVal  : string                = (string)itemId.Get()
      var ret        : GL_ComponentShopOffer = null
      if (itemIdVal != "")
         var shopComp : GL_ComponentShop = (GL_ComponentShop)$UiGlobals.componentsShop.Get((string)itemId.Get())
         if (shopComp.offers.Get().Count() > 0)
            var offerIdxVal : int = (int)offerIdx.Get()
            if (offerIdxVal < shopComp.offers.Get().Count())
               ret := (GL_ComponentShopOffer)shopComp.offers.Get().Get(offerIdxVal)
            end
         end
      end
      return ret      
   end
   
   
   func GetOwnType() : int
      return $uiEconomy.GetItemOwnType((string)itemId.Get())
   end
   
   func IsGlLock() : bool
      return $uiEconomy.IsItemLockedGl((string)itemId.Get())
   end

   func IsCrLock() : bool
      return $uiEconomy.IsItemLockedCr((string)itemId.Get())
   end
   
   func IsLvlLock() : bool
      var ret : bool = false
      var userLvl  : int = (int)$UserDataStorage.local_user.level.Get()
      var shopComp : GL_ComponentShop = (GL_ComponentShop)$UiGlobals.componentsShop.Get((string)itemId.Get())
      var itemLevel : int = (int)shopComp.unlock_level.Get()
      if itemLevel > userLvl
         ret := true
      end
      return ret 
   end
   
   func GetIsGpOffer() : bool
      return ((string)gpOffer.Get()) != "" and ! IsGlLock() and IsOffersRequestsEnabled() and ! $uiPartyMonitor.IsMatchCountdown()
   end
   
   func IsOffersRequestsEnabled() : bool
      var ret : bool = false
      ret := (int)$UiGlobals.backend_requests.apply_offer.progress.state.Get() == $uiEnums.BACKEND_REQUEST_STATE_NONE
      return ret
   end
   
   func GetGpCost() : string
      var offerVal   : GL_ComponentShopOffer = (GL_ComponentShopOffer)offer.Get()
      var ret        : string                = "carousel_offer_na_small"
      if (offerVal != null)
         if ((int)offerVal.gl_cost.Get() > 0)
            ret := (string)offerVal.gl_cost.Get()
         end
      end
      return ret
   end
   
   func GetGpOldCost() : string
      var offerVal   : GL_ComponentShopOffer = (GL_ComponentShopOffer)offer.Get()
      var ret        : string                = "carousel_offer_na_small"
      if (offerVal != null)
         if ((float)offerVal.gl_sale_percentage.Get() < 1)
            ret := (string)(int)((int)offerVal.gl_cost.Get() / (1 - (float)offerVal.gl_sale_percentage.Get()))
         else
            ret := "0"
         end
      end
      Fire("UpdateCrossOutLines")
      return ret
   end
   
   func GetGpDiscount() : string
      var offerVal   : GL_ComponentShopOffer = (GL_ComponentShopOffer)offer.Get()
      var ret        : string                = ""
      if (offerVal != null)
         if ((int)offerVal.gl_cost.Get() > 0 and (float)offerVal.gl_sale_percentage.Get() > 0)
            ret := "-" + (string)(int)((float)offerVal.gl_sale_percentage.Get() * 100) + "%"
         end
      end
      return ret
   end
   
   func GetGpAlpha() : float
      var ret : float = 100
      if (GetGpOffer() == "")
         ret := 40
      end
      return ret
   end
   
   func GetCrAlpha() : float
      var ret : float = 100
      if (GetCrOffer() == "")
         ret := 40
      end
      return ret
   end
   
   func GetGpOffer() : string
      var offerVal   : GL_ComponentShopOffer = (GL_ComponentShopOffer)offer.Get()
      var ret        : string                = ""
      if (offerVal != null)
         if ((int)offerVal.gl_cost.Get() > 0)
            ret := (string)offerVal.gl_offer.Get()
         end
      end
      return ret
   end
   
   func GetIsCrOffer() : bool
      return ((string)crOffer.Get()) != "" and ! IsCrLock() and IsOffersRequestsEnabled() and ! $uiPartyMonitor.IsMatchCountdown()
   end
   
   func GetCrCost() : string
      var offerVal   : GL_ComponentShopOffer = (GL_ComponentShopOffer)offer.Get()
      var ret        : string                = "carousel_offer_na_small"
      if (offerVal != null)
         if ((int)offerVal.cr_cost.Get() > 0)
            ret := (string)offerVal.cr_cost.Get()
         end
      end
      return ret
   end
   
   func GetCrOldCost() : string
      var offerVal   : GL_ComponentShopOffer = (GL_ComponentShopOffer)offer.Get()
      var ret        : string                = "carousel_offer_na_small"
      if (offerVal != null)
         if ((float)offerVal.cr_sale_percentage.Get() < 1)
            ret := (string)(int)((int)offerVal.cr_cost.Get() / (1 - (float)offerVal.cr_sale_percentage.Get()))
         else
            ret := "0"
         end
      end
      Fire("UpdateCrossOutLines")
      return ret
   end
   
   func GetCrDiscount() : string
      var offerVal   : GL_ComponentShopOffer = (GL_ComponentShopOffer)offer.Get()
      var ret        : string                = ""
      if (offerVal != null)
         if ((int)offerVal.cr_cost.Get() > 0 and (float)offerVal.cr_sale_percentage.Get() > 0)
            ret := "-" + (string)(int)((float)offerVal.cr_sale_percentage.Get() * 100) + "%"
         end
      end
      return ret
   end

   func GetCrCostInt() : int
      var offerVal   : GL_ComponentShopOffer = (GL_ComponentShopOffer)offer.Get()
      var ret        : int                   = 0
      if (offerVal != null)
         ret := (int)offerVal.cr_cost.Get()
      end
      return ret
   end
   
   func GetGpCostInt() : int
      var offerVal   : GL_ComponentShopOffer = (GL_ComponentShopOffer)offer.Get()
      var ret        : int                   = 0
      if (offerVal != null)
         ret := (int)offerVal.gl_cost.Get()
      end
      return ret
   end
   
   func GetDurationTxt() : string
      var offerVal   : GL_ComponentShopOffer = (GL_ComponentShopOffer)offer.Get()
      var ret        : string                = ""
      if (offerVal != null)
         var durationParm : params = offerVal.DurationToStrings()
         ret := durationParm.daysCount
      end
      return ret
   end

   func GetDurationLabel() : string
      var offerVal   : GL_ComponentShopOffer = (GL_ComponentShopOffer)offer.Get()
      var ret        : string                = ""
      if (offerVal != null)
         var durationParm : params = offerVal.DurationToStrings()
         ret := durationParm.daysLabel
      end
      return ret
   end

   func GetCrOffer() : string
      var offerVal   : GL_ComponentShopOffer = (GL_ComponentShopOffer)offer.Get()
      var ret        : string                = ""
      if (offerVal != null)
         if ((int)offerVal.cr_cost.Get() > 0)
            ret := (string)offerVal.cr_offer.Get()         
         end
      end
      return ret
   end
end

class OffersModuleVM
   var parentVM            : ItemShopBaseVM = null
   
   var itemId              : ObservableProperty = $OM.Property("")
   var offersCount         : ObservableProperty = $OM.Calculated(this, "GetOffersCount")
   var canAssign           : ObservableProperty = $OM.Calculated(this, "GetCanAssign")
   var hasOffers           : ObservableProperty = $OM.Calculated(this, "GetHasOffers")
   var offers              : ObservableProperty = $OM.Calculated(this, "GetOffers")
   var headerY             : ObservableProperty = $OM.Calculated(this, "GetHeaderY")
   var headerText          : ObservableProperty = $OM.Calculated(this, "GetHeaderText")   
   var assignY             : ObservableProperty = $OM.Calculated(this, "GetAssignY")
   var assignAlpha         : ObservableProperty = $OM.Calculated(this, "GetAssignAlpha")
   var assignEnabled       : ObservableProperty = $OM.Calculated(this, "GetAssignEnabled")
   var assignText          : ObservableProperty = $OM.Calculated(this, "GetAssignText")
   var timeRemainY         : ObservableProperty = $OM.Calculated(this, "GetTimeRemainY")
   var timeRemainTxt       : ObservableProperty = $OM.Calculated(this, "GetTimeRemainTxt")
   var timeRemainVisible   : ObservableProperty = $OM.Calculated(this, "GetTimeRemainVisible")
   var timeRemainFrame     : ObservableProperty = $OM.Calculated(this, "GetTimeRemainFrame")
   var ownTypeInternal     : ObservableProperty = $OM.Calculated(this, "GetOwnTypeInternal")
   var lockStatus          : ObservableProperty = $OM.Calculated(this, "GetLockStatus")
   var isWide              : ObservableProperty = $OM.Property(false)
   var purchasedTxt        : ObservableProperty = $OM.Property("carousel_txt_purchased")
   var nonPurchasedTxt     : ObservableProperty = $OM.Property("carousel_txt_non_purchased")
   var addTimeTxt          : ObservableProperty = $OM.Property("carousel_txt_purchased_add_time")
   var rentTxt             : ObservableProperty = $OM.Property("carousel_txt_non_purchased_rent")
   var isSpartanArmory     : ObservableProperty = $OM.Property(false)
   var shopWidget          : UiWidget           = null
   var wgt                 : UiWidget           = null
   var offerLines          : vector
   var maxOffers           : int = 5
   var y0                  : float = 262.0
   //var offer0        : ObservableProperty = $OM.Property(null)   
   var isSubscribed        : bool               = false
      
      
   func SubscribeToUpdates()
      if (! isSubscribed)
         hasOffers.Subscribe(this, "UpdateOfferLinesSubsciption")
         offersCount.Subscribe(this, "UpdateOfferLinesSubsciption")
         isSubscribed := true         
      end
   end
   
   func UnsubscribeFromUpdates()
      if (isSubscribed)
         hasOffers.Unsubscribe(this, "UpdateOfferLinesSubsciption")
         offersCount.Unsubscribe(this, "UpdateOfferLinesSubsciption")
         isSubscribed := false
      end      
   end
   
   func Term()
      UnsubscribeFromUpdates()
   end
   
   func OnAssignBtnClicked(p : params) : bool
      if (((string)itemId.Get()) != "" and ((string)itemId.Get()) != "null")
         if lockStatus.Get() == "locked"
            //var compShop : GL_ComponentShop = (GL_ComponentShop)$UiGlobals.componentsShop.Get(itemId.Get())
            //$UiGlobals.techOpenTechId := (string)compShop.requirement.Get()
            //shopWidget.GenerateEvent("OpenTechTreeScreen")
         else
            UpdateItemId((string)itemId.Get())
            offersCount.Invalidate()
            Go2Loadout(0.0, (string)itemId.Get())
         end
      end
      return false
   end

   func AssignItem(_itemId :  string)
      //$user_service.SetLoadout(_itemId)
   end
   
   func AssignWeapon(_itemId :  string)
      $user_service.SetWeaponLoadoutWeapon($hf2pEngine.GetUIPlayerModelId(), (int)parentVM.selectedLoadoutIdx.Get(), _itemId)
   end
   
   func AssignArmor(_armorId :  string)
      var shopComp : GL_ComponentShop = (GL_ComponentShop)$UiGlobals.componentsShop.Get(_armorId)
      
      $user_service.SetArmorLoadoutItem($hf2pEngine.GetUIPlayerModelId(), (int)parentVM.selectedArmorLoadoutIdx.Get(), _armorId)      
   end
   
   global event OnSpartanStoreOpen()
      isSpartanArmory.Set(true)
   end

   global event OnSpartanStoreClose()
      isSpartanArmory.Set(false)
   end

   func Go2LoadoutAfterPurchase(_itemId : string)
      Go2LoadoutAfterPurchaseDelayed(_itemId) : 0
   end
   
   func Go2LoadoutAfterPurchaseDelayed(_itemId : string)
      if (! $uiPartyMonitor.IsMatchCountdown())
         var pp         : params
         pp.mbType            := $uiEnums.MB_TYPE_NO_YES
         pp.titleTxt          := "msg_equip_item_header"
         pp.messageTxt        := "msg_equip_item_text"
         pp.callbackEvent     := "OnEquipItemConfirmed"
         pp.itemID            := _itemId
         $sslWidgetMgr.GenerateEvent("MainMenuDialogRequest", pp)            
      end
   end
   
   func GetItemIdVal() : string
      return (string)itemId.Get()
   end
      
   func Go2Loadout(_delay: float = 0.0, _itemId : string)
      var p : params
      p.ItemID := _itemId
      p.isOK := true
      OnEquipItemConfirmed(p)
      /*
      var itemType : int = $uiEconomy.GetItemType(_itemId)
      if itemType == $uiEnums.ITEM_TYPE_WEAPON
         //AssignWeapon(_itemId)
         Go2LoadoutType("weapon", _itemId): _delay
      elif itemType == $uiEnums.ITEM_TYPE_TACTICAL
         Go2LoadoutType("consumable", _itemId): _delay
      elif itemType == $uiEnums.ITEM_TYPE_ARMOR
         //AssignArmor(_itemId)
         Go2LoadoutType("armor", _itemId) : _delay
      elif itemType == $uiEnums.ITEM_TYPE_ARMOR_SUIT
         Go2LoadoutType("armor_suit", _itemId) : _delay
      elif itemType == $uiEnums.ITEM_TYPE_UNKNOWN
         if parentVM.shopType == $uiEnums.SHOP_TYPE_TACTICAL
            Go2LoadoutType("booster", _itemId): _delay
         elif parentVM.shopType == $uiEnums.SHOP_TYPE_WEAPON
            //AssignItem(_itemId)
            Go2LoadoutType("weapon", _itemId): _delay
         end
      end
      */
   end

   func OnEquipItemConfirmed(p : params) : bool
      if p.isOK
         var slot = (int)parentVM.parentVM.loadoutSelectedSlotIndex.Get()
         if $UiGlobals.PassesAsTacticalPackageFilter(p.ItemID)
            if slot >= 4 and slot <= 7
               $user_service.EquipCharacterWithSlot(p.ItemID, slot - 4)
            end
         else
            if !(slot >= 4 and slot <= 7)
               $user_service.EquipCharacter(p.ItemID)
               if $UiGlobals.PassesAsArmorFilter(p.ItemID)
                  $hq.RenderLocalLoadouts()
               end
            end
         end
      end
      return true
   end

   func Go2LoadoutType(_loadoutType: string, _itemId : string)
      if (_loadoutType == "weapon")
         Go2WeaponLoadout(_itemId)
      else if (_loadoutType == "consumable")
         Go2TacticalLoadout(_itemId)
      else if (_loadoutType == "booster")
         Go2BoosterLoadout(_itemId)
      else if (_loadoutType == "armor")
         Go2ArmoryLoadout(_itemId)
      else if (_loadoutType == "armor_suit")
         Go2WeaponLoadout(_itemId)
      end
   end

   func Go2WeaponLoadout(_itemId : string)
      var p       : params
      p.itemId       := _itemId
      p.minSlotIdx   := 0
      p.maxSlotIdx   := 3
      p.closeEvent   := "openWeaponConfig"
      $sslWidgetMgr.GenerateEvent("openLoadoutAssignWpnConf", p)
   end

   func Go2TacticalLoadout(_itemId : string)
      var p:params
      p.itemId       := _itemId
      p.minSlotIdx   := 4
      p.maxSlotIdx   := 8
      p.closeEvent   := "openTacticalPackages"
      $sslWidgetMgr.GenerateEvent("openLoadoutAssignPerks", p)
   end

   func Go2BoosterLoadout(_itemId : string)
      var p:params
      p.itemId       := _itemId
      p.minSlotIdx   := 8
      p.maxSlotIdx   := 8
      p.closeEvent   := "openTacticalPackages"
      $sslWidgetMgr.GenerateEvent("openLoadoutAssignBooster", p)
   end

   func Go2ArmoryLoadout(_itemId : string)
      Log("ui~wc_weaponContBig", "Go2ArmoryLoadout (itemID) -> ( " + _itemId + " )")
      var p:params
      p.itemId   := _itemId       
      p.armorType := "item"
      
      $sslWidgetMgr.GenerateEvent("openArmorLoadoutAssgin", p)
   end
   
   func OffersModuleVM()
      var i : int
      for i := 0 to maxOffers - 1
         var offerLine : OffersLineVM = new OffersLineVM()
         offerLine.offerIdx.Set(i)
         offerLines.Push(offerLine)
      end
   end
   
   func UpdateOfferLinesSubsciption()
      UpdateOfferLines()
   end
   
   func UpdateOfferLines()
      var i             : int
      var totalOffers   : int    = (int)offersCount.Get()
      for i := 0 to maxOffers - 1
         var offerLine : OffersLineVM = offerLines.Get(i)
                  
         var y : float = y0 - 47.0 * (i + 1)
         offerLine.yPos.Set(y)                  
         offerLine.itemId.Set(itemId.Get())
         offerLine.shopWidget := shopWidget
         
         if (i < totalOffers)
            offerLine.isVisible.Set(true)
         else
            offerLine.isVisible.Set(false)
         end         
         offerLine.isWide.Set((bool)isWide.Get())
      end
   end
      
   func UpdateItemId(_itemId : string)
      itemId.Set(_itemId)
      UpdateOfferLines()
      UnsubscribeFromUpdates()
      SubscribeToUpdates()
   end
   
   func GetOffersCount() : int
      var ret : int
      ret := GetOffers().Count()
      if (GetOwnType() == $uiEnums.ITEM_OWN_TYPE_PURCHASED)
         ret := 0
      end
      return ret
   end
   
   func GetCanAssign() : bool
      var ret : bool
      
      ret := GetOwnType() != $uiEnums.ITEM_OWN_TYPE_NONE and ! $uiPartyMonitor.IsMatchCountdown()            
      
      return ret
   end

   func GetHasOffers() : bool
      var ret : bool
      if (GetOwnType() != $uiEnums.ITEM_OWN_TYPE_PURCHASED and GetOffers().Count() > 0)
         ret := true
      end
      return ret 
   end
   
   func CompareOffers(a : GL_ComponentShopOffer, b : GL_ComponentShopOffer) : int
      var da   : int = (int)a.rent_duration.Get()
      var db   : int = (int)b.rent_duration.Get()
      var ret  : int = 0
      if (da > db)
         ret := -1
      elif (da < db)
         ret := 1
      end
      return ret
   end 
   
   func GetOffers() : vector
      var ret        : vector
      var shopComp   : GL_ComponentShop = (GL_ComponentShop)$UiGlobals.componentsShop.Get((string)itemId.Get())
      var ownType    : int = GetOwnType()
      if (shopComp.offers.Get().Count() > 0)
         ret := shopComp.offers.Get()
         ret.Sort(this, "CompareOffers")
      end
      return ret
   end
   
   func GetOwnTypeInternal() : int
      var ret        : int = 0
      var shopComp   : GL_ComponentShop = (GL_ComponentShop)$UiGlobals.componentsShop.Get((string)itemId.Get())
      if (shopComp.bundled_items.Get().Count() > 0)         
         ret := $uiEnums.ITEM_OWN_TYPE_PURCHASED
         var i : int
         for i := 0 to shopComp.bundled_items.Get().Count() - 1
            var item : GL_ComponentShopBundledItem = (GL_ComponentShopBundledItem)shopComp.bundled_items.Get().Get(i)
            var inventItem : GL_ComponentInventory = (GL_ComponentInventory)$UiGlobals.componentsInventory.Get((string)item.item_id.Get())
            var itemStatus : int = (int)inventItem.ownership_type.Get()
            if (itemStatus == $uiEnums.ITEM_OWN_TYPE_NONE)
               ret := $uiEnums.ITEM_OWN_TYPE_NONE
            elif (itemStatus == $uiEnums.ITEM_OWN_TYPE_RENTED)            
               ret := $uiEnums.ITEM_OWN_TYPE_RENTED
            end
         end         
      else
         var inventItem : GL_ComponentInventory = (GL_ComponentInventory)$UiGlobals.componentsInventory.Get((string)itemId.Get())      
         ret := (int)inventItem.ownership_type.Get()
      end
      
      return ret
   end
   
   func GetLockStatus() : string
      var ret : string = "none"
      var compShop : GL_ComponentShop = (GL_ComponentShop)$UiGlobals.componentsShop.Get(itemId.Get())
      if compShop.requirement.Get() != ""
         var compInventory : GL_ComponentInventory = (GL_ComponentInventory)$UiGlobals.componentsInventory.Get(compShop.requirement.Get())
         if compInventory.ownership_type.Get() == $uiEnums.ITEM_OWN_TYPE_PURCHASED
            ret := "unlocked"
         else
            ret := "locked"
         end
      end
      return ret
   end
   
   func GetOwnType() : int
      var ret : int = (int)ownTypeInternal.Get()
      return ret
   end
   
   func GetHeaderY() : float
      var ret              : float = 0
      var offersCountVal   : int = (int)offersCount.Get()
      ret := y0 - 47.0 * offersCountVal - 45
      return ret      
   end

   func GetHeaderText() : string
      var ret : string
      if (GetOwnType() == $uiEnums.ITEM_OWN_TYPE_NONE)
         if ($uiEconomy.IsItemPurchasable(GetItemIdVal()))
            ret := (string)nonPurchasedTxt.Get()
         else
            ret := (string)rentTxt.Get()
         end
      else
         var ci : GL_ComponentInventory = (GL_ComponentInventory)$UiGlobals.componentsInventory.Get(itemId.Get())
         var es : int = (int)ci.equipped_state.Get()
         if es == 2 and isSpartanArmory.Get() == true
            ret := "carousel_txt_assigned"
         else
            if ($uiEconomy.IsItemPurchasable(GetItemIdVal()))
               ret := (string)purchasedTxt.Get()
            else
               ret := (string)addTimeTxt.Get()
            end
         end
      end
      return ret
   end
      
   func GetAssignY() : float
      var ret : float = 0
      ret := y0
      return ret      
   end
   
   func GetTimeRemainY() : float
      return (float)headerY.Get() - 23
   end

   func GetTimeRemainTxt() : wstring
      var ret : wstring
      if ((bool)timeRemainVisible.Get())
         ret := $root.MakeUiTimerSubHead(GetRentTime())
      end
      return ret      
   end
   
   func GetRentTime() : int
      var ret     : int
      if ((bool)timeRemainVisible.Get())
         var uiInventoryItem : GL_ComponentInventory = (GL_ComponentInventory)$UiGlobals.componentsInventory.Get(itemId.Get())
         var ownTime : int = (int)uiInventoryItem.ownership_time.Get() - (int)$UiGlobals.timer.Get()
         ret := ownTime
      end
      return ret   
   end   
   
   func GetTimeRemainFrame() : string
      var ret        : string = "green"
      var timeLeft   : int    = GetRentTime()
      if (timeLeft <= 0 or timeLeft < $uiEnums.ITEM_RENT_ALERT_SECONDS)
         ret := "red"
      end
      return ret   
   end   
   
   func GetTimeRemainVisible() : bool
      var ret : bool = false
      if ($uiEconomy.GetItemOwnType((string)itemId.Get()) == $uiEnums.ITEM_OWN_TYPE_RENTED)
         ret := true
      end
      return ret
   end
   
   func GetAssignAlpha() : float
      var ret : float = 0
      if (((bool)assignEnabled.Get()) == true)
         ret := 100.0
      else
         ret := 20.0
      end
      return ret      
   end

   func GetAssignText() : string
      var ret : string = "carousel_ui_btn_assign"
      var type : int = GetOwnType()
      
      if (type != $uiEnums.ITEM_OWN_TYPE_NONE)
         ret := "carousel_ui_btn_assign"
      elif ($uiEconomy.IsItemLocked((string)itemId.Get()))
         ret := "carousel_ui_btn_assign_locked"
         //ret := "carousel_goto_tech_tree"
      else 
         ret := "carousel_ui_btn_unavailable"
      end
      
      return ret      
   end
   
   func GetAssignEnabled() : bool
      var ret : bool = false
      if (bool)canAssign.Get() or lockStatus.Get() == "locked"
         ret := true
      else
         ret := false
      end
      return ret      
   end
   
   func Init(p : params)
      wgt := p.widget
   end
end


class ItemShopBaseVM : UiSlidingScreenMainMenuPageVM
   var shopType         : int                = $uiEnums.SHOP_TYPE_NONE
   var itemList         : ObservableProperty = $OM.Calculated(this, "GetItemList")
   var itemQuality      : ObservableProperty = $OM.Property(0)
   var selectedIdx      : ObservableProperty = $OM.Property(0)
   var mouseOverIdx     : ObservableProperty = $OM.Property(0)
   var itemCat          : ObservableProperty = $OM.Property(0)   
   var catCount         : ObservableProperty = $OM.Calculated(this, "GetCatCount")
   var selectedItemId   : ObservableProperty = $OM.Calculated(this, "GetSelectedItemId")
   var mouseOverItemId  : ObservableProperty = $OM.Calculated(this, "GetMouseOverItemId")
   var selectedItem     : ObservableProperty = $OM.Calculated(this, "GetSelectedItem")
   var itemCategories   : ObservableProperty = $OM.Calculated(this, "GetItemCategories")
   var sections         : ObservableProperty = $OM.Calculated(this, "GetSections")   
   var descpanelVM      : ItemDescPanelVM    = new ItemDescPanelVM()
   var offersModuleVM   : OffersModuleVM     = new OffersModuleVM()
   var bigIconPic       : ObservableProperty = $OM.Calculated(this, "GetBigIconPic")
   var bigIconVideo     : ObservableProperty = $OM.Calculated(this, "GetBigIconVideo")
   var isVideoIcons     : ObservableProperty = $OM.Calculated(this, "GetIsVideoIcons")
   var isVideoVisible   : ObservableProperty = $OM.Property(false)
   var isRentTimer      : ObservableProperty = $OM.Property(false)
   var wgt              : UiWidget           = null
   var rentTimeLeft     : ObservableProperty = $OM.Calculated(this, "GetRentTimeLeft")
   var rentTimeLeftClr  : ObservableProperty = $OM.Calculated(this, "GetRentTimeLeftClr")
   var itemName         : ObservableProperty = $OM.Calculated(this, "GetItemName")
   var selectedLoadoutIdx      : ObservableProperty = $OM.Calculated(this, "GetSelectedWeaponLoadoutIdx")
   var selectedArmorLoadoutIdx : ObservableProperty = $OM.Calculated(this, "GetSelectedArmorLoadoutIdx")
   

   override InitOverride //(p : params)
      wgt                        := p.widget
      offersModuleVM.shopWidget  := wgt
      mouseOverItemId.Subscribe(this, "MouseOverItemIdChanged")
   end
   
   override TermOverride // ()
      mouseOverItemId.Unsubscribe(this, "MouseOverItemIdChanged")
   end
   
   func MouseOverItemIdChanged(itemId : string)
      var slotIndex : int = (int)parentVM.loadoutSelectedSlotIndex.Get()
      if $UiGlobals.PassesAsArmorFilter(itemId)
         parentVM.loadoutSelectedSlotIndex.Set(0)
      elif $UiGlobals.PassesAsPrimaryWeaponFilter(itemId)
         parentVM.loadoutSelectedSlotIndex.Set(1)
      elif $UiGlobals.PassesAsSecondaryWeaponFilter(itemId)
         parentVM.loadoutSelectedSlotIndex.Set(2)
      elif $UiGlobals.PassesAsGrenadeWeaponFilter(itemId)
         parentVM.loadoutSelectedSlotIndex.Set(3)
      elif $UiGlobals.PassesAsTacticalPackageFilter(itemId)
         if slotIndex < 4 or slotIndex > 7
            var newSlotIdx = 4
            var char : UD_Character = $UserDataStorage.GetLocalUserData().GetActiveCharacter()
            if char.tactical_package_first.Get() == ""
               newSlotIdx := 4
            elif char.tactical_package_second.Get() == ""
               newSlotIdx := 5
            elif char.tactical_package_third.Get() == ""
               newSlotIdx := 6
            elif char.tactical_package_fourth.Get() == ""
               newSlotIdx := 7
            end
            parentVM.loadoutSelectedSlotIndex.Set(newSlotIdx)
         end
      elif $UiGlobals.PassesAsSupportPackageFilter(itemId)
         parentVM.loadoutSelectedSlotIndex.Set(8)
      end
   end
   
   func inputEvent(p: params) : bool
      return false
   end
   
   func SaveState () : params
      var ret : params
      ret.itemQuality   := (int)itemQuality.Get()
      ret.itemCat       := (int)itemCat.Get()
      ret.selectedIdx   := (int)selectedIdx.Get()
      return ret
   end

   func LoadState (p : params) : bool
      if (!IsVoid(p.itemQuality))
         itemQuality.Set(p.itemQuality)
      end
      if (!IsVoid(p.itemCat))
         itemCat.Set(p.itemCat)
      end
      if (!IsVoid(p.selectedIdx))
         selectedIdx.Set(p.selectedIdx)
         SetListSelection(p.selectedIdx)
      end
      return true
   end

      
   func OpenBuyDialogue(p : params) : bool
      var itemId : string = p.itemId
      var offer : GL_ComponentShopOffer = p.offer
      var isGold : bool = p.isGold
      var playerCurrency = 0
      var offerString : string
      var offerCost : int
      if offer == null
         return true
      end
      if isGold
         playerCurrency := (int)$UserDataStorage.local_user.gold.Get()
         offerString := (string)offer.gl_offer.Get()
         offerCost := (int)offer.gl_cost.Get()
      else
         playerCurrency := (int)$UserDataStorage.local_user.cr.Get()
         offerString := (string)offer.cr_offer.Get()
         offerCost := (int)offer.cr_cost.Get()
      end
      if offerString != ""
         var par: params
         par.itemID        :=  itemId
         par.offer         := offerString
         par.priceAmount   := offerCost
         if isGold
            par.priceUnit  := $uiEnums.TOKEN_GOLD
         else
            par.priceUnit  := $uiEnums.TOKEN_CREDITS
         end
         if (offerCost <= playerCurrency)
            // is rent ?
            var ret : int = 0
            ret := (int)offer.rent_duration.Get()
            if (ret > 0)
               par.isRent := true
            end
            // end 
            par.mbType           := "ConfirmBuy"
            par.callbackEvent    := "OnItemPurchased"
            par.callbackTarget   := wgt.Props
         else
            par.mbType     := "Info"
            par.titleTxt   := "msg_ui_warning"
            if isGold
               par.messageTxt := "msg_ui_not_enough_gp"
            else
               par.messageTxt := "msg_ui_not_enough_cr"
            end
         end
         $sslWidgetMgr.GenerateEvent("MainMenuDialogRequest", par)
      end
      return true
   end
   
   func ItemShopBaseVM()
      mouseOverItemId.Subscribe(this, "UpdateSelectedItem")   
      itemQuality.Subscribe(this, "itemQualityChanged")
      offersModuleVM.parentVM := this
      offersModuleVM.isWide.Subscribe(this, "OnIsWideChanged")
   end
   
   func BaseTerm()
      itemQuality.Unsubscribe(this, "itemQualityChanged")
      mouseOverItemId.Unsubscribe(this, "UpdateSelectedItem")
      offersModuleVM.isWide.Unsubscribe(this, "OnIsWideChanged")
      offersModuleVM.parentVM := null
      offersModuleVM.Term()
      $sslWidgetMgr.PrintStats()
      offersModuleVM := null
      $sslWidgetMgr.PrintStats()
   end
   
