/***************************************************************
* NT_Notification
*
***************************************************************/   
class NT_Notification : UiSslBindableBase
   var type                      : ObservableProperty = null
   var index                     : ObservableProperty = null
   
   // ssl-extensions
   var isNew                     : ObservableProperty = $OM.Property(true)
   var isProcessed               : ObservableProperty = $OM.Property(false)
   var isIngameProcessed         : ObservableProperty = $OM.Property(false)
   
   func MarkProcessed(ingameOnly : bool = false)
      isNew.Set(false)
      if (!ingameOnly)
         isProcessed.Set(true)
      end
      isIngameProcessed.Set(true)
   end
end

/***************************************************************
* NT_Notifications
*
***************************************************************/   
class NT_Notifications : UiSslBindableBase
   var notifications                   : ObservableProperty = null

   var errors                          : ObservableProperty = null
   
   var session_rewards                 : ObservableProperty = null
   var level_ups                       : ObservableProperty = null
   var new_items                       : ObservableProperty = null

   var party_invites                   : ObservableProperty = null
   var party_kicks                     : ObservableProperty = null

   var clan_invites                    : ObservableProperty = null

   var challenge_progress              : ObservableProperty = null
   var challenge_complete              : ObservableProperty = null

   var session_rewards_last_session    : ObservableProperty = null
   
   // ssl-only
   var session_reward_replayIdx        : int                = -1
   var last_processed_reward_version   : int                = -1
 
   var isWaitingRewardStats            : ObservableProperty = $OM.Property(false)
   var isWaitingSubscribed             : bool               = false
            
   var isNotificationMonitoring        : bool               = false
   var isAcceptingNotifications        : bool               = false
   var isProcessingNotification        : bool               = false


   func IsWaitingRewardStats() : bool
      return (bool)isWaitingRewardStats.Get()
   end
   
   func StartWaitingRewardStats()
      isWaitingRewardStats.Set(true)
      if (last_processed_reward_version != (int)session_rewards_last_session.Get())
         UpdateRewards(null)
      else
         if (! isWaitingSubscribed)
            isWaitingSubscribed := true
            session_rewards_last_session.Subscribe(this, "UpdateRewards")
         end
      end
   end
      
   func StopWaitingRewards()
      if (isWaitingSubscribed)
         session_rewards_last_session.Unsubscribe(this, "UpdateRewards")
         isWaitingSubscribed := false
      end
      isWaitingRewardStats.Set(false)
   end
      
   func UpdateRewards(_val : *)
      last_processed_reward_version := (int)session_rewards_last_session.Get()
      StopWaitingRewards()
   end
      
   func GetNewNotifCountByType(_notifType : int, _onlyNew : bool = false) : int
      var notifVec   : vector =  $UiGlobals.notifications.notifications.Get()
      var retCount   : int    = 0
      var idx        : int      
      for idx := 0 to notifVec.Count() - 1
         var notifRec   : NT_Notification    = (NT_Notification)notifVec.Get(idx)
         var recType    : int                = (int)notifRec.type.Get()         
         if (recType == _notifType and (!_onlyNew or (bool)notifRec.isNew.Get()))
            retCount := retCount + 1            
         end
      end
      return retCount            
   end
   
   func IsNewNotificationByType(_notifType : int) : bool
      return GetNewNotifCountByType(_notifType, true) > 0
   end
   
   func GetFirstUnprocessedIdxByType(_notifType : int, isIngame : bool = false): int
      var ret        : int    = -1
      var notifVec   : vector =  $UiGlobals.notifications.notifications.Get()
      var idx        : int      
      for idx := 0 to notifVec.Count() - 1
         var notifRec   : NT_Notification    = (NT_Notification)notifVec.Get(idx)
         var recType    : int                = (int)notifRec.type.Get()         
         if (recType == _notifType) 
            var isProcessed : bool = false
            if (isIngame)
               isProcessed := (bool)notifRec.isIngameProcessed.Get()
            else
               isProcessed := (bool)notifRec.isProcessed.Get()
            end
            if (! isProcessed)
               ret := idx
               break
            end
         end
      end
      return ret         
   end
   
   func GetFirstUnprocessedByType(_notifType : int, isIngame : bool = false): NT_Notification
      var ret  : NT_Notification = null
      var idx  : int             = GetFirstUnprocessedIdxByType(_notifType, isIngame)
      if (idx != -1)
         var notifVec : vector =  $UiGlobals.notifications.notifications.Get()
         ret := (NT_Notification)notifVec.Get(idx)
      end
      return ret
   end
   
   func GetFirstUnprocessedDetailsByType(_notifType : int): object
      return GetNotifDetails(GetFirstUnprocessedByType(_notifType))
   end
   
   func GetNotifDetailsRecByIdx(idx : int) : object      
      var notifVec   : vector = notifications.Get()
      var ret        : object = null
      if (idx < notifVec.Count())
         ret := GetNotifDetails((NT_Notification)notifVec.Get(idx))
      end
      return ret
   end
   
   func GetNotifDetails(notifRec : NT_Notification) : object
      var ret        : object = null
      if (notifRec != null)
         var notifType  : int    = (int)notifRec.type.Get()
         if (notifType == $uiEnums.NOTIFICATION_SESSION_REWARDS)
            var rewardsVec : vector = $UiGlobals.notifications.session_rewards.Get()
            ret := (NT_SessionRewards)rewardsVec.Get((int)notifRec.index.Get())
         elif (notifType == $uiEnums.NOTIFICATION_SESSION_LVLUP)
            var lvlUpVec : vector = $UiGlobals.notifications.level_ups.Get()
            ret := (NT_LevelUp)lvlUpVec.Get((int)notifRec.index.Get())
         elif (notifType == $uiEnums.NOTIFICATION_SESSION_UNLOCK)
            var unlockItems : vector = $UiGlobals.notifications.new_items.Get()
            ret := (NT_NewItemsAvailable)unlockItems.Get((int)notifRec.index.Get())
         elif (notifType == $uiEnums.NOTIFICATION_PARTY_INVITE)
            var invites : vector = $UiGlobals.notifications.party_invites.Get()
            ret := (NT_PartyInvite)invites.Get((int)notifRec.index.Get())
         elif (notifType == $uiEnums.NOTIFICATION_CLAN_INVITE)
            var invites : vector = $UiGlobals.notifications.clan_invites.Get()
            ret := (NT_ClanInvite)invites.Get((int)notifRec.index.Get())
         elif (notifType == $uiEnums.NOTIFICATION_CHALLENGE_PROGRESS)
            var chalengeProgress : vector = $UiGlobals.notifications.challenge_progress.Get()
            ret := (NT_ChallengeProgress)chalengeProgress.Get((int)notifRec.index.Get())
         elif (notifType == $uiEnums.NOTIFICATION_CHALLENGE_COMPLETE)
            var chalengeComplete : vector = $UiGlobals.notifications.challenge_complete.Get()
            ret := (NT_ChallengeComplete)chalengeComplete.Get((int)notifRec.index.Get())
         elif (notifType == $uiEnums.NOTIFICATION_ERROR)
            var errorsVec : vector = $UiGlobals.notifications.errors.Get()
            ret := (NT_Error)errorsVec.Get((int)notifRec.index.Get())
         end      
      end
      return ret
   end
   
   func MarkProcessedFirstByType(_notifType : int)
      var notif : NT_Notification = GetFirstUnprocessedByType(_notifType)
      if (notif != null)
         notif.isProcessed.Set(true)
         notif.isIngameProcessed.Set(true)
         notif.isNew.Set(false)
      end
   end
   
   func MarkProcessed(_notifType : int)
      var notifVec   : vector =  $UiGlobals.notifications.notifications.Get()
      var idx        : int      
      for idx := 0 to notifVec.Count() - 1
         var notifRec : NT_Notification = (NT_Notification)notifVec.Get(idx)
         var recType    : int                = (int)notifRec.type.Get()         
         if (recType == _notifType)
            notifRec.isProcessed.Set(true)
            notifRec.isNew.Set(false)
            notifRec.isIngameProcessed.Set(true)
         end   
      end
   end
   
   func MarkNotNew(_notifType : int)
      var notifVec   : vector =  $UiGlobals.notifications.notifications.Get()
      var idx        : int      
      for idx := 0 to notifVec.Count() - 1
         var notifRec : NT_Notification = (NT_Notification)notifVec.Get(idx)
         var recType    : int                = (int)notifRec.type.Get()         
         if (recType == _notifType)
            notifRec.isNew.Set(false)
            notifRec.isIngameProcessed.Set(true)
         end   
      end
   end
   
   func GetByIdx(idx : int) : NT_Notification
      var notifVec   : vector          =  $UiGlobals.notifications.notifications.Get()
      var ret        : NT_Notification = null
      if (idx >= 0 and idx < notifVec.Count())
         ret := notifVec.Get(idx)
      end
      return ret
   end
   
   func MarkProcessedAll()
      var notifVec   : vector =  $UiGlobals.notifications.notifications.Get()
      var idx        : int      
      for idx := 0 to notifVec.Count() - 1
         var notifRec : NT_Notification = (NT_Notification)notifVec.Get(idx)
         notifRec.isProcessed.Set(true)
         notifRec.isNew.Set(false)
         notifRec.isIngameProcessed.Set(true)
      end
   end

   func EnableNotificationsMonitoring(isEnabled : bool)
      if (isAcceptingNotifications != isEnabled)
         isAcceptingNotifications := isEnabled
         if (isAcceptingNotifications)
            StartNotificationMonitoring()
         else
            StopNotificationMonitoring()
         end      
      end
   end

   func IsAcceptingNotifications() : bool
      return isAcceptingNotifications
   end

   func StartNotificationMonitoring()
      if (!isNotificationMonitoring)
         isNotificationMonitoring := true
         $UiGlobals.notifications.notifications.Subscribe(this, "UpdateNotifications")
         UpdateNotifications()
      end
   end

   func StopNotificationMonitoring()
      if (isNotificationMonitoring)
         $UiGlobals.notifications.notifications.Unsubscribe(this, "UpdateNotifications")
         isNotificationMonitoring := false
         isProcessingNotification := false
      end   
   end

   func NotificationProcessed(notifRef : NT_Notification, ingameOnly : bool = false)
      if (notifRef != null)
         notifRef.MarkProcessed(ingameOnly)
      end
      isProcessingNotification := false 
      UpdateNotifications()
   end

   func UpdateNotifications(val : * = null)
      if (!isProcessingNotification)
         var notifVec   : vector =  $UiGlobals.notifications.notifications.Get()
         var idx        : int      
         for idx := 0 to notifVec.Count() - 1
            var notifRef         : NT_Notification    = (NT_Notification)notifVec.Get(idx)
            var isProcessed      : bool               = (bool)notifRef.isProcessed.Get()
            var canBeProcessed   : bool               = false
            var updateEvent      : string
            
            if (!isProcessed)
               var recType : int = (int)notifRef.type.Get()
               if (recType == $uiEnums.NOTIFICATION_ERROR)
                  canBeProcessed := true
                  updateEvent    := "ErrorNotification"
               end               
            end
            
            if (canBeProcessed and updateEvent != "")
               var p : params
               p.notifRef := notifRef
               isProcessingNotification := true
               $sslWidgetMgr.GenerateEvent(updateEvent, p)
               break
            end
         end
      end
   end
end

/***************************************************************
* GL_Party
*
***************************************************************/   
class GL_Party : UiSslBindableBase
   var state                       : ObservableProperty = null

   var members                     : ObservableProperty = null
   
//extensions   
   func GetStateStr() : string
      var ret        : string = "UNKNOWN"
      var stateVal   : int    = (int)state.Get()
      if (stateVal == $uiEnums.PARTY_STATE_NONE)
         ret := "NONE"
      elif (stateVal == $uiEnums.PARTY_STATE_FORMATION)
         ret := "FORMATION"
      elif (stateVal == $uiEnums.PARTY_STATE_IN_QUEUE)
         ret := "IN QUEUE"
      elif (stateVal == $uiEnums.PARTY_STATE_IN_GAME)
         ret := "IN GAME"
      end
      return ret
   end
   
   func GetMMEnumFromState() : string
      var   ret      : string = $uiPartyMonitor.STATE_NONE
      var   stateVal : int    = (int)state.Get()
      if (stateVal == $uiEnums.PARTY_STATE_NONE)
         ret := $uiPartyMonitor.STATE_NONE
      elif (stateVal == $uiEnums.PARTY_STATE_FORMATION)
         ret := $uiPartyMonitor.STATE_FORMATION
      elif (stateVal == $uiEnums.PARTY_STATE_IN_QUEUE or stateVal == $uiEnums.PARTY_STATE_IN_GAME)
         ret := $uiPartyMonitor.STATE_MATCHMAKING
      end
      return ret
   end
end

/***************************************************************
* GL_Matchmaking
*
***************************************************************/   
class GL_Matchmaking : UiSslBindableBase
   var queue                       : ObservableProperty = null
   var in_queue                    : ObservableProperty = null

   var state                       : ObservableProperty = null
   var state_timer                 : ObservableProperty = null

   var group                       : ObservableProperty = null
 
   var playlists                   : ObservableProperty = null
   var playlists_selection         : ObservableProperty = null

   var custom_game_maps            : ObservableProperty = null
   var custom_game_maps_selection  : ObservableProperty = null
   var custom_game_modes           : ObservableProperty = null
   var custom_game_modes_selection : ObservableProperty = null

   func GetStateStr() : string
      var ret        : string = "UNKNOWN"
      var stateVal   : int    = (int)state.Get()
      if (stateVal == $uiEnums.MATCHMAKING_STATE_NONE)
         ret := "None"
      elif (stateVal == $uiEnums.MATCHMAKING_STATE_ONLINE)
         ret := "Online"
      elif (stateVal == $uiEnums.MATCHMAKING_STATE_WAITING_FOR_ENQUEUE)
         ret := "Waiting enqueue"
      elif (stateVal == $uiEnums.MATCHMAKING_STATE_WAITING_FOR_DEQUEUE)
         ret := "Waiting dequeue"
      elif (stateVal == $uiEnums.MATCHMAKING_STATE_IN_QUEUE)
         ret := "In queue"
      elif (stateVal == $uiEnums.MATCHMAKING_STATE_IN_SESSION)
         ret := "In Session"
      end   
      return ret
   end
   
   func GetCurrentPlaylistIdx() : int
      var playlistsVec  : vector = playlists.Get()
      var ret           : int    = 0
      var i             : int
      for i := 0 to playlistsVec.Count() - 1
         var playlistRec : GL_String = (GL_String)playlistsVec.Get(i)
         if ((string)playlistRec.value.Get() == (string)playlists_selection.Get())
            ret := i
            break
         end
      end
      return ret
   end
end

/***************************************************************
* GL_ChatStreamMessage
*
***************************************************************/   
class GL_ChatStreamMessage : UiSslBindableBase
   var sender_user_id                 : ObservableProperty = null
   var timestamp                      : ObservableProperty = null
   var text                           : ObservableProperty = null
   
   //ssl extensions
   var addressee_user_id               : ObservableProperty = null
   var chatFormattedMes                : ObservableProperty = $OM.Calculated(this, "GetChatFormattedMes", true)
   var ingameFormattedMes              : ObservableProperty = $OM.Calculated(this, "GetIngameFormattedMes", true)
   var isProcessed                     : bool               = false
   var originalChannel                 : int                = $uiEnums.CHAT_CHANNEL_NONE
   var baked                           : bool               = false
   var directMsg                       : bool               = false
   var ingameSlotIdx                   : int                = -1   
   
   func InitFromMessage(message : GL_ChatStreamMessage)
      sender_user_id    := $OM.Property(message.sender_user_id.Get())
      timestamp         := $OM.Property(message.timestamp.Get())
      text              := $OM.Property(message.text.Get())      
      isProcessed       := message.isProcessed
      originalChannel   := message.originalChannel
      baked             := message.baked
      directMsg         := message.directMsg
      if (message.addressee_user_id != null)
         addressee_user_id := $OM.Property(message.addressee_user_id.Get())
      end
   end
   
   func GetChatFormattedMes(_viewChannel : int) : wstring
      return GetFormattedText(_viewChannel, true, false)
   end
   
   func GetIngameFormattedMes(_viewChannel : int) : wstring
      return GetFormattedText(_viewChannel, false, true)
   end
   
   func GetMessageColorSpan(_viewChannel : int, _isIngameMessage : bool) : string
      var ret : string = "channel_all"
      if (_isIngameMessage)
         if (originalChannel == $uiEnums.CHAT_CHANNEL_PRIVATE and _viewChannel != $uiEnums.CHAT_CHANNEL_PRIVATE)
            ret := "channel_private"
         elif (originalChannel == $uiEnums.CHAT_CHANNEL_GAME_TEAM)
            var teamIdx : int = (int)$UiIngame.team_index.Get()
            if (teamIdx == 0)
               ret := "channel_team_0"
            elif (teamIdx == 1)
               ret := "channel_team_1"
            else
               ret := "channel_team"
            end
         elif (originalChannel == $uiEnums.CHAT_CHANNEL_PARTY)
            ret := "channel_party"
         else
            if ($UserDataStorage.IsFriend(sender_user_id.Get()))
               ret := "channel_friend"
            end
         end
      else
         if (originalChannel == $uiEnums.CHAT_CHANNEL_PRIVATE and _viewChannel != $uiEnums.CHAT_CHANNEL_PRIVATE)
            ret := "channel_private"
         end
      end

      return ret
   end
   
   func GetMessageColorSpanColor(_viewChannel : int, _isIngameMessage : bool) : string
      var ret : string = GetMessageColorSpan(_viewChannel, _isIngameMessage)
      if (ret == "channel_all")
         ret := $UserDataStorage.GetColorDefault()
      elif (ret == "channel_private")
         ret := $UserDataStorage.GetColorPrivate()
      elif (ret == "channel_team_0")
         ret := $UserDataStorage.GetColorTeamRed()
      elif (ret == "channel_team_1")
         ret := $UserDataStorage.GetColorTeamBlue()
      elif (ret == "channel_team")
         ret := $UserDataStorage.GetColorTeam()
      elif (ret == "channel_party")
         ret := $UserDataStorage.GetColorParty()
      elif (ret == "channel_party")
         ret := $UserDataStorage.GetColorFriend()
      else
         ret := $UserDataStorage.GetColorDefault()
      end
      return ret
   end
   
   func GetFormattedText(_viewChannel : int, _addNewLine : bool, _isIngameMessage : bool) : wstring
      var ret     : wstring
      var userUid : *
      var mesStr  : wstring
      var p       : params
      if $UserDataStorage.IsLocalUID(sender_user_id.Get()) and !directMsg
         return $UiGlobals.String2WString("")
      end
      if (originalChannel == $uiEnums.CHAT_CHANNEL_PRIVATE and _viewChannel != $uiEnums.CHAT_CHANNEL_PRIVATE)
         if ($UserDataStorage.IsLocalUID(sender_user_id.Get()))
            p.nickDecor := $UiGlobals.String2WString("main_chat_whisper_to,") // "to {STRING}" | "??? {STRING}" | "{STRING}??"
            userUid := addressee_user_id.Get()
         else
            p.nickDecor := $UiGlobals.String2WString("main_chat_whisper_from,") // "from {STRING}" | "?? {STRING}" |?"{STRING} ??"
            userUid := sender_user_id.Get()
         end
      else
         p.nickDecor := $UiGlobals.String2WString("{STRING}~")
         userUid := sender_user_id.Get()
      end
      var ud      : UserData = (UserData)$UserDataStorage.users.Get(userUid)
      
      if ($UserDataStorage.IsValidUID(userUid))
         var nickName   : wstring   = ud.base.full_nickname.Get()
         nickName := ud.base.full_nickname.Get()
         var link : string = $UserDataStorage.UID2Str(userUid)         
         p.nick   := nickName      
         p.nick   := $root.MakeColorCodedWText(p.nick, $UserDataStorage.GetPlayerStatusColorCode(userUid))
         p.nick   := $root.MakeLinkWText(p.nick, link, $UserDataStorage.GetUserColorCode(userUid))
      else
         p.nick   := $root.MakeColorCodedWText($UiGlobals.String2WString("SYSTEM"), "#FF0000")
      end      
      
      p.nickDecor := $UiGlobals.TranslateWText(p.nickDecor + p.nick)
      
      p.mes       := text.Get()
      mesStr      := p.mes
      p.mes       := $UiGlobals.StripHtmlTags(mesStr)
      if (_isIngameMessage)
         p.mes    := $root.MakeColorCodedWText(p.mes, GetMessageColorSpanColor(_viewChannel, _isIngameMessage))
      end
      p.mes       := $root.MakeSpanWText(p.mes, GetMessageColorSpan(_viewChannel, _isIngameMessage))
                  
      var timeClr : string
      timeClr := "#808080"
      p.delim     := $root.MakeColorCodedWText($UiGlobals.String2WString(" : "), timeClr)
      
      if (_isIngameMessage)
         p.space := $UiGlobals.String2WString(" ")
         p.nickDecor   := $root.MakeColorCodedWText(p.nickDecor, $UserDataStorage.GetColorDefault())
         ret := ret + p.space + p.nickDecor
      else
         var timestamp : string = $UiGlobals.Timestamp2Time(this.timestamp.Get())
         p.timelb := $UiGlobals.String2WString("[")
         p.timerb := $UiGlobals.String2WString("] ")
         p.time   := p.timelb + $UiGlobals.String2WString(timestamp) + p.timerb + p.nickDecor
         p.time   := $root.MakeColorCodedWText(p.time, timeClr)
         ret := ret + p.time
      end
      ret := ret + p.delim
      ret := ret + p.mes
      if (_addNewLine)
         p.nl := $UiGlobals.String2WString("\n")
         ret  := ret + p.nl
      end      
      
      return ret
   end
end

/***************************************************************
* GL_ChatStream
*
***************************************************************/   
class GL_ChatStream : UiSslBindableBase
   var messages                        : ObservableProperty = null
   
   // ssl extensions
   var channel                         : int                = -1
   var private_chat_uid                : *                  = 0
   var lastMessageTime                 : ObservableProperty = $OM.Property(0)
   var tabState                        : string             = "none" //"opened", "closed"
   var originalStream                  : GL_ChatStream      = null
   var cachedChatLog                   : wstring
   var isActive                        : bool
   var newMessagesCount                : ObservableProperty = $OM.Property(0)
   var newNonPrivateMessagesCount      : ObservableProperty = $OM.Property(0)
   var isTextValid                     : bool               = false
   var updateWholeText                 : bool               = false
   var uiStreamIdx                     : int                = -1
   
   var waitingUserData                 : UserData           = null
   var isSubscribed                    : bool               = false
   
   func SubscribeToUpdates()
      if (!isSubscribed)
         messages.Subscribe(this, "OnMessagesChanged")
         OnMessagesChanged(messages.Get())
      end
   end
   
   func UnsubscribeFromUpdates()
      if (isSubscribed)
         messages.Unsubscribe(this, "OnMessagesChanged")
         isSubscribed := false
      end
   end
   
   func Init(channel : int)
      this.channel := channel
      SubscribeToUpdates()
   end
   
   func Term()
      UnsubscribeFromUpdates()
   end
   
   func NewMessagesCount() : int
      return (int)newMessagesCount.Get()
   end
   
   func SetUiStreamIdx(streamIdx : int)
      if (streamIdx != uiStreamIdx)
         uiStreamIdx := streamIdx
         isTextValid := false
      end
   end
   
   func SGtUiStreamIdx() : int
      return uiStreamIdx
   end
   
   func SendUpdateText()
      var p : params
      p.txt                := cachedChatLog
      p.channel            := channel
      p.private_chat_uid   := private_chat_uid
      p.uiStreamIdx        := uiStreamIdx
      $sslWidgetMgr.GenerateEvent("SetChatText", p)
      isTextValid := true
   end
      
   func Activate()
      isActive := true
      SubscribeToUpdates()
      if (!isTextValid or updateWholeText)
         SendUpdateText()
      end
      UpdateLastViewTime()
   end
   
   func Deactivate()
      isActive := false      
   end
   
   func OnMessagesChanged(msgs : vector)
      var lastBakedMsgIdx : int = -1
      var i : int
      for i := msgs.Count() - 1 downto 0
         var msg = (GL_ChatStreamMessage)msgs.Get(i)
         if (msg.baked)
            lastBakedMsgIdx := i
            break
         end
      end
      var append : params
      append.txt := $UiGlobals.String2WString("")
      var waitForUserData        : bool = false
      var waitingUid             : *
      var newMesCount            : int = (int)newMessagesCount.Get()
      var newMesNonPrivateCount  : int = (int)newNonPrivateMessagesCount.Get()
      for i := lastBakedMsgIdx + 1 to msgs.Count() - 1
         var msg = (GL_ChatStreamMessage)msgs.Get(i)
         var uid : *
         if msg.addressee_user_id != null and !$UserDataStorage.IsEqualUIDs(msg.addressee_user_id.Get(), $UserDataStorage.GetInvalidUID())
            uid := msg.addressee_user_id.Get()
         else
            uid := msg.sender_user_id.Get()
         end
         var ud = (UserData)$UserDataStorage.users.Get(uid)
         if (bool)ud.has_base.Get()
            append.txt  := append.txt + msg.GetFormattedText(channel, true, false)
            msg.baked   := true
            newMesCount := newMesCount + 1
            if (msg.originalChannel != $uiEnums.CHAT_CHANNEL_PRIVATE)
               newMesNonPrivateCount := newMesNonPrivateCount + 1
            end
         else
            waitForUserData   := true
            waitingUserData   := ud
            waitingUid        := uid
            break
         end
      end      
      if (string)(append.txt) != ""
         append.old_txt          := cachedChatLog
         append.new_txt          := append.old_txt + append.txt
         cachedChatLog           := append.new_txt
         append.channel          := channel
         append.uiStreamIdx      := uiStreamIdx
         append.private_chat_uid := private_chat_uid
         $sslWidgetMgr.GenerateEvent("AppendChatText", append)
         if isActive
            UpdateLastViewTime()
         else
            newMessagesCount.Set(newMesCount)
            newNonPrivateMessagesCount.Set(newMesNonPrivateCount)
         end
      end
      if (waitForUserData)
         waitingUserData.has_base.Subscribe(this, "OnUserDataChanged")
         $user_service.RequestData(waitingUid, $uiEnums.USER_DATA_BASE)         
      end
   end
   
   func OnUserDataChanged(newVal : *)
      var ud : UserData = waitingUserData
      waitingUserData := null
      ud.has_base.Unsubscribe(this, "OnUserDataChanged")
      messages.OnChanged()
   end
   
   func InitFromSSL(origStream : GL_ChatStream)
      messages       := $OM.Property(new vector)      
      originalStream := origStream
   end
   
   func Clean()
      if (messages.Get().Count() > 0)
         messages.Get().Clear()
         messages.OnChanged()
      end
      cachedChatLog := $UiGlobals.String2WString("")
   end
   
   func GetLastViewTime() : *
      if (IsVoid(lastMessageTime.Get()))
         lastMessageTime.Set($UiGlobals.IntToInt64(0))
      end
      return lastMessageTime.Get()
   end
   
   
   func GetLastMessage() : GL_ChatStreamMessage
      var ret : GL_ChatStreamMessage = null
      var messagesVec : vector = GetMessages()
      if (messagesVec.Count() > 0)
         ret := messagesVec.Get(messagesVec.Count() - 1)
      end
      return ret
   end
   
   
   func UpdateLastViewTime()
      newMessagesCount.Set(0)
      newNonPrivateMessagesCount.Set(0)
   end
   
   func GetMembers() : vector
      var ret : vector
      return ret
   end
   
   func GetMessages() : vector
      var ret : vector
      ret := messages.Get()
      return ret      
   end
   
   func GetNewMessagesCount(ignorePrivates : bool) : int
      var ret : int = 0
      if (ignorePrivates)
         ret := (int)newNonPrivateMessagesCount.Get()      
      else
         ret := (int)newMessagesCount.Get()      
      end      
      return ret      
   end
   
end

/***************************************************************
* GL_Chat
*
***************************************************************/   
class GL_Chat : UiSslBindableBase
   var private_channel              : GL_ChatStream = null 
   var general                      : GL_ChatStream = null
   var party                        : GL_ChatStream = null
   var clan_channel                 : GL_ChatStream = null
   var game_all_channel             : GL_ChatStream = null
   var game_team_channel            : GL_ChatStream = null
   
   //extensions
   var private_channels             : vector
   var private_members              : ObservableProperty = $OM.Property(new vector)
   
   // ssl-only challens
   var ui_channel_private           : GL_ChatStream = new GL_ChatStream()
   var ui_channel_general           : GL_ChatStream = new GL_ChatStream()
   var ui_channel_party             : GL_ChatStream = new GL_ChatStream()
   var ui_channel_clan              : GL_ChatStream = new GL_ChatStream()
   var ui_channel_ingame            : GL_ChatStream = new GL_ChatStream()
   var ui_channel_game_all          : GL_ChatStream = new GL_ChatStream()
   var ui_channel_game_team         : GL_ChatStream = new GL_ChatStream()
   
   func Init()
      ui_channel_private.InitFromSSL(private_channel)
      ui_channel_general.InitFromSSL(general)
      ui_channel_party.InitFromSSL(party)
      ui_channel_clan.InitFromSSL(clan_channel)
      ui_channel_game_all.InitFromSSL(game_all_channel)
      ui_channel_game_team.InitFromSSL(game_team_channel)
      ui_channel_ingame.InitFromSSL(null)
      
      private_channel.messages.Subscribe(this, "PrivateMessagesListener")
      game_all_channel.messages.Subscribe(this, "GameAllMessagesListener")
      game_team_channel.messages.Subscribe(this, "GameTeamMessagesListener")
      general.messages.Subscribe(this, "GeneralMessagesListener")
      party.messages.Subscribe(this, "PartyMessagesListener")
      clan_channel.messages.Subscribe(this, "ClanMessagesListener")
   end
   
   func GetPrivateMembers() : vector
      return private_members.Get()
   end
   
   func Clean(_cleanChat : bool = true)
      GetPrivateMembers().Clear()
      private_channels.Clear()
      
      ui_channel_private.Clean()
      ui_channel_general.Clean()
      ui_channel_party.Clean()
      ui_channel_clan.Clean()
      ui_channel_game_all.Clean()
      ui_channel_game_team.Clean()
      ui_channel_ingame.Clean()   
      
      if (_cleanChat)
         $sslWidgetMgr.GenerateEvent("CleanChat", null)
      end
   end
   
   func Term()      
      private_channel.messages.Unsubscribe(this, "PrivateMessagesListener")      
      
      game_all_channel.messages.Unsubscribe(this, "GameAllMessagesListener")
      game_team_channel.messages.Unsubscribe(this, "GameTeamMessagesListener")
      general.messages.Unsubscribe(this, "GeneralMessagesListener")
      party.messages.Unsubscribe(this, "PartyMessagesListener")
      clan_channel.messages.Unsubscribe(this, "ClanMessagesListener")      
      
      Clean(false)
   end
   
   func GetPrivateChannel(uid : *) : GL_ChatStream
      var i : int
      for i := 0 to private_channels.Count() - 1
         var channel : GL_ChatStream = private_channels.Get(i)
         if !IsVoid(channel.private_chat_uid) and $UserDataStorage.IsEqualUIDs(channel.private_chat_uid, uid)
            return channel
         end
      end
      return null
   end
   
   func GetLastProcessedIdx(messages : vector) : int
      var i : int
      var lastProcessedIdx : int = -1
      for i := messages.Count() - 1 downto 0
         var message = (GL_ChatStreamMessage)messages.Get(i)
         if message.isProcessed
            lastProcessedIdx := i
            break
         end
      end      
      return lastProcessedIdx
   end
   
   func CopyMessage(message : GL_ChatStreamMessage, stream :  GL_ChatStream, originalChannelIdx : int, markProcessed : bool, callOnChanged : bool = true)
      var messageCopy : GL_ChatStreamMessage = new GL_ChatStreamMessage()
      messageCopy.InitFromMessage(message)
      
      if (messageCopy.originalChannel == $uiEnums.CHAT_CHANNEL_NONE)
         messageCopy.originalChannel := originalChannelIdx
      end
      
      if (markProcessed)
         message.isProcessed := true
      end
      
      stream.messages.Get().Push(messageCopy)
      if (callOnChanged)
         stream.messages.OnChanged()               
      end
   end
   
   func CopyNewMessages(messages : vector, stream :  GL_ChatStream, originalChannelIdx : int, markProcessed : bool)
      var lastProcessedIdx : int = GetLastProcessedIdx(messages)
      var i                : int
      for i := lastProcessedIdx + 1 to messages.Count() - 1
         var message : GL_ChatStreamMessage = (GL_ChatStreamMessage)messages.Get(i)         
         CopyMessage(message, stream, originalChannelIdx, markProcessed, false)
      end
      stream.messages.OnChanged()
   end
   
   func GameAllMessagesListener(messages : vector)
      CopyNewMessages(messages, ui_channel_game_all, $uiEnums.CHAT_CHANNEL_GAME_ALL, false) 
      CopyNewMessages(messages, ui_channel_ingame,    $uiEnums.CHAT_CHANNEL_GAME_ALL, true) 
   end
   
   func GameTeamMessagesListener(messages : vector)
      CopyNewMessages(messages, ui_channel_game_team, $uiEnums.CHAT_CHANNEL_GAME_ALL, false) 
      CopyNewMessages(messages, ui_channel_ingame,    $uiEnums.CHAT_CHANNEL_GAME_TEAM, true) 
   end
   
   var repeatCount   : int = 0
   var maxRepeat     : int = 100
   var isRepeating   : bool = false
   
   func RepeatMessages(messages : vector)
      //if (repeatCount < maxRepeat)
         var i : int
         for i := 0 to 1000
            CopyNewMessages(messages, ui_channel_general, $uiEnums.CHAT_CHANNEL_ALL, false)
         end
         //repeatCount := repeatCount + 1
         //delay kill, this, REPEAT_CHAT
         //RepeatMessages(messages): 0, REPEAT_CHAT
      //else
      //   delay kill, this, REPEAT_CHAT
         //isRepeating := false
         CopyNewMessages(messages, ui_channel_general, $uiEnums.CHAT_CHANNEL_ALL, true)
      //end
   end
   
   func GeneralMessagesListener(messages : vector) 
      //if (isRepeating)
      //   delay kill, this, REPEAT_CHAT
      //   isRepeating := false
      //   CopyNewMessages(messages, ui_channel_general, $uiEnums.CHAT_CHANNEL_ALL, true)
      //end
      //repeatCount := 0
      //isRepeating := true
      //RepeatMessages(messages)
      CopyNewMessages(messages, ui_channel_general, $uiEnums.CHAT_CHANNEL_ALL, true) 
   end
   
   func PartyMessagesListener(messages : vector)
      CopyNewMessages(messages, ui_channel_party, $uiEnums.CHAT_CHANNEL_PARTY, true) 
   end
   
   func ClanMessagesListener(messages : vector)
      CopyNewMessages(messages, ui_channel_clan, $uiEnums.CHAT_CHANNEL_CLAN, true) 
   end   
      
   func PrivateMessagesListener(messages : vector)      
      var lastProcessedIdx : int = GetLastProcessedIdx(messages)
      var i                : int
      for i := lastProcessedIdx + 1 to messages.Count() - 1
         var message = (GL_ChatStreamMessage)messages.Get(i)
         var stream : GL_ChatStream = null
         if $UserDataStorage.IsEqualUIDs(message.sender_user_id.Get(), $UserDataStorage.local_user.uid.Get())
            stream := GetPrivateChannel(message.addressee_user_id.Get())
         else
            stream := GetPrivateChannel(message.sender_user_id.Get())
         end
         if stream == null
            stream := new GL_ChatStream()
            stream.messages := $OM.Property(new vector)
            stream.private_chat_uid := message.sender_user_id.Get()
            private_channels.Push(stream)
            var glUid = new GL_UID()
            glUid.value := $OM.Property(message.sender_user_id.Get())
            GetPrivateMembers().Push(glUid)
            private_members.OnChanged()
            var p : params
            p.uid := message.sender_user_id.Get()
            $sslWidgetMgr.GenerateEvent("OpenNewPrivateChat", p)
         end
         message.isProcessed := true         
         CopyMessage(message, stream,              $uiEnums.CHAT_CHANNEL_PRIVATE, false)
         CopyMessage(message, ui_channel_private,  $uiEnums.CHAT_CHANNEL_PRIVATE, false)
         CopyMessage(message, ui_channel_general,  $uiEnums.CHAT_CHANNEL_PRIVATE, false)
         CopyMessage(message, ui_channel_ingame,   $uiEnums.CHAT_CHANNEL_PRIVATE, false)
         CopyMessage(message, ui_channel_party,    $uiEnums.CHAT_CHANNEL_PRIVATE, false)
         CopyMessage(message, ui_channel_game_all, $uiEnums.CHAT_CHANNEL_PRIVATE, false)
         CopyMessage(message, ui_channel_clan,     $uiEnums.CHAT_CHANNEL_PRIVATE, false)         
      end
   end
   
end

