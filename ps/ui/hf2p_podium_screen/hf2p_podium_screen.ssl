class UiPodiumVM
   var loadoutVM           : UiKillerLoadoutVM  = new UiKillerLoadoutVM()
   
   func SetPodiumLoadoutUID(p : params) : bool
      loadoutVM.isVisible.Set(true)
      loadoutVM.SetUid(p.uid)
      return true
   end
end
