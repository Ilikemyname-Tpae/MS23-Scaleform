   func GetStateNameStr() : string
      var ret              : string = "UNKNOWN"
      var screenStateVal   : int    = GetScreenStateVal()
      if (screenStateVal == $uiEnums.LOBBY_SCREEN_STATE_NONE)
         ret := "NONE"
      elif (screenStateVal == $uiEnums.LOBBY_SCREEN_STATE_PLAYLIST)
         ret := "PLAYLIST"
      elif (screenStateVal == $uiEnums.LOBBY_SCREEN_STATE_MATCHMAKING)
         ret := "MATCHMAKING"
      elif (screenStateVal == $uiEnums.LOBBY_SCREEN_STATE_VOTING)
         ret := "VOTING"
      elif (screenStateVal == $uiEnums.LOBBY_SCREEN_STATE_COUNTDOWN)
         ret := "COUNTDOWN"
      elif (screenStateVal == $uiEnums.LOBBY_SCREEN_STATE_WAITING_MM)
         ret := "WAITING MM"
      elif (screenStateVal == $uiEnums.LOBBY_SCREEN_STATE_WAITING_LOBBY)
         ret := "WAITING LOBBY"
      elif (screenStateVal == $uiEnums.LOBBY_SCREEN_STATE_LOBBY_JOINING_SESSION)
         ret := "JOINING SESSION"
      end
            
      return ret
   end
   
   func UpdateLobbyStateInternal(_forceUpdate : bool = false)      
      var isPlaylists      : bool   = false
      var isMapMode        : bool   = false
      var isVotingMaps     : bool   = false
      var isPlayers1       : bool   = true
      var isPlayers2       : bool   = true
      var isPlayers1Enable : bool   = true
      var isPlayers2Enable : bool   = true
      var isStartBtn       : bool   = false
      var isCloseBtn       : bool   = true
      var isCloseLobby     : bool   = false
      var isWaiting        : bool   = false
      var isFlowPanel      : bool   = true
      var isLobbyModeSet   : bool   = false
      var waitingTextSet   : string = ""
      var lobbyStateTxtSet : string = ""
      var skipUpdate       : bool   = false
      var screenStateSet   : int    = (int)screenState.Get()
      var isCountdownSet   : bool   = false
      
      var mmStateIdx    : int    = (int)$UiGlobals.matchmaking.state.Get()
      var lobbyStateIdx : int    = (int)$UiGlobals.lobby.state.Get()

      $root.UiLog("Lobby: screenState = " + GetStateNameStr())
      $root.UiLog("Lobby: mmState= " + $UiGlobals.matchmaking.GetStateStr() + ", LobbyState = " + $UiGlobals.lobby.GetStateStr())
      $UiBiLogger.LogLobbyState($UserDataStorage.local_user.IsPartyLeader(), $UiGlobals.matchmaking.GetStateStr(), $UiGlobals.lobby.GetStateStr())
      if (GetScreenStateVal() == $uiEnums.LOBBY_SCREEN_STATE_NONE)
      elif (GetScreenStateVal() == $uiEnums.LOBBY_SCREEN_STATE_PLAYLIST)
         isWaiting         := false
         isStartBtn        := true
         isCloseBtn        := true
         isFlowPanel       := false
         isMapMode         := true
         isLobbyModeSet    := false
         isPlayers1        := true
         isPlayers2        := true
         if (IsCustomGame())
            if ($UserDataStorage.local_user.IsPartyLeader())
               lobbyStateTxtSet  := "lobby_txt_select_map_mode"
            else
               lobbyStateTxtSet  := "lobby_voted_for_map_mode"
            end
            isPlaylists          := true
         else
            if ($UserDataStorage.local_user.IsPartyLeader())
               lobbyStateTxtSet  := "lobby_select_playlist"
               isPlaylists          := true
            else
               lobbyStateTxtSet  := "lobby_selected_playlist"
            end
         end
      else
         isLobbyModeSet    := true
         if (mmStateIdx == $uiEnums.MATCHMAKING_STATE_NONE)
            screenStateSet := $uiEnums.LOBBY_SCREEN_STATE_WAITING_MM
            isWaiting         := true
            //isStartCloseBtn   := true
            isMapMode         := true
            isCloseBtn        := true
            isCloseLobby      := true
         else          
            if (mmStateIdx == $uiEnums.MATCHMAKING_STATE_IN_SESSION and lobbyStateIdx != $uiEnums.LOBBY_STATE_NONE)
               if (lobbyStateIdx == $uiEnums.LOBBY_STATE_VOTING)
                  screenStateSet := $uiEnums.LOBBY_SCREEN_STATE_VOTING
                  isPlayers1        := true
                  isPlayers2        := true
                  isVotingMaps      := true
                  isCloseBtn        := false
                  isCloseLobby      := true
                  lobbyStateTxtSet  := "lobby_vote_for_map_mode"
                  $root.playSound("menu_game_start")
               elif (lobbyStateIdx == $uiEnums.LOBBY_STATE_GAME_START_COUNTDOWN)
                  screenStateSet := $uiEnums.LOBBY_SCREEN_STATE_COUNTDOWN
                  isPlayers1        := true
                  isPlayers2        := true
                  isMapMode         := true
                  isCloseBtn        := false
                  isCloseLobby      := true
                  isCountdownSet    := true
                  lobbyStateTxtSet  := "lobby_voted_for_map_mode"
               elif (lobbyStateIdx == $uiEnums.LOBBY_STATE_WAITING_FOR_VOTING_SET)
                  screenStateSet    := $uiEnums.LOBBY_SCREEN_STATE_LOBBY_JOINING_SESSION
                  isPlayers1        := true
                  isPlayers2        := true
                  isMapMode         := true
                  isCloseBtn        := false
                  isCloseLobby      := true
                  lobbyStateTxtSet  := "lobby_waiting_voting_set"
                  waitingTextSet    := "lobby_state_waiting_voting_set"
               elif (lobbyStateIdx == $uiEnums.LOBBY_STATE_JOINING_SESSION)
                  screenStateSet := $uiEnums.LOBBY_SCREEN_STATE_LOBBY_JOINING_SESSION
                  isPlayers1        := true
                  isPlayers2        := true
                  isWaiting         := true
                  isCloseBtn        := true
                  isCloseLobby      := true
                  isMapMode         := true
                  if (IsCustomGame())
                     lobbyStateTxtSet  := "lobby_voted_for_map_mode"
                  else
                     lobbyStateTxtSet  := "lobby_selected_playlist"
                  end
                  waitingTextSet    := "lobby_state_joining_session"
               else
                  //screenState.Set(SCREEN_STATE_WAITING_LOBBY)
                  isPlayers1        := true
                  isPlayers2        := true
                  isWaiting         := true
                  isCloseBtn        := true
                  isCloseLobby      := true
                  isMapMode         := true
                  if (IsCustomGame())
                     lobbyStateTxtSet  := "lobby_voted_for_map_mode"
                  else
                     lobbyStateTxtSet  := "lobby_selected_playlist"
                  end
                  waitingTextSet    := "lobby_state_waiting_for_players"
                  skipUpdate        := true
               end            
            else
               if (mmStateIdx == $uiEnums.MATCHMAKING_STATE_WAITING_FOR_ENQUEUE)
                  screenStateSet := $uiEnums.LOBBY_SCREEN_STATE_WAITING_MM
                  isWaiting         := true
                  isFlowPanel       := true
                  isCloseBtn        := true
                  isCloseLobby      := true
                  isMapMode         := true
                  if (IsCustomGame())
                     lobbyStateTxtSet  := "lobby_voted_for_map_mode"
                  else
                     lobbyStateTxtSet  := "lobby_selected_playlist"
                  end
                  waitingTextSet    := "lobby_mm_state_waiting_for_enqueue"                  
               elif (mmStateIdx == $uiEnums.MATCHMAKING_STATE_IN_QUEUE)
                  screenStateSet := $uiEnums.LOBBY_SCREEN_STATE_WAITING_MM
                  isWaiting         := true
                  isFlowPanel       := true
                  isCloseBtn        := true
                  isCloseLobby      := true
                  isMapMode         := true
                  if (IsCustomGame())
                     lobbyStateTxtSet  := "lobby_voted_for_map_mode"
                  else
                     lobbyStateTxtSet  := "lobby_selected_playlist"
                  end
                  waitingTextSet    := "lobby_mm_state_in_queue"                 
               end
            end
         end      
      end
                      
      $UiGlobals.isDockerEnabled.Set(GetScreenStateVal() == $uiEnums.LOBBY_SCREEN_STATE_PLAYLIST or GetScreenStateVal() == $uiEnums.LOBBY_SCREEN_STATE_NONE)
      
      
      
      $uiPartyMonitor.SetIsMatchCountdown(isCountdownSet)
      if (IsCustomGame())
         isPlaylistVisible.Set(false)
         var isLeader : bool = (bool)$UserDataStorage.local_user.isPartyLeader.Get()
         isGameModeVisible.Set(isPlaylists and isLeader)
         isGameMapVisible.Set(isPlaylists and isLeader)
         $root.UiLog("LobbyMaps: playlists = " + (string)isPlaylists + ", leader = " + (string)isLeader)
      else
         isPlaylistVisible.Set(isPlaylists)
         isGameModeVisible.Set(false)
         isGameMapVisible.Set(false)
         $root.UiLog("LobbyMaps: playlists = none")
      end
      if (! skipUpdate or _forceUpdate)
         isMapModeVisible.Set(isMapMode)
         isVotingMapsVisible.Set(isVotingMaps)
         isPlayers1Visible.Set(isPlayers1)
         isPlayers2Visible.Set(isPlayers2)
         isPlayers1Enabled.Set(isPlayers1Enable)
         isPlayers2Enabled.Set(isPlayers2Enable)
         isStartBtnVisible.Set(isStartBtn)
         isCloseBtnVisible.Set(isCloseBtn)

         isWaitingMode.Set(isWaiting)
         waitingText.Set(waitingTextSet)
         lobbyStateTxt.Set(lobbyStateTxtSet)
      
         isFlowPanelVisible.Set(isFlowPanel)
         UpdateFlowPanelVisible()
         UpdateCloseBtnVisible()
         UpdateMapMode()
         UpdateTeamMode()

         isLobbyMode.Set(isLobbyModeSet)
         UpdateIsLobbyMode()
         
         screenState.Set(screenStateSet)
         UpdatePlayerSelections()
      end                  
   end   
   
   func UpdateTeamMode(_val : * = null)
      if (wgt != null)
         wgt.SetTeamMode((bool)isTeamModeRoster.Get())
      end
   end
   
   func GetIsTeamModeRoster() : bool
      var ret : bool = false
      if (GetScreenStateVal() == $uiEnums.LOBBY_SCREEN_STATE_COUNTDOWN)
         ret := (bool)isTeamMode.Get()
      end
      //hack
      //ret := true
      return ret
   end
   
   func IsTeamModeAllowed() : bool
      var ret : bool = false
      if (GetScreenStateVal() == $uiEnums.LOBBY_SCREEN_STATE_COUNTDOWN)
         ret := true
      end
      return ret
   end
   
   func GetScreenStateVal() : int
      return (int)screenState.Get()
   end   
   
   func UpdateMapMode(_val : * = null)   
      if (GetScreenStateVal() == $uiEnums.LOBBY_SCREEN_STATE_PLAYLIST or GetScreenStateVal() == $uiEnums.LOBBY_SCREEN_STATE_WAITING_MM or GetScreenStateVal() == $uiEnums.LOBBY_SCREEN_STATE_LOBBY_JOINING_SESSION) 
         $root.UiLog("Lobby: updating map playlist")
         mapMode.isCustom.Set(IsCustomGame())
         mapMode.isMapMode.Set(false)
         mapMode.Invalidate()
      elif (GetScreenStateVal() == $uiEnums.LOBBY_SCREEN_STATE_COUNTDOWN)
         $root.UiLog("Lobby: updating map countdown")
         mapMode.isCustom.Set(IsCustomGame())
         mapMode.isMapMode.Set(true)
         mapMode.Invalidate()
      elif (GetScreenStateVal() != $uiEnums.LOBBY_SCREEN_STATE_NONE)
         $root.UiLog("Lobby: updating map")
         mapMode.isCustom.Set(IsCustomGame())
         mapMode.isMapMode.Set(true)
         mapMode.Invalidate()
      end
   end
   
   func ApplyCurrentPlaylist()
      var idx : int = (int)selectedPlaylistIdx.Get()
      if (idx >= 0 and idx < GetPlaylists().Count())
         $uiPartyMonitor.SetPlaylist(GetPlaylists().Get(idx).id)      
      end
      UpdateRosterLists()
   end

   func ApplyCustomMapMode()
   end
   
   func onRightBtnClicked(): bool
      if (GetScreenStateVal() == $uiEnums.LOBBY_SCREEN_STATE_PLAYLIST)
         var plComp = (GL_ComponentPlaylist)$UiGlobals.componentsPlaylist.Get(selectedPlaylist.Get())
         if internalPlayersParty.Count() > plComp.party_size_max.Get()
            var pp : params
            pp.mbType            := "Info"
            pp.titleTxt          := "msg_too_big_party_title"
            pp.messageTxt        := "msg_too_big_party_text"
            wgt.GenerateEvent("MainMenuDialogRequest", pp)
            return true
         end
         if (! IsCustomGame())
            ApplyCurrentPlaylist()
         end
         wgt.GenerateEvent("onMatchmakeGame")
         $root.playSound("menu_game_start")
      end
      return true
   end
   
   func OnPrepareLobbyScreen(p : params) : bool
      SetScreenActive(true)
      return true      
   end
   
   func OnHideLobbyScreen(p : params) : bool
      SetScreenActive(false)
      return true      
   end
   
   func GetLobbyPartyHelperText() : string
      var ret : string
      if ($uiPartyMonitor.IsPartyOwner())
         ret := "lobby_party_helper_text_owner"
      else
         ret := "lobby_party_helper_text"
      end
      return ret
   end
   
   func GetLobbyHeaderText() : string
      var ret : string
      if ($uiPartyMonitor.IsPartyOwner())
         ret := "lobby_game_lobby_header_owner"
      else
         ret := "lobby_game_lobby_header"
      end
      return ret
   end
end
