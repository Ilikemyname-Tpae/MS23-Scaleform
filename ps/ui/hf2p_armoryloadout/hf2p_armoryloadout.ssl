   return false
end

func OnViewStatsBtnClicked(p:params):bool
   viewParts := ! viewParts
   ShowPartsOrStats(viewParts)
   BlinkArmorSlots()
   return false
end   

func onArmorLoadoutOfferCrClicked(p : params) : bool
   var loadoutIdx   : int = p.widget.GetWidget("_parent").GetWidget("_parent").Props().idx
   var shop         : GL_ShopRace    = (GL_ShopRace)$UiGlobals.shop.race_shops.Get().Get((int)$UserDataStorage.local_user.race.Get())
   var shopSection  : GL_ShopSection = shop.FindInternalSection("section_loadouts")
   var shopShelf    : GL_ShopShelf = shopSection.FindShelf("shelf_armor_loadouts")
   var loadoutId    : string = (string)shopShelf.items.Get().Get(loadoutIdx).value.Get()
   var shopComp     : GL_ComponentShop = (GL_ComponentShop)$UiGlobals.componentsShop.Get(loadoutId)
   var loadoutOffer : GL_ComponentShopOffer = (GL_ComponentShopOffer)shopComp.offers.Get().Get(0)
   var offerId      : string = (string)loadoutOffer.cr_offer.Get()
   var offerCr      : int = (int)loadoutOffer.cr_cost.Get()
   if (offerId != "")
      var par: params
      par.itemID        := loadoutId
      par.offer         := offerId
      par.priceCredit   := offerCr
      if (offerCr <= (int)$UserDataStorage.local_user.cr.Get())
         par.mbType     := "ConfirmBuy"
         par.callbackEvent    := "ArmorLoadoutUpdate"
      else
         par.mbType     := "Info"
         par.titleTxt   := "msg_ui_warning"
         par.messageTxt := "msg_ui_not_enough_cr"
      end
      $sslWidgetMgr.GenerateEvent("MainMenuDialogRequest", par)         
   end
  return false
end

func onArmorLoadoutOfferGpClicked(p : params) : bool
   var loadoutIdx   : int = p.widget.GetWidget("_parent").GetWidget("_parent").Props().idx
   var shop         : GL_ShopRace    = (GL_ShopRace)$UiGlobals.shop.race_shops.Get().Get((int)$UserDataStorage.local_user.race.Get())
   var shopSection  : GL_ShopSection = shop.FindInternalSection("section_loadouts")
   var shopShelf    : GL_ShopShelf = shopSection.FindShelf("shelf_armor_loadouts")
   var loadoutId    : string = (string)shopShelf.items.Get().Get(loadoutIdx).value.Get()
   var shopComp     : GL_ComponentShop = (GL_ComponentShop)$UiGlobals.componentsShop.Get(loadoutId)
   var loadoutOffer : GL_ComponentShopOffer = (GL_ComponentShopOffer)shopComp.offers.Get().Get(0)
   var offerId      : string = (string)loadoutOffer.gl_offer.Get()
   var offerGl      : int = (int)loadoutOffer.gl_cost.Get()
   if (offerId != "")
      var par: params
      par.itemID        := loadoutId
      par.offer         := offerId
      par.priceGold     := offerGl
      if (offerGl <= (int)$UserDataStorage.local_user.gold.Get())
         par.mbType     := "ConfirmBuy"
         par.callbackEvent    := "ArmorLoadoutUpdate"
      else
         par.mbType     := "Info"
         par.titleTxt   := "msg_ui_warning"
         par.messageTxt := "msg_ui_not_enough_gp"
      end
      $sslWidgetMgr.GenerateEvent("MainMenuDialogRequest", par)         
   end
   return false
end

func ArmorLoadoutUpdate(p : params) : bool
   ShowPartsOrStats(viewParts)
   return true
end

func onArmoryLoadoutClicked(p: params): bool
   Log("ui~armorLoadout", "onArmoryLoadoutClicked " + p.widget.idx)
	curArmorLoadoutIdx := p.widget.idx
   Log("ui~armorLoadout", "!!! " + (string)(p.widget.GetName()) + " !!!")
   // check item
   if (GetStateName() == "AssignArmor2Loadout")
      VisualizeAndEquip(p.widget.idx)
      //ArmoryAssignMsgBox()   
      $user_service.SetArmorLoadoutActive(0, p.widget.idx)
   else 
      $user_service.SetArmorLoadoutActive(0, p.widget.idx)
      GenerateEvent("onArmoryLoadoutClicked2", p)
   end
   return false
end

func onArmorSlotClicked(p: params): bool 
   Log("ui~armorLoadout", "onArmorSlotClicked")
   return false
end

func VisualizeAndEquip(_armorLoadoutIdx: int)
   Log("ui~armorLoadout", "VisualizeAndEquip " + (string)(viewParts))
   var armorId    : string = armor.armorId
   var armorType  : string = armor.armorType
   // Equip
   var shopComp : GL_ComponentShop = (GL_ComponentShop)$UiGlobals.componentsShop.Get(armorId)
   
   $uiPlayerInfo.AssignItem2Loadout(curArmorLoadoutIdx, armorId)
   
   // Visualize //
   ShowPartsOrStats(viewParts)   
end

func BlinkArmorSlots()
   $root.playSound("screen_rollout")
   var i : int
   var loadOutIdx : int
   for loadOutIdx := 0 to 4
      var armorLoadout : * = Widgets().alslots.GetWidget("armorLoadout" + (string)(loadOutIdx)).Props()   
      armorLoadout.StartDefaultBlinking(loadOutIdx * 0.1 , 1.3)
   end
   for i := 1 to 4
      Widgets().alslots.Get("armorOfferPanel" + i).StartDefaultBlinking(i * 0.1 , 1.3)
   end 
end

func OnArmoryAssignMsgBoxClosed(p: params): bool
   Log("ui~armorLoadout", "OnArmoryAssignMsgBoxClosed")
   return false         
end
   
func ArmoryAssignMsgBox()
   Log("ui~armorLoadout", "ArmoryAssignMsgBox")
   var   pp          : params
   pp.txtTrans       := false
   pp.isSkip         := true
   pp.itemID         := armor.armorId   
   pp.messageTxt     := GetItemName(armor.armorId)
   pp.callbackEvent  := "OnArmoryAssignMsgBoxClosed"
   pp.mbType         := "AssignInfo"
   pp.titleTxt       := "msg_ui_assigned"
   pp.closeTimeout   := 2 
   GenerateEvent("MainMenuDialogRequest", pp)   
end

