   gp_BuyGold   =   {
      events   =   {
         buttonClick   =   {
            eventRemap   =   "openGoldScreen"
         }
      }
      elements   =   {
         itemCont   =   {
            impl   =   {
               __type   =   "ui_widget_impl_gfx_image"
            }
            pic   =   "goldIcon"
            __type   =   "ui_widget_image"
         }
      }
      soundMap   =   {
         soundMaps   =   {
            this   =   {
               mapping   =   {
                  buttonClick   =   {
