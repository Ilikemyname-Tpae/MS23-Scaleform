func onBack()
   Log("ui~menuItems", "MENU_GRID:: onBack()")
   if (GetStateName() == "sRematch") or (GetStateName() == "sHost") or (GetStateName() == "sClientLobby") or (GetStateName() == "sMatchmaking")
   end
end

func GetPlaylistIcon(_mode:string): string
   var ret: string = ""
   if (_mode == "UI_BTN_SLAYER_FFA")
      ret := "slayerMode"
   else if (_mode == "UI_BTN_TEAM_SLAYER")
      ret := "dominionMode"
   else if (_mode == "UI_BTN_CTF")
      ret := "regicideMode"
   else if (_mode == "UI_BTN_KING_OF_THE_HILL")
      ret := "slayerMode"
   else if (_mode == "UI_BTN_ODDBALL")
      ret := "dominionMode"
   end
   return ret      
end

handle OnEnterState("sPlaylist")
   InitPlayLists()
   setInfoAdLeftPlayList()
   $UiBiLogger.LogLeftPanelState($uiEnums.UI_BI_LEFT_PANEL_PLAYLIST)
end

end
