global event SelectedLoadoutChanged()
   if (selectedTab == "paint")
      SetPaletteBtnColor()
      var blinkTime : float = 0
      var j : int
      for j := 1 to 5
         Widgets().Get("paintBtn" + j).StartDefaultBlinking(blinkTime + j * 0.05)
      end
      Widgets().Get("paintBtn1").GenerateEvent("onPaintBtnClicked")
   end
end

func SetPaletteBtnColor()
   var i:int
   for i := 1 to 5
      var idxTag:int = Widgets().Get("paintBtn" + i).numTag
      var defColor:params = GetCurrentColor(idxTag)
      //Log("ui~content", "int2rgb " + Params2Str(p))   
      Widgets().Get("paintBtn" + i).SetBtnColor(defColor)
      selectedColors.Set(Widgets().Get("paintBtn" + i).numTag, defColor.name)
   end   
   unsavedChanges := false
end

func SetPartBtnColor(_color : params)   
   var i : int
   for i := 1 to 5
      if Widgets().Get("paintBtn" + i).Get("numTag") == curNumTag
         Widgets().Get("paintBtn" + i).SetBtnColor(_color)
      end
   end
end

func GetCurrentColor(_paintTag:int): params
   var ud      : UserData  = (UserData)$UserDataStorage.users.Get($UserDataStorage.local_user.uid.Get())
   var colors  : vector    = ud.armor_loadouts.spartan.colors.Get()
   var ret     : params
   ret.name := "color_pri_grey_1"
   ret.r := 30
   ret.g := 30
   ret.b := 30
   if (_paintTag < colors.Count())
      return getClrParFromName((string)(colors.Get(_paintTag).value.Get()))
   end
   return ret
end

func getClrParFromName(_name :  string) :  params
   var clr        : params
   var colorComp  : GL_ComponentColor = (GL_ComponentColor)$UiGlobals.componentsColor.Get(_name)
   clr.name := _name
   clr.r    := (int)colorComp.r.Get()
   clr.g    := (int)colorComp.g.Get()
   clr.b    := (int)colorComp.b.Get()
   return clr
end

func getIntClrFromName(_name : string) : int
   var ret : int = 0
   var clr : params
   var colorComp  : GL_ComponentColor = (GL_ComponentColor)$UiGlobals.componentsColor.Get(_name)
   clr.r    := (int)colorComp.r.Get()
   clr.g    := (int)colorComp.g.Get()
   clr.b    := (int)colorComp.b.Get()
   ret := (int)(clr.r) * 65536 + (int)(clr.g) * 256 + (int)(clr.b)
   return ret
end

func SaveDefColor(_paintTag:int)
   //defaultColor := GetCurrentColor(_paintTag)
   defColorPar  := GetCurrentColor(_paintTag)
end

