class UiMenuItems : UiWidgetContainer

var currentMenu : * = null
var playlistImg: string = ""
var playlistName: string = "" 
var playLists : vector
var hostMapStr: string = "[...]"
var hostModeStr: string = "[...]"   

handle OnChangeStateAny
   if (GetStateName() == "sMain")
      //Widgets.main.EnableBtns($uiPartyMonitor.IsPartyOwner())
      var p: params
      p.isOwner := $uiPartyMonitor.IsPartyOwner()
      GenerateEvent("EnableBtns", p)
      $UiBiLogger.LogLeftPanelState($uiEnums.UI_BI_LEFT_PANEL_MAIN)
   end   
end 

func SendSelectItem(p: params)
   Log("ui~menuItems", "SendSelectItem: " + Params2Str(p)) 
   GenerateEvent("selectItem", p)      
end

func onMenuItemClicked(p:params):bool
   Log("ui~menuItems", "onMenuItemClicked " + Params2Str(p))
   if (! IsVoid(p.widget.nextState) and ! IsVoid(p.widget.nextWidget))
      var pp: params
      pp.nextState := p.widget.nextState
      pp.nextWidget := p.widget.nextWidget         
      SendSelectItem(pp)
   end
   return false
end

func onPlayWithFriendsClicked(p : params) : bool
   GenerateEvent("onOpenGameModeLobby")
   return false
end

func InitPlayLists()
   Log("ui~menuItems", "InitPlayLists")
   playLists.Clear()
   var playListVec : vector
   var i           : int
   playListVec := $UiGlobals.matchmaking.playlists.Get()
   for i := 0 to playListVec.Count() - 1
      var playlistRec     : GL_String = (GL_String)playListVec.Get(i)
      var playlistId      : string = (string)playlistRec.value.Get()
      var playPar         : params
      var playlistUiName  : string = ""
      var playlistIcn     : string = ""
      var playlistDesc    : string = ""
      var playlistIcnB    : string = ""
      var playListIdx     : int
      if (playlistId != "")
         playlistUiName := $UiGlobals.componentsUI.Get(playlistId).name.Get()
         //playlistIcn    := $UiGlobals.componentsUI.Get(playlistId).icon.Get()
         playlistIcnB   := $UiGlobals.componentsUI.Get(playlistId).icon_big.Get()
         playlistDesc   := $UiGlobals.componentsUI.Get(playlistId).desc.Get()
         playListIdx    := i
      end
      playPar.Id      := playlistId
      playPar.Idx     := playListIdx
      playPar.Label   := playlistUiName
      playPar.Icon    := playlistIcn
      playPar.IconBig := playlistIcnB
      playPar.Desc    := playlistDesc
      playLists.Push(playPar)
   end
   Widgets.playlist.Playlists.SetData(playLists)
end

func setInfoAdLeftPlayList()
   var playlistId : string = $uiPartyMonitor.GetPlaylistId()
   Widgets.playlist.PlaylistIcon.iconModeAttach.pic := (string)$UiGlobals.componentsUI.Get(playlistId).icon.Get()
   Widgets.playlist.PlaylistIcon.textField2 := (string)$UiGlobals.componentsUI.Get(playlistId).name.Get()
end

