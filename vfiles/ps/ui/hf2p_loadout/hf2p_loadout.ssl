handle OnEnteringState("SeeLoadout")
   $UiBiLogger.LogGlobalStateChange($uiEnums.UI_BI_WEAPON_LOADOUT_VIEW)
   $hq.RenderLocalLoadouts()
   enteringState := "SeeLoadout"
   //$user_service.RequestData($UserDataStorage.local_user.uid.Get(), $uiEnums.USER_DATA_WEAPON_LOADOUT)   
   Widgets.header.textField := "main_loadout"
   Widgets.header.visible := true
   Widgets.cancelBtn.visible := true
   Widgets.cancelBtn.label := "main_btn_back"
   Widgets.doneBtn.visible := false
   Widgets.slots.visible := true
   Widgets.RespawnPanel.viewLoadoutsButton.visible := false
   Widgets.KillerInfo.state := "Initial"
   Set("visible", true)
   //AddTween("alpha", 1.0,     Props.adelay, "linear")
   isSelectingSlot := true
   clickFlag := false
   EnableFakeBg()
   InitFocus()
   StartBlink()   
end

handle OnLeavingState("SeeLoadout")
