                              binding   =   "{itemStats.perkDuration == 0 ? 'carousel_cons_unit_instant' : itemStats.perkDuration == 1 ? 'carousel_cons_unit_second,' + {format : '%.2f', a0 = itemStats.perkDuration} : 'carousel_cons_unit_seconds,' + {format : '%.2f', a0 = itemStats.perkDuration}}"
                           }
