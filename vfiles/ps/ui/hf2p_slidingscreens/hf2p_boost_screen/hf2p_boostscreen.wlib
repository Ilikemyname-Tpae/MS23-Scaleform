   BoostOfferLine   =   {
      sslClass   =   "BoostOfferLine"
      sslModule   =   "ui.hf2p_SlidingScreens.hf2p_Boost_screen.hf2p_BoostScreen"
      isBlinkable   =   True
      events   =   {
         buttonClick   =   {
            eventRemap   =   "onBoostGpBtnClick"
         }
      }
      elements   =   {
         tfSaleRightAnim   =   {
            visible   =   False
            __type   =   "ui_widget_container"
         }
         saleShapeRight   =   {
            visible   =   False
            __type   =   "ui_widget_container"
         }
         tfOldPriceAnim   =   {
            visible   =   False
            __type   =   "ui_widget_container"
         }
         tfNewPriceAnim   =   {
            visible   =   False
            __type   =   "ui_widget_container"
         }
         daysCont   =   {
            x   =   -60
            y   =   -1
            bindings   =   {
               tFdays   =   {
                  binding   =   "{DurationToStrings().daysCount}"
               }
               tfHours   =   {
                  binding   =   "{DurationToStrings().daysLabel}"
               }
            }
            __type   =   "ui_weaponConf_lib_slide::offersDaysCont"
         }
      }
      bindings   =   {
         DC   =   {
            binding   =   "{GetOffer((:idx))}"
         }
         enabled   =   {
            binding   =   "{(#parent)EnableOfferLine(gl_cost)}"
         }
         tf   =   {
            binding   =   "{(#parent)GetOfferCostLabel(gl_cost)}"
         }
      }
      __type   =   "ui_weaponConf_lib_slide::goldPurchaseBtnBig"
   }
