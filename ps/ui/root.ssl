   if (_damageType >= 0 and _damageType < ui_damage_types.Count())
      ret := ui_damage_types.Get(_damageType).name
   end
   return ret
end

func GetItemIcon(_itemID: string, _isSmall:bool = false): string
   return GetItemIconAndScale(_itemID, _isSmall).iconName
end


func GetItemIconAndScale(_itemID: string, _isSmall:bool = false): params
   Log("ui~Root", "GetItemIconAndScale " + _itemID)
   var   ret      : params   
   ret.scale      := 1.0      
   ret.iconName   := ""

   if (_itemID != "")
      var compUI  : GL_ComponentUI = (GL_ComponentUI)$UiGlobals.componentsUI.Get(_itemID)
      ret.scale := 1.0      
      if (_isSmall)
         ret.iconName   := (string)compUI.icon.Get()
      else
         ret.iconName   := (string)compUI.icon_big.Get()
      end
      
      if ($uiEconomy.IsItemWeapon(_itemID))
         if (_isSmall)
            ret.scale := 0.5
         else
            ret.scale := 3.5
         end
      elif ($uiEconomy.IsItemArmor(_itemID))
         ret.scale := 1.0
      else
         if (_isSmall)
            ret.scale := 0.7
         else
            ret.scale := 3.5
         end
      end
   end
   return ret
end

func MakeUiTimerString(t: int, _expiringTxt : bool = false, _showSeconds : bool = true): string   
   var ret : string = ""
   if (t > 0)
      var fullDays    : int = t / 60 / 60 / 24
      var fullHours   : int = t / 60 / 60 % 24
      var fullMinutes : int = t / 60 % 60
      var fullSeconds : int = t % 60
      if fullDays > 0 and fullSeconds + fullMinutes + fullHours > 0
         fullDays := fullDays + 1
      end
      if fullHours > 0 and fullSeconds + fullMinutes > 0
         fullHours := fullHours + 1
      end
      if fullMinutes > 0 and fullSeconds > 0
         fullMinutes := fullMinutes + 1
      end
      if fullDays > 0
         var label = "carousel_rent_time_day,"
         if fullDays > 1
            label := "carousel_rent_time_days,"
         end
         ret := label + (string)fullDays
      elif fullHours > 0
         var label = "carousel_rent_time_hour,"
         if fullHours > 1
            label := "carousel_rent_time_hours,"
         end
         ret := label + (string)fullHours
      elif fullMinutes > 0
         var label = "carousel_rent_time_minute,"
         if fullMinutes > 1
            label := "carousel_rent_time_minutes,"
         end
         ret := label + (string)fullMinutes
      elif fullSeconds > 0
         var label = "carousel_rent_time_second,"
         if fullSeconds > 1
            label := "carousel_rent_time_seconds,"
         end
         ret := label + (string)fullSeconds
      else
         ret := ""
      end
   else
      if (_expiringTxt)
         ret := "carousel_rent_time_expiring"
      else 
         ret := "0"
      end
   end   
   
   return ret
end

func MakeUiTimerStringMinutes(t: int, _expiringTxt : bool = false): string 
   return MakeUiTimerString(t, _expiringTxt, false)
end

func MakeUiTimerSubHead(t : int) : wstring
   var p : params
   var ret :  wstring
   if (MakeUiTimerStringMinutes(t) == "0")
      ret := $UiGlobals.String2WString("carousel_rent_time_expiring")
   else
      p.str1 := $UiGlobals.String2WString("carousel_rent_time_subheader,")
      p.str2 := $UiGlobals.TranslateText(MakeUiTimerStringMinutes(t))
      ret := p.str1 + p.str2 
   end
   return ret
end

func RestoreModelPermutations()
   $hq.ShowroomEnd()
   $hq.isInShowroom := false
end

func Float2Str2Dec(_val : float) : string
   var ret  : string 
   var v1   : int = (int)_val
   var v2   : int = (int)((_val - v1) * 100)
   ret := ((string)v1) + "." + ((string)v2)
   return ret
end

func MakeColorCodedText(_text : string, _colorCode : string) : string
   var ret : string = ""
   if (_text != "")
      ret := "<FONT COLOR=\"" + _colorCode + "\">" + _text + "</FONT>"
   end
   return ret
end

func MakeColorCodedWText(_text : *, _colorCode : string) : wstring
   var ret : wstring
   if (_text != "")
      var p : params
      p.tag1   := $UiGlobals.String2WString("<FONT COLOR=\"")
      p.color  := $UiGlobals.String2WString(_colorCode)
      p.tag2   := $UiGlobals.String2WString("\">")
      p.text   := _text
      p.tag3   := $UiGlobals.String2WString("</FONT>")
      
      ret := ret + p.tag1
      ret := ret + p.color
      ret := ret + p.tag2
      ret := ret + p.text
      ret := ret + p.tag3
   end
   return ret
end

func MakeLinkWText(_text : *, _linkName : string, _colorCode : string) : wstring
   var ret : wstring
   if (_text != "")
      var p : params
      if (_colorCode != "")
         p.prefix  := $UiGlobals.String2WString("<span class=\"" + _colorCode + "\"><a href=\"event:" + _linkName + "\">")
         p.text    := _text
         p.postfix := $UiGlobals.String2WString("</a></span>")
      else
         p.prefix  := $UiGlobals.String2WString("<span><a href=\"event:" + _linkName + "\">")
         p.text    := _text
         p.postfix := $UiGlobals.String2WString("</a></span>")
      end
      ret := ret + p.prefix
      ret := ret + p.text
      ret := ret + p.postfix
   end
   return ret
end

