		elements {
			bckg {
				__type = "ui_widget_container"

				propMapping {
					textField = {
						mapping = "textField.text"
					}
				}
				x         = -160.95
				y         = -57.15
				scaleX    = 1.4613
				scaleY    = 1.4613

				elements {
					bg {
						__type = "ui_widget_container"

						x         = 13
						y         = 0
					} 
				}
				animated  = true
			} 
		}
	}

	hf2p_Timer = {
		__type = "ui_widget_container"

		symbol  = "hf2p_Timer" 
