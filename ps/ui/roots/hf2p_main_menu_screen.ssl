func inputEvent(p : params) : bool
   if (p.keyCode != $uiKeys.VK_ENTER and p.keyCode != $uiKeys.VK_SPACE)
      p.eventState.SetIsTerminated()      
      if (!IsChangingStateInProgress() and p.keyCode == $uiKeys.VK_ESC and ! p.isDown and GetStateName() == "MainMenuInitial")
         OnLowerPanelSettingClick(null)
      end
   end
   return false
end

