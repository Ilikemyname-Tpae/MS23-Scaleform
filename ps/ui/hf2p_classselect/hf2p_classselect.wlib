classes   =   {
   SelectClassScreenContainer   =   {
      sslClass   =   "ClassSelectScreenContainer"
      sslModule   =   "ui.hf2p_ClassSelect.hf2p_ClassSelect"
      elements   =   {
         screenAttach   =   {
            elements   =   {
               fullScreenBack   =   {
                  visible   =   False
                  __type   =   "ui_subMenuLib::subm_background"
               }
               SelectClassScreen   =   {
                  __type   =   "hf2p_ClassSelect::SelectClassScreen"
               }
            }
            __type   =   "ui_menu_lib::MainMenuFullscreenAttach"
         }
      }
      __type   =   "hf2p_MainMenu_lib::FullScreenCont"
   }
   SelectClassScreen   =   {
      handlers   =   {
         OnApplyStarterKitOfferComplete   =   {
            handlerName   =   "#OnApplyStarterKitOfferComplete"
         }
      }
      elements   =   {
         renameScreen   =   {
            sslClass   =   "RenameScreen"
            sslModule   =   "ui.hf2p_ClassSelect.hf2p_ClassSelect"
            elements   =   {
               inputNameContainer   =   {
                  handlers   =   {
                     OnSelectNicknameComplete   =   {
                        handlerName   =   "#OnSelectNicknameComplete"
                     }
                     OnSelectNicknameError   =   {
                        handlerName   =   "#OnSelectNicknameError"
                     }
                  }
                  elements   =   {
                     heading   =   {
                        bindings   =   {
                           textField   =   {
                              binding   =   "{'main_select_name_header'}"
                           }
                        }
                        __type   =   "ui_widget_container"
                     }
                     headingUnderline   =   {
                        bindings   =   {
                           textField   =   {
                              binding   =   "{'main_select_name_subheader'}"
                           }
                        }
                        __type   =   "ui_widget_container"
                     }
                     inputContainer   =   {
                        handlers   =   {
                           inputEvent   =   {
                              handlerName   =   "#inputEvent"
                           }
                        }
                        impl   =   {
                           propMapping   =   {
                              textFieldW   =   {
                                 mapping   =   "textField.wtext"
                              }
                           }
                           __type   =   "ui_widget_impl_gfx"
                        }
                        bindings   =   {
                           defaultText   =   {
                              binding   =   "{'main_select_name_default_text'}"
                           }
                        }
                        __type   =   "ui_weaponConf_lib::inputFieldContainer"
                     }
                     errorText   =   {
                        bindings   =   {
                           textField   =   {
                              binding   =   "{errorText}"
                           }
                        }
                        __type   =   "ui_widget_container"
                     }
                     rulersTextContainer   =   {
                        bindings   =   {
                           textField   =   {
                              binding   =   "{'main_select_name_desc'}"
                           }
                        }
                        __type   =   "ui_widget_container"
                     }
                     hf2pTreeBtn   =   {
                        x   =   845
                        y   =   620
                        events   =   {
                           buttonClick   =   {
                              eventRemap   =   "#OnNicknameAcceptBtnClicked"
                           }
                        }
                        elements   =   {
                           tf   =   {
                              bindings   =   {
                                 textField   =   {
                                    binding   =   "{'carousel_btn_accept'}"
                                 }
                              }
                              __type   =   "ui_widget_container"
                           }
                        }
                        __type   =   "ui_weaponConf_lib_slide::hf2pTreeBtn"
                     }
                  }
                  __type   =   "ui_widget_container"
               }
            }
            stateMap   =   {
               startState   =   "Visible"
               states   =   {
                  Hidden   =   {
                     transitionsIn   =   {
                        any   =   {
                           action   =   {
                              anim   =   "fadeOut"
                              __type   =   "ui_widget_action_anim"
                           }
                        }
                     }
                  }
                  Visible   =   {
                     transitionsIn   =   {
                        any   =   {
                           action   =   {
                              anim   =   "fadeIn"
                              __type   =   "ui_widget_action_anim"
                           }
                        }
                     }
                  }
                  Initial   =   {
                     transitionsIn   =   {
                        any   =   {
                           action   =   {
                              anim   =   "hidden"
                              __type   =   "ui_widget_action_anim"
                           }
                        }
                     }
                  }
               }
            }
            bindings   =   {
               state   =   {
                  binding   =   "{selectNicknameState}"
               }
            }
            __type   =   "ui_weaponConf_lib::selectNicknameScreen"
         }
         renderAttach   =   {
            elements   =   {
               RenderTexture   =   {
                  __type   =   "ui_rtts_container::rtts_class_selection"
               }
            }
            __type   =   "ui_widget_container"
         }
         class2   =   {
            bindings   =   {
               idx   =   {
                  binding   =   "{2}"
               }
            }
            __type   =   "hf2p_ClassSelect::ClassSelectCard"
         }
         class1   =   {
            bindings   =   {
               idx   =   {
                  binding   =   "{1}"
               }
            }
            __type   =   "hf2p_ClassSelect::ClassSelectCard"
         }
         class0   =   {
            bindings   =   {
               idx   =   {
                  binding   =   "{0}"
               }
            }
            __type   =   "hf2p_ClassSelect::ClassSelectCard"
         }
         description   =   {
            isBlink0Alpha   =   False
            bindings   =   {
               textField   =   {
                  binding   =   "{'carousel_class_select_desc'}"
               }
            }
            __type   =   "ui_widget_container"
         }
         header   =   {
            bindings   =   {
               textField   =   {
                  binding   =   "{'carousel_class_select_header'}"
               }
            }
            __type   =   "ui_widget_container"
         }
         hf2pTreeBtn   =   {
            x   =   845
            y   =   1000
            fixed   =   False
            events   =   {
               buttonClick   =   {
                  eventRemap   =   "#OnAcceptBtnClicked"
               }
            }
            elements   =   {
               tf   =   {
                  bindings   =   {
                     textField   =   {
                        binding   =   "{'carousel_btn_accept'}"
                     }
                  }
                  __type   =   "ui_widget_container"
               }
            }
            bindings   =   {
               enabled   =   {
                  binding   =   "{selectedIdx != -1}"
               }
               visible   =   {
                  binding   =   "{acceptBtnVisible}"
               }
            }
            __type   =   "ui_weaponConf_lib_slide::hf2pTreeBtn"
         }
      }
      bindings   =   {
         DC   =   {
            binding   =   "{new: 'ui.hf2p_ClassSelect.hf2p_ClassSelect.ClassSelectVM'}"
         }
      }
      __type   =   "ui_weaponConf_lib::SelectClassScreen"
   }
   ClassSelectCard   =   {
      events   =   {
         buttonClick   =   {
            eventRemap   =   "#OnClassCardClicked"
         }
      }
      elements   =   {
         description   =   {
            bindings   =   {
               textField   =   {
                  binding   =   "{(:compUI).desc}"
               }
            }
            __type   =   "ui_widget_container"
         }
         className   =   {
            elements   =   {
               textField   =   {
                  impl   =   {
                     __type   =   "ui_widget_impl_gfx"
                  }
                  __type   =   "ui_widget_text"
               }
            }
            bindings   =   {
               textField   =   {
                  binding   =   "{(:compUI).name}"
               }
            }
            __type   =   "ui_widget_container"
         }
         kitIcon   =   {
            bindings   =   {
               pic   =   {
                  binding   =   "{(:compUI).icon_med}"
               }
            }
            isCentered   =   True
            __type   =   "ui_weaponConf_lib::attachPoint"
         }
         iconCont   =   {
            elements   =   {
               icon   =   {
                  bindings   =   {
                     pic   =   {
                        binding   =   "{(:compUI).icon}"
                     }
                  }
                  isCentered   =   True
                  __type   =   "ui_weaponConf_lib::attachPoint"
               }
            }
            __type   =   "ui_weaponConf_lib::starterKitIconAttach"
         }
      }
      bindings   =   {
         compUI   =   {
            binding   =   "{GetClassCompUI((:idx))}"
         }
         selected   =   {
            binding   =   "{selectedIdx == (:idx)}"
         }
      }
      __type   =   "ui_weaponConf_lib::selectClassCard"
   }
}
__type   =   "ui_wlib"
