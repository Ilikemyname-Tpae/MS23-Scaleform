class UiCashPanelVM
   
   var isBuyGoldEnabled : ObservableProperty = $OM.Calculated(this, "GetIsBuyGoldEnabled")
   var xpBoost          : ObservableProperty = $OM.Property(0)
   var crBoost          : ObservableProperty = $OM.Property(0)
   
   func GetIsBuyGoldEnabled() : bool
      var ret : bool = false
      //ret := (int)$UiGlobals.backend_requests.real_money_purchase.progress.state.Get() == $uiEnums.BACKEND_REQUEST_STATE_NONE
      return ret
   end
   
   func GetXpBoostLabel() : string
      var ret : string
      if ((int)xpBoost.Get() == 0)
         ret := "main_ui_xp"
      else   
         ret := "main_xp_boost_percent," + (string)(int)xpBoost.Get()
      end
      return " "
   end
   
   func GetCrBoostLabel() : string
      var ret : string
      if ((int)crBoost.Get() == 0)
         ret := "main_ui_cr"
      else   
         ret := "main_cr_boost_percent," + (string)(int)crBoost.Get()
      end
      return " "
   end
   
   func GetChaleengeBoostLabel() : string
      return " "
   end
   
   func GetBoostTime(boost : string) : int
      var ret     : int
      if ($uiEconomy.GetItemOwnType(boost) == $uiEnums.ITEM_OWN_TYPE_RENTED)
         var uiInventoryItem : GL_ComponentInventory = (GL_ComponentInventory)$UiGlobals.componentsInventory.Get(boost)
         var ownTime : int = (int)uiInventoryItem.ownership_time.Get() - (int)$UiGlobals.timer.Get()
         ret := ownTime
      end
      return ret   
   end
   
   func GetBoostTimeLabel(boost : string) : wstring
      var ret     : wstring      
      if ($uiEconomy.GetItemOwnType(boost) == $uiEnums.ITEM_OWN_TYPE_RENTED)
         ret := $root.MakeUiTimerStringMinutes(GetBoostTime(boost), true)
      end
      return ret
   end
   
   func GetBoostFrame(boost : string) : string
      var ret : string = "off"
      if (GetBoostTime(boost) > 0)
         ret := "on"
      end
      return ret
   end
   
end
