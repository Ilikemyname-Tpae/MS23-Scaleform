   func GetArmorModifs() : vector
      var items      : vector      
      var itemType   : int = $uiEconomy.GetItemType((string)itemId.Get())
      if (itemType == $uiEnums.ITEM_TYPE_ARMOR)
         items.Push(itemId.Get())
      elif (itemType == $uiEnums.ITEM_TYPE_ARMOR_SUIT)
         var suit    : GL_ComponentArmorSuit    = (GL_ComponentArmorSuit)$UiGlobals.componentsArmorSuit.Get((string)itemId.Get())
         var parts   : vector                   = suit.parts.Get()
         var j       : int
         for j := 0 to parts.Count() - 1
            items.Push(parts.Get(j).value.Get())
         end
      end
      var ret : vector = $UiGlobals.GetPartsModifiersVec(items)
      return ret
   end
   
   func GetArmorBonusesTxt() : wstring
      var ret        : wstring
      var itemType   : int = $uiEconomy.GetItemType((string)itemId.Get())
      if (itemType == $uiEnums.ITEM_TYPE_ARMOR and (string)contentType.Get() == "armor")
         var armorStatsParams : params
         if ((bool)isEquipped.Get())
            armorStatsParams := armorStats.GetArmorModifiers($uiPlayerInfo.GetBackendArmorLoadout(-1), true)
         else
            $hq.ShowroomBegin()
            $hq.ShowroomTryOn((string)itemId.Get())
            var currentLoadout   : UD_ArmorLoadout = $UserDataStorage.local_user.GetCurrentLoadout()
            var showroomLoadout  : UD_ArmorLoadout = (UD_ArmorLoadout)$UiGlobals.showroom.armor_loadouts.spartan.loadouts.Get().Get((int)$UiGlobals.showroom.armor_loadouts.spartan.active_loadout_index.Get())
            $hq.ShowroomEnd()
            armorStatsParams := armorStats.GetArmorModifiers(showroomLoadout, true)
         end
         ret := armorStatsParams.text
      end
      return ret
   end
      
   func GetArmorModifId(idx : int) : string
      var ret : string = ""
      var modifs : vector = armorModifs.Get()
      if (modifs.Count() > idx)
         ret := modifs.Get(idx).uiId
      end
      return ret 
   end
   
   func GetArmorModifValue(idx : int) : wstring
      var ret : wstring = ""
      var modifs : vector = armorModifs.Get()
      if (modifs.Count() > idx)
         ret := $root.FormatArmorModifTempHack(modifs.Get(idx).id, modifs.Get(idx).value)
      end
      return ret
   end
      
   func FormatDurationValue(val : float) : string
      var ret : string = ""
      if (val == 0)
         ret := "carousel_cons_unit_instant"
      elif (val == 1)
         ret := "carousel_cons_unit_second," + $root.FormatFloat(val, 2)
      else
         ret := "carousel_cons_unit_seconds," + $root.FormatFloat(val, 2)
      end
      return ret
   end
   
   func InvalidateTextStats()
      textStatsVector.Clear()
      
      var p : params
      p.name   := "carousel_perk_duration"
      p.value  := FormatDurationValue((int)perkDuration.Get())
      p.valid  := true
      textStatsVector.Push(p.Clone())
      
      p.name   := "carousel_perk_cost"
      p.value  := "carousel_cons_unit_energy," + (string)(int)perkCost.Get()
      p.valid  := true
      textStatsVector.Push(p.Clone())
      
      p.name   := "carousel_perk_cooldown"
      p.value  := FormatDurationValue((int)perkCooldown.Get())
      p.valid  := true
      textStatsVector.Push(p.Clone())
      
      p.name   := ""
      p.value  := ""
      p.valid  := false
      textStatsVector.Push(p.Clone())
      
      p.name   := ""
      p.value  := ""
      p.valid  := false
      textStatsVector.Push(p.Clone())
      textStatsVectorObs.Invalidate()
   end
   
   func GetTextStatsVector() : vector
      return textStatsVector
   end
   
   func GetWeaponStat(statName : string, compWeapon : GL_ComponentWeapon) : float
      var ret : float = 0
      if (compWeapon != null)
         if (statName == "dmg")
            ret := (float)compWeapon.damage.Get()
         elif (statName == "acc")
            ret := (float)compWeapon.accuracy.Get()
         elif (statName == "rof")
            ret := (float)compWeapon.rate_of_fire.Get()
         elif (statName == "rng")
            ret := (float)compWeapon.range.Get()
         end
      end
      return ret
   end
   
   func GetArmorStat(statName : string, compArmor : GL_ComponentArmor) : float
      var ret : float = 0
      if (compArmor != null)
         if (statName == "protection")
            ret := (float)compArmor.ui_stats_protection.Get() / 100.0
         elif (statName == "weapons")
            ret := (float)compArmor.ui_stats_weapons.Get() / 100.0
         elif (statName == "tech")
            ret := (float)compArmor.ui_stats_tech.Get() / 100.0
         elif (statName == "mobility")
            ret := (float)compArmor.ui_stats_mobility.Get() / 100.0
         elif (statName == "cqc")
            ret := (float)compArmor.ui_stats_cqc.Get() / 100.0
         elif (statName == "radar")
            ret := (float)compArmor.ui_stats_radar.Get() / 100.0
         end
      end
      return ret
   end

   func GetMinMaxWeaponStat(statName : string, getMin : bool) : float
      var ret        : float              = 0
      var weapon     : GL_ComponentWeapon = (GL_ComponentWeapon)weaponComp.Get()
      var weaponCmp  : GL_ComponentWeapon = (GL_ComponentWeapon)weaponCompCmp.Get()
      if (weapon != null)
         if (weaponCmp != null)
            var v1 : float = GetWeaponStat(statName, weapon)
            var v2 : float = GetWeaponStat(statName, weaponCmp)
            ret := v1
            if (getMin)
               if (v2 < ret)
                  ret := v2
               end
            else
               if (v2 > ret)
                  ret := v2
               end
            end
         else
            ret := GetWeaponStat(statName, weapon)
         end
      end
      return ret
   end
   
   func GetMinMaxArmorStat(statName : string, getMin : bool) : float
      var ret           : float                    = 0
      var armorStat     : GL_ComponentArmor = (GL_ComponentArmor)armorStatComp.Get()
      var armorStatCmp  : GL_ComponentArmor = (GL_ComponentArmor)armorStatCompCmp.Get()
      if (armorStat != null)
         if (armorStatCmp != null)
            var v1 : float = GetArmorStat(statName, armorStat)
            var v2 : float = GetArmorStat(statName, armorStatCmp)
            ret := v1
            if (getMin)
               if (v2 < ret)
                  ret := v2
               end
            else
               if (v2 > ret)
                  ret := v2
               end
            end
         else
            ret := GetArmorStat(statName, armorStat)
         end
      end
      return ret
   end
   
   func GetMinWeaponStat(statName : string) : float
      return GetMinMaxWeaponStat(statName, true)
   end
   
   func GetMaxWeaponStat(statName : string) : float
      return GetMinMaxWeaponStat(statName, false)
   end
      
   func GetMinArmorStat(statName : string) : float
      return GetMinMaxArmorStat(statName, true)
   end
   
   func GetMaxArmorStat(statName : string) : float
      return GetMinMaxArmorStat(statName, false)
   end
   
   func GetClipSize() : int
      var   weapon   :  GL_ComponentWeapon = (GL_ComponentWeapon)weaponComp.Get()
      var ret : int = 0 
      if (weapon != null)
         ret := (int)weapon.clip_size.Get()
      end
      return ret
   end
      
   func GetCmpBarColor(paramName : string) : params
      var ret           :  params
      var selectedWpn   :  GL_ComponentWeapon   = (GL_ComponentWeapon)weaponComp.Get()
      var wpnStat       :  float                = 0
      var myWpn         :  GL_ComponentWeapon   = (GL_ComponentWeapon)weaponCompCmp.Get()
      var myWpnStat     :  float                = 0 
      
      if (selectedWpn == null or myWpn == null)
         ret.r  := 33
         ret.g  := 61
         ret.b  := 98
         return ret
      end
      
      wpnStat     := GetWeaponStat(paramName, selectedWpn)
      myWpnStat   := GetWeaponStat(paramName, myWpn)
      
      if (wpnStat >= myWpnStat)
         ret.r  := 166
         ret.g  := 248
         ret.b  := 255
      else
         ret.r  := 48
         ret.g  := 76
         ret.b  := 103
      end
      return ret
   end
   
   func GetCmpBarColorArmor(paramName : string) : params
      var ret           :  params
      var selectedItem  :  GL_ComponentArmor   = (GL_ComponentArmor)armorStatComp.Get()
      var selectedStat  :  float                      = 0
      var myItem        :  GL_ComponentArmor   = (GL_ComponentArmor)armorStatCompCmp.Get()
      var myStat        :  float                      = 0 
      
      if (selectedItem == null or myItem == null)
         ret.r  := 33
         ret.g  := 61
         ret.b  := 98
         return ret
      end
      
      selectedStat   := GetArmorStat(paramName, selectedItem)
      myStat         := GetArmorStat(paramName, myItem)
      
      if (selectedStat >= myStat)
         ret.r  := 166
         ret.g  := 248
         ret.b  := 255
      else
         ret.r  := 48
         ret.g  := 76
         ret.b  := 103
      end
      return ret
   end
   
   func GetBarColor() : params
      var ret : params = $uiEconomy.GetWeaponPrimaryArrtibuteColor("unknown")
      return ret
   end
   
   func GetTfColor : int
      var defClr : params = $uiEconomy.GetWeaponPrimaryArrtibuteColor("unknown")
      var clr : int = $root.RGB2Clr(defClr.r, defClr.g, defClr.b)
      return clr
   end
   
