func GetItemName(_itemId:string):string
   var ret:string 
   if (_itemId != "")
      var compUI  : GL_ComponentUI = (GL_ComponentUI)$UiGlobals.componentsUI.Get(_itemId)
      ret := (string)compUI.name.Get()
      return ret
   end
   return ret
end

func GetLoadout(_loadoutIdx:int) : *
   return Widgets.slots.GetWidget("Loadout" + _loadoutIdx)
end

func GetSlotBtn(_slotIdx:int, _btnIdx:int): *
   return Widgets.slots.GetWidget("Loadout" + _slotIdx).Widgets.btnBox.GetWidget("btn" + _btnIdx)
end
   
func onLoadoutSmallBtnClick(p:params): bool
   Log("ui~loadoutSelect", "onLoadoutSmallBtnClicked " + p.widget.idx)
   $user_service.SetCharacterActive(p.widget.idx)
   return false   
end

handle OnChangeStateAny
   if (GetStateName() == "SeeLoadout" or GetStateName() == "Assign2Loadout" or GetStateName() == "SelectLoadout" or GetStateName() == "SelectLoadoutPregame")
      subscribe := true
      $UserDataStorage.InvalidateWeaponLoadouts()
      GetObservableLoadoutCount().Subscribe(this, "CheckUpdateLoadout")
      var i: int
      for i := 0 to 2
	     UpdateLoadoutStatus(i, true)
      end
      for i:= 1 to 2
         UpdateLoadoutOffersLine(i)
      end
   end
   ShowSelectLoadoutButtons()
end

handle OnEnteringState("Initial")
   if (subscribe)
      GetObservableLoadoutCount().Unsubscribe(this, "CheckUpdateLoadout")
      subscribe := false
   end
   enteringState := "Initial"
   //AddTween("alpha", 0.0, 0.15, "linear")
   Set("visible", false)// : 0.15
   $UiGlobals.DeathScreenLoadoutsMode.Set("weapons")
   ShowSelectLoadoutButtons()
end          

handle OnEnterState("Initial")
   Widgets.KillerInfo.state := "Initial"
