func EnterRematchLobby(_startPage : string)
   var partyState : int = (int)$UiGlobals.party.state.Get()
   if (partyState != $uiEnums.PARTY_STATE_NONE)
      GotoLobby($UiGlobals.party.GetMMEnumFromState(), _startPage)
   else
      $uiMatchmaking.ResetIsRematch()
      GotoMainMenuInitial()
   end
end

