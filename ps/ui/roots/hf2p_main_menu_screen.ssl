func onPostgameOut(p: params): bool
   Log("ui~hf2p_main_menu", "MAIN_MENU onPostgameOut")
   var pp : params
   pp.enabled := true
   GenerateEvent("TechBtnEnabled", pp)
   Widgets().postgame.state := "Initial"
   //SetStateName("PostGameTutorial")
   if ($uiPartyMonitor.GetIsLeavedGame() or $UiGlobals.notifications.session_reward_replayIdx != $uiEnums.NOTIFICATION_SESSION_REWARDS_UNDEFINED)
      if ($uiMatchmaking.GetIsRematch() or $uiPartyMonitor.IsFormationOrLobby())
         EnterRematchLobby($uiEnums.SLIDING_PAGE_LOBBY)
      else
         RollbackAllStates()
      end
   elif (! $uiPartyMonitor.GetIsLeavedGame())
      onRematch()
   else 
      RollbackAllStates()
   end
   return false
end

