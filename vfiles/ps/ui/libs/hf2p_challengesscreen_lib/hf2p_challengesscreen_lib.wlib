   ChallengeProgressBar   =   {
      elements   =   {
         progress   =   {
            elements   =   {
               bar   =   {
                  sslClass   =   "ChallengeProgress"
                  sslModule   =   "ui.libs.hf2p_ChallengesScreen_lib.hf2p_ChallengesScreen_lib"
                  isBlinkable   =   True
                  fixed   =   False
                  bindings   =   {
                     x   =   {
                        binding   =   "{-365 + progress * 364}"
                     }
                     tint   =   {
                        binding   =   "{barTint}"
                     }
                  }
                  __type   =   "ui_widget_container"
               }
            }
            bindings   =   {
               visible   =   {
                  binding   =   "{!isLocked}"
               }
            }
            __type   =   "ui_widget_container"
         }
         starRight   =   {
            bindings   =   {
               frame   =   {
                  binding   =   "{GetMedalFrame()}"
               }
               visible   =   {
                  binding   =   "{!isLocked and HasCounters() and !isComplete}"
               }
            }
            __type   =   "ui_widget_container"
         }
         starLeft   =   {
            bindings   =   {
               frame   =   {
                  binding   =   "{GetMedalFrame(true)}"
               }
               visible   =   {
                  binding   =   "{!isLocked and HasCounters()}"
               }
            }
            __type   =   "ui_widget_container"
         }
         icon   =   {
            visible   =   False
            __type   =   "ui_challengesScreen_lib::attachPointIcon"
         }
         tpIcon   =   {
            isBlinkable   =   True
            bindings   =   {
               visible   =   {
                  binding   =   "{!isLocked and HasCounters() and !isComplete}"
               }
               frame   =   {
                  binding   =   "{GetTokenFrame()}"
               }
            }
            __type   =   "ui_weaponConf_lib_slide::medalChallenge"
         }
         tfTechPointsReward   =   {
            isBlinkable   =   True
            bindings   =   {
               tf   =   {
                  binding   =   "{GetTotalPoints()}"
               }
               visible   =   {
                  binding   =   "{!isLocked and HasCounters() and !isComplete}"
               }
            }
            __type   =   "ui_widget_container"
         }
         tfGetItem   =   {
            isBlinkable   =   True
            elements   =   {
               tf   =   {
                  bindings   =   {
                     text   =   {
                        binding   =   "{GetItemGetTxt()}"
                     }
                     textColor   =   {
                        binding   =   "{GetItemGetTxtColor()}"
                     }
                  }
                  alignVertical   =   "UI_TEXT_VERTICAL_ALIGN_CENTER"
                  __type   =   "ui_widget_text"
               }
            }
            bindings   =   {
               visible   =   {
                  binding   =   "{!isLocked and !HasUnlockItem() and IsChallengeItem()}"
               }
            }
            __type   =   "ui_widget_container"
         }
         getItemBg   =   {
            bindings   =   {
               frame   =   {
                  binding   =   "{GetLineFrame()}"
               }
               visible   =   {
                  binding   =   "{!isLocked and !HasUnlockItem() and IsChallengeItem()}"
               }
            }
            __type   =   "ui_challengesScreen_lib::getItemLirBgLine"
         }
         tfNumberChallengeCard   =   {
            isBlinkable   =   True
            bindings   =   {
               tf   =   {
                  binding   =   "{GetProgressTxt()}"
               }
               visible   =   {
                  binding   =   "{!isLocked}"
               }
            }
            __type   =   "ui_widget_container"
         }
         tfDscChallengeCard   =   {
            isBlinkable   =   True
            elements   =   {
               tf   =   {
                  bindings   =   {
                     text   =   {
                        binding   =   "{GetDesc()}"
                     }
                  }
                  alignVertical   =   "UI_TEXT_VERTICAL_ALIGN_BOTTOM"
                  __type   =   "ui_widget_text"
               }
            }
            bindings   =   {
               visible   =   {
                  binding   =   "{!isLocked}"
               }
            }
            __type   =   "ui_widget_container"
         }
         tfRewardCard   =   {
            isBlinkable   =   True
            bindings   =   {
               tf   =   {
                  binding   =   "{GetHeaderReward()}"
               }
               visible   =   {
                  binding   =   "{!isLocked and HasUnlockItem()}"
               }
            }
            __type   =   "ui_widget_container"
         }
         tfChallengeCard   =   {
            isBlinkable   =   True
            bindings   =   {
               tf   =   {
                  binding   =   "{GetHeaderRank()}"
               }
               visible   =   {
                  binding   =   "{!isLocked}"
               }
            }
            __type   =   "ui_widget_container"
         }
         innerLine   =   {
            bindings   =   {
               visible   =   {
                  binding   =   "{!isLocked}"
               }
            }
            __type   =   "ui_challengesScreen_lib::ChallengeProgressBarInnerLine"
         }
         attachChallengeSide   =   {
            x   =   9
            y   =   33
            fixed   =   False
            bindings   =   {
               pic   =   {
                  binding   =   "{GetChallengeIcon()}"
               }
               visible   =   {
                  binding   =   "{!isLocked and false}"
               }
            }
            __type   =   "ui_challengesScreen_lib::attachPointIcon"
         }
      }
      __type   =   "ui_challengesScreen_lib::ChallengeProgressBar"
   }
   challengeSlidePopUp   =   {
      sslClass   =   "ChallengeSlidePopup"
      sslModule   =   "ui.hf2p_SlidingScreens.hf2p_challenges_screen.hf2p_challengeProgressPopup"
      x   =   1520
      y   =   925
      elements   =   {
         challengeSlideProgress   =   {
            elements   =   {
               completeElem   =   {
                  elements   =   {
                     tpIcon   =   {
                        bindings   =   {
                           frame   =   {
                              binding   =   "{GetTokenFrame()}"
                           }
                        }
                        __type   =   "ui_challengesScreen_lib::iconTechPoints"
                     }
                     tfTechPointsReward   =   {
                        bindings   =   {
                           tf   =   {
                              binding   =   "{GetTotalPoints()}"
                           }
                        }
                        __type   =   "ui_widget_container"
                     }
                     tfRewardCard   =   {
                        visible   =   False
                        __type   =   "ui_widget_container"
                     }
                     header   =   {
                        bindings   =   {
                           tf   =   {
                              binding   =   "{'msg_challengebox_header'}"
                           }
                        }
                        __type   =   "ui_challengesScreen_lib::cheCompleteHeader"
                     }
                     challengeName   =   {
                        elements   =   {
                           tf   =   {
                              bindings   =   {
                                 text   =   {
                                    binding   =   "{GetHeaderRank()}"
                                 }
                              }
                              alignVertical   =   "UI_TEXT_VERTICAL_ALIGN_CENTER"
                              __type   =   "ui_widget_text"
                           }
                        }
                        __type   =   "ui_challengesScreen_lib::cheCompleteName"
                     }
                     itemAttach   =   {
                        bindings   =   {
                           pic   =   {
                              binding   =   "{GetChallengeIcon()}"
                           }
                        }
                        __type   =   "ui_challengesScreen_lib::attachPointIcon"
                     }
                  }
                  bindings   =   {
                     visible   =   {
                        binding   =   "{isComplete}"
                     }
                  }
                  __type   =   "ui_challengesScreen_lib::ChallengeCompletePopup"
               }
               progressElem   =   {
                  elements   =   {
                     tfDscChallengeCard   =   {
                        elements   =   {
                           tf   =   {
                              alignVertical   =   "UI_TEXT_VERTICAL_ALIGN_BOTTOM"
                              __type   =   "ui_widget_text"
                           }
                        }
                        __type   =   "ui_widget_container"
                     }
                     attachChallengeSide   =   {
                        x   =   0
                        __type   =   "ui_challengesScreen_lib::attachPointIcon"
                     }
                  }
                  bindings   =   {
                     visible   =   {
                        binding   =   "{!isComplete}"
                     }
                  }
                  __type   =   "hf2p_ChallengesScreen_lib::ChallengeProgressBar"
               }
               attachChallengeSide   =   {
                  bindings   =   {
                     pic   =   {
                        binding   =   "{GetChallengeIcon()}"
                     }
                     visible   =   {
                        binding   =   "{!isComplete}"
                     }
                  }
                  __type   =   "ui_challengesScreen_lib::attachPointIcon"
               }
            }
            bindings   =   {
               tfChallengeHeader   =   {
                  binding   =   "{' '}"
               }
               tfDescChallenge   =   {
                  binding   =   "{' '}"
               }
               curProgressTf   =   {
                  binding   =   "{' '}"
               }
               maxProgressTf   =   {
                  binding   =   "{' '}"
               }
               DC   =   {
                  binding   =   "{progress}"
               }
            }
            __type   =   "ui_challengesScreen_lib::challengeSideLabel"
         }
      }
      stateMap   =   {
         startState   =   "Initial"
         states   =   {
            Waiting   =   {
            }
            Initial   =   {
            }
            AnimIn   =   {
               transitionsIn   =   {
                  any   =   {
                     action   =   {
                        anim   =   "fadeIn"
                        __type   =   "ui_widget_action_anim"
                     }
                  }
               }
            }
            AnimOut   =   {
               transitionsIn   =   {
                  any   =   {
                     action   =   {
                        anim   =   "fadeOut"
                        __type   =   "ui_widget_action_anim"
                     }
                  }
               }
            }
         }
      }
      bindings   =   {
         DC   =   {
            binding   =   "{new: 'ui.hf2p_SlidingScreens.hf2p_challenges_screen.hf2p_challengeProgressPopup.ChallengeSlidePopupVM'}"
         }
      }
      __type   =   "ui_challengesScreen_lib::challengeSideAnim"
   }
   ItemChallengesList   =   {
      elements   =   {
         list   =   {
            bindings   =   {
               items   =   {
                  binding   =   "{GetItemChallenges()}"
               }
               direction   =   {
                  binding   =   "{'vertical'}"
               }
            }
            lir   =   {
               isBlinkable   =   True
               events   =   {
                  click   =   {
                     eventRemap   =   "#OnItemChallengeLirClicked"
                  }
               }
               elements   =   {
                  tfLockedChallengege   =   {
                     bindings   =   {
                        visible   =   {
                           binding   =   "{isLocked}"
                        }
                        tf   =   {
                           binding   =   "{'carousel_tree_item_locked'}"
                        }
                     }
                     __type   =   "ui_widget_container"
                  }
                  lockIcon   =   {
                     bindings   =   {
                        visible   =   {
                           binding   =   "{isLocked}"
                        }
                     }
                     __type   =   "ui_challengesScreen_lib::wc_lock_iconBig"
                  }
                  lockBG   =   {
                     bindings   =   {
                        visible   =   {
                           binding   =   "{isLocked}"
                        }
                     }
                     __type   =   "ui_widget_container"
                  }
                  tfHeaderChallengeScreen   =   {
                     isBlinkable   =   True
                     bindings   =   {
                        tf   =   {
                           binding   =   "{GetTechLabel()}"
                        }
                     }
                     __type   =   "ui_widget_container"
                  }
                  level1   =   {
                     isBlinkable   =   True
                     bindings   =   {
                        frame   =   {
                           binding   =   "{GetCurrentRank() >= 0 ? GetMedalFrame(0) : GetMedalFrame(-1)}"
                        }
                        visible   =   {
                           binding   =   "{!isLocked}"
                        }
                     }
                     __type   =   "ui_weaponConf_lib_slide::medalChallenge"
                  }
                  level2   =   {
                     isBlinkable   =   True
                     bindings   =   {
                        frame   =   {
                           binding   =   "{GetCurrentRank() >= 1 ? GetMedalFrame(1) : GetMedalFrame(-1)}"
                        }
                        visible   =   {
                           binding   =   "{!isLocked}"
                        }
                     }
                     __type   =   "ui_weaponConf_lib_slide::medalChallenge"
                  }
                  level3   =   {
                     isBlinkable   =   True
                     bindings   =   {
                        frame   =   {
                           binding   =   "{GetCurrentRank() >= 2 ? GetMedalFrame(2) : GetMedalFrame(-1)}"
                        }
                        visible   =   {
                           binding   =   "{!isLocked}"
                        }
                     }
                     __type   =   "ui_weaponConf_lib_slide::medalChallenge"
                  }
                  activeChallenge   =   {
                     fixed   =   False
                     elements   =   {
                        equipCont   =   {
                           y   =   -2
                           fixed   =   False
                           bindings   =   {
                              visible   =   {
                                 binding   =   "{!isLocked and IsItemEquippedForChallenge() and !IsComplete()}"
                              }
                           }
                           __type   =   "ui_weaponConf_lib_slide::equipClip"
                        }
                     }
                     __type   =   "ui_widget_container"
                  }
                  challengeIcon   =   {
                     isBlinkable   =   True
                     bindings   =   {
                        pic   =   {
                           binding   =   "{GetTechIcon()}"
                        }
                     }
                     isCentered   =   True
                     __type   =   "ui_challengesScreen_lib::challengeAttachPoint"
                  }
                  wpnStatIndicator   =   {
                     bindings   =   {
                        visible   =   {
                           binding   =   "{StatLineVisible()}"
                        }
                        tint   =   {
                           binding   =   "{GetStatLineTint()}"
                        }
                     }
                     __type   =   "ui_challengesScreen_lib::statLineColor"
                  }
                  border   =   {
                     bindings   =   {
                        frame   =   {
                           binding   =   "{GetBorderFrame()}"
                        }
                     }
                     __type   =   "ui_challengesScreen_lib::borderChallenges"
                  }
                  bg   =   {
                     animated   =   True
                     isBlink0Alpha   =   False
                     bindings   =   {
                        anim   =   {
                           binding   =   "{GetChallengeStateFrame()}"
                        }
                     }
                     __type   =   "ui_challengesScreen_lib::ChallengeScreenBg"
                  }
                  boostStrip   =   {
                     bindings   =   {
                        visible   =   {
                           binding   =   "{BoostStripVisible()}"
                        }
                     }
                     __type   =   "ui_challengesScreen_lib::challengeBoosterAngle"
                  }
                  challengeProgress   =   {
                     isBlinkable   =   True
                     elements   =   {
                        icon   =   {
                           visible   =   True
                           bindings   =   {
                              pic   =   {
                                 binding   =   "{GetChallengeIcon()}"
                              }
                              visible   =   {
                                 binding   =   "{!isLocked}"
                              }
                           }
                           __type   =   "ui_challengesScreen_lib::attachPointIcon"
                        }
                        tfGetItem   =   {
                           bindings   =   {
                              visible   =   {
                                 binding   =   "{!isLocked and IsChallengeItem()}"
                              }
                           }
                           __type   =   "ui_widget_container"
                        }
                        getItemBg   =   {
                           bindings   =   {
                              visible   =   {
                                 binding   =   "{!isLocked and IsChallengeItem()}"
                              }
                           }
                           __type   =   "ui_challengesScreen_lib::getItemLirBgLine"
                        }
                     }
                     bindings   =   {
                        DC   =   {
                           binding   =   "{progress}"
                        }
                     }
                     __type   =   "hf2p_ChallengesScreen_lib::ChallengeProgressBar"
                  }
               }
               bindings   =   {
                  DC   =   {
                     binding   =   "{new: 'ui.hf2p_SlidingScreens.hf2p_challenges_screen.hf2p_item_challenges_screen.UiItemChallengesLIRVM', challengeItemId = (:DC2).challengeItemId, tmpVar = (:DC2).tmpVar, tmpVar2 = (:DC2).tmpVar2}"
                  }
               }
               __type   =   "ui_challengesScreen_lib::ItemChallengesLIR"
            }
            scrollbar   =   {
               __type   =   "hf2p_WeaponList_lib::wc_ItemsListScrollBarNew"
            }
            __type   =   "ui_challengesScreen_lib::ItemChallengesList"
         }
      }
      __type   =   "ui_challengesScreen_lib::ItemChallengeListCont"
   }
   msgBoxRewardContainer   =   {
      elements   =   {
         itemAttach   =   {
            bindings   =   {
               pic   =   {
                  binding   =   "{GetRewardIcon()}"
               }
            }
            __type   =   "ui_postmatch_lib::RewardItemAttach"
         }
         itemTfCont   =   {
            bindings   =   {
               itemTf   =   {
                  binding   =   "{GetRewardLabel()}"
               }
            }
            __type   =   "ui_widget_container"
         }
      }
      __type   =   "ui_postmatch_lib::LevelUpRewardContainer"
   }
   victoryChallengeAnim   =   {
      __type   =   "ui_postmatch_lib::hf2p_pm_victory_challenge"
   }
}
__type   =   "ui_widget_lib"
