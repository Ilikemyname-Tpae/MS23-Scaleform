   end
   
   func GetPlaylistIdx(id : string) : int
      var ret        : int = -1
      var i          : int
      var playlists  : vector = GetPlaylists()
      for i := 0 to playlists.Count() - 1
         var playlistId : string = playlists.Get(i).id
         if (playlistId == id)
            ret := i
            break
         end
      end
      return ret
   end
         
