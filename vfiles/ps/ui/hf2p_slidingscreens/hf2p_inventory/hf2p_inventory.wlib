               }
               tfHeadDD   =   {
                  bindings   =   {
                     tf   =   {
                        binding   =   "{'carousel_inventory_class'}"
                     }
                  }
                  __type   =   "ui_widget_container"
               }
            }
            bindings   =   {
               DC   =   {
                  binding   =   "{categoryDrop}"
               }
               visible   =   {
                  binding   =   "{false}"
               }
            }
            __type   =   "hf2p_Inventory::InventoryFilter"
         }
         inventoryDrop3   =   {
            elements   =   {
               dropFilter   =   {
                  bindings   =   {
                     items   =   {
                        binding   =   "{(#parent.#parent)qualityFilterList}"
                     }
                     enabled   =   {
                        binding   =   "{false}"
                     }
                  }
                  __type   =   "ui_inventory_lib_as3::inventoryDropdown"
               }
               tfHeadDD   =   {
                  bindings   =   {
                     tf   =   {
                        binding   =   "{'carousel_inventory_quality'}"
                     }
                  }
                  __type   =   "ui_widget_container"
               }
            }
            bindings   =   {
               DC   =   {
                  binding   =   "{qualityDrop}"
               }
               visible   =   {
                  binding   =   "{false}"
               }
            }
            __type   =   "hf2p_Inventory::InventoryFilter"
