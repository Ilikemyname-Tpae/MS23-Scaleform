                  }
                  pic   =   "emblemA"
                  __type   =   "ui_widget_image"
               }
               KilledBy_header   =   {
                  impl   =   {
                     propMapping   =   {
                        headerText   =   {
                           mapping   =   "tf.text"
                        }
                     }
                     __type   =   "ui_widget_impl_gfx"
                  }
                  customProps   =   [
                     {
                        propName   =   "headerText"
                        propVal   =   {
                           val   =   "ingame_killer_killed_by"
                           __type   =   "ui_widget_desc_prop_string"
                        }
                     }
                  ]
                  __type   =   "ui_widget_container"
               }
               TagName_field   =   {
                  impl   =   {
                     propMapping   =   {
                        nameText   =   {
                           mapping   =   "tf.text"
