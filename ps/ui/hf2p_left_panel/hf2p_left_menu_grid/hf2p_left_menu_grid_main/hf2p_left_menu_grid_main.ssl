class UiMain : UiWidgetContainer


func ToggleEnabled(widgetObj: *, isEnabled: bool)
   var isNowEnabled : bool = (bool)(widgetObj.enabled)
   if ((string)(isNowEnabled) != (string)(isEnabled))
      Log("ui~main", "OnEnableBtns toggle for " + widgetObj.GetName() + " changed from " + (string)(isNowEnabled) + " to " + (string)(isEnabled))
      widgetObj.enabled := isEnabled
   end
end

