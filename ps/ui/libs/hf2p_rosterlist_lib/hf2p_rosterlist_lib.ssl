class UiLobbyVotingGroupElem : UiWidgetContainer

var   mapId       :  int
var   isVoting    :  bool
var   votesCount  :  int = 0
var   tmpMapPic   :  string

func InitForVoting()
   isVoting                         := true
   Widgets().checkupElem.visible    := true
   Widgets().bg.votesLabelTxt.text  := "lobby_votes"
end

func InitForPreview()
   isVoting                         := false
   Widgets().checkupElem.visible    := false
   Widgets().bg.votesTxt.text       := ""
   Widgets().bg.votesLabelTxt.text  := ""
end

end

