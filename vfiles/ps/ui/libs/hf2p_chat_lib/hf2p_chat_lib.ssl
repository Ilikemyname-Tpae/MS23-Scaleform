   func SendMessage(p : params) : bool
      var txt     : string    = wgt.Widgets.inputCont.inputTf.text
      var wtxt    : wstring   = wgt.Widgets.inputCont.inputTf.wtext
      wgt.Widgets.inputCont.inputTf.text := ""
      if (txt != "" and CanSendMessage())
         var command : wstring = $hq.ChatExtractCommand(wtxt)
         if (command == $UiGlobals.String2WString(""))
            // send message
            //wtxt := $UiGlobals.EscapeString(wtxt)
            var stream : GL_ChatStream = null
            var msg = new GL_ChatStreamMessage()
            msg.sender_user_id := $OM.Property($UserDataStorage.local_user.uid.Get())
            msg.addressee_user_id := $OM.Property($UserDataStorage.GetInvalidUID())
            msg.timestamp := $OM.Property($UiGlobals.GetCurrentTimeStamp())
            msg.text := $OM.Property(wtxt)
            msg.directMsg := true
            var selectedChannel : int = GetSelectedChannel()
            
            if (selectedChannel == $uiEnums.CHAT_CHANNEL_ALL)
               $hq.ChatSendGeneral(wtxt)
               stream := $UiGlobals.chat.general
               msg.originalChannel := $uiEnums.CHAT_CHANNEL_ALL
               
            elif (selectedChannel == $uiEnums.CHAT_CHANNEL_PARTY)
               $hq.ChatSendParty(wtxt)
               stream := $UiGlobals.chat.party
               msg.originalChannel := $uiEnums.CHAT_CHANNEL_PARTY
               
            elif (selectedChannel == $uiEnums.CHAT_CHANNEL_GAME_ALL)
               $hq.ChatSendGameAll(wtxt)
               stream := $UiGlobals.chat.game_all_channel
               msg.originalChannel := $uiEnums.CHAT_CHANNEL_GAME_ALL
               
            elif (selectedChannel == $uiEnums.CHAT_CHANNEL_CLAN)
               $hq.ChatSendClan(wtxt)
               stream := $UiGlobals.chat.clan_channel
               msg.originalChannel := $uiEnums.CHAT_CHANNEL_CLAN
               
            elif (selectedChannel == $uiEnums.CHAT_CHANNEL_PRIVATE)
               $hq.ChatSendPrivate(privateMessagesTarget.Get(), wtxt)
               stream := $UiGlobals.chat.GetPrivateChannel(privateMessagesTarget.Get())
               msg.addressee_user_id := $OM.Property(privateMessagesTarget.Get())
               msg.originalChannel := $uiEnums.CHAT_CHANNEL_PRIVATE
               $UiGlobals.chat.CopyMessage(msg, $UiGlobals.chat.ui_channel_general, $uiEnums.CHAT_CHANNEL_PRIVATE, true)
               $UiGlobals.chat.CopyMessage(msg, $UiGlobals.chat.ui_channel_clan, $uiEnums.CHAT_CHANNEL_PRIVATE, true)
               $UiGlobals.chat.CopyMessage(msg, $UiGlobals.chat.ui_channel_party, $uiEnums.CHAT_CHANNEL_PRIVATE, true)
               $UiGlobals.chat.CopyMessage(msg, $UiGlobals.chat.ui_channel_game_all, $uiEnums.CHAT_CHANNEL_PRIVATE, true)
               $UiGlobals.chat.CopyMessage(msg, $UiGlobals.chat.ui_channel_ingame, $uiEnums.CHAT_CHANNEL_PRIVATE, true)
            end
            
            stream.messages.Get().Push(msg)
            stream.messages.OnChanged()
         else
            $hq.ChatSendCommand(command)
         end
      end
      return true
   end
   
   func CanSendMessage() : bool
      var ret : bool  = true      
      var selectedChannel : int = GetSelectedChannel()
      if (selectedChannel == $uiEnums.CHAT_CHANNEL_NEWS)
         ret := false
      elif (selectedChannel == $uiEnums.CHAT_CHANNEL_PRIVATE)
         ret := CanSendPrivate()
      end
      return ret
   end
   
   func GetDefaultInputText() : wstring
      var ret : wstring = $UiGlobals.String2WString("main_chat_input")
      var selectedChannel : int = GetSelectedChannel()
      if (selectedChannel == $uiEnums.CHAT_CHANNEL_PRIVATE)
         if (CanSendPrivate())
            var ud   : UserData = (UserData)$UserDataStorage.users.Get(privateMessagesTarget.Get())
            var p    : params
            p.lb     := $UiGlobals.String2WString("")
            p.nick   := ud.base.full_nickname.Get()
            p.rb     := $UiGlobals.String2WString(": ~")
            ret      := p.lb
            ret      := ret + p.nick
            ret      := ret + p.rb
         else
            ret := $UiGlobals.String2WString("main_chat_input_private")
         end
      else if (!CanSendMessage())
         ret := $UiGlobals.String2WString("main_chat_input_disabled")
      end
      ret := $UiGlobals.TranslateWText(ret)
      return ret      
   end
   
   func CanSendPrivate() : bool
      var ret : bool = false
      ret := $UserDataStorage.IsValidUID(privateMessagesTarget.Get()) and ! $UserDataStorage.IsLocalUID(privateMessagesTarget.Get())
      return ret
   end
   
   func OnSetChatPrivateUser(p : params) : bool
      if (! IsVoid(p.uid))
         SwitchToPrivate(p.uid)
      end
      return true
   end
      
   func SwitchToPrivate(_uid : *)
      var stream : GL_ChatStream = null
      stream := $UiGlobals.chat.GetPrivateChannel(_uid)
      if stream == null
         stream := new GL_ChatStream()
         //stream.members := $OM.Property(new vector)
         stream.messages := $OM.Property(new vector)
         //stream.members.Get().Push(new GL_UID())
         //stream.members.Get().Get(0).value := $OM.Property(_uid)
         stream.private_chat_uid := _uid
         $UiGlobals.chat.private_channels.Push(stream)
         var glUid = new GL_UID()
         glUid.value := $OM.Property(_uid)
         $UiGlobals.chat.GetPrivateMembers().Push(glUid)
         $UiGlobals.chat.private_members.OnChanged()
      end

      var p : params
      p.uid := _uid
      $sslWidgetMgr.GenerateEvent("OpenNewPrivateChat", p)
      
      privateMessagesTarget.Set(_uid)
      
      GotoPrivateTab(_uid) : 0
   end
   
   func GotoPrivateTab(_uid : *)
      var foundPinnedTab = false
      var i : int
      for i := 0 to tabs.tabs.Count() - 1
         var tabData : UiChatTabVMData = (UiChatTabVMData)tabs.tabs.Get(i).data.Get()
         if $UserDataStorage.IsEqualUIDs(tabData.privateUid, _uid)
            tabs.SetSelectedTabIdx(i)
            $sslWidgetMgr.GenerateEvent("SetFocusInputText") : 0
            foundPinnedTab := true
            break
         end
      end
      
      if !foundPinnedTab
         gotoPrivateFlag := true
         tabs.SetSelectedTabIdx(9)
         gotoPrivateFlag := false
         for i := 0 to $UiGlobals.chat.GetPrivateMembers().Count() - 1
            if $UserDataStorage.IsEqualUIDs($UiGlobals.chat.GetPrivateMembers().Get(i).value.Get(), _uid)
               selectedMemberIdx.Set(i):0
               break
            end
         end
         $sslWidgetMgr.GenerateEvent("SetFocusInputText") : 0
      end
   end
   
   func OnLinkClicked(p : params) : bool
      if (!IsVoid(p.text) and p.text != "")
         //SwitchToPrivate($UiGlobals.String2Int64(p.text))
      end
      return true
   end
   
   func OnLinkMouseOver(p : params) : bool
      if (!IsVoid(p.text) and p.text != "")
         userContext.uid      := $UiGlobals.String2Int64(p.text)
         userContext.canOpen  := true
      else
         userContext.canOpen  := false
      end
      playerUID.value.Set($UiGlobals.GetInvalidUIDVal())
      return true
   end
   
   func OnLinkMouseOut(p : params) : bool      
      userContext.canOpen  := false
      playerUID.value.Set(userContext.uid)
      return true
   end
   
   func GetStyleSheet() : vector
      return chatStyleSheet.GetStyleSheet()
   end
   
   func OnSelectedMemberChanged(p : params) : bool
      var members : vector = membersObservable.Get()
      selectedMemberIdx.Set(p.index)
      if p.index >=0 and p.index < members.Count()
         if GetSelectedChannel() == $uiEnums.CHAT_CHANNEL_PRIVATE and !IsPinnedPrivateTab()
            selectedPrivateMemberIdx := p.index
            if !$UserDataStorage.IsEqualUIDs(privateMessagesTarget.Get(), $UserDataStorage.GetInvalidUID())
               var stream = $UiGlobals.chat.GetPrivateChannel(privateMessagesTarget.Get())
               if stream != null
                  stream.Deactivate()
                  FreeStreamTextfield(stream)
               end
            end
            privateMessagesTarget.Set(members.Get(p.index).value.Get())
            var stream = $UiGlobals.chat.GetPrivateChannel(privateMessagesTarget.Get())
            if stream != null
               stream.Activate()
            end
         end
      end
      return true
   end
   
   func OnSendBtnClicked(p : params) : bool
      return SendMessage(p)
   end
end

/*************************************************************
* UiChatMessageLIRVM
* 
*************************************************************/
class UiChatMessageLIRVM
   var mes           : ObservableProperty = $OM.Property(null)
   var userContext   : UserContextMenu    = new UserContextMenu()
   
   func Init(p : params)
      if (! IsVoid(p.message))         
         var mesVal : GL_ChatStreamMessage = (GL_ChatStreamMessage)p.message
         if ($UserDataStorage.IsValidUID(mesVal.sender_user_id.Get()))
            $user_service.RequestData(mesVal.sender_user_id.Get(), $uiEnums.USER_DATA_BASE)
            userContext.uid := mesVal.sender_user_id.Get()
         end
         mes.Set(mesVal)
      end
   end
   
   func GetMessage() : GL_ChatStreamMessage
      var ret : GL_ChatStreamMessage = (GL_ChatStreamMessage)mes.Get()
      return ret
   end
      
   func GetText() : wstring
      var ret : wstring
      var mesVal : GL_ChatStreamMessage = GetMessage()
      if (mesVal != null)
         var ud : UserData = (UserData)$UserDataStorage.users.Get(mesVal.sender_user_id.Get())
         var p : params
         if ($UserDataStorage.IsValidUID(mesVal.sender_user_id.Get()))
            var nickName : wstring = ud.base.full_nickname.Get()
            p.nick   := $root.MakeColorCodedWText(nickName, $UserDataStorage.GetPlayerStatusColorCode(mesVal.sender_user_id.Get()))
         else
            p.nick   := $root.MakeColorCodedWText($UiGlobals.String2WString("SYSTEM"), "#FFFF00")
         end
         p.time      := $root.MakeColorCodedWText($UiGlobals.String2WString("[00:00] "), "#808080")
         p.delim     := $root.MakeColorCodedWText($UiGlobals.String2WString(" : "), "#808080")
         p.mes       := mesVal.text.Get()
         
         ret := ret + p.time
         ret := ret + p.nick
         ret := ret + p.delim
         ret := ret + p.mes
      end
      return ret
   end
end

/*************************************************************
* UiChatMembersLIRVM
* 
*************************************************************/
class UiChatMembersLIRVM
   var uid           : ObservableProperty = $OM.Property($UiGlobals.GetInvalidUIDVal())
   var parentVM      : UiChatVM = null
   //var mes           : ObservableProperty = $OM.Property("")
   var userContext   : UserContextMenu    = new UserContextMenu()
   var unreadMsgCount : ObservableProperty = $OM.Calculated(this, "GetUnreadMsgCount")
   
   func Init(p : params)
      uid.Set($UiGlobals.GetInvalidUIDVal())
      if (! IsVoid(p.uid))
         if ($UserDataStorage.IsValidUID(p.uid))
            $user_service.RequestData(p.uid, $uiEnums.USER_DATA_BASE)
            $user_service.RequestData(p.uid, $uiEnums.USER_DATA_PRESENCE)
            userContext.uid := p.uid
         end
         uid.Set(p.uid)
      end
      if (! IsVoid(p.chatVM))
         parentVM := (UiChatVM)p.chatVM
      end
   end
   
   func GetUID() : *
      return uid.Get()
   end
   
   func GetUserData() : UserData
      var ud : UserData = (UserData)$UserDataStorage.users.Get(GetUID())
      return ud
   end
   
   func GetNickname() : wstring
      var ud   : UserData  = GetUserData()
      var ret  : wstring    = ud.base.full_nickname.Get()
      ret := $root.MakeColorCodedWText(ret, $UserDataStorage.GetPlayerStatusColorCode(GetUID()))
      return ret
   end   
   
   func GetUnreadMsgCount() : int
      if parentVM.IsPrivateTab() and !parentVM.IsPinnedPrivateTab()
         var stream : GL_ChatStream = $UiGlobals.chat.GetPrivateChannel(GetUID())
         if stream != null
            if parentVM.IsPrivateTab()
               return stream.GetNewMessagesCount(false)
            else
               return stream.GetNewMessagesCount(true)
            end
         end
      end
      return 0
   end
      
   func GetStatusFrame() : string
      if GetUserData().presence.presence_state.Get() == $uiEnums.USER_PRESENCE_STATE_OFFLINE
         return "offline"
      elif GetUserData().presence.presence_state.Get() == $uiEnums.USER_PRESENCE_STATE_INGAME
         return "ingame"
      else
         return "online"
      end
   end
   
   func IsStatusVisible() : bool
      return (bool)GetUserData().has_presence.Get()
   end
end


/*************************************************************
* UiChatMessage
* 
*************************************************************/
class UiChatMessage : UiWidgetContainer
   func inputEvent(p : params) : bool
      var isTerminated  : bool   = false
      var keyCode       : int    = p.keyCode
      if (p.isDown == false)
         if (keyCode == $uiKeys.VK_ENTER)
            GenerateEvent("#SendMessage")
            isTerminated := true
         end
      end
      if (keyCode == $uiKeys.VK_DOWN or keyCode == $uiKeys.VK_UP or keyCode == $uiKeys.VK_TAB)
         isTerminated := true
      end
      var caretIndex : * = Get("caretIndex")
      var length  : * = Get("length")
      if (keyCode == $uiKeys.VK_LEFT and caretIndex == 0)
         isTerminated := true
      end
      if (keyCode == $uiKeys.VK_RIGHT and caretIndex == length)
         isTerminated := true
      end
      if (isTerminated)
         p.eventState.SetIsTerminated(isTerminated)
      end
      return false
   end
   
   func focusIn(p : params) : bool
      return false
   end
end


/*************************************************************
* UiChatMembersListCont
* 
*************************************************************/
class UiChatMembersListCont : UiWidgetContainer
   handle OnEnteringState("Initial")
      Props.visible := false
   end
   
   handle OnEnteringState("Visible")
      Props.visible := true      
   end
end

/*************************************************************
* UiChatMessagesListCont
* 
*************************************************************/
class UiChatMessagesListCont : UiWidgetContainer
   var maxTabs : int = 10
   
   handle OnEnteringState("Small")
      Props.x      := 210
      //Widgets.listContentAttach.messages._width := 475
   end
   
   handle OnEnteringState("Full")
      Props.x      := 5
      //Widgets.listContentAttach.messages._width := 695
   end   
   
   func OnSetChatTabText(p : params) : bool      
      var txtIdx : int = -1
      if (!IsVoid(p.txtIdx))
         txtIdx := p.txtIdx
      end
      if (txtIdx >= 0 and txtIdx < maxTabs)
         var txtArea : UiWidgetTextArea = (UiWidgetTextArea)GetWidget("txtAreaCont" + (string)txtIdx).GetWidget("txtArea")
         txtArea.Set("htmlText", p.txt)
      end
      return false
   end
   
   func OnAppendChatTabText(p : params) : bool
      var txtIdx : int = -1
      if (!IsVoid(p.txtIdx))
         txtIdx := p.txtIdx
      end
      if (txtIdx >= 0 and txtIdx < maxTabs)
         var txtArea : UiWidgetTextArea = (UiWidgetTextArea)GetWidget("txtAreaCont" + (string)txtIdx).GetWidget("txtArea")
         txtArea.AppendHtmlText(p.txt)
      end
      return false
   end
   
   func OnShowChatTabMessages(p : params) : bool
      var i       : int
      var txtIdx  : int    = -1
      var isFull  : bool   = false
      if (!IsVoid(p.txtIdx))
         txtIdx := p.txtIdx
      end
      if (!IsVoid(p.isFull))
         isFull:= p.isFull
      end
      for i := 0 to maxTabs - 1
         var txtArea : UiWidgetTextArea = (UiWidgetTextArea)GetWidget("txtAreaCont" + (string)i).GetWidget("txtArea")
         if (txtIdx == i)
            if (isFull)
               txtArea.Props.x := 0
            else
               txtArea.Props.x := 200
            end
            if (!IsVoid(p.width))
               txtArea.Props._width := p.width
            end
            if (!IsVoid(p.height))
               txtArea.Props._height := p.height
            end
            if (!IsVoid(p.autoScrollLastLine))
               txtArea.Props.autoScrollLastLine := p.autoScrollLastLine
            end
         end
         txtArea.Props.visible := txtIdx == i
      end
      return false      
   end
end

