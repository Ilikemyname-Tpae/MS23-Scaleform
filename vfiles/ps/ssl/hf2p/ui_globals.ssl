   var weaponSlotIdxToItemTypeVec               : vector
   var armorSlotIdxToItemTypeVec                : vector
   
   func UiEnums()
      var p : params
      // weaponSlotIdxToItemTypeVec      
      p.itemType     := ITEM_TYPE_WEAPON
      p.itemSubType  := ITEM_SUB_TYPE_WPN_PRIMARY
      weaponSlotIdxToItemTypeVec.Push(p.Clone())
      
      p.itemType     := ITEM_TYPE_WEAPON
      p.itemSubType  := ITEM_SUB_TYPE_WPN_SECONDARY
      weaponSlotIdxToItemTypeVec.Push(p.Clone())
      
      p.itemType     := ITEM_TYPE_WEAPON
      p.itemSubType  := ITEM_SUB_TYPE_WPN_GRENADE
      weaponSlotIdxToItemTypeVec.Push(p.Clone())
      
      p.itemType     := ITEM_TYPE_TACTICAL
      p.itemSubType  := ITEM_SUB_TYPE_TP_PERK
      weaponSlotIdxToItemTypeVec.Push(p.Clone())
      weaponSlotIdxToItemTypeVec.Push(p.Clone())
      weaponSlotIdxToItemTypeVec.Push(p.Clone())
      weaponSlotIdxToItemTypeVec.Push(p.Clone())
      
      p.itemType     := ITEM_TYPE_TACTICAL
      p.itemSubType  := ITEM_SUB_TYPE_TP_BOOST
      weaponSlotIdxToItemTypeVec.Push(p.Clone())
      
      // armorSlotIdxToItemTypeVec
      p.itemType     := ITEM_TYPE_ARMOR
      p.itemSubType  := ARMOR_PART_HELMET
      armorSlotIdxToItemTypeVec.Push(p.Clone())
      
      p.itemType     := ITEM_TYPE_ARMOR
      p.itemSubType  := ARMOR_PART_CHEST
      armorSlotIdxToItemTypeVec.Push(p.Clone())
      
      p.itemType     := ITEM_TYPE_ARMOR
      p.itemSubType  := ARMOR_PART_SHOULDER
      armorSlotIdxToItemTypeVec.Push(p.Clone())      
      
      p.itemType     := ITEM_TYPE_ARMOR
      p.itemSubType  := ARMOR_PART_ARMS
      armorSlotIdxToItemTypeVec.Push(p.Clone())
      
      p.itemType     := ITEM_TYPE_ARMOR
      p.itemSubType  := ARMOR_PART_LEGS
      armorSlotIdxToItemTypeVec.Push(p.Clone())
      return       
   end
end

var $uiEnums : UiEnums


/***************************************************************
* GL_Int
*
***************************************************************/   
class GL_Int : UiSslBindableBase
   var value  : ObservableProperty = null
end

/***************************************************************
* GL_ComponentUI
*
***************************************************************/  
class GL_ComponentUI : UiSslBindableBase
   var name       : ObservableProperty = null

   var desc       : ObservableProperty = null
   var desc_short : ObservableProperty = null

   var icon       : ObservableProperty = null
   var icon_med   : ObservableProperty = null
   var icon_big   : ObservableProperty = null

   var video      : ObservableProperty = null

   var quality    : ObservableProperty = null
   
   func GetQualityIntVal() : int
      var ret : int = 0
      if ((string)quality.Get() == "" or (string)quality.Get() == "common")
         ret := 0
      elif ((string)quality.Get() == "uncommon")   
         ret := 1
      elif ((string)quality.Get() == "rare")   
         ret := 2   
      elif ((string)quality.Get() == "legendary")   
         ret := 3
      elif ((string)quality.Get() == "epic")   
         ret := 4   
      end
      return ret
   end
   
end

