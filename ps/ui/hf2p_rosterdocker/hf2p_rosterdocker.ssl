/*---------------------------------------------------------
* UiRosterDockerSearchField
-----------------------------------------------------------*/
class UiRosterDockerSearchField : UiWidgetText
   func inputEvent(p : params) : bool
      var isTerminated  : bool   = false
      var keyCode       : int    = p.keyCode
      if (p.isDown == true)
         if (keyCode == $uiKeys.VK_ENTER)
            GenerateEvent("#DoSearch")
            isTerminated := true
         end
      end
      if (keyCode == $uiKeys.VK_DOWN or keyCode == $uiKeys.VK_UP or keyCode == $uiKeys.VK_TAB or keyCode == $uiKeys.VK_ENTER)
         isTerminated := true
      end
      if (isTerminated)
         p.eventState.SetIsTerminated(isTerminated)
      end
      return false
   end
   
   func focusIn(p : params) : bool
      var txt : string = Props().text
      if (txt == "type to search")
         Props().text := ""
      end
      return false
   end
end

/*---------------------------------------------------------
* UiRosterPlayerLirVM
-----------------------------------------------------------*/
class UiRosterPlayerLirVM
   var uid           : ObservableProperty = $OM.Property($UserDataStorage.invalidUID.value.Get())
   var userContext   : UserContextMenu    = new UserContextMenu()
   var wgt           : UiWidget           = null 
   
   func Init(p : params)  
      wgt := p.widget
      wgt.Props().mouseChildren  := true      
      //wgt.Props().mouseEnabled   := false
      
      if (! IsVoid(p.uid))
         uid.Set(p.uid)
         userContext.uid := p.uid
         $user_service.RequestData(uid.Get(), $uiEnums.USER_DATA_BASE)
         $user_service.RequestData(uid.Get(), $uiEnums.USER_DATA_PRESENCE)
      end
   end
   
   func GetPlayerName() : wstring
      var ret  :  wstring      
      var ud   :  UserData = (UserData)$UserDataStorage.users.Get(uid.Get())      
      ret := ud.base.full_nickname.Get()
      ret := $root.MakeColorCodedWText(ret, $UserDataStorage.GetPlayerStatusColorCode(uid.Get()))
      return ret
   end
   
   func GetPlayerStatus() : string
      var ret     : string    = "lobby_presence_state_unknown"
      var ud      : UserData  = (UserData)$UserDataStorage.users.Get(uid.Get())
      var pState  : int       = (int)ud.presence.presence_state.Get()            
      if (pState >= $uiEnums.USER_PRESENCE_STATE_OFFLINE)
         ret := "lobby_presence_state_" + (string)pState
      end
      ret := $root.MakeColorCodedText(ret, $UserDataStorage.GetPlayerPresenceColorCode(uid.Get()))
      return ret      
   end
   
   func IsOnline() : bool
      var ret : bool = $UserDataStorage.IsOnline(uid.Get())
      return ret
   end
   
   func GetContextMenuInfo() : GL_ComponentUserContextMenu
      var ret : GL_ComponentUserContextMenu = (GL_ComponentUserContextMenu)$UiGlobals.componentsUserContextMenu.Get(uid.Get())
      return ret
   end
   
   func GetCanInvite() : bool
      return (bool)GetContextMenuInfo().party_can_invite.Get() and IsOnline()
   end
   
   func GetCanUnfollow() : bool
      return (bool)GetContextMenuInfo().social_can_unfollow.Get()      
   end
   
   func GetCanFollow() : bool
      return (bool)GetContextMenuInfo().social_can_follow.Get()      
   end
            
   func GetPlayerTag() : string
      var ret : string
      return ret      
   end
   
   func OnPlayerLIRPlusClicked(p : params) : bool
      var pp : params
      pp.uid := uid.Get()
      wgt.GenerateEvent("OnPlayerLIRPlusClicked", pp)
      return true
   end
      
   func OnPlayerLIRMinusClicked(p : params) : bool
      var pp : params
      pp.uid := uid.Get()
      wgt.GenerateEvent("OnPlayerLIRMinusClicked", pp)
      return true
   end

   func OnPlayerLIRJoinClicked(p : params) : bool
      var pp : params
      pp.uid := uid.Get()
      wgt.GenerateEvent("OnPlayerLIRJoinClicked", pp)
      return true
   end
   
end

