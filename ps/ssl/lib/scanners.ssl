class ScannerPlayer
   native func SetDistEnter(dist : float)
   native func SetDistLeave(dist : float)
   native func SetPos      (obj : object)
   native func AddEnterCB  (f : refFUNC_PTR)
   native func AddLeaveCB  (f : refFUNC_PTR)
   native func Start       ()
   native func Stop        ()
end

class ScannerSmtDomain
   native func SetDomain   (obj : object)
   native func SetMinDist  (dist : float)
   native func SetIdealDist(dist : float)
   native func SetFilter   (filter : StridFlags)
   native func SetOwner    (obj : object)
   native func SetPrevSmt  (obj : object)
   native func AddSelectCB (f : refFUNC_PTR)
   native func Select      ()
end 

class ScannerRetreatPoint
   native func SetOwner    (obj : object)
   native func SetFilter   (isMil : bool = false, isCiv : bool = false, isRbl : bool = false)
   native func AddSelectCB (f : refFUNC_PTR)
   native func Select      ()
end

class ScannerSmt
   native func SetMinDist  (dist : float)
   native func SetIdealDist(dist : float)
   native func SetOwner    (obj : object)
   native func SetFilter   (filter : StridFlags)
   native func AddSelectCB (f : refFUNC_PTR)
   native func Select      ()
end

