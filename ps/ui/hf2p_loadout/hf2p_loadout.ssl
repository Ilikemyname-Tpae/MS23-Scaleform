func VisualizeLoadoutArsenal(loadoutIdx: int)
   Log("ui~loadoutSelect", "VisualizeLoadoutArsenal  " + assignItemId)
   $user_service.SetWeaponLoadoutWeapon(GetRaceIdx(), loadoutIdx, assignItemId)       
end

func VisualizeLoadoutAfterBuy(loadoutIdx: int)
   Log("ui~loadoutSelect", "VisualizeLoadoutAfterBuy")
   UpdateLoadoutStatus(loadoutIdx)   
   ShowSelectLoadoutButtons()
end

func GetKeyBindText(biped : bool, keyId : string) : string
   var labels : vector = $hf2pPreferences.GetActionLabels(biped)
   var labelIdx : int = -1
   var i : int
   for i := 0 to labels.Count() - 1
      if labels.Get(i) == keyId
         labelIdx := i
         break
      end
   end
   var keys : vector = $hf2pPreferences.GetKeyBinds(biped)
   var keyIdx : int = keys.Get(labelIdx).primary
   var keyLabels : vector = $hf2pPreferences.GetKeyLabels()
   var keyLabel : string = ""
   if keyIdx == -1
      keyIdx := keys.Get(labelIdx).alternative
   end
   if keyIdx != -1
      keyLabel := keyLabels.Get(keyIdx)
   end
   return keyLabel
end

func UpdateLoadoutStatusPart2(_loadoutIdx: int, _savePerks : bool = false)
   var loadoutSlot : * = GetLoadout(_loadoutIdx)
   var hasLoadout : bool   = true //$sslUserStates.HasItem(loadoutSlot.Props().loadoutName)
   var udLocal : UserDataLocal = $UserDataStorage.local_user
   var unlockedLoadouts : int = (int)udLocal.weapon_loadouts_unlocked.Get()
   hasLoadout := _loadoutIdx < unlockedLoadouts
   if (hasLoadout)
      //loadoutSlot.Props().btnBox.GotoAndStop("Unlocked")
      loadoutSlot.Props().subText := loadoutSlot.Props().loadoutLabel      
      EnableLoadoutElements(_loadoutIdx, loadoutSlot.Props().loadoutName, _savePerks) : 0
      
      loadoutSlot.Widgets().btnBox.btn3.text2 := GetKeyBindText(true, "settings_actions_throw_grenade")
      loadoutSlot.Widgets().btnBox.btn4.text2 := GetKeyBindText(true, "settings_actions_use_consumable_1")
      loadoutSlot.Widgets().btnBox.btn5.text2 := GetKeyBindText(true, "settings_actions_use_consumable_2")
      loadoutSlot.Widgets().btnBox.btn6.text2 := GetKeyBindText(true, "settings_actions_use_consumable_3")
      loadoutSlot.Widgets().btnBox.btn7.text2 := GetKeyBindText(true, "settings_actions_use_consumable_4")
   else
      //loadoutSlot.Props().btnBox.GotoAndStop("Locked")
      loadoutSlot.Props().subText := loadoutSlot.Props().defSubText      
   end   
   //loadoutSlot.SetLockedState(! hasLoadout, GetStateName() == "Assign2Loadout")
   loadoutSlot.SetLockedState(! hasLoadout, false)
   var slotMouseEnabled: bool = hasLoadout or GetStateName() == "Assign2Loadout"
   loadoutSlot.Props().mouseChildren   := slotMouseEnabled and (GetStateName() != "SeeLoadout" and GetStateName() != "SelectLoadout" and GetStateName() != "SelectLoadoutPregame")
   loadoutSlot.Props().mouseEnabled    := slotMouseEnabled
   loadoutSlot.Props().ingameBg.visible := (GetStateName() == "SelectLoadout" or GetStateName() == "SelectLoadoutPregame")
end

func UpdateLoadoutStatus(_loadoutIdx: int, _savePerks : bool = false)
   var loadoutSlot: * = GetLoadout(_loadoutIdx)
   var hasLoadout : bool   = true //$sslUserStates.HasItem(loadoutSlot.Props().loadoutName)
   var udLocal : UserDataLocal = $UserDataStorage.local_user
   var unlockedLoadouts : int = (int)udLocal.weapon_loadouts_unlocked.Get()
   hasLoadout := _loadoutIdx < unlockedLoadouts
   if (hasLoadout)
      loadoutSlot.GotoAndStop("up")
   else
      loadoutSlot.GotoAndStop("disabled")
   end
   loadoutSlot.Props().enabled  := hasLoadout
   UpdateLoadoutStatusPart2(_loadoutIdx, _savePerks)
end

func UpdateLoadoutOffersLine(_loadoutIdx : int)
   var hasLoadout : bool
   var udLocal : UserDataLocal = $UserDataStorage.local_user
   var unlockedLoadouts : int = (int)udLocal.weapon_loadouts_unlocked.Get()
   hasLoadout := _loadoutIdx < unlockedLoadouts
   if (GetStateName() == "SeeLoadout")
      if (hasLoadout)
         Widgets().slots.Get("offerPanel" + _loadoutIdx).visible := false
      else
         Widgets().slots.Get("offerPanel" + _loadoutIdx).visible := true
         EnableOfferLine(_loadoutIdx, unlockedLoadouts)
      end   
   else
      Widgets().slots.Get("offerPanel" + _loadoutIdx).visible := false
   end
end

func EnableOfferLine(_loadoutIdx : int, _unlockedLoadouts : int)
   if (_loadoutIdx > _unlockedLoadouts)
      Widgets().slots.Get("offerPanel" + _loadoutIdx).tfItemName := "carousel_ui_btn_unavailable"
      Widgets().slots.Get("offerPanel" + _loadoutIdx).alpha := 100
      Widgets().slots.Get("offerPanel" + _loadoutIdx).offerButtons.crBuyBtn.enabled := false
      Widgets().slots.Get("offerPanel" + _loadoutIdx).offerButtons.gpBuyBtn.enabled := false
   else
      Widgets().slots.Get("offerPanel" + _loadoutIdx).tfItemName := "carousel_txt_non_purchased"
      Widgets().slots.Get("offerPanel" + _loadoutIdx).alpha := 100
      Widgets().slots.Get("offerPanel" + _loadoutIdx).offerButtons.crBuyBtn.enabled := true
      Widgets().slots.Get("offerPanel" + _loadoutIdx).offerButtons.gpBuyBtn.enabled := true
   end
end

func GetObservableLoadoutCount() : ObservableProperty
   var udLocal : UserDataLocal = $UserDataStorage.local_user
   return udLocal.weapon_loadouts_unlocked
end

func CheckUpdateLoadout(val : *)  
   var i : int
   for i := 0 to 4
      UpdateLoadoutStatus(i, true)
   end
   for i:= 1 to 4
      UpdateLoadoutOffersLine(i)
   end 
end

func IsShowSelectLoadoutBtns(): bool
   return (GetStateName() == "ChoiceLoadoutBtn")
end

func ShowSelectLoadoutButtons()      
   if (IsShowSelectLoadoutBtns())
      if ($UiGlobals.DeathScreenLoadoutsMode.Get() == "weapons")
         Widgets().RespawnPanel.loadouts.loadout0.Init(1, "Loadout0", "carousel_loadout_1", false)
         Widgets().RespawnPanel.loadouts.loadout1.Init(2, "Loadout1", "carousel_loadout_2", false)
         Widgets().RespawnPanel.loadouts.loadout2.Init(3, "Loadout2", "carousel_loadout_3", false)
         Widgets().RespawnPanel.loadouts.loadout3.Init(4, "Loadout3", "carousel_loadout_4", false)
         Widgets().RespawnPanel.loadouts.loadout4.Init(5, "Loadout4", "carousel_loadout_5", false)
      else
         Widgets().RespawnPanel.loadouts.loadout0.Init(1, "Loadout0", "carousel_armor_1", true)
         Widgets().RespawnPanel.loadouts.loadout1.Init(2, "Loadout1", "carousel_armor_2", true)
         Widgets().RespawnPanel.loadouts.loadout2.Init(3, "Loadout2", "carousel_armor_3", true)
         Widgets().RespawnPanel.loadouts.loadout3.Init(4, "Loadout3", "carousel_armor_4", true)
         Widgets().RespawnPanel.loadouts.loadout4.Init(5, "Loadout4", "carousel_armor_5", true)
      end
      Widgets().RespawnPanel.GenerateEvent("#ShowRespawnPanel")
   else   
      Widgets().RespawnPanel.GenerateEvent("#HideRespawnPanel")
   end
end

func GetDisabledColorTint(_slotIdx: int): params
   var ret: params
   if (_slotIdx < 4)
      ret.r := 255
      ret.g := 255
      ret.b := 255
      ret.a := 255
      ret.v := 255
   else
      ret.r := 128
      ret.g := 128
      ret.b := 128
      ret.a := 255
      ret.v := 255
   end
   return ret
end

func GetEnabledColorTint(_slotIdx: int): params
   var ret: params
   ret.r := 255
   ret.g := 255
   ret.b := 255
   ret.a := 255
   ret.v := 255
   return ret
end

func GetStateColorTint(_isEnabled: bool, _slotIdx: int): params
   var ret: params
   if (_isEnabled)
      ret := GetEnabledColorTint(_slotIdx)
   else
      ret := GetDisabledColorTint(_slotIdx)
   end
   return ret
end

func GetStateBgColorTint(_isEnabled: bool, _slotIdx: int): params
   var ret: params
   if (_isEnabled)
      ret.r := 255
      ret.g := 255
      ret.b := 255
      ret.a := 255
      ret.v := 255
   else
      ret.r := 64
      ret.g := 64
      ret.b := 64
      ret.a := 64
      ret.v := 64
   end
   return ret
end

func IsAssignSlotEnabled(i: int): bool
   var ret: bool = false
   if (GetStateName() != "Assign2Loadout")
      ret := false
   else
      ret := (i - 1) >= minSlotIdx and (i - 1) <= maxSlotIdx
   end
   return ret
end

func EnableLoadoutElements(_idx: int, loadoutName:string, _savePerks: bool = false)
   var btnIdx : int
   
   if GetStateName() == "Assign2Loadout"
      for btnIdx := 1 to 3 // weapons and grenade
         var isClickable : bool = IsAssignSlotEnabled(btnIdx)
         Widgets().slots.Get(loadoutName).btnBox.Get("btn" + btnIdx).selected  := isClickable
         Widgets().slots.Get(loadoutName).btnBox.Get("btn" + btnIdx).enabled  := isClickable
         Widgets().slots.Get(loadoutName).btnBox.Get("btn" + btnIdx).mouseEnabled  := false
      end
      
      for btnIdx := 4 to 8 // tactical packages and booster
         var isClickable : bool = IsAssignSlotEnabled(btnIdx)
         Widgets().slots.Get(loadoutName).btnBox.Get("btn" + btnIdx).selected  := isClickable
         Widgets().slots.Get(loadoutName).btnBox.Get("btn" + btnIdx).enabled  := isClickable
         Widgets().slots.Get(loadoutName).btnBox.Get("btn" + btnIdx).mouseEnabled  := isClickable
      end
   else
      for btnIdx := 1 to 3 // weapons and grenade
         var isClickable : bool = IsAssignSlotEnabled(btnIdx)
         Widgets().slots.Get(loadoutName).btnBox.Get("btn" + btnIdx).selected  := isClickable
         Widgets().slots.Get(loadoutName).btnBox.Get("btn" + btnIdx).enabled  := true
         Widgets().slots.Get(loadoutName).btnBox.Get("btn" + btnIdx).mouseEnabled  := false
      end
      
      for btnIdx := 4 to 8 // tactical packages and booster
         var isClickable : bool = IsAssignSlotEnabled(btnIdx)
         Widgets().slots.Get(loadoutName).btnBox.Get("btn" + btnIdx).selected  := isClickable
         Widgets().slots.Get(loadoutName).btnBox.Get("btn" + btnIdx).enabled  := true
         Widgets().slots.Get(loadoutName).btnBox.Get("btn" + btnIdx).mouseEnabled  := isClickable
      end
   end
end

func OnUpdateLoadoutAfterBuy(p:params):bool
   Log("ui~loadoutSelect", "OnUpdateWpnContAfterBuy ...")
   if (p.isOK == true)
		UpdateLoadoutSlot(p.ItemID)    
      $root.playSound("menu_purchase_item")
      GenerateEvent("uiUpdatePlayerInfoAnim")      
   else
      Log("ui~loadoutSelect", "OnUpdateLoadoutAfterBuy - Cancel")
   end
   return false
end

func UpdateSlotsAfterBuy(p:params):bool
   Log("ui~loadoutSelect", "UpdateSlotsAfterBuy " + (string)(p.itemID))
   UpdateLoadoutSlot(p.itemID)    
   $root.playSound("menu_purchase_item")
   GenerateEvent("uiUpdatePlayerInfoAnim")
   return false
end

func UpdateLoadoutSlot(loadoutName:string)
   Log("ui~loadoutSelect", "UpdateLoadoutSlot")
	Widgets().slots.Get(loadoutName).alpha := 100
	Widgets().slots.Get(loadoutName).enabled := true 
	//Widgets().slots.Get(loadoutName).btnBox.lock.GotoAndPlay("unlocked")
	Widgets().slots.Get(loadoutName).btnBox.GoldV.visible := false
	Widgets().slots.Get(loadoutName).btnBox.CreditsV.visible := false
	VisualizeLoadoutAfterBuy(curLoadoutIdx)
end

func onLoadoutClicked(p: params): bool
   Log("ui~loadoutSelect", "onLoadoutClicked " + p.widget.idx)
	curLoadoutIdx := p.widget.idx
	var state: bool = true
   Log("ui~loadoutSelect", "!!! " + (string)(p.widget.GetName()) + " " + (string)(state) + " !!!")
   if GetStateName() == "Assign2Loadout"
      var loadoutIdx : int = p.widget.Get("idx")
      if wpnAssign
         //!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
         //!!!       HACK TO DIFFERENTIATE GRENADES FROM WEAPONS       !!!
         //!!!                     |   |   |   |                       !!!
         //!!!                     V   V   V   V                       !!!
         //!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
         if assignItemId == "frag_grenade" or assignItemId == "plasma_grenade" or assignItemId == "spike_grenade" or assignItemId == "fire_grenade"
            $user_service.SetWeaponLoadoutGrenade(GetRaceIdx(), loadoutIdx, assignItemId)
         else
            $user_service.SetWeaponLoadoutWeapon(GetRaceIdx(), loadoutIdx, assignItemId)
         end
         acceptLoadout(p)
      end
   elif GetStateName() == "SeeLoadout"
      acceptLoadout(p)
   else // SelectLoadout state
      acceptLoadout(p)
   end	  
   return false
end

func onLoadoutOfferCrClicked(p : params) : bool
   var loadoutIdx   : int = p.widget.GetWidget("_parent").GetWidget("_parent").Props().idx
   var shop         : GL_ShopRace    = (GL_ShopRace)$UiGlobals.shop.race_shops.Get().Get(GetRaceIdx())
   var shopSection  : GL_ShopSection = shop.FindInternalSection("section_loadouts")
   var shopShelf    : GL_ShopShelf = shopSection.FindShelf("shelf_weapon_loadouts")
   var loadoutId    : string = (string)shopShelf.items.Get().Get(loadoutIdx).value.Get()
   var shopComp     : GL_ComponentShop = (GL_ComponentShop)$UiGlobals.componentsShop.Get(loadoutId)
   var loadoutOffer : GL_ComponentShopOffer = (GL_ComponentShopOffer)shopComp.offers.Get().Get(0)
   var offerId      : string  = loadoutOffer.GetCrOffer()
   var offerCr      : int     = loadoutOffer.GetCrCost()
   if (offerId != "")
      var par: params
      par.itemID        := loadoutId
      par.offer         := offerId
      par.priceCredit   := offerCr
      if (offerCr <= (int)$UserDataStorage.local_user.cr.Get())
         par.mbType           := "ConfirmBuy"
         par.callbackEvent    := "loadoutUpdate"
      else
         par.mbType     := "Info"
         par.titleTxt   := "msg_ui_warning"
         par.messageTxt := "msg_ui_not_enough_cr"
      end
      $sslWidgetMgr.GenerateEvent("MainMenuDialogRequest", par)         
   end
   return false
end

func onLoadoutOfferGpClicked(p : params) : bool
   var loadoutIdx   : int = p.widget.GetWidget("_parent").GetWidget("_parent").Props().idx
   var shop         : GL_ShopRace    = (GL_ShopRace)$UiGlobals.shop.race_shops.Get().Get(GetRaceIdx())
   var shopSection  : GL_ShopSection = shop.FindInternalSection("section_loadouts")
   var shopShelf    : GL_ShopShelf = shopSection.FindShelf("shelf_weapon_loadouts")
   var loadoutId    : string = (string)shopShelf.items.Get().Get(loadoutIdx).value.Get()
   var shopComp     : GL_ComponentShop = (GL_ComponentShop)$UiGlobals.componentsShop.Get(loadoutId)
   var loadoutOffer : GL_ComponentShopOffer = (GL_ComponentShopOffer)shopComp.offers.Get().Get(0)
   var offerId      : string  = loadoutOffer.GetGlOffer()
   var offerGl      : int     = loadoutOffer.GetGlCost()
   if (offerId != "")
      var par: params
      par.itemID        := loadoutId
      par.offer         := offerId
      par.priceGold     := offerGl
      if (offerGl <= (int)$UserDataStorage.local_user.gold.Get())
         par.mbType           := "ConfirmBuy"
         par.callbackEvent    := "loadoutUpdate"
      else
         par.mbType     := "Info"
         par.titleTxt   := "msg_ui_warning"
         par.messageTxt := "msg_ui_not_enough_gp"
      end
      $sslWidgetMgr.GenerateEvent("MainMenuDialogRequest", par)         
   end
   return false
end

