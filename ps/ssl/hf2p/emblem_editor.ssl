	native func GetLayers             () : vector
	native func GetCurrentLayer       () : params
	native func GetPaliteColors       () : vector
	native func LoadEmblemFromPlayerProfiler (type : int) : void
	native func SaveEmblemToPlayerProfiler (type : int) : void
	native func GetColorById          (id : int) : params
	native func EMGetEmblemData       (emblem_id : int) : vector
	native func EMSetEmblemIsReady    (emblem_id : int) : void
	native func EMSetFrameIsActive    () : void
	native func HotKeyActionRemap     (hot_action : int) : string
	native func GetHotKeyActionRemapArray() : vector
end
var $hf2pEmblemEditor : HF2P_EMBLEM_EDITOR