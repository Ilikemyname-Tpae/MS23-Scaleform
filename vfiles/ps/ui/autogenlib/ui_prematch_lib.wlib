classes = {
	attachPoint = {
		__type = "ui_widget_container"

		symbol  = "attachPoint" 
		lib     = prematch_lib 
	}

	hf2p_TeamBoard = {
		__type = "ui_widget_container"

		symbol  = "hf2p_TeamBoard" 
		lib     = prematch_lib 

		elements {
			container {
				__type = "ui_widget_container"

				propMapping {
					textDesc = {
						mapping = "textDesc.text"
					}
					textHeader = {
						mapping = "textHeader.text"
					}
				}
				x         = 0
				y         = 0

				elements {
					gameModeAttach {
						__type = "ui_prematch_lib::attachPoint"
						x         = 21
						y         = 46.5
					} 
				}
				animated  = true
			} 
		}
	}

	hf2p_TeamNotification = {
		__type = "ui_widget_container"

		symbol  = "hf2p_TeamNotification" 
