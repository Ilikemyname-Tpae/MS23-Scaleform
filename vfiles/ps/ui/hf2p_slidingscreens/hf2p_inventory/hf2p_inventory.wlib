            bindings   =   {
               items   =   {
                  binding   =   "{inventoryList}"
               }
            }
            customProps   =   [
               {
                  propName   =   "_width"
                  propVal   =   {
                     val   =   1237
                     __type   =   "ui_widget_desc_prop_int"
                  }
               },
               {
                  propName   =   "_height"
                  propVal   =   {
                     val   =   428
                     __type   =   "ui_widget_desc_prop_int"
                  }
               }
            ]
            lir   =   {
