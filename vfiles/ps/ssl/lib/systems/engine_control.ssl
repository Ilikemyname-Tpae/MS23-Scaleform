   native func GetLevelName() : string
   native func GetDefaultLevelName() : string
   native func GetBuildInfo() : string
   native func SetCameraToStartPos(idxStartPos : int)
   native func SetSplitScreen(isOn: bool)
   native func SetSmtSharedScreen(isOn: bool)
   native func GetVariable(sect : string, key : string, type : string) : *
   native func SetVariable(sect : string, key : string, type : string, val : *)
   native func GetGlobalVar(key : string) : *
   native func SetGlobalVar(key : string, val : *)
   native func GetUserVar(userID : int, key : string) : *
   native func SetUserVar(userID : int, key : string, val : *)
   native func IsUserSignedIn(userID: int): bool
   native func IsReadyToCheckSignIn(): bool
   native func ReloadBrands(prefix : string, postfix : string, macro : string)
   native func GetActualMapList(): vector
   native func GetPlatformName(): string
