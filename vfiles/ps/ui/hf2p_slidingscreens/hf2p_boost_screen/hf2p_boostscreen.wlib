   BoosterCont   =   {
      isBlinkable   =   True
      handlers   =   {
         UpdateBoosts   =   {
            handlerName   =   "#OnUpdateBoosts"
         }
      }
      elements   =   {
         tfBoostDesc   =   {
            bindings   =   {
               tf   =   {
                  binding   =   "{GetCompUI().desc + ',' + GetCompUI().desc_short}"
               }
            }
            __type   =   "ui_widget_container"
         }
         tfBoostHead   =   {
            bindings   =   {
               tf   =   {
                  binding   =   "{GetCompUI().name}"
               }
            }
            __type   =   "ui_widget_container"
         }
         tfBoostTime   =   {
            bindings   =   {
               tf   =   {
                  binding   =   "{GetRentLabel()}"
               }
            }
            __type   =   "ui_widget_container"
         }
         tfBoost   =   {
            visible   =   False
            bindings   =   {
               tf   =   {
                  binding   =   "{GetSubHeader()}"
               }
            }
            __type   =   "ui_widget_container"
         }
         iconBoost   =   {
            bindings   =   {
               pic   =   {
                  binding   =   "{GetCompUI().icon}"
               }
            }
            isCentered   =   True
            __type   =   "ui_playerInfoPanel_lib::attachPoint"
         }
         bgBoostImg   =   {
            bindings   =   {
               pic   =   {
                  binding   =   "{GetCompUI().icon_big}"
               }
            }
            __type   =   "ui_playerInfoPanel_lib::attachPoint"
         }
         colorShopBooster   =   {
            bindings   =   {
               tint   =   {
                  binding   =   "{GetTint((:idx))}"
               }
            }
            __type   =   "ui_widget_container"
         }
      }
      bindings   =   {
         DC   =   {
            binding   =   "{new: 'ui.hf2p_SlidingScreens.hf2p_Boost_screen.hf2p_BoostScreen.BoostVM', idx = (:idx)}"
         }
      }
      __type   =   "ui_playerInfoPanel_lib::boosterXpCr"
   }
