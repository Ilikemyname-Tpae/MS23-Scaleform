         if (p.keyCode == 16)
            isShiftPressed := true      
         end               
      else
         if (p.keyCode == 16)
            isShiftPressed := false
         elif (p.keyCode == 82)
            if (isShiftPressed) 
               RestartFadeIn()
            end
         elif (p.keyCode == 79)
            if (isShiftPressed) 
               RestartFadeOut()
            end
         end               
      end
   end
   
   return true
end
*/

func OnOpenChallengesCarousel(p : params) : bool
   OpenSlidingScreenByName($uiEnums.SLIDING_PAGE_ITEM_CHALLENGES, $uiEnums.SLIDING_SCREENS_MODE_CHALLENGES)
   return false
end

func ShowUserProfile(_uid : *)
   $UiGlobals.profileScreenUID.Set(_uid)
   OpenSlidingScreenByName($uiEnums.SLIDING_PAGE_PROFILE, $uiEnums.SLIDING_SCREENS_MODE_PROFILE)
end

func OnShowPostgameReplay(p : params) : bool      
   $UiGlobals.notifications.session_reward_replayIdx := p.session_reward_idx
   GenerateEvent("closeRosterDocker")
   SetStateName("Postgame")
   return false
end


func OnShowShopItem(p : params) : bool
   var urlComp : vector = p.urlComp
   if (urlComp.Count() > 2 and urlComp.Get(0) == "shop")
      var shopItem      : string = urlComp.Get(urlComp.Count() - 1)
      var shopLocation  : params = $uiEconomy.FindShopItem(shopItem)
      if (shopLocation.found)
         $UiGlobals.shop.openParams.isValid     := true
         $UiGlobals.shop.openParams.sectionIdx  := shopLocation.sectionIdx
         $UiGlobals.shop.openParams.shelfIdx    := shopLocation.shelfIdx
         $UiGlobals.shop.openParams.itemIdx     := shopLocation.itemIdx
         
         var shopType : int = shopLocation.shopType
         if (shopType == $uiEnums.SHOP_TYPE_WEAPON)
            OpenSlidingScreenByName($uiEnums.SLIDING_PAGE_WEAPONS, $uiEnums.SLIDING_SCREENS_MODE_SHOP_SMALL)
         elif (shopType == $uiEnums.SHOP_TYPE_TACTICAL)
            OpenSlidingScreenByName($uiEnums.SLIDING_PAGE_TACTICAL, $uiEnums.SLIDING_SCREENS_MODE_SHOP_SMALL)
         elif (shopType == $uiEnums.SHOP_TYPE_ARMOR)
            OpenSlidingScreenByName($uiEnums.SLIDING_PAGE_ARMORY, $uiEnums.SLIDING_SCREENS_MODE_SHOP_SMALL)
         elif (shopType == $uiEnums.SHOP_TYPE_BUNDLES)
            OpenSlidingScreenByName($uiEnums.SLIDING_PAGE_BUNDLES, $uiEnums.SLIDING_SCREENS_MODE_SHOP_SMALL)
         end         
      end
   end
   return false
end

func OnStartAsyncWait(p : params) : bool
   var asyncOp : UiAsyncOperation = null
   if (! IsVoid(p.asyncOp))
      asyncOp := p.asyncOp
   end
   Widgets().asyncWaiting.GetDC().StartWaiting(asyncOp)
   return false
end

func OnStopAsyncWait(p : params) : bool
   Widgets().asyncWaiting.GetDC().StopWaiting()
   return false   
end

func StartSpartanWait()
   var wgt : UiWidget = (UiWidget)GetWidget("spartanWaiting")
   if (wgt != null)
      wgt.GetDC().StartWaiting()
   end
end

func StopSpartanWait()
   var wgt : UiWidget = (UiWidget)GetWidget("spartanWaiting")
   if (wgt != null and !IsVoid(wgt.GetDC()))
      wgt.GetDC().StopWaiting()
   end
end
   
end

class UiBg : UiWidgetContainer

var   startCameraAngle  : float

override StartDrag   
   startCameraAngle  := $hf2pEngine.GetRotatePlayerModel()
   var pp: params
   pp.dragEvent   := "MainMenuCameraDrag"
   pp.dragTarget  :=  this
   GenerateEvent("StartUniversalDrag", pp)
   return null
end

func OnMainMenuCameraDrag(p: params): bool
   $hf2pEngine.SetRotatePlayerModel(startCameraAngle + p.mouseOffset.x * 0.5)
   return false
end

func OnMouseDown(p: params): bool
   StartDragManual()
   return false
end
end


class UiHf2pMainMenuVM 
   var wgt                 :  UiHf2pMainMenu       = null
   var isSpartanWaiting    :  ObservableProperty   = $OM.Calculated(this, "GetIsSpartanWaiting")
   var currentState        :  ObservableProperty   = $OM.Property("")
      
   func Init(p : params)
      wgt := p.widget
      isSpartanWaiting.Subscribe(this, "UpdateSpartanWaiting")
      isSpartanWaiting.Get()
   end
   
   func Term()
      isSpartanWaiting.Unsubscribe(this, "UpdateSpartanWaiting")      
   end
      
   func UpdateSpartanWaiting(_val : *)
      if (wgt != null)
         if (GetIsSpartanWaiting())
            wgt.StartSpartanWait()            
         else
            wgt.StopSpartanWait()            
         end
      end
   end
            
   func GetIsSpartanWaiting() : bool
      return IsMainMenuInitial() and $UserDataStorage.local_user.IsWaitingLoadout()
   end

   func IsMainMenuInitial() : bool
      var ret : bool = false
      if (wgt != null)
         ret := currentState.Get() == "MainMenuInitial"
      end
      return ret
   end
   
   func GetCurrentState() : string
      return (string)currentState.Get()
   end
   
   func OnChangeStateAny(_stateName : string)
      currentState.Set(_stateName)
      if (GetCurrentState() == "MainMenuInitial")
         wgt.EnableNotificationsPopup(true)
         $uiPartyMonitor.SetLobbyMode("")
      elif (GetCurrentState() == "Welcome" or GetCurrentState() == "WelcomeInitial")
         wgt.EnableNotificationsPopup(false)
      end
   end
end

class UiUniversalDragSymbol : UiWidgetContainer

var   dragEvent      : string = ""
var   startMousePos  : params
var   dragTarget     : UiWidget = null

override StartDrag   
   if (dragEvent != "")
      startMousePos := GetMousePos()
      GenerateUpdateEvent("start")
      Props().visible   := true
      return this
   end
   return null
end

func GenerateUpdateEvent(_updType : string)
   if (dragEvent != "")
      var   curMousePos    : params = GetMousePos()
      var   mouseOffset    : params
      mouseOffset.x := curMousePos.x - startMousePos.x
      mouseOffset.y := curMousePos.y - startMousePos.y
      var dragParams: params
      dragParams.startMousePos   := startMousePos
      dragParams.curMousePos     := curMousePos
      dragParams.mouseOffset     := mouseOffset
      dragParams.updateType      := _updType
      if (dragTarget != null)
         GenerateEventTargeted(dragEvent, dragParams, dragTarget.Props())
      else
         GenerateEvent(dragEvent, dragParams)
      end
   end
end

override CanDrop
   GenerateUpdateEvent("update")
   return false
end

override EndDrag
   GenerateUpdateEvent("end")
   Props().visible := false
end

func SetDragEvent(_dragEvent: string, _dragTarget : UiWidget)
   dragEvent   := _dragEvent
   dragTarget  := _dragTarget
end

end
