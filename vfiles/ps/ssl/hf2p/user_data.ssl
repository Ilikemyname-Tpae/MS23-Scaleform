      ret := $root.MakeUiTimerString(time)
      return ret
   end
         
   func GetScorePerGameStr() : string
      var ret  : string
      ret := $root.Float2Str2Dec((float)wp_per_game.Get())
      return ret      
   end
end

/***************************************************************
* UD_Base
*
***************************************************************/   
class UD_Base : UiSslBindableBase
   var nickname   : ObservableProperty = null
   var clan_id    : ObservableProperty = null
   var clan_tag   : ObservableProperty = null
   var level      : ObservableProperty = null
   var level_id   : ObservableProperty = null
   
   var full_nickname : ObservableProperty = $OM.Calculated(this, "GetFullNickName", true)   
   
   func GetFullNickName() : wstring
      if clan_tag.Get() != ""
         var p : params
         p.decorL := $UiGlobals.String2WString("[")
         p.decorR := $UiGlobals.String2WString("]")
         var result : * = p.decorL + clan_tag.Get() + p.decorR + nickname.Get()
         return result
      end
      return nickname.Get()
   end
end

/***************************************************************
* UserData
*
***************************************************************/   
class UserData : UiSslBindableBase
   var has_base                  : ObservableProperty = null
   var has_stats                 : ObservableProperty = null
   var has_presence              : ObservableProperty = null
   var has_social                : ObservableProperty = null
   var has_customizations        : ObservableProperty = null
   var has_armor_loadouts        : ObservableProperty = null
   var has_weapon_loadouts       : ObservableProperty = null

   var has_character_spartan_slot_0 : ObservableProperty = null
   var has_character_spartan_slot_1 : ObservableProperty = null
   var has_character_spartan_slot_2 : ObservableProperty = null

   var base             : UD_Base               = null
   var stats            : UD_Stats              = null
   var presence         : UD_Presence           = null
   var social           : UD_Social             = null

   var customizations   : UD_Customizations     = null
   var armor_loadouts   : UD_RaceArmorLoadouts  = null
   var weapon_loadouts  : UD_RaceWeaponLoadouts = null
   
   var character_spartan_slot_0 : UD_Character = null
   var character_spartan_slot_1 : UD_Character = null
   var character_spartan_slot_2 : UD_Character = null

// ssl-only
   var canRenderBiped   : ObservableProperty    = $OM.Calculated(this, "GetCanRenderBiped", true)
   
   func CanRenderBiped() : bool
      return (bool)canRenderBiped.Get()
   end
   
   func GetCanRenderBiped() : bool
      var ret : bool = true
      
      ret := (bool)(has_customizations.Get()) and ret
      ret := GetHasActiveCharacter() and ret
      
      return ret
   end
   
   func GetCharacterByIdx(idx : int) : UD_Character
      if idx == 0
         return character_spartan_slot_0
      elif idx == 1
         return character_spartan_slot_1
      else
         return character_spartan_slot_2
      end
   end
   
   func GetActiveCharacter() : UD_Character
      return GetCharacterByIdx((int)customizations.character_active_index.Get())
   end
   
   func GetHasCharacterByIdx(idx : int) : bool
      if idx == 0
         return (bool)has_character_spartan_slot_0.Get()
      elif idx == 1
         return (bool)has_character_spartan_slot_1.Get()
      else
         return (bool)has_character_spartan_slot_2.Get()
      end
   end
   
   func GetHasActiveCharacter() : bool
      return GetHasCharacterByIdx((int)customizations.character_active_index.Get())
   end   
end

