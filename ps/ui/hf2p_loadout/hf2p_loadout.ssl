func acceptLoadout(p: params): bool
   Log("ui~loadoutSelect", "acceptLoadout")
   $user_service.SetWeaponLoadoutActive(GetRaceIdx(), p.widget.idx)
   if (GetStateName() == "SelectLoadoutPregame")    
      GenerateEvent("onPregameLoadoutAccepted")
      //SetStateName("Initial")  
   else 
      if (GetStateName() == "SelectLoadout")
         SetStateName("ChoiceLoadoutBtn")
      end
   end

   return false
end

func CloseLoadoutSelection()
   Log("ui~loadoutSelect", "onCloseLoadoutSelection - send")
   GenerateEvent("onCloseLoadoutSelection")
end

func doneA2l(p: params): bool
   if (! IsVoid(curLoadoutIdx))
      $user_service.SetWeaponLoadoutActive(GetRaceIdx(), curLoadoutIdx)
   end
   CloseLoadoutSelection()
   if (clickFlag)
      //AssignMessage()
   end
   return false
end

func AssignMessage()
   Log("ui~loadoutSelect", "AssignMessage")
   var   pp          : params
   pp.itemId         := assignItemId
   pp.isSkip         := true
   pp.mbType         := "AssignInfo"
   pp.callbackEvent  := "AssignMessageClosed"
   //pp.messageTxt     := "Text"
   pp.titleTxt       := "msg_ui_assigned_to_loadout" + (string)(curLoadoutIdx + 1)
   pp.closeTimeout   := 3
   GenerateEvent("MainMenuDialogRequest", pp)   
end

