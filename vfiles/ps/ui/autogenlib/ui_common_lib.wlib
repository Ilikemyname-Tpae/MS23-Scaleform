classes = {
	CommonHorizontalTabs = {
		__type = "ui_widget_container"

		symbol  = "CommonHorizontalTabs" 
		lib     = common_lib 
	}

	common_text = {
		__type = "ui_widget_container"

		symbol  = "common_text" 
		lib     = common_lib 
		propMapping {
			tf = {
				mapping = "tf.text"
			}
		}
	}

	CurrencyUnits = {
		__type = "ui_widget_container"

		symbol  = "CurrencyUnits" 
		lib     = common_lib 
	}

	DefaultTextArea = {
		__type = "ui_widget_text_area"

		symbol  = "DefaultTextArea" 
		lib     = common_lib 
		propMapping {
			raw_textField = {
				mapping = "raw_textField.text"
			}
		}
	}

	DefaultTextAreaCont = {
		__type = "ui_widget_container"

		symbol  = "DefaultTextAreaCont" 
		lib     = common_lib 

		elements {
			txtArea {
				__type = "ui_common_lib::DefaultTextArea"
				x         = 1
				y         = 1
			} 
		}
	}

	DefaultTextInputSkinned = {
		__type = "ui_widget_container"

		symbol  = "DefaultTextInputSkinned" 
		lib     = common_lib 
		propMapping {
			textField = {
				mapping = "textField.text"
			}
		}
	}

	progressBar = {
		__type = "ui_widget_container"

		symbol  = "progressBar" 
		lib     = common_lib 

		elements {
			progressOver {
				__type = "ui_widget_container"

				x         = 4.75
				y         = 4.15
			} 
		}
	}

	progressDiffBar = {
		__type = "ui_widget_container"

		symbol  = "progressDiffBar" 
		lib     = common_lib 

		elements {
			upperMask {
				__type = "ui_widget_container"

				x         = -1
				y         = 2.15
			} 
			progress {
				__type = "ui_widget_container"

				x         = 0
				y         = 0
			} 
			progressYellow {
				__type = "ui_widget_container"

				x         = 0
				y         = 0
			} 
			lowerMask {
				__type = "ui_widget_container"

				x         = -1
				y         = 2.15
			} 
			progressRed {
				__type = "ui_widget_container"

				x         = 0
				y         = 0
			} 
			progressGreen {
				__type = "ui_widget_container"

				x         = 0
				y         = 0
			} 
		}
	}

	universalFakeBackground = {
