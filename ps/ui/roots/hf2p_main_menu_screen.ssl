func OpenReopenSlidingScreen(childSlidingScreens : UiSlidingScreens, slidingScreenMode: string = "GiftShop", startingScreen: string)
   if (childSlidingScreens.GetStateName() != "Visible" or childSlidingScreens.GetCurrentScreenName() != startingScreen)
      var screenLayer : int = -1
      if (childSlidingScreens.GetStateName() == "Visible")
         if (startingScreen == $uiEnums.SLIDING_PAGE_TECHTREE or startingScreen == $uiEnums.SLIDING_PAGE_PROFILE)
            screenLayer := 1
         end
      end
      OpenChild(childSlidingScreens.GetName(), screenLayer, "SlidingScreens")
      childSlidingScreens.SetViewPage(slidingScreenMode, startingScreen)
      childSlidingScreens.SetStateName("Visible")
      SetStateName("SlidingScreens")
   else
      childSlidingScreens.SetViewPage(slidingScreenMode, startingScreen)
   end
end

func OpenSlidingScreenByName(_startingScreen: string, _slidingScreenMode: string = "GiftShop")
   Log("ui~hf2p_main_menu", "OpenSlidingScreenByName " + _startingScreen)
   OpenReopenSlidingScreen(slidingScreens, _slidingScreenMode, _startingScreen)
end

