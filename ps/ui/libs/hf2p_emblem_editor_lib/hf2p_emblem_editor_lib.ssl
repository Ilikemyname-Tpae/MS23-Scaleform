class UiEcRightContainer : UiWidgetContainer

var data1 : vector
var data2 : vector
var data3 : vector
var data4 : vector
var isInited : bool = false
var currentIndex : int = -1

func OnItemDoubleClicked(p:params):bool 
   var eventParams   : params
   eventParams.index := p.index
   var defMousePos : float = 0.0
   eventParams.x := defMousePos
   eventParams.y := defMousePos

   GenerateEvent("eventNewSymbol", eventParams)

   return false
end

func OnStepperIndexChange(p:params):bool
   var val : int = Widgets().tabsRightStepper.selection

   SetGridItemsByTabIndex(val + 1)

   return false
end

func OnFirstRightTabClicked(p:params):bool
   SetGridItemsByTabIndex(1)

   return false
end

func OnSecondRightTabClicked(p:params):bool
   SetGridItemsByTabIndex(2)

   return false
end

func OnThirdRightTabClicked(p:params):bool
   SetGridItemsByTabIndex(3)

   return false
end

func OnFourthRightTabClicked(p:params):bool
   SetGridItemsByTabIndex(4)
   return false
end

func Mod(x : int, m : int) : int
   return x - m * (int)(x / m)
end

func Init()
   if (isInited)
return
   end

   var tabsData : vector 
   var tabElem :  params
   tabElem.label := "1 / 4"
   tabsData.Push(tabElem.Clone())
   tabElem.label := "2 / 4"
   tabsData.Push(tabElem.Clone())
   tabElem.label := "3 / 4"
   tabsData.Push(tabElem.Clone())
   tabElem.label := "4 / 4"
   tabsData.Push(tabElem.Clone())
   Widgets().tabsRightStepper.SetData(tabsData)

   var val : int = 4
   var i : int = 0

   currentIndex := -1
   data1.Clear()
   data2.Clear()
   data3.Clear()
   data4.Clear()

   var pCross : params
   pCross.pic   := "cross"
   pCross.index := 0

   var pTriangle   : params
   pTriangle.pic   := "triangle"
   pTriangle.index := 1

   var pQuadro : params
   pQuadro.pic   := "quadro"
   pQuadro.index := 2

   var pRound : params
   pRound.pic   := "round"
   pRound.index := 3

   var p : vector
   p.Push(pCross)
   p.Push(pTriangle)
   p.Push(pQuadro)
   p.Push(pRound)

   for i := 0 to 5
      data1.Push(p.Get(Mod(i+0, 4)))
      data1.Push(p.Get(Mod(i+1, 4)))
      data1.Push(p.Get(Mod(i+2, 4)))
      data1.Push(p.Get(Mod(i+3, 4))) 
   end
   for i := 0 to 5
      data2.Push(p.Get(Mod(i+1, 4)))
      data2.Push(p.Get(Mod(i+2, 4)))
      data2.Push(p.Get(Mod(i+3, 4)))
      data2.Push(p.Get(Mod(i+0, 4))) 
   end
   for i := 0 to 5
      data3.Push(p.Get(Mod(i+2, 4)))
      data3.Push(p.Get(Mod(i+3, 4)))
      data3.Push(p.Get(Mod(i+0, 4)))
      data3.Push(p.Get(Mod(i+1, 4))) 
   end
   for i := 0 to 5
      data4.Push(p.Get(Mod(i+3, 4)))
      data4.Push(p.Get(Mod(i+0, 4)))
      data4.Push(p.Get(Mod(i+1, 4)))
      data4.Push(p.Get(Mod(i+2, 4))) 
   end
   
   SetColumnCount(val)

   isInited := true
end

func SetGridItemsByTabIndex(index : int)
   if (!isInited)
      Init()
   end
   if (currentIndex != index)
      currentIndex := index

      Widgets().firstRightTab.enabled     := true
      Widgets().secondRightTab.enabled    := true
      Widgets().thirdRightTab.enabled     := true
      Widgets().fourthRightTab.enabled    := true

      Widgets().tabsRightStepper.selection := index - 1

      if (index == 1)
         SetTextVector(data1)
         Widgets().firstRightTab.enabled  := false
      end               
      if (index == 2)
         SetTextVector(data2)
         Widgets().secondRightTab.enabled := false
      end 
      if (index == 3)
         SetTextVector(data3)
         Widgets().thirdRightTab.enabled  := false
      end 
      if (index == 4)
         SetTextVector(data4)
         Widgets().fourthRightTab.enabled := false
      end            
   end
end

func SetColumnCount(data:int)
   Widgets().itemsRightGrid.SetColumnCount(data)
end

func SetTextVector(data:vector)
   Widgets().itemsRightGrid.SetData(data)
end
end

class UiEcStepper : UiWidgetStepper

func OnMouseIn(p:params):bool
   Props().SetFocus()
   return false
end
end

